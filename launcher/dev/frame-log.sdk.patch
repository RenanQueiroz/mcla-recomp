+// TMPFL: one line per draw with the state that matters for the frame
+// structure; constants of the first draw of each shader in the frame and of
+// every small draw (full-screen passes, HUD quads).
+static void TmpFlConstants(const char* tag, const RegisterFile& regs, const Shader& shader,
+                           uint32_t first_reg, uint32_t draw) {
+  const Shader::ConstantRegisterMap& map = shader.constant_register_map();
+  TmpFl("%s n=%u h=%016llX", tag, draw, (unsigned long long)shader.ucode_data_hash());
+  uint32_t logged = 0;
+  for (uint32_t i = 0; i < 256 && logged < 128; ++i) {
+    if (!(map.float_bitmap[i >> 6] & (uint64_t(1) << (i & 63)))) continue;
+    float c[4];
+    std::memcpy(c, &regs.values[first_reg + i * 4], sizeof(c));
+    TmpFl(" c%u=%.6g,%.6g,%.6g,%.6g", i, c[0], c[1], c[2], c[3]);
+    ++logged;
+  }
+  TmpFl(" dyn=%d\n", int(map.float_dynamic_addressing));
+}
+static void TmpFlTextures(const RegisterFile& regs, const Shader& shader) {
+  const char kind = shader.type() == xenos::ShaderType::kPixel ? 't' : 'v';
+  for (const Shader::TextureBinding& binding : shader.texture_bindings()) {
+    const xenos::xe_gpu_texture_fetch_t f = regs.GetTextureFetch(binding.fetch_constant);
+    TmpFl(" %c%u:%08X:%u:%ux%u:d%u:s%u%u%u%u:e%u", kind, binding.fetch_constant,
+          uint32_t(f.base_address) << 12, uint32_t(f.format), uint32_t(f.size_2d.width) + 1,
+          uint32_t(f.size_2d.height) + 1, uint32_t(f.dimension), uint32_t(f.sign_x),
+          uint32_t(f.sign_y), uint32_t(f.sign_z), uint32_t(f.sign_w),
+          uint32_t(f.exp_adjust) & 63);
+  }
+}
+static void TmpFlDraw(const RegisterFile& regs, xenos::PrimitiveType primitive_type,
+                      uint32_t index_count, bool indexed, xenos::EdramMode edram_mode,
+                      const Shader& vertex_shader, const Shader* pixel_shader) {
+  static std::unordered_set<uint64_t> seen_vs, seen_ps;
+  if (g_tmpfl_draw == 0) {
+    seen_vs.clear();
+    seen_ps.clear();
+  }
+  const uint32_t n = g_tmpfl_draw++;
+  uint32_t param_gen = UINT32_MAX;
+  if (pixel_shader) {
+    pixel_shader->GetInterpolatorInputMask(regs.Get<reg::SQ_PROGRAM_CNTL>(),
+                                           regs.Get<reg::SQ_CONTEXT_MISC>(), param_gen);
+  }
+  auto f32 = [&](uint32_t r) {
+    float v;
+    std::memcpy(&v, &regs.values[r], 4);
+    return v;
+  };
+  TmpFl("D n=%u prim=%u cnt=%u ib=%d mode=%u si=%08X ci=%08X,%08X,%08X,%08X di=%08X cm=%08X "
+        "dc=%08X sr=%08X cc=%08X ar=%g bc=%08X,%08X,%08X,%08X wo=%08X ws=%08X,%08X ss=%08X,%08X "
+        "vte=%08X mc=%08X clip=%08X vp=%g,%g,%g,%g,%g,%g vs=%016llX ps=%016llX pg=%d wd=%d kill=%d "
+        "wct=%X",
+        n, uint32_t(primitive_type), index_count, int(indexed), uint32_t(edram_mode),
+        regs[XE_GPU_REG_RB_SURFACE_INFO], regs[XE_GPU_REG_RB_COLOR_INFO],
+        regs[XE_GPU_REG_RB_COLOR1_INFO], regs[XE_GPU_REG_RB_COLOR2_INFO],
+        regs[XE_GPU_REG_RB_COLOR3_INFO], regs[XE_GPU_REG_RB_DEPTH_INFO],
+        regs[XE_GPU_REG_RB_COLOR_MASK], regs[XE_GPU_REG_RB_DEPTHCONTROL],
+        regs[XE_GPU_REG_RB_STENCILREFMASK], regs[XE_GPU_REG_RB_COLORCONTROL],
+        f32(XE_GPU_REG_RB_ALPHA_REF), regs[XE_GPU_REG_RB_BLENDCONTROL0],
+        regs[XE_GPU_REG_RB_BLENDCONTROL1], regs[XE_GPU_REG_RB_BLENDCONTROL2],
+        regs[XE_GPU_REG_RB_BLENDCONTROL3], regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET],
+        regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL], regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR],
+        regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL], regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR],
+        regs[XE_GPU_REG_PA_CL_VTE_CNTL], regs[XE_GPU_REG_PA_SU_SC_MODE_CNTL],
+        regs[XE_GPU_REG_PA_CL_CLIP_CNTL], f32(XE_GPU_REG_PA_CL_VPORT_XSCALE),
+        f32(XE_GPU_REG_PA_CL_VPORT_XOFFSET), f32(XE_GPU_REG_PA_CL_VPORT_YSCALE),
+        f32(XE_GPU_REG_PA_CL_VPORT_YOFFSET), f32(XE_GPU_REG_PA_CL_VPORT_ZSCALE),
+        f32(XE_GPU_REG_PA_CL_VPORT_ZOFFSET), (unsigned long long)vertex_shader.ucode_data_hash(),
+        (unsigned long long)(pixel_shader ? pixel_shader->ucode_data_hash() : 0),
+        param_gen == UINT32_MAX ? -1 : int(param_gen),
+        int(pixel_shader && pixel_shader->writes_depth()),
+        int(pixel_shader && pixel_shader->kills_pixels()),
+        pixel_shader ? pixel_shader->writes_color_targets() : 0);
+  TmpFlTextures(regs, vertex_shader);
+  if (pixel_shader) TmpFlTextures(regs, *pixel_shader);
+  TmpFl("\n");
+  const bool tiny_draw = index_count <= 6;
+  if (seen_vs.insert(vertex_shader.ucode_data_hash()).second || tiny_draw) {
+    TmpFlConstants("VC", regs, vertex_shader, XE_GPU_REG_SHADER_CONSTANT_000_X, n);
+  }
+  if (pixel_shader && (seen_ps.insert(pixel_shader->ucode_data_hash()).second || tiny_draw)) {
+    TmpFlConstants("PC", regs, *pixel_shader, XE_GPU_REG_SHADER_CONSTANT_256_X, n);
+  }
+}
