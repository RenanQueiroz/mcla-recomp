+// TMPFL: the guest memory of the textures of draws with one pixel shader (with
+// readback_resolve=full, resolved data is there by the time the draw runs).
+static void TmpFlDumpTextures(const RegisterFile& regs, const Shader& vertex_shader,
+                              const Shader* pixel_shader, const memory::Memory& memory,
+                              uint32_t draw) {
+  const std::string want = REXCVAR_GET(tmp_frame_dump_ps);
+  if (want.empty() || !pixel_shader) return;
+  char hash[24];
+  std::snprintf(hash, sizeof(hash), "%016llX", (unsigned long long)pixel_shader->ucode_data_hash());
+  if (want != hash) return;
+  std::string dir = REXCVAR_GET(tmp_frame_log_dir);
+  if (dir.empty()) dir = ".";
+  for (const Shader* shader : {&vertex_shader, pixel_shader}) {
+    const char kind = shader == pixel_shader ? 't' : 'v';
+    for (const Shader::TextureBinding& binding : shader->texture_bindings()) {
+      const xenos::xe_gpu_texture_fetch_t f = regs.GetTextureFetch(binding.fetch_constant);
+      const FormatInfo* info = FormatInfo::Get(uint32_t(f.format));
+      if (!info || info->block_width != 1 || info->block_height != 1) continue;
+      const uint32_t w = uint32_t(f.size_2d.width) + 1, h = uint32_t(f.size_2d.height) + 1;
+      const uint32_t pitch = std::max(uint32_t(f.pitch) << 5, w);
+      const uint32_t bytes = rex::align(pitch, 32u) * rex::align(h, 32u) * (info->bits_per_pixel / 8);
+      const uint32_t base = uint32_t(f.base_address) << 12;
+      char name[96];
+      std::snprintf(name, sizeof(name), "%s_tex%u_%c%u.bin", g_tmpfl_name.c_str(), draw, kind,
+                    binding.fetch_constant);
+      if (std::FILE* out = std::fopen((dir + "/" + name).c_str(), "wb")) {
+        std::fwrite(memory.TranslatePhysical<const uint8_t*>(base), 1, bytes, out);
+        std::fclose(out);
+      }
+      TmpFl("X n=%u %c%u base=%08X fmt=%u w=%u h=%u pitch=%u tiled=%u endian=%u bytes=%u "
+            "exp=%d file=%s\n",
+            draw, kind, binding.fetch_constant, base, uint32_t(f.format), w, h, pitch,
+            uint32_t(f.tiled), uint32_t(f.endianness), bytes, int(f.exp_adjust), name);
+    }
+  }
+}
