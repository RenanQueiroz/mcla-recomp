+void TmpFl(const char* format, ...) {
+  if (!g_tmpfl_file) return;
+  va_list args;
+  va_start(args, format);
+  std::vfprintf(g_tmpfl_file, format, args);
+  va_end(args);
+}
+// At every swap: closes the frame being logged, opens the next one. Returns
+// true when a new frame starts being logged.
+bool TmpFlSwap(std::string* label_out) {
+  static std::string last_label;
+  static std::string label;
+  static uint32_t remaining = 0, index = 0;
+  if (g_tmpfl_file) {
+    std::fclose(g_tmpfl_file);
+    g_tmpfl_file = nullptr;
+  }
+  g_tmpfl_active = false;
+  const std::string want = REXCVAR_GET(tmp_frame_log);
+  if (!want.empty() && want != last_label) {
+    last_label = want;
+    label = want;
+    remaining = std::max<uint32_t>(1, REXCVAR_GET(tmp_frame_log_frames));
+    index = 0;
+  }
+  if (!remaining) return false;
+  --remaining;
+  std::string dir = REXCVAR_GET(tmp_frame_log_dir);
+  if (dir.empty()) dir = ".";
+  const std::string name = label + "_" + std::to_string(index++);
+  const std::string path = dir + "/" + name + ".txt";
+  if (!REXCVAR_GET(tmp_frame_log_quiet)) {
+    g_tmpfl_file = std::fopen(path.c_str(), "w");
+    if (!g_tmpfl_file) return false;
+    std::setvbuf(g_tmpfl_file, nullptr, _IOFBF, 1 << 20);
+  }
+  g_tmpfl_active = true;
+  g_tmpfl_draw = 0;
+  g_tmpfl_name = name;
+  if (label_out) *label_out = name;
+  return true;
+}
