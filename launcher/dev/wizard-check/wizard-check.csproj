<Project Sdk="Microsoft.NET.Sdk">

  <!-- Development only: the setup wizard's engine (launcher/src/Setup) without its window, for tests
       (Program.cs). Not part of the launcher's build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MclaLauncher</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Backend.cs" />
    <Compile Include="..\..\src\GameSettings.cs" />
    <Compile Include="..\..\src\ShaderStamp.cs" />
    <Compile Include="..\..\src\ShaderPrep.cs" />
    <Compile Include="..\..\src\DisplayHdr.cs" />
    <Compile Include="..\..\src\Setup\*.cs" />
    <!-- Setup\LauncherUpdate.cs uses the self-update pieces (and they the folder swap). -->
    <Compile Include="..\..\src\SelfUpdate.cs" />
    <Compile Include="..\..\installer\FolderSwap.cs" />
  </ItemGroup>

</Project>
