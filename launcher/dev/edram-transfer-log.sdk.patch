+uint32_t DrawExtentEstimator::TmpxfPositions(const Shader& vertex_shader, float* out,
+                                             uint32_t max_vertices) {
+  const RegisterFile& regs = register_file_;
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (vgt_draw_initiator.source_select != xenos::SourceSelect::kDMA &&
+      vgt_draw_initiator.source_select != xenos::SourceSelect::kAutoIndex) {
+    return 0;
+  }
+  if (!vertex_shader.is_ucode_analyzed() || !ShaderInterpreter::CanInterpretShader(vertex_shader)) {
+    return 0;
+  }
+  struct Sink : ShaderInterpreter::ExportSink {
+    float pos[4] = {};
+    bool have = false;
+    float interp[16][4] = {};
+    uint32_t interp_mask = 0, last_interp = 0;
+    void Export(ucode::ExportRegister r, const float* v, uint32_t m) override {
+      if (r == ucode::ExportRegister::kVSPosition) {
+        for (int i = 0; i < 4; ++i) {
+          if (m & (1u << i)) pos[i] = v[i];
+        }
+        have = true;
+      } else if (uint32_t(r) < 16) {
+        last_interp = uint32_t(r);
+        for (int i = 0; i < 4; ++i) {
+          if (m & (1u << i)) interp[uint32_t(r)][i] = v[i];
+        }
+        interp_mask |= 1u << uint32_t(r);
+      }
+    }
+  } sink;
+  auto vgt_dma_size = regs.Get<reg::VGT_DMA_SIZE>();
+  const void* ib = nullptr;
+  xenos::Endian endian = vgt_dma_size.swap_mode;
+  if (vgt_draw_initiator.source_select == xenos::SourceSelect::kDMA) {
+    uint32_t base = regs[XE_GPU_REG_VGT_DMA_BASE];
+    if (vgt_draw_initiator.index_size == xenos::IndexFormat::kInt16) {
+      if (endian == xenos::Endian::k8in32) endian = xenos::Endian::k8in16;
+      else if (endian == xenos::Endian::k16in32) endian = xenos::Endian::kNone;
+      base &= ~uint32_t(1);
+    } else {
+      base &= ~uint32_t(3);
+    }
+    ib = memory_.TranslatePhysical(base);
+  }
+  uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  uint32_t min_index = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  uint32_t max_index = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+  shader_interpreter_.SetShader(vertex_shader);
+  shader_interpreter_.SetExportSink(&sink);
+  uint32_t n = std::min(uint32_t(vgt_draw_initiator.num_indices), max_vertices);
+  for (uint32_t i = 0; i < n; ++i) {
+    uint32_t vi = i;
+    if (ib) {
+      if (vgt_draw_initiator.index_size == xenos::IndexFormat::kInt16) {
+        vi = static_cast<const uint16_t*>(ib)[i];
+      } else {
+        vi = static_cast<const uint32_t*>(ib)[i];
+      }
+      vi = xenos::GpuSwap(vi, endian) & 0xFFFFFF;
+    }
+    vi = std::min(max_index, std::max(min_index, (vi + index_offset) & 0xFFFFFF));
+    sink.have = false;
+    shader_interpreter_.temp_registers()[0] = float(vi);
+    shader_interpreter_.Execute();
+    for (int k = 0; k < 4; ++k) out[i * 4 + k] = sink.have ? sink.pos[k] : -12345.0f;
+  }
+  tmpxf_interp_mask = sink.interp_mask;
+  std::memcpy(tmpxf_interp0, sink.interp[0], sizeof(tmpxf_interp0));
+  std::memcpy(tmpxf_interp1, sink.interp[1], sizeof(tmpxf_interp1));
+  shader_interpreter_.SetExportSink(nullptr);
+  return n;
+}
+bool DrawExtentEstimator::TmpxfPixelColor(const Shader& pixel_shader, float* out) {
+  if (!pixel_shader.is_ucode_analyzed() || !ShaderInterpreter::CanInterpretShader(pixel_shader)) {
+    return false;
+  }
+  struct Sink : ShaderInterpreter::ExportSink {
+    float c[4] = {-1, -1, -1, -1};
+    void Export(ucode::ExportRegister r, const float* v, uint32_t m) override {
+      if (r == ucode::ExportRegister::kPSColor0) {
+        for (int i = 0; i < 4; ++i) {
+          if (m & (1u << i)) c[i] = v[i];
+        }
+      }
+    }
+  } sink;
+  shader_interpreter_.SetShader(pixel_shader);
+  shader_interpreter_.SetExportSink(&sink);
+  for (int pass = 0; pass < 2; ++pass) {
+    float* temps = shader_interpreter_.temp_registers();
+    for (uint32_t i = 0; i < 4 * 64; ++i) temps[i] = float(pass);
+    shader_interpreter_.Execute();
+    for (int i = 0; i < 4; ++i) out[pass * 4 + i] = sink.c[i];
+  }
+  shader_interpreter_.SetExportSink(nullptr);
+  return true;
+}
