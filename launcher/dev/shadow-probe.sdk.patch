+  uint32_t draw_initiator = 0, depth_control = 0, screen_scissor_br = 0, viewport[4] = {};
+};
+bool g_sp_mark_pending = false;
+// Is this one of the sun-shadow cascade draws: a triangle list into the 4x MSAA D24S8 depth target with
+// no colour written, in a cascade's render phase.
+bool SpIsCascadeDraw(const RegisterFile& regs, uint32_t phase, xenos::PrimitiveType prim) {
+  if (prim != xenos::PrimitiveType::kTriangleList) return false;
+  if (phase != 0x20 && phase != 0x40 && phase != 0x80 && phase != 0x100) return false;
+  if (regs.Get<reg::RB_SURFACE_INFO>().msaa_samples != xenos::MsaaSamples::k4X) return false;
+  if (regs.Get<reg::RB_DEPTH_INFO>().depth_format != xenos::DepthRenderTargetFormat::kD24S8) {
+    return false;
+  }
+  if (regs[XE_GPU_REG_RB_COLOR_MASK] & 0xFFFF) return false;
+  const auto depth_control = regs.Get<reg::RB_DEPTHCONTROL>();
+  return depth_control.z_enable && depth_control.z_write_enable;
+}
