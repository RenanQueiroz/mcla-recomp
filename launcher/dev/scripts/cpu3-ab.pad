# The A/B route of the cpu3 chain (generated by scratchpad/cpu3/gen_pads.py): uncapped standing (roam) and driving,
# then the caps 120 and 60. Run it with real-time steps (no --mcla_fixed_dt) and --mcla_fps=0.
# Marks: title, map_zoom, free_roam, roam, drive, settle1, cap120, settle2, cap60, end.
wait 8s
mark title
press_until start left_title every=2s timeout=90s
mark map_zoom
wait_until roam 180s
mark free_roam
wait 5s
mark roam
include cpup-sample.pad
wait 8s
include cpup-sample.pad
trigger rt 1 0.35s
trigger rt 0.6
stick lx 1 0.28s
trigger rt 1
mark drive
include cpup-sample.pad
wait 10s
include cpup-sample.pad
release all
set mcla_fps 120
mark settle1
wait 2s
mark cap120
include cpup-sample.pad
wait 7s
include cpup-sample.pad
set mcla_fps 60
mark settle2
wait 2s
mark cap60
include cpup-sample.pad
wait 7s
include cpup-sample.pad
set mcla_fps 0
mark end
