# A tour of the pause menu, to see what is in it: a screenshot after each step, and the UI
# manager's movie names in the log. Run through coverage.py soak (which fills in {SHOTS}).
include boot-to-roam.pad
log tour: roam
screens
shot {SHOTS}/00-roam.png 0.5
wait 1s 60f
press start 4f
wait 1500ms 90f
log tour: pause menu opened
screens
shot {SHOTS}/01-pause.png 0.5
press rb 4f
wait 1000ms 60f
screens
