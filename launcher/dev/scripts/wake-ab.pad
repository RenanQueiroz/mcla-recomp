# One run for every frame-rate cap, for the A/B of mcla_pump_wake_on_demand (cpu/wake-on-demand work).
# Run it with real-time steps (no --mcla_fixed_dt) and --mcla_fps=0 (uncapped). Boot -> title -> city, a standing
# segment (roam) and a wall-time drive (drive), both uncapped; then the frame-rate caps 120, 60 and 30 are set with
# `set mcla_fps` while the car coasts to a stop, each with a few seconds to settle (the "settle" marks are left out of
# the analysis) and 12 s measured. cpup-sample.pad takes a sample (wall clock, engine frames, swaps, the pump thread's
# rounds and early rounds, the game clock, the position) at the start and end of every measured segment, so that the
# rounds a second and the game clock per wall second come out of the log (launcher/dev/scripts/cpup-speed.pad's reading).
# Marks: title, map_zoom, free_roam, roam, drive, settle1, cap120, settle2, cap60, settle3, cap30, end.
wait 8s
mark title
press_until start left_title every=2s timeout=90s
mark map_zoom
wait_until roam 180s
mark free_roam
wait 8s
mark roam
include cpup-sample.pad
wait 12s
include cpup-sample.pad
trigger rt 1 0.35s
trigger rt 0.6
stick lx 1 0.28s
trigger rt 1
mark drive
include cpup-sample.pad
wait 14s
include cpup-sample.pad
release all
set mcla_fps 120
mark settle1
wait 3s
mark cap120
include cpup-sample.pad
wait 12s
include cpup-sample.pad
set mcla_fps 60
mark settle2
wait 3s
mark cap60
include cpup-sample.pad
wait 12s
include cpup-sample.pad
set mcla_fps 30
mark settle3
wait 3s
mark cap30
include cpup-sample.pad
wait 12s
include cpup-sample.pad
set mcla_fps 0
mark end
