# In-run A/B of the cpu3 chain (generated by scratchpad/cpu3/gen_pads.py): the options are switched every 5 s at the
# spawn point so both sides see the same scene: 1 s to settle (mark x<NN>), 4 s measured (mark u<NN>_<state>).
# Run it with real-time steps and --mcla_fps=0. States: off, po (mcla_poll_wait), pause (mcla_poll_pause_turns 128),
# gpu (gpu_float_constants_run_copy). Uncapped, then at a cap of 60 FPS.
wait 8s
mark title
press_until start left_title every=2s timeout=90s
mark map_zoom
wait_until roam 180s
mark free_roam
wait 8s
set mcla_poll_wait false
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xu01
wait 1s
mark u01_off
wait 4s
set mcla_poll_wait true
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xu02
wait 1s
mark u02_po
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xu03
wait 1s
mark u03_off
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 128
set gpu_float_constants_run_copy false
mark xu04
wait 1s
mark u04_pause
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xu05
wait 1s
mark u05_off
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy true
mark xu06
wait 1s
mark u06_gpu
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xu07
wait 1s
mark u07_off
wait 4s
set mcla_poll_wait true
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xu08
wait 1s
mark u08_po
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xu09
wait 1s
mark u09_off
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 128
set gpu_float_constants_run_copy false
mark xu10
wait 1s
mark u10_pause
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xu11
wait 1s
mark u11_off
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy true
mark xu12
wait 1s
mark u12_gpu
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xu13
wait 1s
mark u13_off
wait 4s
set mcla_poll_wait true
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xu14
wait 1s
mark u14_po
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xu15
wait 1s
mark u15_off
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 128
set gpu_float_constants_run_copy false
mark xu16
wait 1s
mark u16_pause
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xu17
wait 1s
mark u17_off
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy true
mark xu18
