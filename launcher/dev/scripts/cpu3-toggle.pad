set gpu_float_constants_run_copy false
mark xu19
wait 1s
mark u19_off
wait 4s
set mcla_fps 60
mark settlecap
wait 3s
set mcla_poll_wait false
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xc01
wait 1s
mark c01_off
wait 4s
set mcla_poll_wait true
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xc02
wait 1s
mark c02_po
wait 4s
set mcla_poll_wait false
set mcla_poll_pause_turns 0
set gpu_float_constants_run_copy false
mark xc03
