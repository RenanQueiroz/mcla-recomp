+// TMPDV: validation of direct resolves, development only.
+void D3D12RenderTargetCache::ValidateDirectResolve(
+    const draw_util::ResolveInfo& resolve_info, draw_util::ResolveCopyShaderIndex copy_shader,
+    const draw_util::ResolveCopyShaderConstants& copy_shader_constants, uint32_t copy_group_count_x,
+    uint32_t copy_group_count_y, const ui::d3d12::util::DescriptorCpuGpuHandlePair& descriptor_dest,
+    D3D12TextureCache& texture_cache, std::string key) {
+  (void)descriptor_dest;
+  // The written extent in the buffer of the current scaled resolve range.
+  uint64_t scale = uint64_t(draw_resolution_scale_x()) * draw_resolution_scale_y();
+  uint64_t offset =
+      texture_cache.GetCurrentScaledResolveRangeStartScaled() -
+      (uint64_t(texture_cache.GetCurrentScaledResolveBufferIndexPublic()) << 30) +
+      uint64_t(resolve_info.copy_dest_extent_start - resolve_info.copy_dest_base) * scale;
+  uint64_t length = uint64_t(resolve_info.copy_dest_extent_length) * scale;
+  if (!length) {
+    return;
+  }
+  ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+  if (direct_resolve_validation_readback_size_ < length) {
+    direct_resolve_validation_readback_size_ = 0;
+    D3D12_RESOURCE_DESC readback_desc;
+    ui::d3d12::util::FillBufferResourceDesc(readback_desc, length, D3D12_RESOURCE_FLAG_NONE);
+    for (uint32_t i = 0; i < 2; ++i) {
+      direct_resolve_validation_readback_[i].Reset();
+      if (FAILED(device->CreateCommittedResource(
+              &ui::d3d12::util::kHeapPropertiesReadback, D3D12_HEAP_FLAG_NONE, &readback_desc,
+              D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+              IID_PPV_ARGS(&direct_resolve_validation_readback_[i])))) {
+        REXGPU_ERROR("TMPDV failed to create a {}-byte readback buffer", length);
+        return;
+      }
+    }
+    direct_resolve_validation_readback_size_ = length;
+  }
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  ID3D12Resource* scaled_resolve_buffer = texture_cache.GetCurrentScaledResolveBufferResource();
+
+  // The direct resolve's result.
+  texture_cache.TransitionCurrentScaledResolveRange(D3D12_RESOURCE_STATE_COPY_SOURCE);
+  command_processor_.SubmitBarriers();
+  command_list.D3DCopyBufferRegion(direct_resolve_validation_readback_[0].Get(), 0,
+                                   scaled_resolve_buffer, offset, length);
+
+  // The EDRAM buffer path into the same destination, with new descriptors as
+  // bindful ones may be in a new heap.
+  uint32_t dump_base, dump_row_length_used, dump_rows, dump_pitch;
+  resolve_info.GetCopyEdramTileSpan(dump_base, dump_row_length_used, dump_rows, dump_pitch);
+  if (!DumpRenderTargets(dump_base, dump_row_length_used, dump_rows, dump_pitch)) {
+    REXGPU_ERROR("TMPDV failed to dump the render targets");
+    return;
+  }
+  const draw_util::ResolveCopyShaderInfo& copy_shader_info =
+      draw_util::resolve_copy_shader_info[size_t(copy_shader)];
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[2];
+  if (!command_processor_.RequestOneUseSingleViewDescriptors(bindless_resources_used_ ? 1 : 2,
+                                                             descriptors)) {
+    REXGPU_ERROR("TMPDV failed to get descriptors");
+    return;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair reference_dest = descriptors[0];
+  ui::d3d12::util::DescriptorCpuGpuHandlePair reference_source;
+  if (bindless_resources_used_) {
+    reference_source = copy_shader_info.source_is_raw
+                           ? command_processor_.GetSystemBindlessViewHandlePair(
+                                 D3D12CommandProcessor::SystemBindlessView::kEdramRawSRV)
+                           : command_processor_.GetEdramUintPow2BindlessSRVHandlePair(
+                                 copy_shader_info.source_bpe_log2);
+  } else {
+    reference_source = descriptors[1];
+    if (copy_shader_info.source_is_raw) {
+      WriteEdramRawSRVDescriptor(reference_source.first);
+    } else {
+      WriteEdramUintPow2SRVDescriptor(reference_source.first, copy_shader_info.source_bpe_log2);
+    }
+  }
+  texture_cache.CreateCurrentScaledResolveRangeUintPow2UAV(reference_dest.first,
+                                                           copy_shader_info.dest_bpe_log2);
+  texture_cache.TransitionCurrentScaledResolveRange(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  TransitionEdramBuffer(D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+  command_list.D3DSetComputeRootSignature(resolve_copy_root_signature_);
+  command_list.D3DSetComputeRootDescriptorTable(2, reference_source.second);
+  command_list.D3DSetComputeRootDescriptorTable(1, reference_dest.second);
+  command_list.D3DSetComputeRoot32BitConstants(
+      0, sizeof(copy_shader_constants.dest_relative) / sizeof(uint32_t),
+      &copy_shader_constants.dest_relative, 0);
+  command_processor_.SetExternalPipeline(resolve_copy_pipelines_[size_t(copy_shader)]);
+  command_processor_.SubmitBarriers();
+  command_list.D3DDispatch(copy_group_count_x, copy_group_count_y, 1);
+  texture_cache.MarkCurrentScaledResolveRangeUAVWritesCommitNeeded();
+
+  // The reference result, left in the destination.
+  texture_cache.TransitionCurrentScaledResolveRange(D3D12_RESOURCE_STATE_COPY_SOURCE);
+  command_processor_.SubmitBarriers();
+  command_list.D3DCopyBufferRegion(direct_resolve_validation_readback_[1].Get(), 0,
+                                   scaled_resolve_buffer, offset, length);
+
+  direct_resolve_validation_submission_ = command_processor_.GetCurrentSubmission();
+  direct_resolve_validation_length_ = length;
+  direct_resolve_validation_key_ = std::move(key);
+}
+
+// TMPDV
+void D3D12RenderTargetCache::CheckDirectResolveValidation() {
+  if (direct_resolve_validation_submission_ == UINT64_MAX ||
+      command_processor_.GetCompletedSubmission() < direct_resolve_validation_submission_) {
+    return;
+  }
+  void* mappings[2] = {};
+  D3D12_RANGE read_range = {0, SIZE_T(direct_resolve_validation_length_)};
+  bool mapped = true;
+  for (uint32_t i = 0; i < 2; ++i) {
+    mapped &= SUCCEEDED(direct_resolve_validation_readback_[i]->Map(0, &read_range, &mappings[i]));
+  }
+  if (mapped) {
+    CompareDirectResolveValidation(
+        direct_resolve_validation_key_, static_cast<const uint8_t*>(mappings[0]),
+        static_cast<const uint8_t*>(mappings[1]), size_t(direct_resolve_validation_length_));
+  } else {
+    REXGPU_ERROR("TMPDV failed to map the readback buffers");
+  }
+  D3D12_RANGE written_range = {0, 0};
+  for (uint32_t i = 0; i < 2; ++i) {
+    if (mappings[i]) {
+      direct_resolve_validation_readback_[i]->Unmap(0, &written_range);
+    }
+  }
+  direct_resolve_validation_submission_ = UINT64_MAX;
+}
