+// TMPDV: validation of direct resolves, development only.
+bool RenderTargetCache::ShouldValidateDirectResolve(uint64_t frame, bool validation_pending) {
+  if (frame != direct_resolve_validation_frame_) {
+    direct_resolve_validation_frame_ = frame;
+    direct_resolve_validation_last_frame_resolves_ = direct_resolve_validation_frame_resolves_;
+    direct_resolve_validation_frame_resolves_ = 0;
+    if (direct_resolve_validation_target_ >= direct_resolve_validation_last_frame_resolves_) {
+      direct_resolve_validation_target_ = 0;
+    }
+  }
+  uint32_t index = direct_resolve_validation_frame_resolves_++;
+  if (validation_pending || index != direct_resolve_validation_target_) {
+    return false;
+  }
+  ++direct_resolve_validation_target_;
+  return true;
+}
+
+// TMPDV
+std::string RenderTargetCache::GetDirectResolveValidationKey(
+    const draw_util::ResolveInfo& resolve_info, draw_util::ResolveCopyShaderIndex copy_shader,
+    RenderTargetKey source_key, uint32_t source_constants_info) const {
+  bool is_depth = resolve_info.IsCopyingDepth();
+  const draw_util::ResolveEdramInfo& edram_info =
+      is_depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  const FormatInfo* dest_format_info =
+      FormatInfo::Get(xenos::TextureFormat(resolve_info.copy_dest_info.copy_dest_format));
+  return fmt::format(
+      "{} | {}x {} {} read as {} | to {} | samples {} | conversion {} | exp bias {} swap {} "
+      "endian {}",
+      draw_util::resolve_copy_shader_info[size_t(copy_shader)].debug_name,
+      uint32_t(1) << uint32_t(source_key.msaa_samples), is_depth ? "depth" : "color",
+      is_depth ? xenos::GetDepthRenderTargetFormatName(source_key.GetDepthFormat())
+               : xenos::GetColorRenderTargetFormatName(source_key.GetColorFormat()),
+      is_depth
+          ? xenos::GetDepthRenderTargetFormatName(xenos::DepthRenderTargetFormat(edram_info.format))
+          : xenos::GetColorRenderTargetFormatName(
+                xenos::ColorRenderTargetFormat(edram_info.format)),
+      dest_format_info ? dest_format_info->name : "?",
+      uint32_t(resolve_info.copy_dest_coordinate_info.copy_sample_select),
+      source_constants_info & 0xF, int32_t(resolve_info.copy_dest_info.copy_dest_exp_bias),
+      uint32_t(resolve_info.copy_dest_info.copy_dest_swap),
+      uint32_t(resolve_info.copy_dest_info.copy_dest_endian));
+}
+
+// TMPDV
+void RenderTargetCache::CompareDirectResolveValidation(const std::string& key,
+                                                       const uint8_t* direct,
+                                                       const uint8_t* reference, size_t length) {
+  std::array<uint64_t, 3>& stats = direct_resolve_validation_stats_[key];
+  ++stats[0];
+  ++direct_resolve_validation_count_;
+  if (std::memcmp(direct, reference, length)) {
+    size_t differing = 0, first = SIZE_MAX;
+    for (size_t i = 0; i < length; ++i) {
+      if (direct[i] != reference[i]) {
+        if (first == SIZE_MAX) {
+          first = i;
+        }
+        ++differing;
+      }
+    }
+    ++stats[1];
+    stats[2] += differing;
+    size_t row = first & ~size_t(15);
+    std::string direct_hex, reference_hex;
+    for (size_t i = row; i < std::min(row + 16, length); ++i) {
+      direct_hex += fmt::format("{:02X}", direct[i]);
+      reference_hex += fmt::format("{:02X}", reference[i]);
+    }
+    REXGPU_WARN(
+        "TMPDV direct resolve differs: {} - {} of {} bytes, first at {}, at {}: direct {} "
+        "reference {}",
+        key, differing, length, first, row, direct_hex, reference_hex);
+  }
+  if (direct_resolve_validation_count_ % 50 == 0) {
+    REXGPU_INFO("TMPDV direct resolve validation: {} resolves", direct_resolve_validation_count_);
+    for (const auto& stats_pair : direct_resolve_validation_stats_) {
+      REXGPU_INFO("TMPDV   {}: {} validated, {} differing, {} bytes", stats_pair.first,
+                  stats_pair.second[0], stats_pair.second[1], stats_pair.second[2]);
+    }
+  }
+}
