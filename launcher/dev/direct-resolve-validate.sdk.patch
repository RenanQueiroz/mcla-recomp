+// TMPDV: validation of direct resolves, development only.
+void VulkanRenderTargetCache::ValidateDirectResolve(
+    const draw_util::ResolveInfo& resolve_info, draw_util::ResolveCopyShaderIndex copy_shader,
+    const draw_util::ResolveCopyShaderConstants& copy_shader_constants, uint32_t copy_group_count_x,
+    uint32_t copy_group_count_y, VkDescriptorSet descriptor_set_dest, VkBuffer dest_buffer,
+    uint64_t dest_offset, uint64_t dest_length, std::string key) {
+  if (!dest_length) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (direct_resolve_validation_readback_size_ < dest_length) {
+    direct_resolve_validation_readback_size_ = 0;
+    for (uint32_t i = 0; i < 2; ++i) {
+      ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device,
+                                             direct_resolve_validation_readback_[i]);
+      ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device,
+                                             direct_resolve_validation_readback_memory_[i]);
+      if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+              vulkan_device, dest_length, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+              ui::vulkan::util::MemoryPurpose::kReadback, direct_resolve_validation_readback_[i],
+              direct_resolve_validation_readback_memory_[i])) {
+        REXGPU_ERROR("TMPDV failed to create a {}-byte readback buffer", dest_length);
+        return;
+      }
+    }
+    direct_resolve_validation_readback_size_ = dest_length;
+  }
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  VkBufferCopy copy_region;
+  copy_region.srcOffset = dest_offset;
+  copy_region.dstOffset = 0;
+  copy_region.size = dest_length;
+
+  // The direct resolve's result.
+  command_processor_.PushBufferMemoryBarrier(
+      dest_buffer, dest_offset, dest_length, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+      VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, false);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkCopyBuffer(dest_buffer, direct_resolve_validation_readback_[0], 1,
+                                 &copy_region);
+
+  // The EDRAM buffer path into the same destination.
+  uint32_t dump_base, dump_row_length_used, dump_rows, dump_pitch;
+  resolve_info.GetCopyEdramTileSpan(dump_base, dump_row_length_used, dump_rows, dump_pitch);
+  if (!DumpRenderTargets(dump_base, dump_row_length_used, dump_rows, dump_pitch)) {
+    REXGPU_ERROR("TMPDV failed to dump the render targets");
+    return;
+  }
+  command_processor_.PushBufferMemoryBarrier(
+      dest_buffer, dest_offset, dest_length, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_SHADER_WRITE_BIT,
+      VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, false);
+  UseEdramBuffer(EdramBufferUsage::kComputeRead);
+  command_processor_.BindExternalComputePipeline(resolve_copy_pipelines_[size_t(copy_shader)]);
+  VkDescriptorSet descriptor_sets[kResolveCopyDescriptorSetCount] = {};
+  descriptor_sets[kResolveCopyDescriptorSetEdram] = edram_storage_buffer_descriptor_set_;
+  descriptor_sets[kResolveCopyDescriptorSetDest] = descriptor_set_dest;
+  command_buffer.CmdVkBindDescriptorSets(
+      VK_PIPELINE_BIND_POINT_COMPUTE, resolve_copy_pipeline_layout_, 0,
+      uint32_t(rex::countof(descriptor_sets)), descriptor_sets, 0, nullptr);
+  command_buffer.CmdVkPushConstants(resolve_copy_pipeline_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    sizeof(copy_shader_constants.dest_relative),
+                                    &copy_shader_constants.dest_relative);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkDispatch(copy_group_count_x, copy_group_count_y, 1);
+
+  // The reference result, left in the destination.
+  command_processor_.PushBufferMemoryBarrier(
+      dest_buffer, dest_offset, dest_length, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+      VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, false);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkCopyBuffer(dest_buffer, direct_resolve_validation_readback_[1], 1,
+                                 &copy_region);
+  // Before the next uses of the destination, and the host reading the copies.
+  command_processor_.PushBufferMemoryBarrier(
+      dest_buffer, dest_offset, dest_length, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+      VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT, VK_QUEUE_FAMILY_IGNORED,
+      VK_QUEUE_FAMILY_IGNORED, false);
+  for (uint32_t i = 0; i < 2; ++i) {
+    command_processor_.PushBufferMemoryBarrier(
+        direct_resolve_validation_readback_[i], 0, dest_length, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT,
+        VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, false);
+  }
+  command_processor_.SubmitBarriers(true);
+
+  direct_resolve_validation_submission_ = command_processor_.GetCurrentSubmission();
+  direct_resolve_validation_length_ = dest_length;
+  direct_resolve_validation_key_ = std::move(key);
+}
+
+// TMPDV
+void VulkanRenderTargetCache::CheckDirectResolveValidation() {
+  if (direct_resolve_validation_submission_ == UINT64_MAX ||
+      command_processor_.GetCompletedSubmission() < direct_resolve_validation_submission_) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  void* mappings[2] = {};
+  bool mapped = true;
+  for (uint32_t i = 0; i < 2; ++i) {
+    if (dfn.vkMapMemory(device, direct_resolve_validation_readback_memory_[i], 0, VK_WHOLE_SIZE, 0,
+                        &mappings[i]) != VK_SUCCESS) {
+      mappings[i] = nullptr;
+      mapped = false;
+      continue;
+    }
+    VkMappedMemoryRange mapped_range;
+    mapped_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    mapped_range.pNext = nullptr;
+    mapped_range.memory = direct_resolve_validation_readback_memory_[i];
+    mapped_range.offset = 0;
+    mapped_range.size = VK_WHOLE_SIZE;
+    dfn.vkInvalidateMappedMemoryRanges(device, 1, &mapped_range);
+  }
+  if (mapped) {
+    CompareDirectResolveValidation(
+        direct_resolve_validation_key_, static_cast<const uint8_t*>(mappings[0]),
+        static_cast<const uint8_t*>(mappings[1]), size_t(direct_resolve_validation_length_));
+  } else {
+    REXGPU_ERROR("TMPDV failed to map the readback buffers");
+  }
+  for (uint32_t i = 0; i < 2; ++i) {
+    if (mappings[i]) {
+      dfn.vkUnmapMemory(device, direct_resolve_validation_readback_memory_[i]);
+    }
+  }
+  direct_resolve_validation_submission_ = UINT64_MAX;
+}
+
 bool VulkanRenderTargetCache::GetDirectResolveSourceConversion(
     RenderTargetKey key, DirectResolveSourceConversion& conversion_out) const {
   // The same conversions as in GetDumpPipeline.
