<Project Sdk="Microsoft.NET.Sdk">

  <!-- Development only: the launcher's self-update pieces without its window, for tests (Program.cs):
       the folder swap and the verified download, and, given a built MCLA-Setup.exe, the installer
       itself (install, update, rollback, uninstall). Not part of the launcher's build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UpdateCheck</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\installer\FolderSwap.cs" />
    <Compile Include="..\..\src\SelfUpdate.cs" />
    <!-- SelfUpdate.cs downloads through the launcher's network code. -->
    <Compile Include="..\..\src\Net.cs" />
  </ItemGroup>

</Project>
