diff --git a/dev/include/rex/graphics/d3d12/tmp_hitch.h b/include/rex/graphics/d3d12/tmp_hitch.h
new file mode 100644
index 0000000..5079085
--- /dev/null
+++ b/include/rex/graphics/d3d12/tmp_hitch.h
@@ -0,0 +1,50 @@
+#pragma once
+
+// TMPHITCH: development-only CPU timers for Direct3D 12 operations that can
+// stall the GPU command thread, logged per frame by IssueSwap
+// (launcher/dev/d3d12-hitch-timers.sdk.patch). Not for upstream.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace rex::graphics::d3d12::tmphitch {
+
+enum Kind {
+  kTexCreate,
+  kTexPlacedOrCommitted,  // n counts committed textures only
+  kTexLoad,
+  kTexDestroy,
+  kScaledHeap,
+  kScaledAwait,
+  kSharedHeap,
+  kRtCreate,
+  kScratchGrow,
+  kFenceWait,
+  kSrvPage,
+  kCount,
+};
+
+inline const char* const kNames[kCount] = {
+    "tex_create", "tex_committed", "tex_load", "tex_destroy", "scaled_heap", "scaled_await",
+    "shared_heap", "rt_create",     "scratch",  "fence_wait",  "srv_page",
+};
+
+inline std::atomic<uint64_t> g_us[kCount];
+inline std::atomic<uint32_t> g_n[kCount];
+
+struct Scope {
+  explicit Scope(Kind kind) : kind_(kind), start_(std::chrono::steady_clock::now()) {}
+  ~Scope() {
+    g_us[kind_] += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                                std::chrono::steady_clock::now() - start_)
+                                .count());
+    ++g_n[kind_];
+  }
+  Kind kind_;
+  std::chrono::steady_clock::time_point start_;
+};
+
+}  // namespace rex::graphics::d3d12::tmphitch
