+          std::snprintf(part, sizeof(part), " %s %ux %.1fms", tmphitch::kNames[k],
+                        unsigned(tmphitch::g_n[k].load()), tmphitch::g_us[k].load() / 1000.0);
+          line += part;
+        }
+      }
+      REXGPU_INFO("TMPHITCH frame {} {:.1f} ms:{}", tmphitch_frame, frame_ms, line);
+    }
+    for (int k = 0; k < tmphitch::kCount; ++k) {
+      tmphitch::g_us[k] = 0;
