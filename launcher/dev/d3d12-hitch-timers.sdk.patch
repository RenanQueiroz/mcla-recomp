 void D3D12CommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbuffer_width,
                                       uint32_t frontbuffer_height) {
   SCOPE_profile_cpu_f("gpu");
+  {  // TMPHITCH: one line per frame whose timed work took over 2 ms.
+    static auto tmphitch_last = std::chrono::steady_clock::now();
+    static uint64_t tmphitch_frame = 0;
+    auto now = std::chrono::steady_clock::now();
+    double frame_ms = std::chrono::duration<double, std::milli>(now - tmphitch_last).count();
+    tmphitch_last = now;
+    ++tmphitch_frame;
+    uint64_t timed_us = 0;
+    for (int k = 0; k < tmphitch::kCount; ++k) {
+      timed_us += k == tmphitch::kTexLoad ? 0 : tmphitch::g_us[k].load();
+    }
+    if (timed_us > 2000 || frame_ms > 25.0) {
+      std::string line;
+      for (int k = 0; k < tmphitch::kCount; ++k) {
