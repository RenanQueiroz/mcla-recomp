diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 04d246b..7bc7b3d 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -4814,6 +4814,15 @@ void D3D12CommandProcessor::UpdateSystemConstantValues(
   system_constants_.alpha_test_reference = rb_alpha_ref;
   uint32_t alpha_to_mask =
       rb_colorcontrol.alpha_to_mask_enable ? (rb_colorcontrol.value >> 24) | (1 << 8) : 0;
+  {
+    // Development switch (launcher/dev/alpha-to-mask-debug.sdk.patch).
+    const int32_t tmp_a2m = REXCVAR_GET(tmp_a2m);
+    if (tmp_a2m == 1) {
+      alpha_to_mask = 0;
+    } else if (tmp_a2m == 2 && alpha_to_mask) {
+      alpha_to_mask = 0xAAu | (1u << 8);
+    }
+  }
   dirty |= system_constants_.alpha_to_mask != alpha_to_mask;
   system_constants_.alpha_to_mask = alpha_to_mask;
 
