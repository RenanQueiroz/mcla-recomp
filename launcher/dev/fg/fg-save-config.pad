# What the F4 overlay's Save (save_config) writes on a file with stale temporal_aa lines, after
# frame generation was turned on: only frame_generation; the stale lines stay as they were.
# Run with --toml <a file with mcla_fps and those lines> and compare it with mcla.toml.after.
wait 8s
mark title
press_until start left_title every=2s timeout=90s
mark map_zoom
wait_until roam 180s
mark settle
wait 3s
get mcla_anti_aliasing temporal_aa temporal_aa_available
set frame_generation fsr
wait 2s
save_config
wait 1s
get mcla_anti_aliasing temporal_aa temporal_aa_available
set frame_generation off
wait 1s
mark end
wait 1s
