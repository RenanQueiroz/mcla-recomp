<Project Sdk="Microsoft.NET.Sdk">

  <!-- Built and published by ..\build-launcher.ps1 into ..\app\. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>MclaLauncher</RootNamespace>
    <AssemblyName>MclaLauncher</AssemblyName>
    <Product>Midnight Club: Los Angeles Launcher</Product>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <!-- A plain unpackaged exe: no MSIX, no Developer Mode. The Windows App SDK
         runtime is bundled so the launcher doesn't depend on which Windows App
         Runtime version is installed; .NET itself comes from the installed runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationIcon>launcher.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating: every build takes the newest Reactor preview and the newest
         stable Windows App SDK 2.x. Reactor is pre-1.0, so a new preview can
         change its API and need code changes here. Move the Windows App SDK to
         a new major only when Reactor does.
         Only the Windows App SDK's WinUI component is referenced (it brings its
         Foundation, InteractiveExperiences and Base components), not the
         Microsoft.WindowsAppSDK metapackage: that one adds the AI, ML (ONNX
         Runtime and DirectML), Search and Widgets components, which the launcher
         does not use. They were 59 MB of the self-contained publish (235 to 176 MB;
         the release's zip 94.6 to 69.4 MB) and 60 MB of a build from source in
         launcher\app (159 to 99 MB). Add a component back here if the launcher
         ever calls its API. -->
    <PackageReference Include="Microsoft.UI.Reactor" Version="*-*" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="launcher.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The folder swap of an update (SelfUpdate.cs), shared with the installer program. -->
    <Compile Include="..\installer\FolderSwap.cs" Link="SelfUpdate\FolderSwap.cs" />
  </ItemGroup>

  <!-- Publishing an unpackaged WinUI app leaves out the app's own .pri, the
       index of its XAML resources; without it the window fails to load
       (0xC000027B / 0x802B000A). Reactor's AOT sample copies it the same way. -->
  <Target Name="CopyAppPriToPublishDir" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" Condition="Exists('$(OutDir)$(AssemblyName).pri')" />
  </Target>

</Project>
