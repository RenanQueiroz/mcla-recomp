diff --git a/src/system/handoff_trace.cpp b/src/system/handoff_trace.cpp
new file mode 100644
index 0000000..70501a1
--- /dev/null
+++ b/src/system/handoff_trace.cpp
@@ -0,0 +1,389 @@
+/**
+ * @file        handoff_trace.cpp
+ * @brief       Development trace of the hand-offs between threads (rexglue-handoff-trace.patch).
+ *
+ * See include/rex/handoff_trace.h. The buffer is one array of 40-byte slots, filled in the order
+ * the threads take an index from one atomic counter; nothing is ever overwritten, and when it is
+ * full recording stops and the rest is counted as dropped. A slot whose event number is still 0
+ * was being written when the buffer was dumped and is skipped by the reader.
+ */
+
+#include <rex/handoff_trace.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <thread>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ppc/context.h>
+#include <rex/system/thread_state.h>
+#include <rex/system/xmemory.h>
+#include <rex/system/xthread.h>
+#include <rex/thread.h>
+
+REXCVAR_DEFINE_BOOL(handoff_trace, false, "Development",
+                    "Development: record time-stamped events at the points where threads wait for each "
+                    "other (guest kernel waits and signals with the guest call chain, the command "
+                    "processor's wait for work, swaps, the Direct3D 12 submission thread, the game's own) "
+                    "into a buffer that is written to handoff_trace_file. Costs about 60 ns an event")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+REXCVAR_DEFINE_INT32(handoff_trace_events, 6, "Development",
+                     "Development: with handoff_trace, the size of the buffer in millions of events "
+                     "(40 bytes each); recording stops when it is full")
+    .range(1, 64)
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+REXCVAR_DEFINE_STRING(handoff_trace_file, "handoff-trace.hotrace", "Development",
+                      "Development: with handoff_trace, where the buffer is written (at exit, or when "
+                      "handoff_trace_dump is set)");
+REXCVAR_DEFINE_BOOL(handoff_trace_run, true, "Development",
+                    "Development: with handoff_trace, whether events are recorded now. Setting it to true "
+                    "starts a window (a mark with the number of handoff_trace_label is recorded) and to "
+                    "false ends it; start the game with it false to record only the windows a script opens")
+    .transient();
+REXCVAR_DEFINE_STRING(handoff_trace_label, "", "Development",
+                      "Development: with handoff_trace, the name of the next window; its number is in the "
+                      "window's marks and the names are in the file")
+    .transient();
+REXCVAR_DEFINE_BOOL(handoff_trace_dump, false, "Development",
+                    "Development: setting this to true writes the trace to handoff_trace_file and stops "
+                    "recording")
+    .transient();
+
+namespace rex::handoff {
+namespace {
+
+struct Slot {  // 40 bytes
+  uint64_t t;  // steady_clock, ns
+  uint16_t ev;
+  uint16_t thread;
+  uint32_t a, b, c;
+  uint32_t ra[4];
+};
+static_assert(sizeof(Slot) == 40, "the file format's slot");
+
+struct ThreadInfo {  // 56 bytes in the file
+  uint32_t tid;
+  uint32_t guest_handle;
+  int64_t first_ns;
+  char name[40];
+};
+static_assert(sizeof(ThreadInfo) == 56, "the file format's thread entry");
+
+constexpr uint32_t kMaxThreads = 192;
+constexpr uint32_t kMaxLabels = 64;
+constexpr uint32_t kLabelLen = 48;
+
+std::mutex& Mutex() {
+  static std::mutex m;
+  return m;
+}
+
+std::atomic<bool> g_decided{false};
+std::atomic<bool> g_recording{false};
+std::atomic<bool> g_dumped{false};
+Slot* g_slots = nullptr;
+uint64_t g_capacity = 0;
+std::atomic<uint64_t> g_next{0};
+std::atomic<uint64_t> g_dropped{0};
+std::atomic<uint32_t> g_thread_count{0};
+ThreadInfo g_threads[kMaxThreads];
+char g_labels[kMaxLabels][kLabelLen];
+uint32_t g_label_count = 1;  // 0 is "no label"
+std::atomic<uint32_t> g_label{0};
+int64_t g_start_ns = 0;
+thread_local uint16_t t_thread = 0xFFFF;
+
+int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+bool IsTrue(std::string_view v) {
+  std::string s(v);
+  for (char& c : s) {
+    c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+  }
+  return s == "1" || s == "true" || s == "on" || s == "yes";
+}
+
+uint16_t ThreadIndex() {
+  if (t_thread != 0xFFFF) {
+    return t_thread;
+  }
+  const uint32_t i = g_thread_count.fetch_add(1, std::memory_order_relaxed);
+  if (i >= kMaxThreads) {
+    t_thread = static_cast<uint16_t>(kMaxThreads - 1);  // the last entry stands for all the rest
+    return t_thread;
+  }
+  ThreadInfo& info = g_threads[i];
+  info.tid = rex::thread::current_thread_system_id();
+  info.first_ns = NowNs();
+  if (rex::system::XThread::IsInThread()) {
+    rex::system::XThread* thread = rex::system::XThread::GetCurrentThread();
+    if (thread) {
+      info.guest_handle = thread->handle();
+      std::snprintf(info.name, sizeof(info.name), "%s", thread->name().c_str());
+    }
+  }
+  t_thread = static_cast<uint16_t>(i);
+  return t_thread;
+}
+
+void Put(uint16_t ev, uint32_t a, uint32_t b, uint32_t c, const uint32_t* ra) {
+  const uint64_t i = g_next.fetch_add(1, std::memory_order_relaxed);
+  if (i >= g_capacity) {
+    if (i == g_capacity) {
+      g_recording.store(false, std::memory_order_relaxed);
+    }
+    g_dropped.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  Slot& s = g_slots[i];
+  s.t = static_cast<uint64_t>(NowNs());
+  s.thread = ThreadIndex();
+  s.a = a;
+  s.b = b;
+  s.c = c;
+  if (ra) {
+    s.ra[0] = ra[0];
+    s.ra[1] = ra[1];
+    s.ra[2] = ra[2];
+    s.ra[3] = ra[3];
+  }
+  __atomic_store_n(&s.ev, ev, __ATOMIC_RELEASE);  // last: the slot is complete
+}
+
+uint32_t Load32(const uint8_t* base, uint32_t address) {
+  uint32_t raw;
+  std::memcpy(&raw, base + address, sizeof(raw));
+  return __builtin_bswap32(raw);
+}
+
+// The calling guest thread's call chain. Everything read is inside the thread's own stack, between
+// the bounds in its PCR (r13 + 0x70 and 0x74), on 8-byte boundaries; a frame is [r1] = the caller's r1 and, in the
+// caller's frame, at -8 from that, the return address the callee was called with.
+void GuestChain(uint32_t ra[4]) {
+  ra[0] = ra[1] = ra[2] = ra[3] = 0;
+  if (!rex::system::XThread::IsInThread()) {
+    return;
+  }
+  rex::system::XThread* thread = rex::system::XThread::GetCurrentThread();
+  if (!thread || !thread->is_guest_thread()) {
+    return;
+  }
+  rex::runtime::ThreadState* state = rex::runtime::ThreadState::Get();
+  if (!state || !state->memory()) {
+    return;
+  }
+  const PPCContext* ctx = state->context();
+  const uint8_t* base = state->memory()->virtual_membase();
+  if (!ctx || !base) {
+    return;
+  }
+  ra[0] = static_cast<uint32_t>(ctx->lr);
+  const uint32_t pcr = ctx->r13.u32;
+  if (pcr < 0x10000) {
+    return;
+  }
+  const uint32_t w0 = Load32(base, pcr + 0x70);
+  const uint32_t w1 = Load32(base, pcr + 0x74);
+  const uint32_t lo = std::min(w0, w1);
+  const uint32_t hi = std::max(w0, w1);
+  uint32_t sp = ctx->r1.u32;
+  if (lo < 0x10000 || hi - lo > (64u << 20) || sp < lo || sp >= hi || (sp & 7) != 0) {
+    return;
+  }
+  for (int i = 1; i < 4; ++i) {
+    const uint32_t prev = Load32(base, sp);  // the caller's frame
+    if (prev <= sp || prev >= hi || (prev & 7) != 0 || prev - 8 < lo) {
+      break;
+    }
+    ra[i] = Load32(base, prev - 8);
+    sp = prev;
+  }
+}
+
+uint32_t LabelNumber(std::string_view name) {
+  std::lock_guard<std::mutex> lock(Mutex());
+  for (uint32_t i = 1; i < g_label_count; ++i) {
+    if (name == g_labels[i]) {
+      return i;
+    }
+  }
+  if (g_label_count >= kMaxLabels) {
+    return kMaxLabels - 1;
+  }
+  const uint32_t i = g_label_count++;
+  std::snprintf(g_labels[i], kLabelLen, "%.*s", static_cast<int>(name.size()), name.data());
+  return i;
+}
+
+void OnRun(std::string_view, std::string_view value) {
+  if (!g_slots || g_dumped.load()) {
+    return;
+  }
+  if (IsTrue(value)) {
+    if (!g_recording.load(std::memory_order_relaxed)) {
+      Put(kMark, g_label.load(), 1, 0, nullptr);
+      g_recording.store(true, std::memory_order_release);
+    }
+  } else if (g_recording.load(std::memory_order_relaxed)) {
+    Put(kMark, g_label.load(), 0, 0, nullptr);
+    g_recording.store(false, std::memory_order_release);
+  }
+}
+
+void OnLabel(std::string_view, std::string_view value) {
+  g_label.store(LabelNumber(value));
+}
+
+void OnDump(std::string_view, std::string_view value) {
+  if (IsTrue(value)) {
+    Dump(nullptr);
+  }
+}
+
+void Init() {
+  bool on;
+  {
+    std::lock_guard<std::mutex> lock(Mutex());
+    if (g_decided.load(std::memory_order_acquire)) {
+      return;
+    }
+    on = REXCVAR_GET(handoff_trace);
+    if (on) {
+      const uint64_t capacity =
+          static_cast<uint64_t>(std::clamp(REXCVAR_GET(handoff_trace_events), 1, 64)) * 1000000ull;
+      g_slots = static_cast<Slot*>(std::calloc(capacity, sizeof(Slot)));
+      if (g_slots) {
+        g_capacity = capacity;
+        g_start_ns = NowNs();
+        g_labels[0][0] = 0;
+      } else {
+        REXLOG_ERROR("handoff trace: cannot allocate {} MB; the trace is off",
+                     capacity * sizeof(Slot) / (1024 * 1024));
+        on = false;
+      }
+    }
+    if (on) {
+      g_recording.store(REXCVAR_GET(handoff_trace_run), std::memory_order_release);
+    }
+    g_decided.store(true, std::memory_order_release);
+  }
+  if (on) {
+    // After the lock: the change callbacks run under the cvar registry's lock, and one of them dumps.
+    rex::cvar::RegisterChangeCallback("handoff_trace_run", OnRun);
+    rex::cvar::RegisterChangeCallback("handoff_trace_label", OnLabel);
+    rex::cvar::RegisterChangeCallback("handoff_trace_dump", OnDump);
+    std::atexit([] {
+      if (!g_dumped.load()) {
+        Dump(nullptr);
+      }
+    });
+    REXLOG_INFO("handoff trace: on, {} million events, to {}{}", g_capacity / 1000000,
+                REXCVAR_GET(handoff_trace_file),
+                g_recording.load() ? "" : " (recording starts with handoff_trace_run)");
+  }
+}
+
+}  // namespace
+
+bool Active() {
+  if (g_recording.load(std::memory_order_relaxed)) {
+    return true;
+  }
+  if (g_decided.load(std::memory_order_acquire)) {
+    return false;
+  }
+  Init();
+  return g_recording.load(std::memory_order_relaxed);
+}
+
+void Record(uint16_t event, uint32_t a, uint32_t b, uint32_t c) {
+  if (!Active()) {
+    return;
+  }
+  Put(event, a, b, c, nullptr);
+}
+
+void RecordGuest(uint16_t event, uint32_t a, uint32_t b, uint32_t c) {
+  if (!Active()) {
+    return;
+  }
+  uint32_t ra[4];
+  GuestChain(ra);
+  Put(event, a, b, c, ra);
+}
+
+void SetLabel(const char* label) {
+  if (label) {
+    g_label.store(LabelNumber(label));
+  }
+}
+
+bool Dump(const char* path_arg) {
+  std::lock_guard<std::mutex> lock(Mutex());
+  if (!g_slots) {
+    return false;
+  }
+  g_recording.store(false, std::memory_order_release);
+  g_dumped.store(true);
+  // A thread that took an index just before the stop may still be filling its slot.
+  std::this_thread::sleep_for(std::chrono::milliseconds(30));
+  const std::string path = (path_arg && *path_arg) ? std::string(path_arg) : REXCVAR_GET(handoff_trace_file);
+  std::FILE* f = std::fopen(path.c_str(), "wb");
+  if (!f) {
+    REXLOG_ERROR("handoff trace: cannot write {}", path);
+    return false;
+  }
+  const uint64_t count = std::min<uint64_t>(g_next.load(), g_capacity);
+  const uint32_t threads = std::min<uint32_t>(g_thread_count.load(), kMaxThreads);
+#pragma pack(push, 1)
+  struct Header {
+    char magic[8];
+    uint32_t version;
+    uint32_t slot_size;
+    uint64_t count;
+    uint32_t thread_count;
+    uint32_t label_count;
+    int64_t start_ns;
+    int64_t dump_ns;
+    uint64_t dropped;
+    uint64_t reserved;
+  } header{};
+#pragma pack(pop)
+  static_assert(sizeof(Header) == 64, "the file format's header");
+  std::memcpy(header.magic, "HOTRACE1", 8);
+  header.version = 1;
+  header.slot_size = sizeof(Slot);
+  header.count = count;
+  header.thread_count = threads;
+  header.label_count = g_label_count;
+  header.start_ns = g_start_ns;
+  header.dump_ns = NowNs();
+  header.dropped = g_dropped.load();
+  bool ok = std::fwrite(&header, sizeof(header), 1, f) == 1;
+  ok = ok && (threads == 0 || std::fwrite(g_threads, sizeof(ThreadInfo), threads, f) == threads);
+  ok = ok && std::fwrite(g_labels, kLabelLen, g_label_count, f) == g_label_count;
+  ok = ok && (count == 0 || std::fwrite(g_slots, sizeof(Slot), static_cast<size_t>(count), f) == count);
+  ok = (std::fclose(f) == 0) && ok;
+  if (ok) {
+    REXLOG_INFO("handoff trace: wrote {} events ({} dropped, {} threads) to {}", count, header.dropped, threads,
+                path);
+  } else {
+    REXLOG_ERROR("handoff trace: writing {} failed", path);
+  }
+  return ok;
+}
+
+}  // namespace rex::handoff
