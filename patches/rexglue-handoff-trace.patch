index 0000000..8db3c65
--- /dev/null
+++ b/include/rex/handoff_trace.h
@@ -0,0 +1,85 @@
+#pragma once
+/**
+ * @file        handoff_trace.h
+ * @brief       Development trace of the hand-offs between threads (rexglue-handoff-trace.patch).
+ *
+ * With the cvar handoff_trace on, the runtime puts a time-stamped event into a big buffer at the
+ * points where one thread waits for another or wakes it: the guest's kernel waits and signals
+ * (with the guest call chain of the caller), the command processor's wait for the guest's write
+ * pointer, its execution of the ring, the swaps and the Direct3D 12 submission thread's queue; the
+ * game adds its own (frame start, the render thread's loop...). The buffer is written to a file
+ * (handoff_trace_file) when handoff_trace_dump is set to true or at exit, and a script turns it
+ * into per-frame timelines (launcher/dev/handoff_trace.py of the game's repository).
+ *
+ * With the trace off every call below is one function call and two loads. Recording takes about
+ * 60 ns and no lock.
+ *
+ * The event numbers are part of the file format (version 1): below 100 the SDK's, 100 and up the
+ * game's own.
+ */
+
+#include <cstdint>
+
+namespace rex::handoff {
+
+enum Event : uint16_t {
+  kNone = 0,
+  // a = label number, b = 1 when a window starts (handoff_trace_run set to true) and 0 when it ends
+  kMark = 1,
+  // Guest kernel objects (src/system/xobject.cpp ...). a = the object (ObjectId), c = its
+  // type; the guest call chain is in the event.
+  kWaitBegin = 10,       // b = timeout in ms (0xFFFFFFFF: none)
+  kWaitEnd = 11,         // b = the X_STATUS
+  kWaitPoll = 12,        // a wait with no timeout, answered at once: b = the X_STATUS
+  kWaitMultiBegin = 13,  // a = the first object, b = count | wait type << 16, c = timeout in ms
+  kWaitMultiEnd = 14,    // a = the first object, b = the X_STATUS
+  kSignalAndWait = 15,   // a = the object signalled, b = the object waited for
+  kEventSet = 16,        // XEvent::Set or Pulse: b = 0 for Set, 1 for Pulse
+  kSemRelease = 17,      // b = the count released
+  kMutantRelease = 18,
+  kDelayBegin = 19,      // KeDelayExecutionThread / Sleep: a = ms (not for a Sleep(0))
+  kDelayEnd = 20,
+  kSleepZero = 21,       // a Sleep(0) (a polling loop's turn), one call in 32 per thread: a = the thread's count of them, b = 32
+  // The command processor (src/graphics/command_processor.cpp, d3d12/command_processor.cpp)
+  kCpIdleBegin = 40,  // out of commands: a = read index
+  kCpIdleEnd = 41,    // a = turns of the wait loop, b = write index
+  kCpExecBegin = 42,  // a = read index, b = write index
+  kCpExecEnd = 43,    // a = the new read index
+  kCpWritePtr = 44,   // the guest writes CP_RB_WPTR (on the guest's thread): a = value
+  kCpSwapBegin = 45,  // a = front buffer
+  kCpSwapEnd = 46,
+  kD3dFenceBegin = 47,    // waits for the Direct3D 12 queue (the frame in flight limit)
+  kD3dFenceEnd = 48,
+  kSubmitQueue = 49,      // the command processor hands a command list to the submission thread: a = its number
+  kSubmitBegin = 50,      // the submission thread starts on it
+  kSubmitEnd = 51,
+  kSubmitAwaitBegin = 52,  // the command processor waits for the submission thread
+  kSubmitAwaitEnd = 53,
+  kCpWaitRegBegin = 54,   // a WAIT_REG_MEM packet that does not match yet: a = the register or address, b = wait info
+  kCpWaitRegEnd = 55,     // ... and does
+  // The game's own events start at 100 (its src/handoff_trace.h).
+  kUserBase = 100,
+};
+
+// True while events are being recorded. Cheap.
+bool Active();
+
+// Records an event for the calling thread (a, b, c are the event's own).
+void Record(uint16_t event, uint32_t a = 0, uint32_t b = 0, uint32_t c = 0);
+
+// Like Record, with the calling guest thread's call chain: the link register, then the return
+// addresses saved in the next three frames of its PPC stack (zeros for a host thread).
+void RecordGuest(uint16_t event, uint32_t a = 0, uint32_t b = 0, uint32_t c = 0);
+
+// Names the next window (handoff_trace_label does the same from a script).
+void SetLabel(const char* label);
+
+// Writes the buffer to `path`, or to handoff_trace_file when null; recording stops. True on success.
+bool Dump(const char* path = nullptr);
+
+// A number for a host object in the events (a stand-in for its address).
+inline uint32_t ObjectId(const void* object) {
+  return static_cast<uint32_t>(reinterpret_cast<uintptr_t>(object) >> 4);
+}
+
+}  // namespace rex::handoff
