diff --git a/cmake/fidelityfx/CMakeLists.txt b/cmake/fidelityfx/CMakeLists.txt
new file mode 100644
index 0000000..379dd09
--- /dev/null
+++ b/cmake/fidelityfx/CMakeLists.txt
@@ -0,0 +1,28 @@
+# Builds one ffx-api backend (FFX_API_BACKEND = DX12_X64 or VK_X64) of the FidelityFX
+# SDK at FFX_ROOT as a shared library, for cmake/rexglue_fsr.cmake (an ExternalProject,
+# so the two backends, which can't share a configure, each get their own).
+cmake_minimum_required(VERSION 3.23)
+project(rexglue_fidelityfx C CXX)
+if(NOT FFX_ROOT OR NOT FFX_API_BACKEND)
+    message(FATAL_ERROR "FFX_ROOT and FFX_API_BACKEND are required")
+endif()
+# Upscaling only: no frame generation providers.
+set(FFX_API_ENABLE_FRAMEGEN_PROVIDER OFF CACHE BOOL "" FORCE)
+set(FFX_API_AUTO_COMPILE_SHADERS ON CACHE BOOL "" FORCE)
+add_subdirectory("${FFX_ROOT}/ffx-api" "${CMAKE_BINARY_DIR}/ffx-api")
+# FidelityFX's toolchain.cmake sets a Visual Studio platform, which Ninja rejects.
+unset(CMAKE_GENERATOR_PLATFORM CACHE)
+string(TOLOWER "${FFX_API_BACKEND}" _backend)
+string(REGEX REPLACE "_x64$" "" _backend "${_backend}")
+set(_target amd_fidelityfx_${_backend})
+# Outputs into this build tree (ffx-api's CMake would put them next to this file).
+foreach(_config "" _DEBUG _RELEASE _RELWITHDEBINFO)
+    set_target_properties(${_target} PROPERTIES
+        RUNTIME_OUTPUT_DIRECTORY${_config} "${CMAKE_BINARY_DIR}/bin"
+        LIBRARY_OUTPUT_DIRECTORY${_config} "${CMAKE_BINARY_DIR}/bin"
+        ARCHIVE_OUTPUT_DIRECTORY${_config} "${CMAKE_BINARY_DIR}/lib")
+endforeach()
+# The DLL's version resource is UTF-16, which Clang's resource compiler rejects;
+# the library doesn't need it.
+set_source_files_properties("${FFX_ROOT}/ffx-api/src/resource/ffx_api_dll.rc"
+    TARGET_DIRECTORY ${_target} PROPERTIES HEADER_FILE_ONLY ON)
diff --git a/cmake/rexglue_fsr.cmake b/cmake/rexglue_fsr.cmake
new file mode 100644
index 0000000..a2c5ea6
--- /dev/null
+++ b/cmake/rexglue_fsr.cmake
@@ -0,0 +1,114 @@
+# rexglue_fsr.cmake - AMD FSR 3.1 for temporal anti-aliasing (rexglue-temporal-aa.patch)
+#
+# Builds ffx-api of the AMD FidelityFX SDK 1.1.4 (MIT) from source, as
+# amd_fidelityfx_dx12 and amd_fidelityfx_vk shared libraries that the GPU plugin
+# loads at run time from its own folder. The plugin compiles against the
+# headers in thirdparty/fidelityfx-api; this file only builds the runtime.
+#
+# The source is fetched at a pinned commit of the ReXGlue fork (AMD's v1.1.4,
+# c6efa6b, plus portability fixes) into the build tree, and checked against
+# pinned git tree hashes of the two directories that are built, so what is
+# compiled is exactly what was reviewed. REXGLUE_FSR_SOURCE_DIR may point at an
+# existing checkout of that commit instead (checked the same way).
+#
+# FidelityFX compiles its shaders at build time with its own FidelityFX_SC tool
+# (from the same commit; Windows). The Vulkan library needs the Vulkan SDK
+# (find_package(Vulkan)); without it only the D3D12 one is built.
+
+if(NOT REXGLUE_ENABLE_FSR)
+    return()
+endif()
+
+set(REXGLUE_FSR_REPOSITORY "https://github.com/rexglue/FidelityFX-SDK.git" CACHE STRING
+    "Where the FidelityFX SDK is fetched from (the pinned commit must exist there)")
+set(REXGLUE_FSR_SOURCE_DIR "" CACHE PATH
+    "An existing checkout of the pinned FidelityFX SDK commit (fetched into the build tree otherwise)")
+set(_rexglue_fsr_commit "eee08db1688ac3d1275a70b728f4a8ba22914213")
+set(_rexglue_fsr_tree_ffx_api "cdcd115d3ea4f855251049dc3d5517b3ae448a46")
+set(_rexglue_fsr_tree_sdk "47c22f65b682061792531316670251a5c8ae81e7")
+
+find_package(Git REQUIRED)
+
+function(_rexglue_fsr_git dir)
+    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" ${ARGN}
+                    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
+                    OUTPUT_STRIP_TRAILING_WHITESPACE)
+    if(NOT result EQUAL 0)
+        message(FATAL_ERROR "FSR: git ${ARGN} failed in ${dir}:\n${error}")
+    endif()
+    set(_rexglue_fsr_git_output "${output}" PARENT_SCOPE)
+endfunction()
+
+if(REXGLUE_FSR_SOURCE_DIR)
+    set(_rexglue_fsr_src "${REXGLUE_FSR_SOURCE_DIR}")
+else()
+    set(_rexglue_fsr_src "${CMAKE_BINARY_DIR}/_deps/fidelityfx-src")
+    if(NOT EXISTS "${_rexglue_fsr_src}/.git")
+        message(STATUS "FSR: fetching FidelityFX SDK ${_rexglue_fsr_commit} (ffx-api and sdk only)")
+        file(MAKE_DIRECTORY "${_rexglue_fsr_src}")
+        _rexglue_fsr_git("${_rexglue_fsr_src}" init -q)
+        _rexglue_fsr_git("${_rexglue_fsr_src}" config core.longpaths true)
+        _rexglue_fsr_git("${_rexglue_fsr_src}" config core.autocrlf false)
+        _rexglue_fsr_git("${_rexglue_fsr_src}" remote add origin "${REXGLUE_FSR_REPOSITORY}")
+        _rexglue_fsr_git("${_rexglue_fsr_src}" sparse-checkout set --no-cone /ffx-api/ /sdk/ /LICENSE.txt)
+        _rexglue_fsr_git("${_rexglue_fsr_src}" fetch -q --depth 1 --filter=blob:none origin
+                         "${_rexglue_fsr_commit}")
+        _rexglue_fsr_git("${_rexglue_fsr_src}" checkout -q FETCH_HEAD)
+    endif()
+endif()
+
+# What is built must be the pinned commit's ffx-api and sdk, unmodified.
+_rexglue_fsr_git("${_rexglue_fsr_src}" rev-parse HEAD)
+if(NOT _rexglue_fsr_git_output STREQUAL _rexglue_fsr_commit)
+    message(FATAL_ERROR "FSR: ${_rexglue_fsr_src} is at ${_rexglue_fsr_git_output}, not ${_rexglue_fsr_commit}")
+endif()
+_rexglue_fsr_git("${_rexglue_fsr_src}" rev-parse HEAD:ffx-api HEAD:sdk)
+string(REPLACE "\n" ";" _rexglue_fsr_trees "${_rexglue_fsr_git_output}")
+if(NOT _rexglue_fsr_trees STREQUAL "${_rexglue_fsr_tree_ffx_api};${_rexglue_fsr_tree_sdk}")
+    message(FATAL_ERROR "FSR: unexpected tree hashes in ${_rexglue_fsr_src}: ${_rexglue_fsr_trees}")
+endif()
+_rexglue_fsr_git("${_rexglue_fsr_src}" diff --quiet HEAD -- ffx-api sdk LICENSE.txt)
+message(STATUS "FSR: FidelityFX SDK ${_rexglue_fsr_commit} verified (ffx-api ${_rexglue_fsr_tree_ffx_api}, sdk ${_rexglue_fsr_tree_sdk})")
+
+include(ExternalProject)
+add_custom_target(rexglue_fsr_runtime)
+set(_rexglue_fsr_apis)
+if(REXGLUE_USE_D3D12)
+    list(APPEND _rexglue_fsr_apis dx12)
+endif()
+if(REXGLUE_USE_VULKAN)
+    find_package(Vulkan QUIET)
+    if(Vulkan_FOUND)
+        list(APPEND _rexglue_fsr_apis vk)
+    else()
+        message(WARNING "FSR: the Vulkan SDK was not found; FSR is built for Direct3D 12 only")
+    endif()
+endif()
+if(WIN32)
+    set(_rexglue_fsr_library_prefix "")
+    set(_rexglue_fsr_library_suffix ".dll")
+else()
+    set(_rexglue_fsr_library_prefix "lib")
+    set(_rexglue_fsr_library_suffix ".so")
+endif()
+foreach(api IN LISTS _rexglue_fsr_apis)
+    string(TOUPPER "${api}" api_upper)
+    set(binary_dir "${CMAKE_BINARY_DIR}/_deps/fidelityfx-${api}")
+    set(library "${binary_dir}/bin/${_rexglue_fsr_library_prefix}amd_fidelityfx_${api}${_rexglue_fsr_library_suffix}")
+    ExternalProject_Add(rexglue_fsr_${api}
+        SOURCE_DIR "${REXGLUE_ROOT}/cmake/fidelityfx"
+        BINARY_DIR "${binary_dir}"
+        CMAKE_GENERATOR Ninja
+        CMAKE_ARGS
+            -DCMAKE_BUILD_TYPE=Release
+            "-DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}"
+            "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}"
+            "-DFFX_ROOT=${_rexglue_fsr_src}"
+            -DFFX_API_BACKEND=${api_upper}_X64
+        BUILD_COMMAND "${CMAKE_COMMAND}" --build "${binary_dir}" --target amd_fidelityfx_${api}
+        INSTALL_COMMAND ""
+        BUILD_BYPRODUCTS "${library}"
+        BUILD_ALWAYS OFF)
+    add_dependencies(rexglue_fsr_runtime rexglue_fsr_${api})
+    install(FILES "${library}" DESTINATION "${CMAKE_INSTALL_BINDIR}")
+endforeach()
