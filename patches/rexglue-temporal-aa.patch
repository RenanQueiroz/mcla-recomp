+struct TaaTimestamp {
+  PFN_vkCmdWriteTimestamp write_timestamp;
+  VkQueryPool pool;
+  uint32_t query;
+  VkPipelineStageFlagBits stage;
+};
+
+void TaaTimestampCallback(VkCommandBuffer command_buffer, const void* data) {
+  TaaTimestamp timestamp;
+  std::memcpy(&timestamp, data, sizeof(timestamp));
+  timestamp.write_timestamp(command_buffer, timestamp.stage, timestamp.pool, timestamp.query);
+}
