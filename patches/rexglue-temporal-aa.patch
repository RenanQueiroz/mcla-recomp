+struct VulkanCommandProcessor::TaaFsr {
+  enum State : uint32_t { kNone, kCreating, kReady, kFailed };
+  std::atomic<uint32_t> state{kNone};
+  std::thread thread;
+  // The size of the context and the images (the scene's, host pixels).
+  uint32_t width = 0;
+  uint32_t height = 0;
+  HdrImage vectors;  // R16G16_SFLOAT
+  HdrImage output;   // R16G16B16A16_SFLOAT
+  // The reactive mask: the luminance snapshots (R16_SFLOAT) and the mask
+  // (R8_UNORM), made with the first snapshot.
+  HdrImage luma[2];
+  HdrImage reactive;
+#if defined(REX_HAS_FSR) && REX_HAS_FSR
+  FsrRuntime runtime;
+  ffxContext context = nullptr;
+#endif
+  // Set on the submission thread when FSR's dispatch failed.
+  std::atomic<bool> dispatch_failed{false};
+  // Released contexts, destroyed once the submissions that may use them are
+  // done (the images go through the command processor's own queues).
+  std::vector<std::pair<uint64_t, void*>> retired;
+  // temporal_aa_debug 4: timestamps around the passes, a pair per slot, each
+  // slot read once its submission is done.
+  static constexpr uint32_t kTimerSlots = 8;
+  VkQueryPool timer_pool = VK_NULL_HANDLE;
+  PFN_vkCmdWriteTimestamp write_timestamp = nullptr;
+  PFN_vkGetQueryPoolResults get_results = nullptr;
+  uint64_t timer_submission[kTimerSlots] = {};  // 0: free
+  uint32_t timer_next = 0;
+  double timer_tick_ms = 0.0;
+  double timer_ms = 0.0;
+  uint32_t timer_count = 0;
+};
+
+namespace {
+
+#if defined(REX_HAS_FSR) && REX_HAS_FSR
+// FidelityFX's Vulkan backend asks for KHR aliases of functions that a Vulkan
+// 1.1+ driver may expose only under their core names.
+std::atomic<PFN_vkGetDeviceProcAddr> taa_get_device_proc_addr{nullptr};
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL TaaGetDeviceProcAddr(VkDevice device, const char* name) {
+  PFN_vkGetDeviceProcAddr get = taa_get_device_proc_addr.load(std::memory_order_relaxed);
+  if (!get || !name) {
+    return nullptr;
+  }
+  if (PFN_vkVoidFunction function = get(device, name)) {
+    return function;
+  }
+  static const char* const kAliases[][2] = {
+      {"vkGetBufferMemoryRequirements2KHR", "vkGetBufferMemoryRequirements2"},
+      {"vkGetImageMemoryRequirements2KHR", "vkGetImageMemoryRequirements2"},
+      {"vkBindBufferMemory2KHR", "vkBindBufferMemory2"},
+      {"vkBindImageMemory2KHR", "vkBindImageMemory2"},
+      {"vkCmdPipelineBarrier2KHR", "vkCmdPipelineBarrier2"},
+      {"vkGetDeviceBufferMemoryRequirementsKHR", "vkGetDeviceBufferMemoryRequirements"},
+      {"vkGetDeviceImageMemoryRequirementsKHR", "vkGetDeviceImageMemoryRequirements"},
+  };
+  for (const auto& alias : kAliases) {
+    if (!std::strcmp(name, alias[0])) {
+      return get(device, alias[1]);
+    }
+  }
+  return nullptr;
+}
+
+struct TaaFsrDispatch {
+  PfnFfxDispatch dispatch;
+  // The context's handle as it was when recorded (a later one may replace it
+  // before this is executed).
+  ffxContext context;
+  std::atomic<bool>* failed;
+  // For the fallback copy of the scene into the output.
+  PFN_vkCmdPipelineBarrier pipeline_barrier;
+  PFN_vkCmdCopyImage copy_image;
+  ffxDispatchDescUpscale desc;
+};
+
+void TaaFsrDispatchCallback(VkCommandBuffer command_buffer, const void* data) {
+  TaaFsrDispatch dispatch;
+  std::memcpy(&dispatch, data, sizeof(dispatch));
+  dispatch.desc.commandList = command_buffer;
+  ffxContext context = dispatch.context;
+  ffxReturnCode_t result = dispatch.dispatch(&context, &dispatch.desc.header);
+  if (result == FFX_API_RETURN_OK) {
+    return;
+  }
+  // The scene as it was into the output, which is copied back into it next:
+  // the frame is left as it was (FSR is given up at the end of the frame).
+  dispatch.failed->store(true, std::memory_order_release);
+  auto color = static_cast<VkImage>(dispatch.desc.color.resource);
+  auto output = static_cast<VkImage>(dispatch.desc.output.resource);
+  VkImageMemoryBarrier barriers[2] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    barriers[i].sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    barriers[i].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barriers[i].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barriers[i].subresourceRange = ui::vulkan::util::InitializeSubresourceRange();
+  }
+  barriers[0].image = color;
+  barriers[0].srcAccessMask = VK_ACCESS_SHADER_READ_BIT;
+  barriers[0].dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+  barriers[0].oldLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+  barriers[0].newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+  barriers[1].image = output;
+  barriers[1].srcAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+  barriers[1].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  barriers[1].oldLayout = VK_IMAGE_LAYOUT_GENERAL;
+  barriers[1].newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+  dispatch.pipeline_barrier(command_buffer, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                            VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 2, barriers);
+  VkImageCopy region = {};
+  region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.extent = {dispatch.desc.renderSize.width, dispatch.desc.renderSize.height, 1};
+  dispatch.copy_image(command_buffer, color, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, output,
+                      VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+  for (VkImageMemoryBarrier& barrier : barriers) {
+    std::swap(barrier.srcAccessMask, barrier.dstAccessMask);
+    std::swap(barrier.oldLayout, barrier.newLayout);
+  }
+  dispatch.pipeline_barrier(command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                            VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr, 2,
+                            barriers);
+  static std::atomic<bool> failure_logged{false};
+  if (!failure_logged.exchange(true)) {
+    REXGPU_ERROR("Temporal AA: FSR's dispatch failed ({}); giving FSR up", result);
+  }
+}
+
+FfxApiResource TaaFsrResource(VkImage image, VkFormat format, uint32_t width, uint32_t height,
+                              VkImageUsageFlags usage, uint32_t state) {
+  // As far as FidelityFX looks at it (not mutable: it would take that for
+  // sRGB).
+  VkImageCreateInfo info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+  info.imageType = VK_IMAGE_TYPE_2D;
+  info.format = format;
+  info.extent = {width, height, 1};
+  info.mipLevels = 1;
+  info.arrayLayers = 1;
+  info.samples = VK_SAMPLE_COUNT_1_BIT;
+  info.usage = usage;
+  return ffxApiGetResourceVK(image, ffxApiGetImageResourceDescriptionVK(image, info, 0), state);
+}
+#endif
