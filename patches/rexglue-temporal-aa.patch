+}  // namespace
+
+uint32_t VulkanCommandProcessor::TaaTimerBegin() {
+  if (TaaDebug() != 4 || !taa_fsr_) {
+    return UINT32_MAX;
+  }
+  TaaFsr& fsr = *taa_fsr_;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  if (fsr.timer_pool == VK_NULL_HANDLE) {
+    const ui::vulkan::VulkanInstance* instance = vulkan_device->vulkan_instance();
+    auto get_device_proc_addr = reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+        instance->functions().vkGetInstanceProcAddr(instance->instance(), "vkGetDeviceProcAddr"));
+    VkPhysicalDeviceProperties properties;
+    instance->functions().vkGetPhysicalDeviceProperties(vulkan_device->physical_device(),
+                                                        &properties);
+    if (!get_device_proc_addr || !(properties.limits.timestampPeriod > 0.0f)) {
+      return UINT32_MAX;
+    }
+    fsr.write_timestamp = reinterpret_cast<PFN_vkCmdWriteTimestamp>(
+        get_device_proc_addr(vulkan_device->device(), "vkCmdWriteTimestamp"));
+    fsr.get_results = reinterpret_cast<PFN_vkGetQueryPoolResults>(
+        get_device_proc_addr(vulkan_device->device(), "vkGetQueryPoolResults"));
+    VkQueryPoolCreateInfo pool_info = {VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+    pool_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    pool_info.queryCount = 2 * TaaFsr::kTimerSlots;
+    if (!fsr.write_timestamp || !fsr.get_results ||
+        vulkan_device->functions().vkCreateQueryPool(vulkan_device->device(), &pool_info, nullptr,
+                                                     &fsr.timer_pool) != VK_SUCCESS) {
+      fsr.timer_pool = VK_NULL_HANDLE;
+      return UINT32_MAX;
+    }
+    fsr.timer_tick_ms = double(properties.limits.timestampPeriod) * 1e-6;
+  }
+  TaaTimerCollect();
+  uint32_t slot = fsr.timer_next;
+  if (fsr.timer_submission[slot]) {
+    return UINT32_MAX;
+  }
+  fsr.timer_next = (slot + 1) % TaaFsr::kTimerSlots;
+  deferred_command_buffer_.CmdVkResetQueryPool(fsr.timer_pool, slot * 2, 2);
+  TaaTimestamp timestamp = {fsr.write_timestamp, fsr.timer_pool, slot * 2,
+                            VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT};
+  deferred_command_buffer_.CmdExternalCallback(TaaTimestampCallback, &timestamp,
+                                               sizeof(timestamp));
+  return slot;
+}
+
+void VulkanCommandProcessor::TaaTimerEnd(uint32_t slot) {
+  if (slot == UINT32_MAX) {
+    return;
+  }
+  TaaFsr& fsr = *taa_fsr_;
+  TaaTimestamp timestamp = {fsr.write_timestamp, fsr.timer_pool, slot * 2 + 1,
+                            VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT};
+  deferred_command_buffer_.CmdExternalCallback(TaaTimestampCallback, &timestamp,
+                                               sizeof(timestamp));
+  fsr.timer_submission[slot] = GetCurrentSubmission();
+}
+
+void VulkanCommandProcessor::TaaTimerCollect() {
+  if (!taa_fsr_ || taa_fsr_->timer_pool == VK_NULL_HANDLE) {
+    return;
+  }
+  TaaFsr& fsr = *taa_fsr_;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  for (uint32_t slot = 0; slot < TaaFsr::kTimerSlots; ++slot) {
+    if (!fsr.timer_submission[slot] || fsr.timer_submission[slot] > GetCompletedSubmission()) {
+      continue;
+    }
+    fsr.timer_submission[slot] = 0;
+    uint64_t ticks[2];
+    if (fsr.get_results(vulkan_device->device(), fsr.timer_pool, slot * 2, 2, sizeof(ticks),
+                        ticks, sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) == VK_SUCCESS &&
+        ticks[1] > ticks[0]) {
+      fsr.timer_ms += double(ticks[1] - ticks[0]) * fsr.timer_tick_ms;
+      ++fsr.timer_count;
+    }
+  }
+}
+
+void VulkanCommandProcessor::TaaTakeGpuTime(double& ms_out, uint32_t& count_out) {
+  ms_out = 0.0;
+  count_out = 0;
+  if (!taa_fsr_) {
+    return;
+  }
+  TaaTimerCollect();
+  ms_out = taa_fsr_->timer_ms;
+  count_out = taa_fsr_->timer_count;
+  taa_fsr_->timer_ms = 0.0;
+  taa_fsr_->timer_count = 0;
+}
+
+void VulkanCommandProcessor::TaaFsrDeleter::operator()(TaaFsr* fsr) const {
+  if (fsr->thread.joinable()) {
+    fsr->thread.join();
+  }
+  delete fsr;
+}
+
+bool VulkanCommandProcessor::TaaReady() const {
+  return taa_fsr_ && taa_fsr_->state.load(std::memory_order_acquire) == TaaFsr::kReady;
+}
+
+bool VulkanCommandProcessor::TaaDeviceSupported() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  // FidelityFX picks its shaders from the physical device's features and
+  // extensions; the device enables the 16-bit and subgroup size features only
+  // as Vulkan 1.2 and 1.3 features (vulkan_device.cpp), not the extensions
+  // older devices have them as.
+  if (vulkan_device->properties().apiVersion < VK_MAKE_API_VERSION(0, 1, 3, 0)) {
+    TaaSetUnavailable("FSR needs a Vulkan 1.3 device");
+    return false;
+  }
+  // The storage formats the passes write (FSR needs them too).
+  const ui::vulkan::VulkanInstance* instance = vulkan_device->vulkan_instance();
+  for (VkFormat format : {VK_FORMAT_R16G16_SFLOAT, VK_FORMAT_R16_SFLOAT, VK_FORMAT_R8_UNORM,
+                          VK_FORMAT_R16G16B16A16_SFLOAT}) {
+    VkFormatProperties properties;
+    instance->functions().vkGetPhysicalDeviceFormatProperties(vulkan_device->physical_device(),
+                                                              format, &properties);
+    if (!(properties.optimalTilingFeatures & VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT)) {
+      TaaSetUnavailable("the device can't write a format FSR needs in shaders");
+      return false;
+    }
+  }
+  return true;
+}
+
+// Whether FidelityFX's Vulkan runtime is there (next to the executable, or
+// linked in).
+static bool TaaRuntimeThere() {
+#if !(defined(REX_HAS_FSR) && REX_HAS_FSR)
+  return false;
+#elif defined(REX_FSR_STATIC) && REX_FSR_STATIC
+  return FsrRuntime::Linked();
+#else
+#if REX_PLATFORM_WIN32
+  const char* name = "amd_fidelityfx_vk.dll";
+#else
+  const char* name = "libamd_fidelityfx_vk.so";
+#endif
+  std::error_code error;
+  return std::filesystem::exists(rex::filesystem::GetExecutableFolder() / name, error);
+#endif
+}
+
+bool VulkanCommandProcessor::TaaCheckAvailable() {
+  // Not on a device made without its features (temporal_aa_device_features).
+  return GetVulkanDevice()->temporal_aa_features() && TaaRuntimeThere() && TaaDeviceSupported();
+}
+
+bool VulkanCommandProcessor::TaaAvailableAtNextStart() {
+  return !GetVulkanDevice()->temporal_aa_features() && TaaRuntimeThere() && TaaDeviceSupported();
+}
+
+void VulkanCommandProcessor::TaaCollectRetired(bool all) {
+  if (!taa_fsr_) {
+    return;
+  }
+  TaaFsr& fsr = *taa_fsr_;
+  for (auto it = fsr.retired.begin(); it != fsr.retired.end();) {
+    if (!all && it->first > GetCompletedSubmission()) {
+      ++it;
+      continue;
+    }
+#if defined(REX_HAS_FSR) && REX_HAS_FSR
+    ffxContext context = it->second;
+    fsr.runtime.destroy(&context, nullptr);
+#endif
+    it = fsr.retired.erase(it);
+  }
+}
+
+void VulkanCommandProcessor::TaaFrameEnd() {
+  TaaCollectRetired(false);
+}
+
+void VulkanCommandProcessor::TaaRelease() {
+  if (!taa_fsr_) {
+    return;
+  }
+  if (taa_fsr_->thread.joinable()) {
+    taa_fsr_->thread.join();
+  }
+#if defined(REX_HAS_FSR) && REX_HAS_FSR
+  if (taa_fsr_->context) {
+    // The GPU and the submission thread may still use it: destroyed once the
+    // submissions so far are done.
+    taa_fsr_->retired.emplace_back(GetCurrentSubmission(), taa_fsr_->context);
+    taa_fsr_->context = nullptr;
+    REXGPU_INFO("Temporal AA: FSR released");
+  }
+#endif
+  taa_fsr_->dispatch_failed.store(false, std::memory_order_relaxed);
+  for (HdrImage* image : {&taa_fsr_->vectors, &taa_fsr_->output, &taa_fsr_->luma[0],
+                          &taa_fsr_->luma[1], &taa_fsr_->reactive}) {
+    if (image->image != VK_NULL_HANDLE) {
+      // Destroyed once the submissions that may use it are done.
+      destroy_image_views_.emplace_back(GetCurrentSubmission(), image->view);
+      destroy_images_.emplace_back(GetCurrentSubmission(), image->image);
+      destroy_memory_.emplace_back(GetCurrentSubmission(), image->memory);
+      *image = HdrImage();
+    }
+  }
+  taa_fsr_->width = 0;
+  taa_fsr_->height = 0;
+  taa_fsr_->state.store(TaaFsr::kNone, std::memory_order_release);
+}
+
+bool VulkanCommandProcessor::TaaCreatePipeline() {
+  if (taa_vectors_pipeline_ != VK_NULL_HANDLE) {
+    return true;
+  }
+  if (taa_pipeline_failed_) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  taa_pipeline_failed_ = true;
+  if (!TaaDeviceSupported()) {
+    return false;
+  }
+  // Set layouts: the vectors' (a uniform buffer, two sampled images, a storage
+  // image) and the reactive mask's (three sampled images, a storage image).
+  for (uint32_t set = 0; set < 2; ++set) {
+    VkDescriptorSetLayoutBinding bindings[4] = {};
+    for (uint32_t i = 0; i < 4; ++i) {
+      bindings[i].binding = i;
+      bindings[i].descriptorType = i == 3                   ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE
+                                   : (!set && !i)           ? VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER
+                                                            : VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+      bindings[i].descriptorCount = 1;
+      bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+    }
+    VkDescriptorSetLayoutCreateInfo layout_info = {
+        VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+    layout_info.bindingCount = 4;
+    layout_info.pBindings = bindings;
+    if (dfn.vkCreateDescriptorSetLayout(device, &layout_info, nullptr,
+                                        set ? &taa_reactive_set_layout_
+                                            : &taa_descriptor_set_layout_) != VK_SUCCESS) {
+      REXGPU_ERROR("Temporal AA: failed to create the descriptor set layouts");
+      return false;
+    }
+  }
+  VkDescriptorPoolSize pool_sizes[3] = {
+      {VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, kMaxFramesInFlight},
+      {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 8 * kMaxFramesInFlight},
+      {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 3 * kMaxFramesInFlight},
+  };
+  VkDescriptorPoolCreateInfo pool_info = {VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+  pool_info.maxSets = 3 * kMaxFramesInFlight;
+  pool_info.poolSizeCount = 3;
+  pool_info.pPoolSizes = pool_sizes;
+  if (dfn.vkCreateDescriptorPool(device, &pool_info, nullptr, &taa_descriptor_pool_) !=
+      VK_SUCCESS) {
+    REXGPU_ERROR("Temporal AA: failed to create the descriptor pool");
+    return false;
+  }
+  for (uint32_t set = 0; set < 3; ++set) {
+    std::array<VkDescriptorSetLayout, kMaxFramesInFlight> layouts;
+    layouts.fill(set ? taa_reactive_set_layout_ : taa_descriptor_set_layout_);
+    VkDescriptorSetAllocateInfo allocate_info = {
+        VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+    allocate_info.descriptorPool = taa_descriptor_pool_;
+    allocate_info.descriptorSetCount = kMaxFramesInFlight;
+    allocate_info.pSetLayouts = layouts.data();
+    VkDescriptorSet* sets = set == 2   ? taa_debug_descriptors_.data()
+                            : set == 1 ? taa_reactive_descriptors_.data()
+                                       : taa_descriptors_.data();
+    if (dfn.vkAllocateDescriptorSets(device, &allocate_info, sets) != VK_SUCCESS) {
+      REXGPU_ERROR("Temporal AA: failed to allocate the descriptor sets");
+      return false;
+    }
+  }
+  auto create = [&](uint32_t set_count, const VkDescriptorSetLayout* set_layouts,
+                    uint32_t push_constants_size, const uint32_t* shader, size_t shader_size,
+                    const char* name, VkPipelineLayout& layout, VkPipeline& pipeline) {
+    VkPushConstantRange push_constants = {VK_SHADER_STAGE_COMPUTE_BIT, 0, push_constants_size};
+    VkPipelineLayoutCreateInfo layout_info = {VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    layout_info.setLayoutCount = set_count;
+    layout_info.pSetLayouts = set_layouts;
+    layout_info.pushConstantRangeCount = push_constants_size ? 1 : 0;
+    layout_info.pPushConstantRanges = &push_constants;
+    if (dfn.vkCreatePipelineLayout(device, &layout_info, nullptr, &layout) != VK_SUCCESS) {
+      return false;
+    }
+    pipeline = ui::vulkan::util::CreateComputePipeline(vulkan_device, layout, shader, shader_size);
+    if (pipeline == VK_NULL_HANDLE) {
+      return false;
+    }
+    vulkan_device->SetObjectName(VK_OBJECT_TYPE_PIPELINE, pipeline, name);
+    return true;
+  };
+  VkDescriptorSetLayout luma_sets[2] = {
+      render_target_cache_->descriptor_set_layout_sampled_image(),
+      GetSingleTransientDescriptorLayout(SingleTransientDescriptorLayout::kStorageImageCompute)};
+  if (!create(1, &taa_descriptor_set_layout_, 0, shaders::taa_motion_vectors_mcla_cs,
+              sizeof(shaders::taa_motion_vectors_mcla_cs), "Temporal AA motion vectors",
+              taa_vectors_pipeline_layout_, taa_vectors_pipeline_) ||
+      !create(2, luma_sets, 16, shaders::taa_luma_snapshot_cs,
+              sizeof(shaders::taa_luma_snapshot_cs), "Temporal AA luminance snapshot",
+              taa_luma_pipeline_layout_, taa_luma_pipeline_) ||
+      !create(1, &taa_reactive_set_layout_, 32, shaders::taa_reactive_mcla_cs,
+              sizeof(shaders::taa_reactive_mcla_cs), "Temporal AA reactive mask",
+              taa_reactive_pipeline_layout_, taa_reactive_pipeline_)) {
+    REXGPU_ERROR("Temporal AA: failed to create the pipelines");
+    return false;
+  }
+  taa_debug_pipeline_ = ui::vulkan::util::CreateComputePipeline(
+      vulkan_device, taa_reactive_pipeline_layout_, shaders::taa_debug_view_cs,
+      sizeof(shaders::taa_debug_view_cs));
+  if (taa_debug_pipeline_ == VK_NULL_HANDLE) {
+    REXGPU_ERROR("Temporal AA: failed to create the pipelines");
+    return false;
+  }
+  taa_pipeline_failed_ = false;
+  return true;
+}
+
+void VulkanCommandProcessor::TaaDestroyPipeline() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (VkPipeline* pipeline : {&taa_vectors_pipeline_, &taa_luma_pipeline_,
+                               &taa_reactive_pipeline_, &taa_debug_pipeline_}) {
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device, *pipeline);
+  }
+  for (VkPipelineLayout* layout : {&taa_vectors_pipeline_layout_, &taa_luma_pipeline_layout_,
+                                   &taa_reactive_pipeline_layout_}) {
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device, *layout);
+  }
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyDescriptorPool, device,
+                                         taa_descriptor_pool_);
+  taa_descriptors_.fill(VK_NULL_HANDLE);
+  taa_reactive_descriptors_.fill(VK_NULL_HANDLE);
+  taa_debug_descriptors_.fill(VK_NULL_HANDLE);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyDescriptorSetLayout, device,
+                                         taa_descriptor_set_layout_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyDescriptorSetLayout, device,
+                                         taa_reactive_set_layout_);
+  if (taa_fsr_) {
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyQueryPool, device, taa_fsr_->timer_pool);
+    for (HdrImage* image : {&taa_fsr_->vectors, &taa_fsr_->output, &taa_fsr_->luma[0],
+                            &taa_fsr_->luma[1], &taa_fsr_->reactive}) {
+      ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImageView, device, image->view);
+      ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImage, device, image->image);
+      ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, image->memory);
+    }
+  }
+}
+
+bool VulkanCommandProcessor::TaaEnsureReactiveTextures() {
+  TaaFsr& fsr = *taa_fsr_;
+  if (fsr.reactive.image != VK_NULL_HANDLE) {
+    return true;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  static const char* const kNames[3] = {"Temporal AA opaque luminance",
+                                        "Temporal AA composite luminance",
+                                        "Temporal AA reactive mask"};
+  for (uint32_t i = 0; i < 3; ++i) {
+    HdrImage& image = i < 2 ? fsr.luma[i] : fsr.reactive;
+    VkImageCreateInfo image_info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    image_info.imageType = VK_IMAGE_TYPE_2D;
+    image_info.format = i < 2 ? VK_FORMAT_R16_SFLOAT : VK_FORMAT_R8_UNORM;
+    image_info.extent = {fsr.width, fsr.height, 1};
+    image_info.mipLevels = 1;
+    image_info.arrayLayers = 1;
+    image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+    image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    image_info.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT;
+    image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    VkImageViewCreateInfo view_info = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    if (ui::vulkan::util::CreateDedicatedAllocationImage(
+            vulkan_device, image_info, ui::vulkan::util::MemoryPurpose::kDeviceLocal, image.image,
+            image.memory)) {
+      view_info.image = image.image;
+      view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+      view_info.format = image_info.format;
+      view_info.subresourceRange = ui::vulkan::util::InitializeSubresourceRange();
+    }
+    if (image.image == VK_NULL_HANDLE ||
+        dfn.vkCreateImageView(device, &view_info, nullptr, &image.view) != VK_SUCCESS) {
+      REXGPU_ERROR("Temporal AA: failed to create the reactive mask's images");
+      for (HdrImage* made : {&fsr.luma[0], &fsr.luma[1], &fsr.reactive}) {
+        ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImageView, device, made->view);
+        ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyImage, device, made->image);
+        ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, made->memory);
+        *made = HdrImage();
+      }
+      return false;
+    }
+    image.width = fsr.width;
+    image.height = fsr.height;
+    image.layout = VK_IMAGE_LAYOUT_UNDEFINED;
+    vulkan_device->SetObjectName(VK_OBJECT_TYPE_IMAGE, image.image, kNames[i]);
+  }
+  return true;
+}
+
+bool VulkanCommandProcessor::TaaSnapshot(uint32_t slot, uint32_t color_target_key) {
+  if (!TaaReady() || slot > 1 || !TaaCreatePipeline() || !BeginSubmission(true) ||
+      !TaaEnsureReactiveTextures()) {
+    return false;
+  }
+  TaaFsr& fsr = *taa_fsr_;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkDescriptorSet dest_set =
+      AllocateSingleTransientDescriptor(SingleTransientDescriptorLayout::kStorageImageCompute);
+  if (dest_set == VK_NULL_HANDLE) {
+    return false;
+  }
+  EndRenderPass();
+  uint32_t width, height;
+  VkDescriptorSet source_set =
+      render_target_cache_->TaaBeginReadColorTarget(color_target_key, width, height);
+  if (source_set == VK_NULL_HANDLE) {
+    return false;
+  }
+  if (width < fsr.width || height < fsr.height) {
+    return false;
+  }
+  VkDescriptorImageInfo dest_info = {VK_NULL_HANDLE, fsr.luma[slot].view, VK_IMAGE_LAYOUT_GENERAL};
+  VkWriteDescriptorSet write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+  write.dstSet = dest_set;
+  write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  write.pImageInfo = &dest_info;
+  dfn.vkUpdateDescriptorSets(vulkan_device->device(), 1, &write, 0, nullptr);
+  HdrTransitionImage(fsr.luma[slot], VK_IMAGE_LAYOUT_GENERAL);
+  SubmitBarriers(true);
+  BindExternalComputePipeline(taa_luma_pipeline_);
+  VkDescriptorSet sets[2] = {source_set, dest_set};
+  deferred_command_buffer_.CmdVkBindDescriptorSets(
+      VK_PIPELINE_BIND_POINT_COMPUTE, taa_luma_pipeline_layout_, 0, 2, sets, 0, nullptr);
+  uint32_t constants[4] = {fsr.width, fsr.height, 0, 0};
+  deferred_command_buffer_.CmdVkPushConstants(taa_luma_pipeline_layout_,
+                                              VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants),
+                                              constants);
+  deferred_command_buffer_.CmdVkDispatch((fsr.width + 15) / 16, (fsr.height + 7) / 8, 1);
+  HdrTransitionImage(fsr.luma[slot], VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  return true;
+}
+
+void VulkanCommandProcessor::TaaRunDebugView(VkImageView scene_view, uint32_t mode) {
+  TaaFsr& fsr = *taa_fsr_;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkDescriptorSet set = taa_debug_descriptors_[frame_current_ % kMaxFramesInFlight];
+  // Without a reactive mask this frame: the vectors in its place (mode 1
+  // doesn't read it).
+  bool reactive = taa_frame_.snapshots == 3 && fsr.reactive.image != VK_NULL_HANDLE;
+  VkDescriptorImageInfo images[4] = {
+      {VK_NULL_HANDLE, scene_view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL},
+      {VK_NULL_HANDLE, fsr.vectors.view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL},
+      {VK_NULL_HANDLE, reactive ? fsr.reactive.view : fsr.vectors.view,
+       VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL},
+      {VK_NULL_HANDLE, fsr.output.view, VK_IMAGE_LAYOUT_GENERAL},
+  };
+  VkWriteDescriptorSet writes[2] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = set;
+    writes[i].dstBinding = i ? 3 : 0;
+    writes[i].descriptorCount = i ? 1 : 3;
+    writes[i].descriptorType =
+        i ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    writes[i].pImageInfo = i ? &images[3] : images;
+  }
+  dfn.vkUpdateDescriptorSets(vulkan_device->device(), 2, writes, 0, nullptr);
+  SubmitBarriers(true);
+  BindExternalComputePipeline(taa_debug_pipeline_);
+  deferred_command_buffer_.CmdVkBindDescriptorSets(
+      VK_PIPELINE_BIND_POINT_COMPUTE, taa_reactive_pipeline_layout_, 0, 1, &set, 0, nullptr);
+  uint32_t constants[4] = {fsr.width, fsr.height, reactive || mode ? mode : 1, 0};
+  deferred_command_buffer_.CmdVkPushConstants(taa_reactive_pipeline_layout_,
+                                              VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants),
+                                              constants);
+  deferred_command_buffer_.CmdVkDispatch((fsr.width + 15) / 16, (fsr.height + 7) / 8, 1);
+  VkMemoryBarrier barrier = {VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr, VK_ACCESS_SHADER_WRITE_BIT,
+                             VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT};
+  deferred_command_buffer_.CmdVkPipelineBarrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                                                VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1,
+                                                &barrier, 0, nullptr, 0, nullptr);
+}
+
+void VulkanCommandProcessor::TaaRunReactive(VkImageView stencil_view) {
+  TaaFsr& fsr = *taa_fsr_;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkDescriptorSet set = taa_reactive_descriptors_[frame_current_ % kMaxFramesInFlight];
+  VkDescriptorImageInfo images[4] = {
+      {VK_NULL_HANDLE, fsr.luma[0].view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL},
+      {VK_NULL_HANDLE, fsr.luma[1].view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL},
+      {VK_NULL_HANDLE, stencil_view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL},
+      {VK_NULL_HANDLE, fsr.reactive.view, VK_IMAGE_LAYOUT_GENERAL},
+  };
+  VkWriteDescriptorSet writes[2] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = set;
+    writes[i].dstBinding = i ? 3 : 0;
+    writes[i].descriptorCount = i ? 1 : 3;
+    writes[i].descriptorType =
+        i ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    writes[i].pImageInfo = i ? &images[3] : images;
+  }
+  dfn.vkUpdateDescriptorSets(vulkan_device->device(), 2, writes, 0, nullptr);
+  HdrTransitionImage(fsr.reactive, VK_IMAGE_LAYOUT_GENERAL);
+  SubmitBarriers(true);
+  BindExternalComputePipeline(taa_reactive_pipeline_);
+  deferred_command_buffer_.CmdVkBindDescriptorSets(
+      VK_PIPELINE_BIND_POINT_COMPUTE, taa_reactive_pipeline_layout_, 0, 1, &set, 0, nullptr);
+  uint32_t constants[8] = {fsr.width, fsr.height, uint32_t(taa_vector_constants_.jitter[2]), 0};
+  TaaReactiveCurve(reinterpret_cast<float*>(&constants[4]));
+  deferred_command_buffer_.CmdVkPushConstants(taa_reactive_pipeline_layout_,
+                                              VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants),
+                                              constants);
+  deferred_command_buffer_.CmdVkDispatch((fsr.width + 15) / 16, (fsr.height + 7) / 8, 1);
+  HdrTransitionImage(fsr.reactive, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+}
+
+void VulkanCommandProcessor::TaaRun(const VulkanShader& pixel_shader) {
+#if defined(REX_HAS_FSR) && REX_HAS_FSR
+  VkFormat scene_format, depth_format;
+  uint32_t width, height, depth_width, depth_height;
+  VkImage scene = texture_cache_->GetActiveTextureImage(kTaaFetchScene, scene_format, width, height);
+  VkImage depth =
+      texture_cache_->GetActiveTextureImage(kTaaFetchDepth, depth_format, depth_width, depth_height);
+  VkFormat stencil_format;
+  uint32_t stencil_width, stencil_height;
+  VkImage stencil = texture_cache_->GetActiveTextureImage(kTaaFetchStencil, stencil_format,
+                                                          stencil_width, stencil_height);
+  taa_frame_.status = 't';
+  if (scene == VK_NULL_HANDLE || depth == VK_NULL_HANDLE ||
+      scene_format != VK_FORMAT_R16G16B16A16_SFLOAT || depth_format != VK_FORMAT_R32_SFLOAT ||
+      depth_width != width || depth_height != height || stencil == VK_NULL_HANDLE ||
+      stencil_width != width || stencil_height != height || !TaaCreatePipeline()) {
+    return;
+  }
+  // The scene's view for the debug views: whichever of the unsigned and the
+  // signed view its fetch constant's signs made.
+  VkImageView scene_view = VK_NULL_HANDLE;
+  for (const VulkanShader::TextureBinding& binding :
+       pixel_shader.GetTextureBindingsAfterTranslation()) {
+    if (binding.fetch_constant == kTaaFetchScene) {
+      for (bool is_signed : {false, true}) {
+        if (scene_view == VK_NULL_HANDLE) {
+          scene_view = texture_cache_->GetActiveBindingOrNullImageView(
+              binding.fetch_constant, binding.dimension, is_signed);
+        }
+      }
+      break;
+    }
+  }
+  VkDescriptorImageInfo textures[2];  // depth (binding 1), stencil (binding 2)
+  for (uint32_t i = 0; i < 2; ++i) {
+    textures[i] = {VK_NULL_HANDLE, VK_NULL_HANDLE, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+    uint32_t fetch_constant = i ? kTaaFetchStencil : kTaaFetchDepth;
+    for (const VulkanShader::TextureBinding& binding :
+         pixel_shader.GetTextureBindingsAfterTranslation()) {
+      if (binding.fetch_constant == fetch_constant) {
+        textures[i].imageView = texture_cache_->GetActiveBindingOrNullImageView(
+            binding.fetch_constant, binding.dimension, bool(binding.is_signed));
+        break;
+      }
+    }
+    if (textures[i].imageView == VK_NULL_HANDLE) {
+      taa_frame_.status = 'n';
+      return;
+    }
+  }
+
+  // The upscaler, made for this size on another thread (the first one takes
+  // half a second or so); the frames until it's ready are left as they are.
+  if (!taa_fsr_) {
+    taa_fsr_.reset(new TaaFsr());
+  }
+  TaaFsr& fsr = *taa_fsr_;
+  uint32_t state = fsr.state.load(std::memory_order_acquire);
+  if (state != TaaFsr::kNone && (fsr.width != width || fsr.height != height)) {
+    // Made again for the new size, from the end of this frame (never released
+    // in the middle of one).
+    taa_release_pending_ = true;
+    return;
+  }
+  if (fsr.dispatch_failed.load(std::memory_order_acquire)) {
+    TaaSetUnavailable("its dispatch failed");
+    fsr.state.store(TaaFsr::kFailed, std::memory_order_release);
+    taa_release_pending_ = true;
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (state == TaaFsr::kNone) {
+    // A failure stays one for this size.
+    fsr.width = width;
+    fsr.height = height;
+    if (!vulkan_device->temporal_aa_features()) {
+      // Created without the features FidelityFX's shaders use
+      // (temporal_aa_device_features): not until the next start.
+      fsr.state.store(TaaFsr::kFailed, std::memory_order_release);
+      return;
+    }
+    if (!fsr.runtime.Load("vk")) {
+      TaaSetUnavailable("the Vulkan FidelityFX runtime couldn't be loaded");
+      fsr.state.store(TaaFsr::kFailed, std::memory_order_release);
+      return;
+    }
+    for (uint32_t i = 0; i < 2; ++i) {
+      HdrImage& image = i ? fsr.output : fsr.vectors;
+      VkImageCreateInfo image_info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+      image_info.imageType = VK_IMAGE_TYPE_2D;
+      image_info.format = i ? VK_FORMAT_R16G16B16A16_SFLOAT : VK_FORMAT_R16G16_SFLOAT;
+      image_info.extent = {width, height, 1};
+      image_info.mipLevels = 1;
+      image_info.arrayLayers = 1;
+      image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+      image_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+      image_info.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT |
+                         (i ? VK_IMAGE_USAGE_TRANSFER_SRC_BIT : 0);
+      image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+      image_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+      if (!ui::vulkan::util::CreateDedicatedAllocationImage(
+              vulkan_device, image_info, ui::vulkan::util::MemoryPurpose::kDeviceLocal,
+              image.image, image.memory)) {
+        REXGPU_ERROR("Temporal AA: failed to create an image");
+        TaaRelease();
+        fsr.width = width;
+        fsr.height = height;
+        fsr.state.store(TaaFsr::kFailed, std::memory_order_release);
+        return;
+      }
+      VkImageViewCreateInfo view_info = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+      view_info.image = image.image;
+      view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+      view_info.format = image_info.format;
+      view_info.subresourceRange = ui::vulkan::util::InitializeSubresourceRange();
+      if (dfn.vkCreateImageView(device, &view_info, nullptr, &image.view) != VK_SUCCESS) {
+        REXGPU_ERROR("Temporal AA: failed to create an image view");
+        TaaRelease();
+        fsr.width = width;
+        fsr.height = height;
+        fsr.state.store(TaaFsr::kFailed, std::memory_order_release);
+        return;
+      }
+      image.width = width;
+      image.height = height;
+      image.layout = VK_IMAGE_LAYOUT_UNDEFINED;
+      vulkan_device->SetObjectName(VK_OBJECT_TYPE_IMAGE, image.image,
+                                   i ? "Temporal AA output" : "Temporal AA motion vectors");
+    }
+    fsr.width = width;
+    fsr.height = height;
+    fsr.state.store(TaaFsr::kCreating, std::memory_order_release);
+    taa_get_device_proc_addr.store(
+        reinterpret_cast<PFN_vkGetDeviceProcAddr>(
+            vulkan_device->vulkan_instance()->functions().vkGetInstanceProcAddr(
+                vulkan_device->vulkan_instance()->instance(), "vkGetDeviceProcAddr")),
+        std::memory_order_relaxed);
+    uint32_t flags = kTaaFsrCreateFlags;
+    if (TaaDebug() == 1) {
+      flags |= FFX_UPSCALE_ENABLE_DEBUG_CHECKING;
+    }
+#if defined(REX_FSR_PREBUILT_SHADERS_VK) && REX_FSR_PREBUILT_SHADERS_VK
+    // The runtime's shaders are only the permutations of the flags they were
+    // made for (launcher/dev/fsr/fsr_vk_shaders.py); others would ask for ones
+    // that aren't there.
+    if ((flags & (REXGLUE_FSR_SHADERS_VK_FLAG_MASK)) != (REXGLUE_FSR_SHADERS_VK_FLAGS)) {
+      REXGPU_ERROR("Temporal AA: FSR's prebuilt Vulkan shaders were made for other create flags "
+                   "({:#x}, these {:#x})",
+                   uint32_t(REXGLUE_FSR_SHADERS_VK_FLAGS),
+                   flags & uint32_t(REXGLUE_FSR_SHADERS_VK_FLAG_MASK));
+      TaaSetUnavailable("its prebuilt shaders don't have the permutations it would use");
+      fsr.state.store(TaaFsr::kFailed, std::memory_order_release);
+      return;
+    }
+#endif
+#if defined(REX_FSR_STATIC) && REX_FSR_STATIC
+    TaaSetStaticVulkanFunctions(&vulkan_device->vulkan_instance()->functions(),
+                                &vulkan_device->functions());
+#endif
+    VkPhysicalDevice physical_device = vulkan_device->physical_device();
+    fsr.thread = std::thread([&fsr, device, physical_device, width, height, flags]() {
+      auto start = std::chrono::steady_clock::now();
+      ffxCreateBackendVKDesc backend = {};
+      backend.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_VK;
+      backend.vkDevice = device;
+      backend.vkPhysicalDevice = physical_device;
+      backend.vkDeviceProcAddr = TaaGetDeviceProcAddr;
+      ffxCreateContextDescUpscale create = {};
+      create.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+      create.header.pNext = &backend.header;
+      create.flags = flags;
+      create.maxRenderSize = {width, height};
+      create.maxUpscaleSize = {width, height};
+      create.fpMessage = FsrRuntime::Message;
+      ffxReturnCode_t result = fsr.runtime.create(&fsr.context, &create.header, nullptr);
+      if (result != FFX_API_RETURN_OK) {
+        fsr.context = nullptr;
+        REXGPU_ERROR("Temporal AA: creating FSR failed ({})", result);
+        TaaSetUnavailable("its context couldn't be created");
+        fsr.state.store(TaaFsr::kFailed, std::memory_order_release);
+        return;
+      }
+      REXGPU_INFO("Temporal AA: FSR 3.1 ready for {}x{} (Vulkan) after {} ms", width, height,
+                  std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now() - start)
+                      .count());
+      fsr.state.store(TaaFsr::kReady, std::memory_order_release);
+    });
+    return;
+  }
+  if (state != TaaFsr::kReady) {
+    taa_frame_.status = state == TaaFsr::kCreating ? 'c' : 'x';
+    return;
+  }
+  if (fsr.thread.joinable()) {
+    fsr.thread.join();
+  }
+
+  // The motion vectors.
+  TaaVectorConstants& constants = taa_vector_constants_;
+  xenos::xe_gpu_texture_fetch_t scene_fetch = register_file_->GetTextureFetch(kTaaFetchScene);
+  constants.size[0] = float(width);
+  constants.size[1] = float(height);
+  constants.size[2] = float(width) / float(scene_fetch.size_2d.width + 1);
+  constants.size[3] = float(height) / float(scene_fetch.size_2d.height + 1);
+  // The stencil is the stencil view's first byte (red): where the fetch
+  // constant's swizzle puts it.
+  uint32_t stencil_swizzle = texture_cache_->GetActiveTextureHostSwizzle(kTaaFetchStencil);
+  constants.jitter[2] = 0.0f;
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (((stencil_swizzle >> (3 * i)) & 7) == xenos::XE_GPU_TEXTURE_SWIZZLE_R) {
+      constants.jitter[2] = float(i);
+      break;
+    }
+  }
+  static bool swizzle_logged = false;
+  if (!swizzle_logged) {
+    swizzle_logged = true;
+    REXGPU_INFO("Temporal AA: stencil view swizzle {:03X}, the stencil in component {}",
+                stencil_swizzle, constants.jitter[2]);
+  }
+  VkDescriptorBufferInfo constants_info;
+  uint8_t* constants_mapping = uniform_buffer_pool_->Request(
+      frame_current_, sizeof(constants),
+      std::max(size_t(vulkan_device->properties().minUniformBufferOffsetAlignment), size_t(16)),
+      constants_info.buffer, constants_info.offset);
+  if (!constants_mapping) {
+    return;
+  }
+  constants_info.range = sizeof(constants);
+  std::memcpy(constants_mapping, &constants, sizeof(constants));
+  uint32_t frame_index = uint32_t(frame_current_ % kMaxFramesInFlight);
+  VkDescriptorSet set = taa_descriptors_[frame_index];
+  VkDescriptorImageInfo vectors_info = {VK_NULL_HANDLE, fsr.vectors.view, VK_IMAGE_LAYOUT_GENERAL};
+  VkWriteDescriptorSet writes[3] = {};
+  for (uint32_t i = 0; i < 3; ++i) {
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = set;
+  }
+  writes[0].dstBinding = 0;
+  writes[0].descriptorCount = 1;
+  writes[0].descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
+  writes[0].pBufferInfo = &constants_info;
+  writes[1].dstBinding = 1;
+  writes[1].descriptorCount = 2;
+  writes[1].descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+  writes[1].pImageInfo = textures;
+  writes[2].dstBinding = 3;
+  writes[2].descriptorCount = 1;
+  writes[2].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  writes[2].pImageInfo = &vectors_info;
+  dfn.vkUpdateDescriptorSets(device, 3, writes, 0, nullptr);
+  EndRenderPass();
+  HdrTransitionImage(fsr.vectors, VK_IMAGE_LAYOUT_GENERAL);
+  HdrTransitionImage(fsr.output, VK_IMAGE_LAYOUT_GENERAL);
+  SubmitBarriers(true);
+  uint32_t timer_slot = TaaTimerBegin();
+  // The game's textures were made visible to the guest shader stages.
+  VkMemoryBarrier memory_barrier = {VK_STRUCTURE_TYPE_MEMORY_BARRIER, nullptr, 0,
+                                    VK_ACCESS_SHADER_READ_BIT};
+  deferred_command_buffer_.CmdVkPipelineBarrier(guest_shader_pipeline_stages_,
+                                                VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1,
+                                                &memory_barrier, 0, nullptr, 0, nullptr);
+  BindExternalComputePipeline(taa_vectors_pipeline_);
+  deferred_command_buffer_.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                                   taa_vectors_pipeline_layout_, 0, 1, &set, 0,
+                                                   nullptr);
+  deferred_command_buffer_.CmdVkDispatch((width + 15) / 16, (height + 7) / 8, 1);
+  HdrTransitionImage(fsr.vectors, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  // The reactive mask, from this frame's snapshots of the scene.
+  if (taa_frame_.snapshots == 3 && fsr.reactive.image != VK_NULL_HANDLE) {
+    TaaRunReactive(textures[1].imageView);
+  } else {
+    taa_frame_.snapshots = 0;
+  }
+  SubmitBarriers(true);
+  taa_frame_.done = true;
+  taa_frame_.status = '+';
+  if (TaaDebug() == 3) {
+    // The raw (jittered) input.
+    TaaTimerEnd(timer_slot);
+    return;
+  }
+  static int debug_view_logged = -1;
+  if (TaaDebug() >= 5 && TaaDebug() != debug_view_logged) {
+    debug_view_logged = TaaDebug();
+    REXGPU_INFO("Temporal AA: debug view {}, the scene's view {}", TaaDebug(),
+                scene_view != VK_NULL_HANDLE ? "found" : "missing");
+  }
+  if (TaaDebug() >= 5 && scene_view != VK_NULL_HANDLE) {
+    // A development view instead of FSR's output.
+    TaaRunDebugView(scene_view, TaaDebug() - 5);
+  } else {
+
+  // FSR, recorded into the real command buffer where it falls (it restores
+  // the states it was given), then the output into the scene texture.
+  TaaFsrDispatch dispatch = {};
+  dispatch.dispatch = fsr.runtime.dispatch;
+  dispatch.context = fsr.context;
+  dispatch.failed = &fsr.dispatch_failed;
+  dispatch.pipeline_barrier = dfn.vkCmdPipelineBarrier;
+  dispatch.copy_image = dfn.vkCmdCopyImage;
+  ffxDispatchDescUpscale& desc = dispatch.desc;
+  desc.header.type = FFX_API_DISPATCH_DESC_TYPE_UPSCALE;
+  desc.color = TaaFsrResource(scene, scene_format, width, height,
+                              VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+                              FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+  desc.depth = TaaFsrResource(depth, depth_format, width, height,
+                              VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+                              FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+  desc.motionVectors = TaaFsrResource(fsr.vectors.image, VK_FORMAT_R16G16_SFLOAT, width, height,
+                                      VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT,
+                                      FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+  if (taa_frame_.snapshots == 3) {
+    desc.reactive = TaaFsrResource(fsr.reactive.image, VK_FORMAT_R8_UNORM, width, height,
+                                   VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT,
+                                   FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+  }
+  desc.output = TaaFsrResource(fsr.output.image, VK_FORMAT_R16G16B16A16_SFLOAT, width, height,
+                               VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT |
+                                   VK_IMAGE_USAGE_TRANSFER_SRC_BIT,
+                               FFX_API_RESOURCE_STATE_UNORDERED_ACCESS);
+  float jitter[2];
+  TaaFsrJitter(jitter);
+  desc.jitterOffset = {jitter[0], jitter[1]};
+  desc.motionVectorScale = {1.0f, 1.0f};
+  desc.renderSize = {width, height};
+  desc.upscaleSize = {width, height};
+  float sharpness = TaaSharpness();
+  desc.enableSharpening = sharpness > 0.0f;
+  desc.sharpness = sharpness;
+  desc.frameTimeDelta = taa_frame_time_ms_;
+  desc.preExposure = 1.0f;
+  desc.reset = taa_camera_.reset;
+  desc.cameraNear = taa_camera_.near_plane;
+  desc.cameraFar = taa_camera_.far_plane;
+  desc.cameraFovAngleVertical = taa_camera_.fov_vertical;
+  desc.viewSpaceToMetersFactor = 1.0f;
+  desc.flags = TaaDebug() == 1 ? FFX_UPSCALE_FLAG_DRAW_DEBUG_VIEW : 0;
+  deferred_command_buffer_.CmdExternalCallback(TaaFsrDispatchCallback, &dispatch,
+                                               sizeof(dispatch));
+  // FSR bound its own compute pipeline and descriptor sets.
+  current_external_compute_pipeline_ = VK_NULL_HANDLE;
+  current_guest_graphics_pipeline_ = VK_NULL_HANDLE;
+  current_external_graphics_pipeline_ = VK_NULL_HANDLE;
+  current_graphics_descriptor_sets_bound_up_to_date_ = 0;
+  }
+
+  // FSR's reads of the scene (compute) before the transition below, whose
+  // source scope is the guest shader stages, and the copy into it.
+  deferred_command_buffer_.CmdVkPipelineBarrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                                                guest_shader_pipeline_stages_, 0, 0, nullptr, 0,
+                                                nullptr, 0, nullptr);
+  texture_cache_->TransitionActiveTexture(kTaaFetchScene, true);
+  HdrTransitionImage(fsr.output, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  SubmitBarriers(true);
+  VkImageCopy region = {};
+  region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  region.extent = {width, height, 1};
+  deferred_command_buffer_.CmdVkCopyImage(fsr.output.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                                          scene, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, region);
+  texture_cache_->TransitionActiveTexture(kTaaFetchScene, false);
+  HdrTransitionImage(fsr.output, VK_IMAGE_LAYOUT_GENERAL);
+  TaaTimerEnd(timer_slot);
+#else
+  (void)pixel_shader;
+#endif  // REX_HAS_FSR
+}
+
+}  // namespace rex::graphics::vulkan
diff --git a/src/graphics/vulkan/temporal_aa_static.cpp b/src/graphics/vulkan/temporal_aa_static.cpp
new file mode 100644
index 0000000..7d90e1f
--- /dev/null
+++ b/src/graphics/vulkan/temporal_aa_static.cpp
@@ -0,0 +1,93 @@
+/**
+ * Temporal anti-aliasing (rexglue-temporal-aa.patch), where FidelityFX is
+ * linked statically (REX_FSR_STATIC: the PS5, which can't load modules and has
+ * no Vulkan loader, its driver being linked in as an ICD).
+ *
+ * FidelityFX's Vulkan backend gets its device functions through the
+ * vkGetDeviceProcAddr it is given, but refers to eight directly, as exported by
+ * a loader (ffx_vk.cpp at the pinned commit): these are those, forwarded to the
+ * instance and device the GPU plugin created (one of each). ps5/make_ps5.sh
+ * checks that nothing else is left undefined.
+ */
+
+#if defined(REX_FSR_STATIC) && REX_FSR_STATIC
+
+#include <atomic>
+
+#include <rex/ui/vulkan/device.h>
+#include <rex/ui/vulkan/instance.h>
+
+namespace rex::graphics::vulkan {
+
+namespace {
+std::atomic<const ui::vulkan::VulkanInstance::Functions*> taa_static_ifn{nullptr};
+std::atomic<const ui::vulkan::VulkanDevice::Functions*> taa_static_dfn{nullptr};
+}  // namespace
+
+// Before FSR's context is created (VulkanCommandProcessor::TaaRun).
+void TaaSetStaticVulkanFunctions(const ui::vulkan::VulkanInstance::Functions* ifn,
+                                 const ui::vulkan::VulkanDevice::Functions* dfn) {
+  taa_static_ifn.store(ifn, std::memory_order_release);
+  taa_static_dfn.store(dfn, std::memory_order_release);
+}
+
+}  // namespace rex::graphics::vulkan
+
+using rex::graphics::vulkan::taa_static_dfn;
+using rex::graphics::vulkan::taa_static_ifn;
+
+extern "C" {
+
+VKAPI_ATTR VkResult VKAPI_CALL vkEnumerateDeviceExtensionProperties(
+    VkPhysicalDevice physical_device, const char* layer_name, uint32_t* count,
+    VkExtensionProperties* properties) {
+  return taa_static_ifn.load(std::memory_order_acquire)
+      ->vkEnumerateDeviceExtensionProperties(physical_device, layer_name, count, properties);
+}
+
+VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceFeatures(VkPhysicalDevice physical_device,
+                                                       VkPhysicalDeviceFeatures* features) {
+  taa_static_ifn.load(std::memory_order_acquire)
+      ->vkGetPhysicalDeviceFeatures(physical_device, features);
+}
+
+VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceFeatures2(VkPhysicalDevice physical_device,
+                                                        VkPhysicalDeviceFeatures2* features) {
+  taa_static_ifn.load(std::memory_order_acquire)
+      ->vkGetPhysicalDeviceFeatures2(physical_device, features);
+}
+
+VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceMemoryProperties(
+    VkPhysicalDevice physical_device, VkPhysicalDeviceMemoryProperties* properties) {
+  taa_static_ifn.load(std::memory_order_acquire)
+      ->vkGetPhysicalDeviceMemoryProperties(physical_device, properties);
+}
+
+VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceProperties(VkPhysicalDevice physical_device,
+                                                         VkPhysicalDeviceProperties* properties) {
+  taa_static_ifn.load(std::memory_order_acquire)
+      ->vkGetPhysicalDeviceProperties(physical_device, properties);
+}
+
+VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceProperties2(
+    VkPhysicalDevice physical_device, VkPhysicalDeviceProperties2* properties) {
+  taa_static_ifn.load(std::memory_order_acquire)
+      ->vkGetPhysicalDeviceProperties2(physical_device, properties);
+}
+
+// Only its address is taken (a fallback for the vkGetDeviceProcAddr FidelityFX
+// is given), but the link needs it all the same.
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vkGetDeviceProcAddr(VkDevice device, const char* name) {
+  return taa_static_ifn.load(std::memory_order_acquire)->vkGetDeviceProcAddr(device, name);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL vkCreateBuffer(VkDevice device, const VkBufferCreateInfo* info,
+                                              const VkAllocationCallbacks* allocator,
+                                              VkBuffer* buffer) {
+  return taa_static_dfn.load(std::memory_order_acquire)
+      ->vkCreateBuffer(device, info, allocator, buffer);
+}
+
+}  // extern "C"
+
+#endif  // REX_FSR_STATIC
diff --git a/src/graphics/vulkan/texture_cache.cpp b/src/graphics/vulkan/texture_cache.cpp
index 376305a..1fd3bd2 100644
--- a/src/graphics/vulkan/texture_cache.cpp
+++ b/src/graphics/vulkan/texture_cache.cpp
@@ -662,6 +662,50 @@ void VulkanTextureCache::RequestTextures(uint32_t used_texture_mask) {
   }
 }
 
+VkImage VulkanTextureCache::GetActiveTextureImage(uint32_t fetch_constant_index,
+                                                  VkFormat& format_out, uint32_t& width_out,
+                                                  uint32_t& height_out) const {
+  const TextureBinding* binding = GetValidTextureBinding(fetch_constant_index);
+  if (!binding || !binding->texture) {
+    return VK_NULL_HANDLE;
+  }
+  const VulkanTexture* texture = static_cast<const VulkanTexture*>(binding->texture);
+  const TextureKey& key = texture->key();
+  format_out = texture->image_format();
+  width_out = key.GetWidth();
+  height_out = key.GetHeight();
+  if (key.scaled_resolve) {
+    width_out *= draw_resolution_scale_x();
+    height_out *= draw_resolution_scale_y();
+  }
+  return texture->image();
+}
+
+void VulkanTextureCache::TransitionActiveTexture(uint32_t fetch_constant_index,
+                                                 bool transfer_destination) {
+  const TextureBinding* binding = GetValidTextureBinding(fetch_constant_index);
+  if (!binding || !binding->texture) {
+    return;
+  }
+  VulkanTexture* texture = static_cast<VulkanTexture*>(binding->texture);
+  VulkanTexture::Usage new_usage = transfer_destination
+                                       ? VulkanTexture::Usage::kTransferDestination
+                                       : VulkanTexture::Usage::kGuestShaderSampled;
+  VulkanTexture::Usage old_usage = texture->SetUsage(new_usage);
+  if (old_usage == new_usage) {
+    return;
+  }
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(new_usage, dst_stage_mask, dst_access_mask, new_layout);
+  command_processor_.PushImageMemoryBarrier(texture->image(),
+                                            ui::vulkan::util::InitializeSubresourceRange(),
+                                            src_stage_mask, dst_stage_mask, src_access_mask,
+                                            dst_access_mask, old_layout, new_layout);
+}
+
 VkImageView VulkanTextureCache::GetActiveBindingOrNullImageView(uint32_t fetch_constant_index,
                                                                 xenos::FetchOpDimension dimension,
                                                                 bool is_signed) {
@@ -1244,6 +1288,7 @@ std::unique_ptr<TextureCache::Texture> VulkanTextureCache::CreateTexture(Texture
 
   std::unique_ptr<VulkanTexture> texture(new VulkanTexture(*this, key, image, allocation));
   texture->set_storage_copy_format(storage_copy_format);
+  texture->set_image_format(formats[0]);
   return texture;
 }
 
diff --git a/src/ui/vulkan/vulkan_device.cpp b/src/ui/vulkan/vulkan_device.cpp
index 3fdcf75..aa5f63c 100644
--- a/src/ui/vulkan/vulkan_device.cpp
+++ b/src/ui/vulkan/vulkan_device.cpp
@@ -22,6 +22,13 @@
 #include <rex/string.h>
 #include <rex/ui/vulkan/device.h>
 
+REXCVAR_DEFINE_BOOL(temporal_aa_device_features, !REX_PLATFORM_PS5, "GPU",
+                    "Temporal anti-aliasing: enable the Vulkan device features FSR uses (16-bit "
+                    "types and storage, extended storage image formats, subgroup size control) "
+                    "where the device has them. Read when the device is created; without them "
+                    "FSR can't run on Vulkan until the next start. Off by default on the PS5, "
+                    "whose host turns it on when the game starts with FSR chosen, so that the "
+                    "console's device stays as it was otherwise.");
 REXCVAR_DEFINE_BOOL(vulkan_require_fragment_stores_and_atomics, true, "UI/Vulkan",
                     "Deprecated and ignored for parity; fragmentStoresAndAtomics is always "
                     "required for Vulkan GPU emulation")
@@ -304,6 +311,11 @@ std::unique_ptr<VulkanDevice> VulkanDevice::CreateIfSupported(
 
   VkPhysicalDeviceFeatures2 supported_features_2 = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
 
+  // Vulkan 1.1 features: as a structure from 1.2 on (temporal AA's 16-bit
+  // storage).
+  VulkanFeatures<VkPhysicalDeviceVulkan11Features,
+                 VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES>
+      features_1_1;
   VulkanFeatures<VkPhysicalDeviceVulkan12Features,
                  VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES>
       features_1_2;
@@ -340,6 +352,10 @@ std::unique_ptr<VulkanDevice> VulkanDevice::CreateIfSupported(
 
   if (get_physical_device_properties2_supported) {
     if (properties.apiVersion >= VK_MAKE_API_VERSION(0, 1, 2, 0)) {
