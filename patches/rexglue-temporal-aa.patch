@@ -0,0 +1,88 @@
+// Temporal anti-aliasing (rexglue-temporal-aa.patch): motion vectors for FSR
+// from Midnight Club: Los Angeles's motion blur inputs, at its draw. Per host
+// pixel: the unjittered position of what the pixel shows (its centre minus the
+// frame's jitter) and its depth (1 near, 0 far) make the clip position (z =
+// 1 - depth), which the matrix of its stencil vehicle ID (0 for the world,
+// 1-23 for a car, x >> 2 of the stencil view) takes to where it was in the
+// previous frame, in guest pixels: the game's own reprojection, with the
+// camera's and each car's motion (CommandProcessor::TaaCheckDraw makes the
+// matrices). Output: previous minus current, host pixels (y down), R16G16
+// float, what FSR reads with a motion vector scale of 1.
+
+#include "../../ui/shaders/xesl.xesli"
+
+// The texture caches bind 2D textures as 2D arrays (layer 0 here).
+#if SHADING_LANGUAGE_GLSL_XE
+  #define XeTaaTexture texture2DArray
+  #define XeTaaFetch(texture_name, position) \
+      texelFetch(texture_name, int3_xe(position, 0), 0)
+  #define XeTaaVectorsFormat rg16f
+#else
+  #define XeTaaTexture Texture2DArray<float4_xe>
+  #define XeTaaFetch(texture_name, position) \
+      ((texture_name).Load(int4_xe(position, 0, 0)))
+  #define XeTaaVectorsFormat float2_xe
+#endif
+
+const_buffer_begin_xe(xe_taa_mv, set=0, binding=0, b0, space0)
+  // Per vehicle ID, 4 rows each: clip position to previous guest pixels.
+  float4_xe xe_taa_mv_previous[96];
+  // Host width, height; host pixels per guest pixel (x, y).
+  float4_xe xe_taa_mv_size;
+  // The jitter (host pixels, y down); which component of the stencil view is
+  // the stencil (its first byte, after the fetch constant's swizzle).
+  float4_xe xe_taa_mv_jitter;
+const_buffer_end_xe(xe_taa_mv)
+
+#define LOCAL_SIZE_X_XE 16
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+entry_bindings_begin_compute_xe
+  const_buffer_binding_xe(xe_taa_mv, buffer(0))
+  entry_binding_next_xe
+  texture_xe(XeTaaTexture, xe_taa_mv_depth, set=0, binding=1, t0, space0, texture(0))
+  entry_binding_next_xe
+  texture_xe(XeTaaTexture, xe_taa_mv_stencil, set=0, binding=2, t1, space0, texture(1))
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, XeTaaVectorsFormat, xe_taa_mv_dest, set=0, binding=3, u0,
+              space0, texture(2))
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+  uint2_xe pixel_index = in_global_thread_id_xe.xy;
+  float4_xe size = constant_xe(xe_taa_mv, xe_taa_mv_size);
+  dont_flatten_xe
+  if (any(greater_than_equal_xe(pixel_index, uint2_xe(size.xy)))) {
+    return;
+  }
+  float depth = XeTaaFetch(xe_taa_mv_depth, pixel_index).x;
+  float stencil =
+      XeTaaFetch(xe_taa_mv_stencil, pixel_index)[uint(constant_xe(xe_taa_mv, xe_taa_mv_jitter).z)];
+  uint id = uint(stencil * 255.0f + 0.5f) >> 2u;
+  if (id >= 24u) {
+    id = 0u;
+  }
+  float2_xe position = float2_xe(pixel_index) + 0.5f - constant_xe(xe_taa_mv, xe_taa_mv_jitter).xy;
+  float2_xe uv = position / size.xy;
+  float4_xe clip = float4_xe(uv.x * 2.0f - 1.0f, 1.0f - uv.y * 2.0f, 1.0f - depth, 1.0f);
+  uint row = id * 4u;
+  float4_xe previous = clip.x * constant_xe(xe_taa_mv, xe_taa_mv_previous)[row] +
+                       clip.y * constant_xe(xe_taa_mv, xe_taa_mv_previous)[row + 1u] +
+                       clip.z * constant_xe(xe_taa_mv, xe_taa_mv_previous)[row + 2u] +
+                       clip.w * constant_xe(xe_taa_mv, xe_taa_mv_previous)[row + 3u];
+  float2_xe motion = float2_xe(0.0f, 0.0f);
+  if (abs(previous.w) > 1.0e-20f) {
+    motion = previous.xy / previous.w * size.zw - position;
+    // Not NaN (by the bits: a compiler may fold x == x), and within the frame.
+    if ((float_bits_to_uint_xe(motion.x) & 0x7FFFFFFFu) > 0x7F800000u ||
+        (float_bits_to_uint_xe(motion.y) & 0x7FFFFFFFu) > 0x7F800000u) {
+      motion = float2_xe(0.0f, 0.0f);
+    }
+    motion = clamp(motion, -size.xy, size.xy);
+  }
+#if SHADING_LANGUAGE_GLSL_XE
+  imageStore(xe_taa_mv_dest, int2_xe(pixel_index), float4_xe(motion, 0.0f, 0.0f));
+#else
+  xe_taa_mv_dest[pixel_index] = motion;
+#endif
+entry_code_end_compute_xe
