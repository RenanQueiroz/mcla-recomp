+/**
+ * Temporal anti-aliasing (rexglue-temporal-aa.patch), Vulkan: see
+ * CommandProcessor::TaaFrame and VulkanCommandProcessor::TaaRun.
+ */
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <thread>
+
+#include <rex/graphics/vulkan/command_processor.h>
+#include <rex/logging.h>
+#include <rex/ui/vulkan/util.h>
+
+#include "../temporal_aa_fsr.h"
+
+#if defined(REX_HAS_FSR) && REX_HAS_FSR
+#include <ffx_api/vk/ffx_api_vk.h>
+#endif
+
+namespace rex::graphics::vulkan {
+
+namespace shaders {
+#include "../shaders/vulkan_spirv/taa_motion_vectors_mcla_cs.h"
+}  // namespace shaders
+
+struct VulkanCommandProcessor::TaaFsr {
+  enum State : uint32_t { kNone, kCreating, kReady, kFailed };
+  std::atomic<uint32_t> state{kNone};
+  std::thread thread;
+  // The size of the context and the images (the scene's, host pixels).
+  uint32_t width = 0;
+  uint32_t height = 0;
+  HdrImage vectors;  // R16G16_SFLOAT
+  HdrImage output;   // R16G16B16A16_SFLOAT
+#if defined(REX_HAS_FSR) && REX_HAS_FSR
+  FsrRuntime runtime;
+  ffxContext context = nullptr;
+#endif
+  // temporal_aa_debug 4: timestamps around the passes, a pair per slot, each
+  // slot read once its submission is done.
+  static constexpr uint32_t kTimerSlots = 8;
+  VkQueryPool timer_pool = VK_NULL_HANDLE;
+  PFN_vkCmdWriteTimestamp write_timestamp = nullptr;
+  PFN_vkGetQueryPoolResults get_results = nullptr;
+  uint64_t timer_submission[kTimerSlots] = {};  // 0: free
+  uint32_t timer_next = 0;
+  double timer_tick_ms = 0.0;
+  double timer_ms = 0.0;
+  uint32_t timer_count = 0;
+};
+
+namespace {
+
+#if defined(REX_HAS_FSR) && REX_HAS_FSR
+// FidelityFX's Vulkan backend asks for KHR aliases of functions that a Vulkan
+// 1.1+ driver may expose only under their core names.
+std::atomic<PFN_vkGetDeviceProcAddr> taa_get_device_proc_addr{nullptr};
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL TaaGetDeviceProcAddr(VkDevice device, const char* name) {
+  PFN_vkGetDeviceProcAddr get = taa_get_device_proc_addr.load(std::memory_order_relaxed);
+  if (!get || !name) {
+    return nullptr;
+  }
+  if (PFN_vkVoidFunction function = get(device, name)) {
+    return function;
+  }
+  static const char* const kAliases[][2] = {
+      {"vkGetBufferMemoryRequirements2KHR", "vkGetBufferMemoryRequirements2"},
+      {"vkGetImageMemoryRequirements2KHR", "vkGetImageMemoryRequirements2"},
+      {"vkBindBufferMemory2KHR", "vkBindBufferMemory2"},
+      {"vkBindImageMemory2KHR", "vkBindImageMemory2"},
+      {"vkCmdPipelineBarrier2KHR", "vkCmdPipelineBarrier2"},
+      {"vkGetDeviceBufferMemoryRequirementsKHR", "vkGetDeviceBufferMemoryRequirements"},
+      {"vkGetDeviceImageMemoryRequirementsKHR", "vkGetDeviceImageMemoryRequirements"},
+  };
+  for (const auto& alias : kAliases) {
+    if (!std::strcmp(name, alias[0])) {
+      return get(device, alias[1]);
+    }
+  }
+  return nullptr;
+}
+
+struct TaaFsrDispatch {
+  PfnFfxDispatch dispatch;
+  ffxContext* context;
+  ffxDispatchDescUpscale desc;
+};
+
+void TaaFsrDispatchCallback(VkCommandBuffer command_buffer, const void* data) {
+  TaaFsrDispatch dispatch;
+  std::memcpy(&dispatch, data, sizeof(dispatch));
+  dispatch.desc.commandList = command_buffer;
+  ffxReturnCode_t result = dispatch.dispatch(dispatch.context, &dispatch.desc.header);
+  static std::atomic<bool> failure_logged{false};
+  if (result != FFX_API_RETURN_OK && !failure_logged.exchange(true)) {
+    REXGPU_ERROR("Temporal AA: FSR's dispatch failed ({})", result);
+  }
+}
+
+FfxApiResource TaaFsrResource(VkImage image, VkFormat format, uint32_t width, uint32_t height,
+                              VkImageUsageFlags usage, uint32_t state) {
+  // As far as FidelityFX looks at it (not mutable: it would take that for
+  // sRGB).
+  VkImageCreateInfo info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+  info.imageType = VK_IMAGE_TYPE_2D;
+  info.format = format;
+  info.extent = {width, height, 1};
+  info.mipLevels = 1;
+  info.arrayLayers = 1;
+  info.samples = VK_SAMPLE_COUNT_1_BIT;
+  info.usage = usage;
+  return ffxApiGetResourceVK(image, ffxApiGetImageResourceDescriptionVK(image, info, 0), state);
+}
+#endif
