diff --git a/src/graphics/shaders/taa_debug_view.cs.xesl b/src/graphics/shaders/taa_debug_view.cs.xesl
new file mode 100644
index 0000000..df68c15
--- /dev/null
+++ b/src/graphics/shaders/taa_debug_view.cs.xesl
@@ -0,0 +1,72 @@
+// Temporal anti-aliasing (rexglue-temporal-aa.patch), development views
+// (temporal_aa_debug 5 and 6), written instead of FSR's output: the reactive
+// mask in red over the scene in grey, or the motion vectors as colour (the hue
+// their direction, the brightness their length, full at 16 host pixels).
+
+#include "../../ui/shaders/xesl.xesli"
+
+#if SHADING_LANGUAGE_GLSL_XE
+  #define XeTaaDebugFormat rgba16f
+  #define XeTaaFrac fract
+  #define XeTaaAtan2 atan
+  #define XeTaaArray texture2DArray
+  #define XeTaaArrayFetch(texture_name, position) \
+      texelFetch(texture_name, int3_xe(position, 0), 0)
+#else
+  #define XeTaaDebugFormat float4_xe
+  #define XeTaaFrac frac
+  #define XeTaaAtan2 atan2
+  #define XeTaaArray Texture2DArray<float4_xe>
+  #define XeTaaArrayFetch(texture_name, position) \
+      ((texture_name).Load(int4_xe(position, 0, 0)))
+#endif
+
+push_const_begin_xe(b0, space0)
+  // x, y: the size; z: 0 the reactive mask, 1 the motion vectors.
+  uint4_xe xe_taa_debug_size_mode;
+push_const_end_xe
+
+#define LOCAL_SIZE_X_XE 16
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+entry_bindings_begin_compute_xe
+  push_const_binding_xe(buffer(0))
+  entry_binding_next_xe
+  texture_xe(XeTaaArray, xe_taa_debug_scene, set=0, binding=0, t0, space0, texture(0))
+  entry_binding_next_xe
+  texture_xe(texture_2d_xe, xe_taa_debug_vectors, set=0, binding=1, t1, space0, texture(1))
+  entry_binding_next_xe
+  texture_xe(texture_2d_xe, xe_taa_debug_reactive, set=0, binding=2, t2, space0, texture(2))
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, XeTaaDebugFormat, xe_taa_debug_dest, set=0, binding=3, u0,
+              space0, texture(3))
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+  uint2_xe pixel_index = in_global_thread_id_xe.xy;
+  uint4_xe size_mode = push_const_xe(xe_taa_debug_size_mode);
+  dont_flatten_xe
+  if (any(greater_than_equal_xe(pixel_index, size_mode.xy))) {
+    return;
+  }
+  float3_xe scene = XeTaaArrayFetch(xe_taa_debug_scene, pixel_index).rgb;
+  float grey = 0.5f * saturate_xe(dot(scene, float3_xe(0.2126f, 0.7152f, 0.0722f)));
+  float3_xe color;
+  if (size_mode.z == 0u) {
+    float reactive = texel_fetch_2d_xe(xe_taa_debug_reactive, int2_xe(pixel_index), 0).r;
+    color = float3_xe(grey, grey, grey) * (1.0f - reactive) + float3_xe(reactive, 0.0f, 0.0f);
+  } else {
+    float2_xe motion = texel_fetch_2d_xe(xe_taa_debug_vectors, int2_xe(pixel_index), 0).rg;
+    float length_ = saturate_xe(length(motion) / 16.0f);
+    float angle = XeTaaAtan2(motion.y, motion.x) * 0.159154943f + 0.5f;
+    float3_xe hue = saturate_xe(abs(XeTaaFrac(float3_xe(angle, angle, angle) +
+                                         float3_xe(0.0f, 2.0f / 3.0f, 1.0f / 3.0f)) * 6.0f -
+                                    3.0f) - 1.0f);
+    color = float3_xe(grey, grey, grey) * (1.0f - length_) + hue * length_;
+  }
+#if SHADING_LANGUAGE_GLSL_XE
+  imageStore(xe_taa_debug_dest, int2_xe(pixel_index), float4_xe(color, 1.0f));
+#else
+  xe_taa_debug_dest[pixel_index] = float4_xe(color, 1.0f);
+#endif
+entry_code_end_compute_xe
diff --git a/src/graphics/shaders/taa_luma_snapshot.cs.xesl b/src/graphics/shaders/taa_luma_snapshot.cs.xesl
new file mode 100644
index 0000000..973d11e
--- /dev/null
+++ b/src/graphics/shaders/taa_luma_snapshot.cs.xesl
@@ -0,0 +1,48 @@
+// Temporal anti-aliasing (rexglue-temporal-aa.patch): the luminance of the
+// scene's render target (a 1x host render target, through its sampled view) at
+// a point in the frame, into an R16 float texture, for the reactive mask
+// (taa_reactive_mcla.cs.xesl). Values in the target's own units.
+
+#include "../../ui/shaders/xesl.xesli"
+
+#if SHADING_LANGUAGE_GLSL_XE
+  #define XeTaaLumaFormat r16f
+#else
+  #define XeTaaLumaFormat float
+#endif
+
+push_const_begin_xe(b0, space0)
+  // x, y: the size.
+  uint4_xe xe_taa_luma_size;
+push_const_end_xe
+
+#define LOCAL_SIZE_X_XE 16
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+entry_bindings_begin_compute_xe
+  push_const_binding_xe(buffer(0))
+  entry_binding_next_xe
+  texture_xe(texture_2d_xe, xe_taa_luma_source, set=0, binding=0, t0, space0, texture(0))
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, XeTaaLumaFormat, xe_taa_luma_dest, set=1, binding=0, u0, space0,
+              texture(1))
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+  uint2_xe pixel_index = in_global_thread_id_xe.xy;
+  dont_flatten_xe
+  if (any(greater_than_equal_xe(pixel_index, push_const_xe(xe_taa_luma_size).xy))) {
+    return;
+  }
+  float3_xe color = texel_fetch_2d_xe(xe_taa_luma_source, int2_xe(pixel_index), 0).rgb;
+  float luma = max(dot(color, float3_xe(0.2126f, 0.7152f, 0.0722f)), 0.0f);
+  // Not NaN or infinite (by the bits).
+  if ((float_bits_to_uint_xe(luma) & 0x7FFFFFFFu) >= 0x7F800000u) {
+    luma = 0.0f;
+  }
+#if SHADING_LANGUAGE_GLSL_XE
+  imageStore(xe_taa_luma_dest, int2_xe(pixel_index), float4_xe(min(luma, 65504.0f), 0.0f, 0.0f, 0.0f));
+#else
+  xe_taa_luma_dest[pixel_index] = min(luma, 65504.0f);
+#endif
+entry_code_end_compute_xe
diff --git a/src/graphics/shaders/taa_motion_vectors_mcla.cs.xesl b/src/graphics/shaders/taa_motion_vectors_mcla.cs.xesl
new file mode 100644
index 0000000..d12faaf
--- /dev/null
+++ b/src/graphics/shaders/taa_motion_vectors_mcla.cs.xesl
@@ -0,0 +1,88 @@
+// Temporal anti-aliasing (rexglue-temporal-aa.patch): motion vectors for FSR
+// from Midnight Club: Los Angeles's motion blur inputs, at its draw. Per host
+// pixel: the unjittered position of what the pixel shows (its centre minus the
+// frame's jitter) and its depth (1 near, 0 far) make the clip position (z =
+// 1 - depth), which the matrix of its stencil vehicle ID (0 for the world,
+// 1-23 for a car, x >> 2 of the stencil view) takes to where it was in the
+// previous frame, in guest pixels: the game's own reprojection, with the
+// camera's and each car's motion (CommandProcessor::TaaCheckDraw makes the
+// matrices). Output: previous minus current, host pixels (y down), R16G16
+// float, what FSR reads with a motion vector scale of 1.
+
+#include "../../ui/shaders/xesl.xesli"
+
+// The texture caches bind 2D textures as 2D arrays (layer 0 here).
+#if SHADING_LANGUAGE_GLSL_XE
+  #define XeTaaTexture texture2DArray
+  #define XeTaaFetch(texture_name, position) \
+      texelFetch(texture_name, int3_xe(position, 0), 0)
+  #define XeTaaVectorsFormat rg16f
+#else
+  #define XeTaaTexture Texture2DArray<float4_xe>
+  #define XeTaaFetch(texture_name, position) \
+      ((texture_name).Load(int4_xe(position, 0, 0)))
+  #define XeTaaVectorsFormat float2_xe
+#endif
+
+const_buffer_begin_xe(xe_taa_mv, set=0, binding=0, b0, space0)
+  // Per vehicle ID, 4 rows each: clip position to previous guest pixels.
+  float4_xe xe_taa_mv_previous[96];
+  // Host width, height; host pixels per guest pixel (x, y).
+  float4_xe xe_taa_mv_size;
+  // The jitter (host pixels, y down); which component of the stencil view is
+  // the stencil (its first byte, after the fetch constant's swizzle).
+  float4_xe xe_taa_mv_jitter;
+const_buffer_end_xe(xe_taa_mv)
+
+#define LOCAL_SIZE_X_XE 16
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+entry_bindings_begin_compute_xe
+  const_buffer_binding_xe(xe_taa_mv, buffer(0))
+  entry_binding_next_xe
+  texture_xe(XeTaaTexture, xe_taa_mv_depth, set=0, binding=1, t0, space0, texture(0))
+  entry_binding_next_xe
+  texture_xe(XeTaaTexture, xe_taa_mv_stencil, set=0, binding=2, t1, space0, texture(1))
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, XeTaaVectorsFormat, xe_taa_mv_dest, set=0, binding=3, u0,
+              space0, texture(2))
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+  uint2_xe pixel_index = in_global_thread_id_xe.xy;
+  float4_xe size = constant_xe(xe_taa_mv, xe_taa_mv_size);
+  dont_flatten_xe
+  if (any(greater_than_equal_xe(pixel_index, uint2_xe(size.xy)))) {
+    return;
+  }
+  float depth = XeTaaFetch(xe_taa_mv_depth, pixel_index).x;
+  float stencil =
+      XeTaaFetch(xe_taa_mv_stencil, pixel_index)[uint(constant_xe(xe_taa_mv, xe_taa_mv_jitter).z)];
+  uint id = uint(stencil * 255.0f + 0.5f) >> 2u;
+  if (id >= 24u) {
+    id = 0u;
+  }
+  float2_xe position = float2_xe(pixel_index) + 0.5f - constant_xe(xe_taa_mv, xe_taa_mv_jitter).xy;
+  float2_xe uv = position / size.xy;
+  float4_xe clip = float4_xe(uv.x * 2.0f - 1.0f, 1.0f - uv.y * 2.0f, 1.0f - depth, 1.0f);
+  uint row = id * 4u;
+  float4_xe previous = clip.x * constant_xe(xe_taa_mv, xe_taa_mv_previous)[row] +
+                       clip.y * constant_xe(xe_taa_mv, xe_taa_mv_previous)[row + 1u] +
+                       clip.z * constant_xe(xe_taa_mv, xe_taa_mv_previous)[row + 2u] +
+                       clip.w * constant_xe(xe_taa_mv, xe_taa_mv_previous)[row + 3u];
+  float2_xe motion = float2_xe(0.0f, 0.0f);
+  if (abs(previous.w) > 1.0e-20f) {
+    motion = previous.xy / previous.w * size.zw - position;
+    // Not NaN (by the bits: a compiler may fold x == x), and within the frame.
+    if ((float_bits_to_uint_xe(motion.x) & 0x7FFFFFFFu) > 0x7F800000u ||
+        (float_bits_to_uint_xe(motion.y) & 0x7FFFFFFFu) > 0x7F800000u) {
+      motion = float2_xe(0.0f, 0.0f);
+    }
+    motion = clamp(motion, -size.xy, size.xy);
+  }
+#if SHADING_LANGUAGE_GLSL_XE
+  imageStore(xe_taa_mv_dest, int2_xe(pixel_index), float4_xe(motion, 0.0f, 0.0f));
+#else
+  xe_taa_mv_dest[pixel_index] = motion;
+#endif
+entry_code_end_compute_xe
diff --git a/src/graphics/shaders/taa_reactive_mcla.cs.xesl b/src/graphics/shaders/taa_reactive_mcla.cs.xesl
new file mode 100644
index 0000000..a14aac3
--- /dev/null
+++ b/src/graphics/shaders/taa_reactive_mcla.cs.xesl
@@ -0,0 +1,69 @@
+// Temporal anti-aliasing (rexglue-temporal-aa.patch): FSR's reactive mask for
+// Midnight Club: Los Angeles. What the scene's translucent effects changed
+// between the start of its translucent phase (0x100000) and its full-screen
+// composites (0x04000000), relative to the brighter of the two luminances:
+// rain, smoke, soft particles and light volumes, which have no motion vectors
+// of their own, so that FSR leans on the current frame there. Cars (a vehicle
+// ID in the stencil: their glass and decals, which are drawn in that window
+// but move with their vectors) are left out.
+
+#include "../../ui/shaders/xesl.xesli"
+
+#if SHADING_LANGUAGE_GLSL_XE
+  #define XeTaaArray texture2DArray
+  #define XeTaaArrayFetch(texture_name, position) \
+      texelFetch(texture_name, int3_xe(position, 0), 0)
+  #define XeTaaReactiveFormat r8
+#else
+  #define XeTaaArray Texture2DArray<float4_xe>
+  #define XeTaaArrayFetch(texture_name, position) \
+      ((texture_name).Load(int4_xe(position, 0, 0)))
+  #define XeTaaReactiveFormat unorm float
+#endif
+
+push_const_begin_xe(b0, space0)
+  // x, y: the size; z: the stencil view's component with the stencil.
+  uint4_xe xe_taa_reactive_size;
+  // x: the scale, y: the change below which nothing is reactive, z: the most.
+  float4_xe xe_taa_reactive_curve;
+push_const_end_xe
+
+#define LOCAL_SIZE_X_XE 16
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+entry_bindings_begin_compute_xe
+  push_const_binding_xe(buffer(0))
+  entry_binding_next_xe
+  texture_xe(texture_2d_xe, xe_taa_reactive_opaque, set=0, binding=0, t0, space0, texture(0))
+  entry_binding_next_xe
+  texture_xe(texture_2d_xe, xe_taa_reactive_composite, set=0, binding=1, t1, space0,
+             texture(1))
+  entry_binding_next_xe
+  texture_xe(XeTaaArray, xe_taa_reactive_stencil, set=0, binding=2, t2, space0, texture(2))
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, XeTaaReactiveFormat, xe_taa_reactive_dest, set=0, binding=3, u0,
+              space0, texture(3))
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+  uint2_xe pixel_index = in_global_thread_id_xe.xy;
+  uint4_xe size = push_const_xe(xe_taa_reactive_size);
+  dont_flatten_xe
+  if (any(greater_than_equal_xe(pixel_index, size.xy))) {
+    return;
+  }
+  float4_xe curve = push_const_xe(xe_taa_reactive_curve);
+  float opaque = texel_fetch_2d_xe(xe_taa_reactive_opaque, int2_xe(pixel_index), 0).r;
+  float composite = texel_fetch_2d_xe(xe_taa_reactive_composite, int2_xe(pixel_index), 0).r;
+  float change = abs(composite - opaque) / max(max(composite, opaque), 1.0e-4f);
+  float reactive = min(saturate_xe((change - curve.y) * curve.x), curve.z);
+  float stencil = XeTaaArrayFetch(xe_taa_reactive_stencil, pixel_index)[size.z];
+  if ((uint(stencil * 255.0f + 0.5f) >> 2u) != 0u) {
+    reactive = 0.0f;
+  }
+#if SHADING_LANGUAGE_GLSL_XE
+  imageStore(xe_taa_reactive_dest, int2_xe(pixel_index), float4_xe(reactive, 0.0f, 0.0f, 0.0f));
+#else
+  xe_taa_reactive_dest[pixel_index] = reactive;
+#endif
+entry_code_end_compute_xe
