diff --git a/cmake/fidelityfx/CMakeLists.txt b/cmake/fidelityfx/CMakeLists.txt
new file mode 100644
index 0000000..365a133
--- /dev/null
+++ b/cmake/fidelityfx/CMakeLists.txt
@@ -0,0 +1,140 @@
+# Builds one ffx-api backend (FFX_API_BACKEND = DX12_X64 or VK_X64) of the FidelityFX
+# SDK at FFX_ROOT as a shared library, for cmake/rexglue_fsr.cmake (an ExternalProject,
+# so the two backends, which can't share a configure, each get their own).
+#   REXGLUE_FSR_SHADERS_DIR     the prebuilt shaders (thirdparty/fidelityfx-shaders-vk)
+#                               instead of FidelityFX_SC (Vulkan; prebuilt_shaders*.cmake)
+#   REXGLUE_FSR_SHADERS_HASH    their hash (only to make a new set rebuild the runtime)
+#   REXGLUE_FSR_VULKAN_HEADERS  Vulkan headers to build against instead of
+#                               find_package(Vulkan)'s, and REXGLUE_FSR_VULKAN_LIBRARY
+#                               the library to link (none for static libraries)
+#   REXGLUE_FSR_STATIC          static libraries instead, checked and copied to
+#                               REXGLUE_FSR_ARCHIVE_DIR by the target rexglue_fsr_static
+#                               (the PS5)
+cmake_minimum_required(VERSION 3.23)
+project(rexglue_fidelityfx C CXX)
+if(NOT FFX_ROOT OR NOT FFX_API_BACKEND)
+    message(FATAL_ERROR "FFX_ROOT and FFX_API_BACKEND are required")
+endif()
+# Upscaling only: no frame generation providers.
+set(FFX_API_ENABLE_FRAMEGEN_PROVIDER OFF CACHE BOOL "" FORCE)
+if(REXGLUE_FSR_SHADERS_DIR)
+    # FidelityFX_SC isn't run: right after the SDK's project() for the Vulkan
+    # backend (after it has picked its compiler), the hook puts
+    # prebuilt_shaders.cmake in its place, which copies the prebuilt headers to
+    # where the compiler's output would go.
+    set(FFX_API_AUTO_COMPILE_SHADERS OFF CACHE BOOL "" FORCE)
+    set(REXGLUE_FSR_WRAPPER_DIR "${CMAKE_CURRENT_LIST_DIR}")
+    set(CMAKE_PROJECT_FidelityFX-SDK_VK_x64_INCLUDE "${CMAKE_CURRENT_LIST_DIR}/prebuilt_shaders_hook.cmake")
+else()
+    set(FFX_API_AUTO_COMPILE_SHADERS ON CACHE BOOL "" FORCE)
+endif()
+if(REXGLUE_FSR_VULKAN_HEADERS)
+    # FidelityFX's find_package(Vulkan REQUIRED) gets these headers.
+    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/vulkan-headers-only")
+endif()
+if(REXGLUE_FSR_STATIC)
+    # Here, so that the static library below sees Vulkan's targets too (imported
+    # targets belong to the folder that finds them).
+    find_package(Vulkan REQUIRED)
+endif()
+add_subdirectory("${FFX_ROOT}/ffx-api" "${CMAKE_BINARY_DIR}/ffx-api")
+if(REXGLUE_FSR_SHADERS_DIR)
+    get_property(_hook_ran GLOBAL PROPERTY REXGLUE_FSR_PREBUILT_HOOK_RAN)
+    if(NOT _hook_ran)
+        message(FATAL_ERROR "FSR: FidelityFX's Vulkan project isn't FidelityFX-SDK_VK_x64 any more, so "
+                            "the prebuilt shaders' hook didn't run (prebuilt_shaders_hook.cmake)")
+    endif()
+endif()
+# FidelityFX's toolchain.cmake sets a Visual Studio platform, which Ninja rejects.
+unset(CMAKE_GENERATOR_PLATFORM CACHE)
+string(TOLOWER "${FFX_API_BACKEND}" _backend)
+string(REGEX REPLACE "_x64$" "" _backend "${_backend}")
+set(_target amd_fidelityfx_${_backend})
+# Outputs into this build tree (ffx-api's CMake would put them next to this file).
+foreach(_config "" _DEBUG _RELEASE _RELWITHDEBINFO)
+    set_target_properties(${_target} PROPERTIES
+        RUNTIME_OUTPUT_DIRECTORY${_config} "${CMAKE_BINARY_DIR}/bin"
+        LIBRARY_OUTPUT_DIRECTORY${_config} "${CMAKE_BINARY_DIR}/bin"
+        ARCHIVE_OUTPUT_DIRECTORY${_config} "${CMAKE_BINARY_DIR}/lib")
+endforeach()
+# The DLL's version resource is UTF-16, which Clang's resource compiler rejects;
+# the library doesn't need it.
+set_source_files_properties("${FFX_ROOT}/ffx-api/src/resource/ffx_api_dll.rc"
+    TARGET_DIRECTORY ${_target} PROPERTIES HEADER_FILE_ONLY ON)
+
+if(REXGLUE_FSR_STATIC)
+    # ffx-api's own library is SHARED; the same sources and settings as a static
+    # library, under the same name, next to the static libraries it uses: its
+    # target's properties, its folder's compile definitions and options (where
+    # ffx-api selects its backend: FFX_BACKEND_VK), and its link libraries' usage
+    # requirements (the backend's, the components', the Vulkan headers).
+    get_target_property(_sources ${_target} SOURCES)
+    get_target_property(_source_dir ${_target} SOURCE_DIR)
+    set(_static_sources)
+    foreach(_source IN LISTS _sources)
+        if(_source MATCHES "\\.rc$")
+            continue()
+        elseif(_source MATCHES "^\\$<" OR IS_ABSOLUTE "${_source}")
+            list(APPEND _static_sources "${_source}")
+        else()
+            list(APPEND _static_sources "${_source_dir}/${_source}")
+        endif()
+    endforeach()
+    add_library(${_target}_static STATIC ${_static_sources})
+    foreach(_property INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FEATURES
+                      CXX_STANDARD C_STANDARD)
+        get_target_property(_value ${_target} ${_property})
+        if(_value)
+            set_property(TARGET ${_target}_static PROPERTY ${_property} "${_value}")
+        endif()
+    endforeach()
+    get_directory_property(_definitions DIRECTORY "${_source_dir}" COMPILE_DEFINITIONS)
+    target_compile_definitions(${_target}_static PRIVATE ${_definitions})
+    get_target_property(_links ${_target} LINK_LIBRARIES)
+    target_link_libraries(${_target}_static PRIVATE ${_links})
+    # Every static library it needs, through their own links.
+    set(_archives)
+    set(_pending ${_links})
+    set(_seen)
+    while(_pending)
+        list(POP_FRONT _pending _link)
+        if(NOT TARGET ${_link} OR _link IN_LIST _seen)
+            continue()
+        endif()
+        list(APPEND _seen ${_link})
+        get_target_property(_type ${_link} TYPE)
+        if(_type STREQUAL "STATIC_LIBRARY")
+            list(APPEND _archives "$<TARGET_FILE:${_link}>")
+            get_target_property(_more ${_link} LINK_LIBRARIES)
+            if(_more)
+                list(APPEND _pending ${_more})
+            endif()
+        endif()
+    endwhile()
+    # Its own folder: on Windows the shared library's import library has the name.
+    set_target_properties(${_target}_static PROPERTIES OUTPUT_NAME ${_target}
+        ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/static")
+    set_target_properties(${_target} PROPERTIES EXCLUDE_FROM_ALL ON)
+    # The archive must have the backend in it (an ffx-api built without its
+    # backend's definition still links, but can't create anything).
+    if(CMAKE_NM)
+        set(_nm "${CMAKE_NM}")
+    else()
+        get_filename_component(_compiler_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
+        find_program(_nm NAMES llvm-nm nm HINTS "${_compiler_dir}" REQUIRED)
+    endif()
+    string(TOUPPER "${_backend}" _backend_upper)
+    if(_backend_upper STREQUAL "VK")
+        set(_interface ffxGetInterfaceVK)
+    else()
+        set(_interface ffxGetInterfaceDX12)
+    endif()
+    add_custom_target(rexglue_fsr_static
+        COMMAND "${CMAKE_COMMAND}" "-DNM=${_nm}" "-DARCHIVE=$<TARGET_FILE:${_target}_static>"
+                "-DSYMBOL=${_interface}" -P "${CMAKE_CURRENT_LIST_DIR}/check_static.cmake"
+        COMMAND "${CMAKE_COMMAND}" -E make_directory "${REXGLUE_FSR_ARCHIVE_DIR}"
+        COMMAND "${CMAKE_COMMAND}" -E copy "$<TARGET_FILE:${_target}_static>" ${_archives}
+                "${REXGLUE_FSR_ARCHIVE_DIR}"
+        DEPENDS ${_target}_static
+        VERBATIM)
+endif()
diff --git a/cmake/fidelityfx/check_static.cmake b/cmake/fidelityfx/check_static.cmake
new file mode 100644
index 0000000..21826f2
--- /dev/null
+++ b/cmake/fidelityfx/check_static.cmake
@@ -0,0 +1,14 @@
+# The static ffx-api (cmake/fidelityfx/CMakeLists.txt, REXGLUE_FSR_STATIC) must
+# refer to its backend's interface: built without the backend's definition it
+# still links, but creating FSR always fails.
+#   cmake -DNM=<llvm-nm> -DARCHIVE=<libamd_fidelityfx_vk.a> -DSYMBOL=ffxGetInterfaceVK -P check_static.cmake
+execute_process(COMMAND "${NM}" -u "${ARCHIVE}" RESULT_VARIABLE result OUTPUT_VARIABLE undefined
+                ERROR_VARIABLE error)
+if(NOT result EQUAL 0)
+    message(FATAL_ERROR "FSR: ${NM} -u ${ARCHIVE} failed: ${error}")
+endif()
+string(FIND "${undefined}" "${SYMBOL}" found)
+if(found EQUAL -1)
+    message(FATAL_ERROR "FSR: ${ARCHIVE} doesn't refer to ${SYMBOL}: ffx-api was built without its backend")
+endif()
+message(STATUS "FSR: ${ARCHIVE} refers to ${SYMBOL}")
diff --git a/cmake/fidelityfx/prebuilt_shaders.cmake b/cmake/fidelityfx/prebuilt_shaders.cmake
new file mode 100644
index 0000000..3d97f52
--- /dev/null
+++ b/cmake/fidelityfx/prebuilt_shaders.cmake
@@ -0,0 +1,61 @@
+# Stands in for FidelityFX_SC.exe (prebuilt_shaders_hook.cmake), called as it
+# would be:
+#   cmake -DREXGLUE_FSR_SHADERS_DIR=<dir> -P prebuilt_shaders.cmake -- <FidelityFX_SC's arguments>
+# Of those it reads -name=<name> and -output=<folder>, and the shader (the last
+# argument); it copies <name>_permutations.h and the blob headers it includes
+# from the prebuilt set into the folder, and writes the dependency file
+# FidelityFX's build expects. A permutation set that isn't prebuilt stops the
+# build (the runtime is then left out, soft_step.cmake).
+set(args)
+set(after_separator FALSE)
+math(EXPR last "${CMAKE_ARGC} - 1")
+foreach(i RANGE 1 ${last})
+    if(after_separator)
+        list(APPEND args "${CMAKE_ARGV${i}}")
+    elseif(CMAKE_ARGV${i} STREQUAL "--")
+        set(after_separator TRUE)
+    endif()
+endforeach()
+set(name "")
+set(output "")
+foreach(arg IN LISTS args)
+    if(arg MATCHES "^-name=(.+)$")
+        set(name "${CMAKE_MATCH_1}")
+    elseif(arg MATCHES "^-output=(.+)$")
+        set(output "${CMAKE_MATCH_1}")
+    endif()
+endforeach()
+list(GET args -1 shader)
+if(NOT name OR NOT output)
+    message(FATAL_ERROR "FSR prebuilt shaders: no -name= or -output= in: ${args}")
+endif()
+set(table "${REXGLUE_FSR_SHADERS_DIR}/${name}_permutations.h")
+if(NOT EXISTS "${table}")
+    message(FATAL_ERROR "FSR prebuilt shaders: ${name} isn't in ${REXGLUE_FSR_SHADERS_DIR} "
+                        "(launcher/dev/fsr/fsr_vk_shaders.py makes the set)")
+endif()
+file(MAKE_DIRECTORY "${output}")
+file(STRINGS "${table}" includes REGEX "^#include \"[^\"]+\"")
+set(files "${name}_permutations.h")
+foreach(line IN LISTS includes)
+    string(REGEX REPLACE "^#include \"([^\"]+)\".*$" "\\1" blob "${line}")
+    list(APPEND files "${blob}")
+endforeach()
+foreach(file IN LISTS files)
+    file(COPY_FILE "${REXGLUE_FSR_SHADERS_DIR}/${file}" "${output}/${file}" ONLY_IF_DIFFERENT)
+endforeach()
+# FidelityFX_SC's output is newer than its input; so is this.
+file(TOUCH "${output}/${name}_permutations.h")
+# Make's syntax, spaces in paths escaped: the shader and the prebuilt files, so
+# that a new set is copied again.
+set(dependencies "${shader}")
+foreach(file IN LISTS files)
+    list(APPEND dependencies "${REXGLUE_FSR_SHADERS_DIR}/${file}")
+endforeach()
+string(REPLACE " " "\\ " depfile "${output}/${name}_permutations.h")
+string(APPEND depfile ":")
+foreach(dependency IN LISTS dependencies)
+    string(REPLACE " " "\\ " dependency "${dependency}")
+    string(APPEND depfile " ${dependency}")
+endforeach()
+file(WRITE "${output}/${name}_permutations.h.d" "${depfile}\n")
diff --git a/cmake/fidelityfx/prebuilt_shaders_hook.cmake b/cmake/fidelityfx/prebuilt_shaders_hook.cmake
new file mode 100644
index 0000000..07e0158
--- /dev/null
+++ b/cmake/fidelityfx/prebuilt_shaders_hook.cmake
@@ -0,0 +1,10 @@
+# Included by FidelityFX's sdk/CMakeLists.txt right after its project() for the
+# Vulkan backend (CMAKE_PROJECT_<name>_INCLUDE, set by cmake/fidelityfx/CMakeLists.txt
+# when REXGLUE_FSR_SHADERS_DIR is given), after it has chosen its shader compiler:
+# instead of FidelityFX_SC.exe (a Windows program), prebuilt_shaders.cmake puts
+# the prebuilt headers where the compiler's output would go.
+set(FFX_SC_EXECUTABLE "${CMAKE_COMMAND}" "-DREXGLUE_FSR_SHADERS_DIR=${REXGLUE_FSR_SHADERS_DIR}"
+    -P "${REXGLUE_FSR_WRAPPER_DIR}/prebuilt_shaders.cmake" --)
+message(STATUS "FSR: FidelityFX's Vulkan shaders come from ${REXGLUE_FSR_SHADERS_DIR}, not its shader compiler (no Wine needed)")
+# The wrapper checks that this ran (a renamed project would skip it silently).
+set_property(GLOBAL PROPERTY REXGLUE_FSR_PREBUILT_HOOK_RAN TRUE)
diff --git a/cmake/fidelityfx/soft_step.cmake b/cmake/fidelityfx/soft_step.cmake
new file mode 100644
index 0000000..b9f78c9
--- /dev/null
+++ b/cmake/fidelityfx/soft_step.cmake
@@ -0,0 +1,26 @@
+# A configure or build step of a FidelityFX runtime (cmake/rexglue_fsr.cmake)
+# that may fail without failing the SDK's build:
+#   cmake -DSTEP_SKIP=<marker> [-DSTEP_FIRST=1] -P soft_step.cmake -- <command>...
+# On failure the marker is written, a warning says the runtime is left out, and
+# the step succeeds; the steps after it are skipped while the marker exists.
+# The first step (the configure) starts afresh.
+set(command)
+set(after_separator FALSE)
+math(EXPR last "${CMAKE_ARGC} - 1")
+foreach(i RANGE 1 ${last})
+    if(after_separator)
+        list(APPEND command "${CMAKE_ARGV${i}}")
+    elseif(CMAKE_ARGV${i} STREQUAL "--")
+        set(after_separator TRUE)
+    endif()
+endforeach()
+if(STEP_FIRST)
+    file(REMOVE "${STEP_SKIP}")
+elseif(EXISTS "${STEP_SKIP}")
+    return()
+endif()
+execute_process(COMMAND ${command} RESULT_VARIABLE result)
+if(NOT result EQUAL 0)
+    file(WRITE "${STEP_SKIP}" "${result}\n")
+    message(WARNING "FSR: a FidelityFX runtime failed to build (${result}); it is left out, and FSR is unavailable for its graphics API")
+endif()
diff --git a/cmake/fidelityfx/vulkan-headers-only/FindVulkan.cmake b/cmake/fidelityfx/vulkan-headers-only/FindVulkan.cmake
new file mode 100644
index 0000000..2a628d3
--- /dev/null
+++ b/cmake/fidelityfx/vulkan-headers-only/FindVulkan.cmake
@@ -0,0 +1,27 @@
+# FidelityFX's find_package(Vulkan) when the SDK gives it Vulkan headers
+# (cmake/fidelityfx/CMakeLists.txt, REXGLUE_FSR_VULKAN_HEADERS): the SDK's own,
+# and REXGLUE_FSR_VULKAN_LIBRARY to link if set (Linux: the system's loader;
+# none for the PS5's static libraries, which link nothing).
+set(Vulkan_INCLUDE_DIR "${REXGLUE_FSR_VULKAN_HEADERS}")
+set(Vulkan_INCLUDE_DIRS "${REXGLUE_FSR_VULKAN_HEADERS}")
+# The headers' version, for FidelityFX's minimum (CheckVulkanSDKVersion).
+file(STRINGS "${REXGLUE_FSR_VULKAN_HEADERS}/vulkan/vulkan_core.h" _vulkan_version_lines
+     REGEX "^#define VK_HEADER_VERSION(_COMPLETE)? ")
+string(REGEX MATCH "VK_HEADER_VERSION ([0-9]+)" _ "${_vulkan_version_lines}")
+set(_vulkan_patch "${CMAKE_MATCH_1}")
+string(REGEX MATCH "VK_MAKE_API_VERSION[(]0, ([0-9]+), ([0-9]+)," _ "${_vulkan_version_lines}")
+set(Vulkan_VERSION "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}.${_vulkan_patch}")
+set(Vulkan_FOUND TRUE)
+if(NOT TARGET Vulkan::Headers)
+    add_library(Vulkan::Headers INTERFACE IMPORTED)
+    set_target_properties(Vulkan::Headers PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${REXGLUE_FSR_VULKAN_HEADERS}")
+endif()
+if(NOT TARGET Vulkan::Vulkan)
+    add_library(Vulkan::Vulkan INTERFACE IMPORTED)
+    set_target_properties(Vulkan::Vulkan PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${REXGLUE_FSR_VULKAN_HEADERS}")
+    if(REXGLUE_FSR_VULKAN_LIBRARY)
+        set(Vulkan_LIBRARY "${REXGLUE_FSR_VULKAN_LIBRARY}")
+        set(Vulkan_LIBRARIES "${REXGLUE_FSR_VULKAN_LIBRARY}")
+        set_target_properties(Vulkan::Vulkan PROPERTIES INTERFACE_LINK_LIBRARIES "${REXGLUE_FSR_VULKAN_LIBRARY}")
+    endif()
+endif()
diff --git a/cmake/rexglue_fsr.cmake b/cmake/rexglue_fsr.cmake
new file mode 100644
index 0000000..a8ee628
--- /dev/null
+++ b/cmake/rexglue_fsr.cmake
@@ -0,0 +1,334 @@
+# rexglue_fsr.cmake - AMD FSR 3.1 for temporal anti-aliasing (rexglue-temporal-aa.patch)
+#
+# Builds ffx-api of the AMD FidelityFX SDK 1.1.4 (MIT) from source, as
+# amd_fidelityfx_dx12 and amd_fidelityfx_vk shared libraries that the GPU plugin
+# loads at run time from the executable's folder. The plugin compiles against
+# the headers in thirdparty/fidelityfx-api; this file only builds the runtime.
+#
+# The source is fetched at a pinned commit of the ReXGlue fork (AMD's v1.1.4,
+# c6efa6b, plus portability fixes) into the build tree, and checked against
+# pinned git tree hashes of the two directories that are built, so what is
+# compiled is exactly what was reviewed. REXGLUE_FSR_SOURCE_DIR may point at an
+# existing checkout of that commit instead (checked the same way).
+#
+# FSR is optional: if the source can't be fetched or verified (no network, no
+# Git), or a runtime fails to configure or build, the SDK builds without it and
+# the GPU plugin reports FSR as unavailable. A fetch goes to a temporary folder
+# that is renamed only once verified, so a failed or partial fetch never stays
+# behind; a checkout that no longer verifies is fetched again once.
+#
+# FidelityFX compiles its shaders at build time with its own FidelityFX_SC tool
+# (from the same commit), a Windows program. Elsewhere the Vulkan library is
+# built from the prebuilt shaders of the permutations rexglue uses
+# (REXGLUE_FSR_PREBUILT_SHADERS). On Windows the Vulkan library needs the Vulkan
+# SDK (without it only the D3D12 one is built); elsewhere it is built against
+# the SDK's own Vulkan headers, and on Linux links the system's Vulkan loader.
+# On the PS5 it is static libraries (no modules).
+
+if(NOT REXGLUE_ENABLE_FSR)
+    return()
+endif()
+
+# What src/graphics/CMakeLists.txt and the summary read.
+set(REXGLUE_FSR_STATIC OFF)
+if(PS5 OR PROSPERO)
+    set(REXGLUE_FSR_STATIC ON)
+endif()
+set(REXGLUE_FSR_VK_PREBUILT OFF)
+set(REXGLUE_FSR_STATUS "ON, but FidelityFX's source is unavailable (see the warning above): built without it")
+
+set(REXGLUE_FSR_REPOSITORY "https://github.com/rexglue/FidelityFX-SDK.git" CACHE STRING
+    "Where the FidelityFX SDK is fetched from (the pinned commit must exist there)")
+set(REXGLUE_FSR_SOURCE_DIR "" CACHE PATH
+    "An existing checkout of the pinned FidelityFX SDK commit (fetched into the build tree otherwise)")
+set(_rexglue_fsr_commit "eee08db1688ac3d1275a70b728f4a8ba22914213")
+set(_rexglue_fsr_tree_ffx_api "cdcd115d3ea4f855251049dc3d5517b3ae448a46")
+set(_rexglue_fsr_tree_sdk "47c22f65b682061792531316670251a5c8ae81e7")
+
+find_package(Git QUIET)
+if(NOT GIT_FOUND)
+    message(WARNING "FSR: Git was not found; building without FSR")
+    return()
+endif()
+
+# Runs git in `dir`; `ok_var` is set to whether it succeeded, the output (or the
+# error) goes to _rexglue_fsr_git_output.
+function(_rexglue_fsr_git ok_var dir)
+    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" ${ARGN}
+                    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error
+                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_STRIP_TRAILING_WHITESPACE)
+    if(result EQUAL 0)
+        set(${ok_var} TRUE PARENT_SCOPE)
+        set(_rexglue_fsr_git_output "${output}" PARENT_SCOPE)
+    else()
+        set(${ok_var} FALSE PARENT_SCOPE)
+        set(_rexglue_fsr_git_output "git ${ARGN}: ${error}" PARENT_SCOPE)
+    endif()
+endfunction()
+
+# Whether `dir` is the pinned commit's ffx-api and sdk, unmodified.
+function(_rexglue_fsr_verify ok_var dir)
+    set(${ok_var} FALSE PARENT_SCOPE)
+    if(NOT EXISTS "${dir}/.git")
+        set(_rexglue_fsr_why "no checkout" PARENT_SCOPE)
+        return()
+    endif()
+    _rexglue_fsr_git(ok "${dir}" rev-parse HEAD)
+    if(NOT ok OR NOT _rexglue_fsr_git_output STREQUAL _rexglue_fsr_commit)
+        set(_rexglue_fsr_why "not at ${_rexglue_fsr_commit} (${_rexglue_fsr_git_output})" PARENT_SCOPE)
+        return()
+    endif()
+    _rexglue_fsr_git(ok "${dir}" rev-parse HEAD:ffx-api HEAD:sdk)
+    string(REPLACE "\n" ";" trees "${_rexglue_fsr_git_output}")
+    if(NOT ok OR NOT trees STREQUAL "${_rexglue_fsr_tree_ffx_api};${_rexglue_fsr_tree_sdk}")
+        set(_rexglue_fsr_why "unexpected tree hashes (${trees})" PARENT_SCOPE)
+        return()
+    endif()
+    _rexglue_fsr_git(ok "${dir}" diff --quiet HEAD -- ffx-api sdk LICENSE.txt)
+    if(NOT ok)
+        set(_rexglue_fsr_why "modified files" PARENT_SCOPE)
+        return()
+    endif()
+    set(${ok_var} TRUE PARENT_SCOPE)
+endfunction()
+
+# Fetches the pinned commit (ffx-api, sdk and the licence only) into `dir`
+# through a temporary folder.
+function(_rexglue_fsr_fetch ok_var dir)
+    set(${ok_var} FALSE PARENT_SCOPE)
+    set(tmp "${dir}.tmp")
+    file(REMOVE_RECURSE "${tmp}")
+    file(MAKE_DIRECTORY "${tmp}")
+    foreach(step IN ITEMS "init;-q" "config;core.longpaths;true" "config;core.autocrlf;false"
+                          "remote;add;origin;${REXGLUE_FSR_REPOSITORY}"
+                          "sparse-checkout;set;--no-cone;/ffx-api/;/sdk/;/LICENSE.txt"
+                          "fetch;-q;--depth;1;--filter=blob:none;origin;${_rexglue_fsr_commit}"
+                          "checkout;-q;FETCH_HEAD")
+        _rexglue_fsr_git(ok "${tmp}" ${step})
+        if(NOT ok)
+            set(_rexglue_fsr_why "${_rexglue_fsr_git_output}" PARENT_SCOPE)
+            file(REMOVE_RECURSE "${tmp}")
+            return()
+        endif()
+    endforeach()
+    _rexglue_fsr_verify(ok "${tmp}")
+    if(NOT ok)
+        set(_rexglue_fsr_why "the fetched source: ${_rexglue_fsr_why}" PARENT_SCOPE)
+        file(REMOVE_RECURSE "${tmp}")
+        return()
+    endif()
+    file(REMOVE_RECURSE "${dir}")
+    file(RENAME "${tmp}" "${dir}")
+    set(${ok_var} TRUE PARENT_SCOPE)
+endfunction()
+
+if(REXGLUE_FSR_SOURCE_DIR)
+    set(_rexglue_fsr_src "${REXGLUE_FSR_SOURCE_DIR}")
+    _rexglue_fsr_verify(_rexglue_fsr_ok "${_rexglue_fsr_src}")
+else()
+    set(_rexglue_fsr_src "${CMAKE_BINARY_DIR}/_deps/ffx")
+    _rexglue_fsr_verify(_rexglue_fsr_ok "${_rexglue_fsr_src}")
+    if(NOT _rexglue_fsr_ok)
+        if(EXISTS "${_rexglue_fsr_src}")
+            message(STATUS "FSR: ${_rexglue_fsr_src}: ${_rexglue_fsr_why}; fetching it again")
+        endif()
+        message(STATUS "FSR: fetching FidelityFX SDK ${_rexglue_fsr_commit} from ${REXGLUE_FSR_REPOSITORY}")
+        _rexglue_fsr_fetch(_rexglue_fsr_ok "${_rexglue_fsr_src}")
+    endif()
+endif()
+if(NOT _rexglue_fsr_ok)
+    message(WARNING "FSR: the FidelityFX SDK source is unavailable (${_rexglue_fsr_why}); building without FSR")
+    return()
+endif()
+message(STATUS "FSR: FidelityFX SDK ${_rexglue_fsr_commit} verified (ffx-api ${_rexglue_fsr_tree_ffx_api}, sdk ${_rexglue_fsr_tree_sdk})")
+
+set(_rexglue_fsr_apis)
+if(REXGLUE_USE_D3D12)
+    list(APPEND _rexglue_fsr_apis dx12)
+endif()
+# The Vulkan runtime's headers and library: on Windows the Vulkan SDK's; off it
+# the SDK's own headers (thirdparty/vulkan-headers, so no development package
+# or minimum version is needed), with the system's loader on Linux and no
+# library for the PS5's static libraries.
+set(_rexglue_fsr_vulkan_headers "")
+set(_rexglue_fsr_vulkan_library "")
+if(REXGLUE_USE_VULKAN)
+    if(WIN32)
+        find_package(Vulkan QUIET)
+        if(Vulkan_FOUND)
+            list(APPEND _rexglue_fsr_apis vk)
+        else()
+            message(WARNING "FSR: the Vulkan SDK was not found; FSR is built for Direct3D 12 only (set VULKAN_SDK, or install it, for Vulkan)")
+        endif()
+    else()
+        set(_rexglue_fsr_vulkan_headers "${REXGLUE_ROOT}/thirdparty/vulkan-headers/include")
+        if(PS5 OR PROSPERO)
+            list(APPEND _rexglue_fsr_apis vk)
+        else()
+            find_library(REXGLUE_FSR_VULKAN_LIBRARY NAMES vulkan libvulkan.so.1
+                         DOC "The Vulkan loader FSR's Vulkan runtime links (Linux)")
+            if(REXGLUE_FSR_VULKAN_LIBRARY)
+                set(_rexglue_fsr_vulkan_library "${REXGLUE_FSR_VULKAN_LIBRARY}")
+                list(APPEND _rexglue_fsr_apis vk)
+            else()
+                message(WARNING "FSR: the Vulkan loader (libvulkan.so.1) was not found; building without FSR")
+            endif()
+        endif()
+    endif()
+endif()
+
+# FidelityFX compiles its shaders at build time with FidelityFX_SC.exe, a Windows
+# program. Elsewhere the Vulkan runtime is built from the prebuilt SPIR-V of the
+# permutations rexglue uses (thirdparty/fidelityfx-shaders-vk, from
+# rexglue-temporal-aa-shaders-vk.patch); on Windows it can be too, to check them.
+if(WIN32)
+    set(_rexglue_fsr_prebuilt_default OFF)
+else()
+    set(_rexglue_fsr_prebuilt_default ON)
+endif()
+option(REXGLUE_FSR_PREBUILT_SHADERS
+    "Build FSR's Vulkan runtime from the prebuilt shaders in thirdparty/fidelityfx-shaders-vk (needed off Windows)"
+    ${_rexglue_fsr_prebuilt_default})
+set(REXGLUE_FSR_SHADERS_DIR "${REXGLUE_ROOT}/thirdparty/fidelityfx-shaders-vk")
+set(_rexglue_fsr_shaders_hash "")
+if("vk" IN_LIST _rexglue_fsr_apis)
+    if(REXGLUE_FSR_PREBUILT_SHADERS)
+        if(EXISTS "${REXGLUE_FSR_SHADERS_DIR}/rexglue_fsr_shaders_vk.h")
+            set(REXGLUE_FSR_VK_PREBUILT ON)
+            # Their hash, in the runtime's configure command: a new set
+            # configures and builds it again (and this configure runs again when
+            # a file of the set changes).
+            file(GLOB _rexglue_fsr_shaders LIST_DIRECTORIES false "${REXGLUE_FSR_SHADERS_DIR}/*")
+            list(SORT _rexglue_fsr_shaders)
+            set(_rexglue_fsr_hashes "")
+            foreach(file IN LISTS _rexglue_fsr_shaders)
+                file(SHA256 "${file}" hash)
+                get_filename_component(name "${file}" NAME)
+                string(APPEND _rexglue_fsr_hashes "${name} ${hash}\n")
+            endforeach()
+            string(SHA256 _rexglue_fsr_shaders_hash "${_rexglue_fsr_hashes}")
+            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_rexglue_fsr_shaders})
+        else()
+            message(WARNING "FSR: the prebuilt Vulkan shaders (thirdparty/fidelityfx-shaders-vk, rexglue-temporal-aa-shaders-vk.patch) are missing; building without FSR for Vulkan")
+            list(REMOVE_ITEM _rexglue_fsr_apis vk)
+        endif()
+    elseif(NOT WIN32)
+        message(WARNING "FSR: off Windows, FidelityFX's shader compiler can't run; REXGLUE_FSR_PREBUILT_SHADERS is needed for Vulkan")
+        list(REMOVE_ITEM _rexglue_fsr_apis vk)
+    endif()
+endif()
+
+# The PS5 can't load modules (REXGLUE_FSR_STATIC): its runtime is static
+# libraries, copied next to the SDK's own (which the game links all of), and
+# the GPU plugin calls it directly.
+if(WIN32)
+    set(_rexglue_fsr_library_prefix "")
+    set(_rexglue_fsr_library_suffix ".dll")
+    set(_rexglue_fsr_install_dir "${CMAKE_INSTALL_BINDIR}")
+elseif(REXGLUE_FSR_STATIC)
+    set(_rexglue_fsr_library_prefix "lib")
+    set(_rexglue_fsr_library_suffix ".a")
+    set(_rexglue_fsr_install_dir "")
+else()
+    # Linux (untested): the library goes with the SDK's own.
+    set(_rexglue_fsr_library_prefix "lib")
+    set(_rexglue_fsr_library_suffix ".so")
+    set(_rexglue_fsr_install_dir "${CMAKE_INSTALL_LIBDIR}")
+endif()
+
+include(ExternalProject)
+add_custom_target(rexglue_fsr_runtime)
+foreach(api IN LISTS _rexglue_fsr_apis)
+    string(TOUPPER "${api}" api_upper)
+    set(binary_dir "${CMAKE_BINARY_DIR}/_deps/ffx-${api}")
+    # Each runtime's project from its own copy of the wrapper in the build
+    # tree: FidelityFX writes its static libraries under the top project's
+    # source folder (CMAKE_HOME_DIRECTORY/bin), which would otherwise be the
+    # SDK's own and shared by the two builds.
+    set(wrapper_dir "${CMAKE_BINARY_DIR}/_deps/ffx-${api}-p")
+    foreach(file CMakeLists.txt soft_step.cmake check_static.cmake prebuilt_shaders_hook.cmake
+                 prebuilt_shaders.cmake vulkan-headers-only/FindVulkan.cmake)
+        configure_file("${REXGLUE_ROOT}/cmake/fidelityfx/${file}" "${wrapper_dir}/${file}" COPYONLY)
+    endforeach()
+    # Every switch of the wrapper given, empty or off when not used, so that its
+    # cache keeps none from an earlier configure.
+    set(args "-DFFX_ROOT=${_rexglue_fsr_src}" -DFFX_API_BACKEND=${api_upper}_X64)
+    if(api STREQUAL "vk" AND REXGLUE_FSR_VK_PREBUILT)
+        list(APPEND args "-DREXGLUE_FSR_SHADERS_DIR=${REXGLUE_FSR_SHADERS_DIR}"
+             "-DREXGLUE_FSR_SHADERS_HASH=${_rexglue_fsr_shaders_hash}")
+    else()
+        list(APPEND args "-DREXGLUE_FSR_SHADERS_DIR=" "-DREXGLUE_FSR_SHADERS_HASH=")
+    endif()
+    if(api STREQUAL "vk")
+        list(APPEND args "-DREXGLUE_FSR_VULKAN_HEADERS=${_rexglue_fsr_vulkan_headers}"
+             "-DREXGLUE_FSR_VULKAN_LIBRARY=${_rexglue_fsr_vulkan_library}")
+    else()
+        list(APPEND args "-DREXGLUE_FSR_VULKAN_HEADERS=" "-DREXGLUE_FSR_VULKAN_LIBRARY=")
+    endif()
+    if(NOT WIN32)
+        # The Linux library is a shared object; the PS5's title is position-independent.
+        list(APPEND args -DCMAKE_POSITION_INDEPENDENT_CODE=ON)
+    endif()
+    if(REXGLUE_FSR_STATIC)
+        # Linked into the title with the SDK's own code, with link-time
+        # optimisation: the same code model as the SDK (an LTO link refuses
+        # modules with different ones).
+        set(flags_c "${CMAKE_C_FLAGS}")
+        set(flags_cxx "${CMAKE_CXX_FLAGS}")
+        if(CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64|x86_64" AND NOT APPLE)
+            string(APPEND flags_c " -mcmodel=large")
+            string(APPEND flags_cxx " -mcmodel=large")
+        endif()
+        set(library "${CMAKE_ARCHIVE_OUTPUT_DIRECTORY}/libamd_fidelityfx_${api}.a")
+        list(APPEND args -DREXGLUE_FSR_STATIC=ON "-DREXGLUE_FSR_ARCHIVE_DIR=${CMAKE_ARCHIVE_OUTPUT_DIRECTORY}"
+             "-DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}"
+             "-DCMAKE_C_FLAGS=${flags_c}" "-DCMAKE_CXX_FLAGS=${flags_cxx}")
+        set(target rexglue_fsr_static)
+    else()
+        list(APPEND args -DREXGLUE_FSR_STATIC=OFF "-DREXGLUE_FSR_ARCHIVE_DIR=")
+        set(library "${binary_dir}/bin/${_rexglue_fsr_library_prefix}amd_fidelityfx_${api}${_rexglue_fsr_library_suffix}")
+        set(target amd_fidelityfx_${api})
+    endif()
+    # A runtime that fails to configure or build is left out with a warning
+    # (soft_step.cmake), and the SDK builds on without it.
+    set(soft "${CMAKE_COMMAND}" "-DSTEP_SKIP=${wrapper_dir}/failed" -P "${wrapper_dir}/soft_step.cmake")
+    # Built again when its library isn't there (an earlier attempt failed).
+    set(stamp_dir "${binary_dir}-stamp")
+    if(NOT EXISTS "${library}")
+        file(REMOVE_RECURSE "${stamp_dir}")
+    endif()
+    ExternalProject_Add(rexglue_fsr_${api}
+        SOURCE_DIR "${wrapper_dir}"
+        BINARY_DIR "${binary_dir}"
+        STAMP_DIR "${stamp_dir}"
+        TMP_DIR "${binary_dir}-tmp"
+        CONFIGURE_COMMAND "${CMAKE_COMMAND}" "-DSTEP_SKIP=${wrapper_dir}/failed" -DSTEP_FIRST=1
+            -P "${wrapper_dir}/soft_step.cmake" --
+            "${CMAKE_COMMAND}" -S "${wrapper_dir}" -B "${binary_dir}" -G Ninja
+            -DCMAKE_BUILD_TYPE=Release
+            "-DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}"
+            "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}"
+            "-DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM}"
+            ${args}
+        BUILD_COMMAND ${soft} -- "${CMAKE_COMMAND}" --build "${binary_dir}" --target ${target}
+        INSTALL_COMMAND ""
+        BUILD_BYPRODUCTS "${library}"
+        BUILD_ALWAYS OFF)
+    add_dependencies(rexglue_fsr_runtime rexglue_fsr_${api})
+    if(_rexglue_fsr_install_dir)
+        install(FILES "${library}" DESTINATION "${_rexglue_fsr_install_dir}" OPTIONAL)
+    endif()
+endforeach()
+if(_rexglue_fsr_apis)
+    string(REPLACE ";" ", " _rexglue_fsr_list "${_rexglue_fsr_apis}")
+    set(REXGLUE_FSR_STATUS "ON (${_rexglue_fsr_list}")
+    if(REXGLUE_FSR_VK_PREBUILT)
+        string(APPEND REXGLUE_FSR_STATUS "; Vulkan shaders prebuilt")
+    endif()
+    if(REXGLUE_FSR_STATIC)
+        string(APPEND REXGLUE_FSR_STATUS "; static")
+    endif()
+    string(APPEND REXGLUE_FSR_STATUS "), built with the SDK; one that fails to build is left out with a warning")
+else()
+    set(REXGLUE_FSR_STATUS "ON, but no runtime can be built here (see the warnings above)")
+endif()
diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index 76794f4..542bfff 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -188,6 +188,10 @@ class CommandProcessor {
     kTonemapBegin = 4,  // the next draws tone-map the scene into the 8-bit target
     kUIBegin = 5,       // the HUD / UI is drawn from here on
     kRenderEnd = 6,     // the title's render loop returned (UI drawn after it)
+    // Temporal anti-aliasing (rexglue-temporal-aa.patch):
+    kSceneBegin = 7,        // the main view's 3D scene starts (its draws are jittered)
+    kSceneTranslucent = 8,  // the scene's translucent effects start
+    kSceneComposite = 9,    // the scene's full-screen composites (fog) start
     kPhase = 0x100,     // diagnostics: value = a title-specific phase
   };
   virtual void OnGuestMarker(uint32_t kind, uint32_t value);
@@ -341,7 +345,132 @@ class CommandProcessor {
   // a while); they're made again when needed.
   virtual void HdrReleaseTextures() {}
 
+  // Temporal anti-aliasing (rexglue-temporal-aa.patch): AMD FSR 3.1 at native
+  // resolution. With temporal_aa on, the draws of the 3D scene (kSceneBegin to
+  // kSceneEnd, those of the main view: TaaJitterNdcOffset) are offset by a
+  // sub-pixel jitter that changes every frame. At the title's anti-aliasing
+  // point, a draw after the scene that has the camera's matrices and the
+  // scene's textures bound (TaaCheckDraw; for Midnight Club: Los Angeles its
+  // motion blur), the backend, before recording that draw, makes motion vectors
+  // from the depth and the matrices (taa_motion_vectors_mcla.cs.xesl), runs FSR
+  // over the scene texture, and copies the result back into that texture, so
+  // that everything after (the blur, the tone map, HDR output) reads the
+  // anti-aliased scene. Nothing changes while temporal_aa is off.
+  enum class TaaMode : uint32_t { kOff, kFsr };
+  struct TaaFrame {
+    TaaMode mode = TaaMode::kOff;
+    bool armed = false;     // the scene's draws of this frame are jittered
+    bool in_scene = false;  // between kSceneBegin and kSceneEnd
+    bool post = false;      // between kSceneEnd and kTonemapBegin
+    bool done = false;      // the anti-aliasing pass ran
+    float jitter[2] = {};   // host pixels, +x right, +y down (FSR's convention)
+    uint32_t jittered_draws = 0;
+    uint32_t scene_draws = 0;
+    // temporal_aa_debug 4: how far the pass got: - the draw not seen, f its
+    // fetch constants, s its size, i its matrices, b the backend's turn, t
+    // the textures, r their formats, n the shader's bindings, c FSR being
+    // made, x FSR failed, + the pass ran.
+    char status = '-';
+    // The reactive mask's snapshots of the scene's luminance taken (bit 0 at
+    // kSceneTranslucent, bit 1 at kSceneComposite).
+    uint32_t snapshots = 0;
+  };
+  TaaFrame taa_frame_;
+  // The constants of the motion vector pass, for the draw TaaCheckDraw found.
+  struct TaaVectorConstants {
+    // Per stencil ID (24): the current frame's clip position (row vector, the
+    // unjittered pixel centre, z = 1 - depth) to the previous frame's guest
+    // pixel position, homogeneous (rows).
+    float previous[24][4][4];
+    // Host width and height, host pixels per guest pixel (x, y).
+    float size[4];
+    // The jitter (host pixels, y down), which component of the stencil view is
+    // the stencil (set by the backend), 0.
+    float jitter[4];
+  };
+  TaaVectorConstants taa_vector_constants_ = {};
+  // What FSR needs from the camera besides the vectors.
+  struct TaaCamera {
+    float near_plane = 0.1f;
+    float far_plane = 1000.0f;
+    float fov_vertical = 1.0f;
+    bool reset = false;  // a cut: the history is dropped
+  };
+  TaaCamera taa_camera_;
+  // Fetch constants of the anti-aliasing draw: the scene (read and written),
+  // the depth (k_24_8_FLOAT), the stencil view (k_8_8_8_8; the ID in x >> 2).
+  static constexpr uint32_t kTaaFetchScene = 0;
+  static constexpr uint32_t kTaaFetchStencil = 1;
+  static constexpr uint32_t kTaaFetchDepth = 2;
+  // Set by TaaCheckDraw for the draw about to be issued: the backend runs the
+  // pass before recording it (TaaRun) and sets taa_frame_.done.
+  bool taa_pending_ = false;
+  // The milliseconds since the previous pass, for FSR.
+  float taa_frame_time_ms_ = 16.7f;
+  // Adds this frame's jitter to a draw's NDC offset if it is one of the scene's
+  // (call after the host viewport is known; extent in host pixels).
+  void TaaJitterNdcOffset(xenos::PrimitiveType primitive_type, bool origin_bottom_left,
+                          const uint32_t extent[2], float ndc_offset[3]);
+  // Backend: whether the upscaler can run now (its context exists).
+  virtual bool TaaReady() const { return false; }
+  // Backend, once when the first frame ends: whether FSR can run here (its
+  // runtime is next to the executable, the device has what it needs). Shown
+  // to titles as temporal_aa_available, which also turns false when FSR fails
+  // later (TaaSetUnavailable).
+  virtual bool TaaCheckAvailable() { return false; }
+  // Backend, when TaaCheckAvailable is false: whether FSR could run after a
+  // restart (the device was created without the features it uses:
+  // temporal_aa_device_features). temporal_aa_available is next_start then.
+  virtual bool TaaAvailableAtNextStart() { return false; }
+  static void TaaSetUnavailable(const char* why);
+  // Backend, at the end of every frame (after the swap): destroying what was
+  // released once the GPU is done with it.
+  virtual void TaaFrameEnd() {}
+  // Set by the backend when FSR must be made again (another size) or given up
+  // (a failed dispatch): released at the end of the frame, never mid-frame.
+  bool taa_release_pending_ = false;
+  // Backend, for FSR's reactive mask: a snapshot of the luminance of the
+  // colour render target `color_target_key` (HdrColorTargetKey) into slot 0
+  // (at kSceneTranslucent: the opaque scene) or 1 (at kSceneComposite: with the
+  // translucent effects); false if it couldn't be taken (then there's no mask
+  // this frame).
+  virtual bool TaaSnapshot([[maybe_unused]] uint32_t slot,
+                           [[maybe_unused]] uint32_t color_target_key) {
+    return false;
+  }
+  // The reactive mask's curve (temporal_aa_reactive): scale (0: no mask),
+  // threshold and maximum.
+  static void TaaReactiveCurve(float curve_out[4]);
+  // Backend: releases the upscaler and its textures once the GPU is done with
+  // them (temporal_aa off for a while).
+  virtual void TaaRelease() {}
+  // Backend, temporal_aa_debug 4: the GPU time of the anti-aliasing passes
+  // (the vectors, FSR and the copy back), summed in milliseconds over the
+  // frames read back since the last call, and how many.
+  virtual void TaaTakeGpuTime(double& ms_out, uint32_t& count_out) {
+    ms_out = 0.0;
+    count_out = 0;
+  }
+  static float TaaSharpness();
+  static uint32_t TaaDebug();
+  // The jitter FSR is told (taa_frame_.jitter, or flipped for checking the
+  // convention: temporal_aa_flip_jitter).
+  void TaaFsrJitter(float jitter_out[2]) const;
+
  private:
+  bool TaaCheckDraw();
+  void TaaEndFrame();
+  void TaaSceneMarker(uint32_t slot);
+  uint32_t taa_jitter_index_ = 0;
+  // When temporal_aa went off (host ticks; 0: on, or released).
+  uint64_t taa_off_since_ = 0;
+  bool taa_last_done_ = false;
+  bool taa_have_last_camera_ = false;
+  float taa_last_camera_[2][3] = {};
+  float taa_last_fov_ = 0.0f;
+  bool taa_availability_checked_ = false;
+  uint64_t taa_last_time_ = 0;
+  uint32_t taa_log_frames_ = 0;
   uint32_t HdrColorTargetKey(uint32_t rt_index) const;
   bool HdrBeforeDraw();
   void HdrBeforeResolve();
