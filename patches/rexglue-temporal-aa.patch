+  // A call into code that records its own commands (a third-party library:
+  // the temporal upscaler), made with the real command list where it falls
+  // among the recorded ones, on the thread that executes them. `data` (trivially
+  // copyable, data_size bytes) is copied into the stream and passed to
+  // `function`. The callee may change any state; the recording side must set
+  // again whatever it relies on (the pipeline state is re-set here).
+  using ExternalCallbackFunction = void (*)(ID3D12GraphicsCommandList* command_list,
+                                            const void* data);
+  void ExternalCallback(ExternalCallbackFunction function, const void* data, size_t data_size) {
+    uint8_t* args_ptr = reinterpret_cast<uint8_t*>(
+        WriteCommand(Command::kExternalCallback, sizeof(ExternalCallbackHeader) + data_size));
+    reinterpret_cast<ExternalCallbackHeader*>(args_ptr)->function = function;
+    std::memcpy(args_ptr + sizeof(ExternalCallbackHeader), data, data_size);
+  }
+
   void InsertDebugMarker(const char* label_name) {
     size_t label_len = std::strlen(label_name);
     uint8_t* args_ptr = reinterpret_cast<uint8_t*>(
@@ -524,6 +539,7 @@ class DeferredCommandList {
     kBeginDebugMarker,
     kEndDebugMarker,
     kInsertDebugMarker,
+    kExternalCallback,
   };
 
   struct CommandHeader {
