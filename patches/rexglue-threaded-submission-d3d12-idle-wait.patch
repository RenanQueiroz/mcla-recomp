+void D3D12CommandProcessor::PrepareForWait() {
+  // This thread is about to spin (SwitchToThread in a loop) or wait for more
+  // guest commands, while the submission thread may still be replaying and
+  // submitting the lists of the guest command buffer that just ended. Spinning
+  // meanwhile ended, with the Radeon of a Ryzen 7 9800X3D, in bursts of 2 to 3
+  // frames of garbage 8x8-pixel blocks over the scene; waiting here does not,
+  // and costs no overlap, as this thread has nothing else to process
+  // (patches/README.md has the measurements).
+  if (REXCVAR_GET(d3d12_threaded_submission_idle_wait)) {
+    AwaitSubmissionThread();
+  }
+  CommandProcessor::PrepareForWait();
+}
