+void D3D12CommandProcessor::LogSharedMemoryHoistStats() {
+  D3D12SharedMemory::HoistStats stats = shared_memory_->TakeHoistStats();
+  hoist_stats_total_.runs += stats.runs;
+  hoist_stats_total_.uploads_hoisted += stats.uploads_hoisted;
+  hoist_stats_total_.uploads_in_place_no_run += stats.uploads_in_place_no_run;
+  hoist_stats_total_.uploads_in_place_page_read += stats.uploads_in_place_page_read;
+  uint64_t now_ms = uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                 std::chrono::steady_clock::now().time_since_epoch())
+                                 .count());
+  if (now_ms < hoist_stats_next_log_ms_) {
+    return;
+  }
+  hoist_stats_next_log_ms_ = now_ms + 5000;
+  REXGPU_INFO(
+      "D3D12 upload hoisting: {} runs of draws, {} uploads hoisted, {} done in place with no run "
+      "going, {} done in place because a draw of the run had read a page (since the last line)",
+      hoist_stats_total_.runs, hoist_stats_total_.uploads_hoisted,
+      hoist_stats_total_.uploads_in_place_no_run, hoist_stats_total_.uploads_in_place_page_read);
+  hoist_stats_total_ = {};
+}
