+// ---------------------------------------------------------------------------------------------
+
+namespace {
+
+void Put16(uint8_t* p, uint16_t v) {
+  p[0] = static_cast<uint8_t>(v);
+  p[1] = static_cast<uint8_t>(v >> 8);
+}
+
+void Put32(uint8_t* p, uint32_t v) {
+  p[0] = static_cast<uint8_t>(v);
+  p[1] = static_cast<uint8_t>(v >> 8);
+  p[2] = static_cast<uint8_t>(v >> 16);
+  p[3] = static_cast<uint8_t>(v >> 24);
+}
+
+}  // namespace
+
+bool WavWriter::Open(const std::string& path, uint16_t format_tag, uint16_t channels, uint32_t rate,
+                     uint16_t bits) {
+  Close();
+  file_ = std::fopen(path.c_str(), "wb");
+  if (!file_) {
+    return false;
+  }
+  uint8_t header[44] = {};
+  std::memcpy(header, "RIFF", 4);
+  std::memcpy(header + 8, "WAVEfmt ", 8);
+  Put32(header + 16, 16);
+  Put16(header + 20, format_tag);
+  Put16(header + 22, channels);
+  Put32(header + 24, rate);
+  Put32(header + 28, rate * channels * (bits / 8));
+  Put16(header + 32, static_cast<uint16_t>(channels * (bits / 8)));
+  Put16(header + 34, bits);
+  std::memcpy(header + 36, "data", 4);
+  std::fwrite(header, 1, sizeof(header), file_);
+  data_bytes_ = 0;
+  buffer_.clear();
+  return true;
+}
+
+void WavWriter::Write(const void* data, size_t bytes) {
+  if (!file_ || !bytes) {
+    return;
+  }
+  if (!TakeBudget(bytes)) {
+    return;
+  }
+  const uint8_t* p = static_cast<const uint8_t*>(data);
+  buffer_.insert(buffer_.end(), p, p + bytes);
+  data_bytes_ += bytes;
+  if (buffer_.size() >= (256u << 10)) {
+    Flush();
+  }
+}
+
+void WavWriter::Flush() {
+  if (file_ && !buffer_.empty()) {
+    std::fwrite(buffer_.data(), 1, buffer_.size(), file_);
+  }
+  buffer_.clear();
+}
+
+void WavWriter::Close() {
+  if (!file_) {
+    return;
+  }
+  Flush();
+  uint8_t field[4];
+  std::fseek(file_, 4, SEEK_SET);
+  Put32(field, static_cast<uint32_t>(std::min<uint64_t>(36 + data_bytes_, 0xFFFFFFFFull)));
+  std::fwrite(field, 1, 4, file_);
+  std::fseek(file_, 40, SEEK_SET);
+  Put32(field, static_cast<uint32_t>(std::min<uint64_t>(data_bytes_, 0xFFFFFFFFull)));
+  std::fwrite(field, 1, 4, file_);
+  std::fclose(file_);
+  file_ = nullptr;
+}
+
+bool RawWriter::Open(const std::string& path) {
+  Close();
+  file_ = std::fopen(path.c_str(), "wb");
+  bytes_ = 0;
+  return file_ != nullptr;
+}
+
+void RawWriter::Write(const void* data, size_t bytes) {
+  if (!file_ || !bytes || !TakeBudget(bytes)) {
+    return;
+  }
+  std::fwrite(data, 1, bytes, file_);
+  bytes_ += bytes;
+}
+
+void RawWriter::Close() {
+  if (file_) {
+    std::fclose(file_);
+    file_ = nullptr;
+  }
+}
+
