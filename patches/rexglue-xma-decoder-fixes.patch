diff --git a/src/audio/audio_dump.cpp b/src/audio/audio_dump.cpp
new file mode 100644
index 0000000..884fcab
--- /dev/null
+++ b/src/audio/audio_dump.cpp
@@ -0,0 +1,339 @@
+/**
+ * @file        audio/audio_dump.cpp
+ * @brief       Counters and WAV dumps of the audio path (fork instrumentation)
+ *
+ * Added by the mcla-recomp fork (patches/rexglue-xma-decoder-fixes.patch).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <filesystem>
+#include <mutex>
+#include <thread>
+
+#include <rex/audio/audio_dump.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(audio_stats, false, "Audio",
+                    "Dev tool: log counters of the audio path every audio_stats_interval seconds and at exit "
+                    "(XMA decoding and what the game wrote into a context meanwhile, the audio worker's pumps, "
+                    "the SDL output's underruns)");
+REXCVAR_DEFINE_INT32(audio_stats_interval, 10, "Audio", "Dev tool: seconds between audio_stats lines")
+    .range(1, 600);
+REXCVAR_DEFINE_STRING(audio_dump_dir, "", "Audio",
+                      "Dev tool: write the audio path to files in this folder: what every XMA context decodes "
+                      "(xma_ctx<N>_s<M>.wav, with its input in .xma and a .json), and the final mix (mix.wav, "
+                      "32-bit float, as the output device gets it). Empty = off");
+REXCVAR_DEFINE_INT32(audio_dump_max_mb, 2048, "Audio",
+                     "Dev tool: stop writing dump files after this many megabytes in all")
+    .range(1, 65536);
+
+namespace rex::audio::dump {
+
+namespace {
+
+std::atomic<bool> g_stats{false};
+std::atomic<bool> g_dump{false};
+std::string g_dir;
+std::chrono::steady_clock::time_point g_start = std::chrono::steady_clock::now();
+std::atomic<uint64_t> g_budget{0};
+std::atomic<uint32_t> g_session{0};
+thread_local bool tls_xma_worker = false;
+Counters g_counters;
+
+std::thread g_reporter;
+std::mutex g_reporter_mutex;
+std::condition_variable g_reporter_cv;
+bool g_reporter_stop = false;
+bool g_initialized = false;
+
+struct Snapshot {
+  uint64_t xma_work_inline = 0, xma_work_worker = 0, xma_work_us = 0, xma_work_slow = 0, xma_kicks = 0,
+           xma_frames = 0, xma_decode_errors = 0, xma_recheck_abort = 0, xma_stalled_loops = 0,
+           xma_cas_retries = 0, wrote_rd = 0, wrote_valid = 0, wrote_other = 0, pump_count = 0,
+           pump_us = 0, pump_late = 0, sdl_callbacks = 0, sdl_frames = 0, sdl_underruns = 0;
+};
+
+Snapshot Take() {
+  Counters& c = g_counters;
+  const auto ld = [](const std::atomic<uint64_t>& a) { return a.load(std::memory_order_relaxed); };
+  Snapshot s;
+  s.xma_work_inline = ld(c.xma_work_inline);
+  s.xma_work_worker = ld(c.xma_work_worker);
+  s.xma_work_us = ld(c.xma_work_us);
+  s.xma_work_slow = ld(c.xma_work_slow);
+  s.xma_kicks = ld(c.xma_kicks);
+  s.xma_frames = ld(c.xma_frames);
+  s.xma_decode_errors = ld(c.xma_decode_errors);
+  s.xma_recheck_abort = ld(c.xma_recheck_abort);
+  s.xma_stalled_loops = ld(c.xma_stalled_loops);
+  s.xma_cas_retries = ld(c.xma_cas_retries);
+  s.wrote_rd = ld(c.xma_game_wrote_read_offset);
+  s.wrote_valid = ld(c.xma_game_wrote_valid);
+  s.wrote_other = ld(c.xma_game_wrote_other);
+  s.pump_count = ld(c.pump_count);
+  s.pump_us = ld(c.pump_us);
+  s.pump_late = ld(c.pump_late);
+  s.sdl_callbacks = ld(c.sdl_callbacks);
+  s.sdl_frames = ld(c.sdl_frames);
+  s.sdl_underruns = ld(c.sdl_underruns);
+  return s;
+}
+
+uint64_t Div(uint64_t a, uint64_t b) {
+  return b ? a / b : 0;
+}
+
+// One statistics line. `prev` is the snapshot of the last line (zeros for the totals).
+void Report(const char* label, const Snapshot& now, const Snapshot& prev, uint64_t work_max,
+            uint64_t pump_max, uint64_t gap_max, uint64_t queue_min) {
+  const uint64_t works = (now.xma_work_inline - prev.xma_work_inline) +
+                         (now.xma_work_worker - prev.xma_work_worker);
+  REXAPU_INFO(
+      "audio stats {} t={:.1f}s | xma: kicks={} work inline={} worker={} avg_us={} max_us={} slow(>2ms)={} "
+      "frames={} errors={} recheck_abort={} stalled={} cas_retry={} | game wrote during a decode: "
+      "read_offset={} valid={} other={} | pump: n={} avg_us={} max_us={} gap_max_us={} late(>8ms)={} | "
+      "sdl: callbacks={} frames={} underruns={} queue_min={}",
+      label, static_cast<double>(NowUs()) / 1e6, now.xma_kicks - prev.xma_kicks,
+      now.xma_work_inline - prev.xma_work_inline, now.xma_work_worker - prev.xma_work_worker,
+      Div(now.xma_work_us - prev.xma_work_us, works), work_max, now.xma_work_slow - prev.xma_work_slow,
+      now.xma_frames - prev.xma_frames, now.xma_decode_errors - prev.xma_decode_errors,
+      now.xma_recheck_abort - prev.xma_recheck_abort, now.xma_stalled_loops - prev.xma_stalled_loops,
+      now.xma_cas_retries - prev.xma_cas_retries, now.wrote_rd - prev.wrote_rd,
+      now.wrote_valid - prev.wrote_valid, now.wrote_other - prev.wrote_other,
+      now.pump_count - prev.pump_count, Div(now.pump_us - prev.pump_us, now.pump_count - prev.pump_count),
+      pump_max, gap_max, now.pump_late - prev.pump_late, now.sdl_callbacks - prev.sdl_callbacks,
+      now.sdl_frames - prev.sdl_frames, now.sdl_underruns - prev.sdl_underruns,
+      queue_min == ~0ull ? 0 : queue_min);
+}
+
+void ReporterMain(int interval_s) {
+  Snapshot prev;
+  uint64_t run_work_max = 0, run_pump_max = 0, run_gap_max = 0, run_queue_min = ~0ull;
+  std::unique_lock<std::mutex> lock(g_reporter_mutex);
+  while (!g_reporter_stop) {
+    if (g_reporter_cv.wait_for(lock, std::chrono::seconds(interval_s), [] { return g_reporter_stop; })) {
+      break;
+    }
+    Counters& c = g_counters;
+    const uint64_t work_max = c.xma_work_us_max.exchange(0);
+    const uint64_t pump_max = c.pump_us_max.exchange(0);
+    const uint64_t gap_max = c.pump_gap_max_us.exchange(0);
+    const uint64_t queue_min = c.sdl_queue_min.exchange(~0ull);
+    run_work_max = std::max(run_work_max, work_max);
+    run_pump_max = std::max(run_pump_max, pump_max);
+    run_gap_max = std::max(run_gap_max, gap_max);
+    run_queue_min = std::min(run_queue_min, queue_min);
+    const Snapshot now = Take();
+    Report("interval", now, prev, work_max, pump_max, gap_max, queue_min);
+    prev = now;
+  }
+  Counters& c = g_counters;
+  run_work_max = std::max(run_work_max, c.xma_work_us_max.load());
+  run_pump_max = std::max(run_pump_max, c.pump_us_max.load());
+  run_gap_max = std::max(run_gap_max, c.pump_gap_max_us.load());
+  run_queue_min = std::min(run_queue_min, c.sdl_queue_min.load());
+  Report("TOTAL", Take(), Snapshot{}, run_work_max, run_pump_max, run_gap_max, run_queue_min);
+}
+
+}  // namespace
+
+Counters& C() {
+  return g_counters;
+}
+
+bool StatsEnabled() {
+  return g_stats.load(std::memory_order_relaxed);
+}
+
+bool DumpEnabled() {
+  return g_dump.load(std::memory_order_relaxed);
+}
+
+uint64_t NowUs() {
+  return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+                                   std::chrono::steady_clock::now() - g_start)
+                                   .count());
+}
+
+const std::string& Dir() {
+  return g_dir;
+}
+
+void MarkXmaWorkerThread() {
+  tls_xma_worker = true;
+}
+
+bool IsXmaWorkerThread() {
+  return tls_xma_worker;
+}
+
+uint32_t NextSession() {
+  return g_session.fetch_add(1, std::memory_order_relaxed);
+}
+
+bool TakeBudget(uint64_t bytes) {
+  uint64_t cur = g_budget.load(std::memory_order_relaxed);
+  while (true) {
+    if (cur < bytes) {
+      return false;
+    }
+    if (g_budget.compare_exchange_weak(cur, cur - bytes, std::memory_order_relaxed)) {
+      return true;
+    }
+  }
+}
+
+void Init() {
+  if (g_initialized) {
+    return;
+  }
+  g_initialized = true;
+  g_start = std::chrono::steady_clock::now();
+  g_stats.store(REXCVAR_GET(audio_stats), std::memory_order_relaxed);
+  const std::string dir = REXCVAR_GET(audio_dump_dir);
+  if (!dir.empty()) {
+    std::error_code ec;
+    std::filesystem::create_directories(dir, ec);
+    if (ec) {
+      REXAPU_ERROR("audio dump: cannot create '{}': {}", dir, ec.message());
+    } else {
+      g_dir = dir;
+      if (g_dir.back() != '/' && g_dir.back() != '\\') {
+        g_dir += '/';
+      }
+      g_budget.store(static_cast<uint64_t>(REXCVAR_GET(audio_dump_max_mb)) << 20, std::memory_order_relaxed);
+      g_dump.store(true, std::memory_order_relaxed);
+      REXAPU_INFO("audio dump: writing to {} (at most {} MB)", g_dir, REXCVAR_GET(audio_dump_max_mb));
+    }
+  }
+  if (StatsEnabled()) {
+    g_reporter_stop = false;
+    g_reporter = std::thread(ReporterMain, REXCVAR_GET(audio_stats_interval));
+  }
+}
+
+void Shutdown() {
+  if (!g_initialized) {
+    return;
+  }
+  g_initialized = false;
+  if (g_reporter.joinable()) {
+    {
+      std::lock_guard<std::mutex> lock(g_reporter_mutex);
