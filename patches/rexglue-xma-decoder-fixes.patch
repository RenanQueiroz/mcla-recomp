+bool XmaContext::DumpOpen(uint32_t rate, uint32_t channels) {
+  if (!dump_) {
+    dump_ = std::make_unique<DumpState>();
+  }
+  DumpState& d = *dump_;
+  d.session = dump::NextSession();
+  d.rate = rate;
+  d.channels = channels;
+  d.stem = dump::Dir() + "xma_ctx" + std::to_string(id_) + "_s" + std::to_string(d.session);
+  d.first_us = dump::NowUs();
+  d.in_total_packets = 0;
+  d.blocks.clear();
+  for (int b = 0; b < 2; ++b) {
+    d.in_hash[b] = 0;
+    d.in_ptr[b] = 0;
+    d.in_packets[b] = 0;
+  }
+  d.opened = d.pcm.Open(d.stem + ".wav", 1, static_cast<uint16_t>(channels), rate, 16) &&
+             d.input.Open(d.stem + ".xma");
+  if (!d.opened) {
+    d.pcm.Close();
+    d.input.Close();
+  }
+  return d.opened;
+}
+
+void XmaContext::DumpInputBuffers(const XMA_CONTEXT_DATA& data) {
+  if (!dump::DumpEnabled()) {
+    return;
+  }
+  for (uint8_t b = 0; b < 2; ++b) {
+    if (!data.IsInputBufferValid(b)) {
+      continue;
+    }
+    const uint32_t ptr = data.GetInputBufferAddress(b);
+    const uint32_t packets = data.GetInputBufferPacketCount(b);
+    if (!ptr || !packets) {
+      continue;
+    }
+    const uint8_t* bytes = memory()->TranslatePhysical(ptr);
+    const size_t size = static_cast<size_t>(packets) * kBytesPerPacket;
+    uint64_t hash = dump::Fnv1a(bytes, std::min<size_t>(size, 4096));
+    if (size > 4096) {
+      hash = dump::Fnv1a(bytes + size - 4096, 4096, hash);
+    }
+    hash ^= size;
+    if (dump_ && dump_->opened && dump_->in_ptr[b] == ptr && dump_->in_packets[b] == packets &&
+        dump_->in_hash[b] == hash) {
+      continue;  // the same buffer as the last time
+    }
+    if (!(dump_ && dump_->opened) &&
+        !DumpOpen(GetSampleRate(data.sample_rate), data.is_stereo ? 2 : 1)) {
+      return;
+    }
+    DumpState& d = *dump_;
+    d.in_ptr[b] = ptr;
+    d.in_packets[b] = packets;
+    d.in_hash[b] = hash;
+    d.input.Write(bytes, size);
+    d.in_total_packets += packets;
+    d.blocks += "[" + std::to_string(dump::NowUs()) + "," + std::to_string(b) + "," +
+                std::to_string(ptr) + "," + std::to_string(packets) + "],";
+  }
+}
+
+void XmaContext::DumpPcm(const uint8_t* big_endian_samples, size_t bytes,
+                         const XMA_CONTEXT_DATA& data) {
+  if (!dump::DumpEnabled()) {
+    return;
+  }
+  const uint32_t rate = GetSampleRate(data.sample_rate);
+  const uint32_t channels = data.is_stereo ? 2 : 1;
+  if (dump_ && dump_->opened && (dump_->rate != rate || dump_->channels != channels)) {
+    DumpClose();  // the context changed format in the middle of a stream: a new file
+  }
+  if (!(dump_ && dump_->opened) && !DumpOpen(rate, channels)) {
+    return;
+  }
+  uint8_t chunk[1024];
+  for (size_t offset = 0; offset + 1 < bytes; offset += sizeof(chunk)) {
+    const size_t n = std::min(sizeof(chunk), (bytes - offset) & ~static_cast<size_t>(1));
+    for (size_t i = 0; i < n; i += 2) {
+      chunk[i] = big_endian_samples[offset + i + 1];
+      chunk[i + 1] = big_endian_samples[offset + i];
+    }
+    dump_->pcm.Write(chunk, n);
+  }
+}
+
+void XmaContext::DumpClose() {
+  if (!dump_ || !dump_->opened) {
+    return;
+  }
+  DumpState& d = *dump_;
+  const uint64_t pcm_bytes = d.pcm.data_bytes();
+  d.pcm.Close();
+  d.input.Close();
+  std::string blocks = d.blocks;
+  if (!blocks.empty()) {
+    blocks.pop_back();
+  }
+  const std::string json = "{\"ctx\":" + std::to_string(id_) + ",\"session\":" + std::to_string(d.session) +
+                           ",\"rate\":" + std::to_string(d.rate) + ",\"channels\":" + std::to_string(d.channels) +
+                           ",\"first_us\":" + std::to_string(d.first_us) + ",\"last_us\":" +
+                           std::to_string(dump::NowUs()) + ",\"pcm_bytes\":" + std::to_string(pcm_bytes) +
+                           ",\"in_packets\":" + std::to_string(d.in_total_packets) + ",\"blocks\":[" + blocks +
+                           "]}\n";
+  if (std::FILE* f = std::fopen((d.stem + ".json").c_str(), "wb")) {
+    std::fwrite(json.data(), 1, json.size(), f);
+    std::fclose(f);
+  }
+  d.opened = false;
+}
