diff --git a/src/graphics/shaders/hdr_refresh.cs.xesl b/src/graphics/shaders/hdr_refresh.cs.xesl
new file mode 100644
index 0000000..137dbd2
--- /dev/null
+++ b/src/graphics/shaders/hdr_refresh.cs.xesl
@@ -0,0 +1,85 @@
+// HDR output (rexglue-hdr-output.patch): the swap's refresher when the
+// presenter's swap chain is HDR10, in place of apply_gamma_table.cs.xesl (same
+// bindings, more constants). The guest's front buffer goes through the guest's
+// own 256-entry display table, as in SDR (so a game's gamma setting, such as
+// MCLA's DISPLAY GAMMA, works the same), then is decoded as SDR content
+// (piecewise sRGB or pure 2.2) at the SDR content level in nits, and written as
+// HDR10 code values (BT.2020, PQ) into the guest output image.
+// The table is never applied to PQ values, and the presenter's scaling only
+// reads what this writes.
+
+#include "../../ui/shaders/xesl.xesli"
+#include "../../ui/shaders/hdr_output.xesli"
+
+push_const_begin_xe(b0, space0)
+  uint2_xe xe_hdr_refresh_size;
+  // x: bit 0: decode SDR with a pure 2.2 power, else the piecewise sRGB curve;
+  //    bit 1: test pattern in place of the game's frame;
+  //    bit 2: swap red and blue of the source.
+  uint2_xe xe_hdr_refresh_flags;
+  // x: SDR content white, y: paper white, z: roll-off start, w: peak (nits).
+  float4_xe xe_hdr_refresh_levels;
+push_const_end_xe
+
+#define LOCAL_SIZE_X_XE 16
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+entry_bindings_begin_compute_xe
+  push_const_binding_xe(buffer(0))
+  entry_binding_next_xe
+  texture_xe(texture_buffer_xe, xe_hdr_refresh_ramp, set=0, binding=0, t0,
+             space0, texture(0))
+  entry_binding_next_xe
+  texture_xe(texture_2d_xe, xe_hdr_refresh_source, set=1, binding=0, t1,
+             space0, texture(1))
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, image_format_rgb10_a2_xe, xe_hdr_refresh_dest,
+              set=2, binding=0, u0, space0, texture(2))
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+  uint2_xe pixel_index = in_global_thread_id_xe.xy;
+  uint2_xe size = push_const_xe(xe_hdr_refresh_size);
+  dont_flatten_xe
+  if (any(greater_than_equal_xe(pixel_index, size))) {
+    return;
+  }
+  uint flags = push_const_xe(xe_hdr_refresh_flags).x;
+  float4_xe levels = push_const_xe(xe_hdr_refresh_levels);
+
+  // UNORM conversion according to the Direct3D 10+ rules, as apply_gamma.
+  float3_xe source = texel_fetch_2d_xe(xe_hdr_refresh_source,
+                                       int2_xe(pixel_index), 0).rgb;
+  dont_flatten_xe if ((flags & 4u) != 0u) {
+    source = source.bgr;
+  }
+  uint3_xe code = uint3_xe(source * 255.0f + 0.5f);
+  // The table has blue in bits 0:9, green in 10:19, red in 20:29 - BGR passed
+  // as an R10G10B10A2 buffer.
+  float3_xe ramped = float3_xe(
+      texel_fetch_buffer_xe(xe_hdr_refresh_ramp, code.r).b,
+      texel_fetch_buffer_xe(xe_hdr_refresh_ramp, code.g).g,
+      texel_fetch_buffer_xe(xe_hdr_refresh_ramp, code.b).r);
+  float3_xe nits = XeHdrSdrToLinear(ramped, (flags & 1u) != 0u) * levels.x;
+
+  dont_flatten_xe if ((flags & 2u) != 0u) {
+    // Test pattern. Top half: 24 bars from 100 nits doubling every 4 bars
+    // (100, 200, 400, 800, 1600, 3200 nits at bars 0, 4, 8, 12, 16, 20), not
+    // rolled off, for where the display itself stops showing steps. Bottom
+    // half: paper white on the left, the same bars rolled off towards the
+    // peak setting on the right.
+    float2_xe position = (float2_xe(pixel_index) + 0.5f) / float2_xe(size);
+    bool top = position.y < 0.5f;
+    float bar_position = top ? position.x : position.x * 2.0f - 1.0f;
+    float bar_nits = 100.0f * exp2(floor(bar_position * 24.0f) * 0.25f);
+    nits = XeHdrSplat(top ? bar_nits
+                          : (bar_position < 0.0f ? levels.y : bar_nits));
+    dont_flatten_xe if (top) {
+      levels.z = 10000.0f;
+    }
+  }
+
+  nits = XeHdrRollOff(nits, levels.z, levels.w);
+  image_store_2d_rgba_xe(xe_hdr_refresh_dest, pixel_index,
+                         float4_xe(XeHdrEncodePq(nits), 1.0f));
+entry_code_end_compute_xe
