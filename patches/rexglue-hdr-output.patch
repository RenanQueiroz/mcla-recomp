+Presenter::HdrOutputState Presenter::GetHdrOutputState() {
+  HdrOutputState state;
+  state.active = hdr_output_active.load(std::memory_order_acquire);
+  if (!state.active) {
+    return state;
+  }
+  HdrDisplayInfo info = GetLastHdrDisplayInfo();
+  float peak = float(REXCVAR_GET(hdr_peak_nits));
+  if (peak <= 0.0f) {
+    peak = info.peak_nits >= 80.0f ? info.peak_nits : 1000.0f;
+  }
+  float paper_white = float(REXCVAR_GET(hdr_paper_white_nits));
+  if (paper_white <= 0.0f) {
+    paper_white = info.sdr_white_nits >= 40.0f ? info.sdr_white_nits : 200.0f;
+  }
+  paper_white = std::min(paper_white, peak);
+  float sdr_white = float(REXCVAR_GET(hdr_ui_nits));
+  state.sdr_white_nits = sdr_white > 0.0f ? std::min(sdr_white, peak) : paper_white;
+  state.paper_white_nits = paper_white;
+  state.peak_nits = peak;
+  state.rolloff_start_nits = 0.75f * peak;
+  state.sdr_pure_gamma_2_2 = hdr_sdr_pure_gamma_2_2.load(std::memory_order_relaxed);
+  state.test_pattern = REXCVAR_GET(hdr_test_pattern);
+  return state;
+}
