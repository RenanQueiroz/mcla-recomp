+
+bool Presenter::IsHdrOutputWanted() {
+  HdrRegisterSettingCallbacks();
+  int mode = hdr_mode.load(std::memory_order_relaxed);
+  if (!mode) {
+    return false;
+  }
+  {
+    // Refresh what the display reports about once a second (Windows doesn't
+    // reliably announce SDR brightness changes), or when the window moved to
+    // another display or the platform reported a change. If another thread is
+    // doing it, use what's there.
+    std::unique_lock<std::mutex> lock(hdr_display_mutex, std::try_to_lock);
+    auto now = std::chrono::steady_clock::now();
+    if (lock.owns_lock() && (hdr_display_info_stale.exchange(false) ||
+                             now - hdr_display_info_time >= std::chrono::seconds(1))) {
+      hdr_display_info_time = now;
+      HdrDisplayInfo info;
+#if REX_PLATFORM_WIN32
+      // DXGI (the HDR switch, and the peak including the Windows HDR
+      // Calibration profile) and DisplayConfig (the SDR content brightness).
+      HMONITOR monitor = static_cast<HMONITOR>(hdr_monitor.load());
+      static Microsoft::WRL::ComPtr<IDXGIFactory1> factory;
+      static Microsoft::WRL::ComPtr<IDXGIOutput6> output6;
+      static HMONITOR output6_monitor = nullptr;
+      if (factory && !factory->IsCurrent()) {
+        factory.Reset();
+        output6.Reset();
+      }
+      if (!factory) {
+        CreateDXGIFactory1(IID_PPV_ARGS(&factory));
+      }
+      if (output6 && output6_monitor != monitor) {
+        output6.Reset();
+      }
+      if (!output6 && factory && monitor) {
+        if (Microsoft::WRL::ComPtr<IDXGIOutput> output =
+                GetDXGIOutputForMonitor(factory.Get(), monitor)) {
+          output.As(&output6);
+          output6_monitor = monitor;
+        }
+      }
+      DXGI_OUTPUT_DESC1 desc;
+      if (output6 && SUCCEEDED(output6->GetDesc1(&desc))) {
+        info.known = true;
+        info.hdr_enabled = desc.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020;
+        info.peak_nits = desc.MaxLuminance;
+        info.full_frame_nits = desc.MaxFullFrameLuminance;
+        info.min_nits = desc.MinLuminance;
+        UINT32 path_count = 0, mode_count = 0;
+        if (GetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, &path_count, &mode_count) ==
+            ERROR_SUCCESS) {
+          std::vector<DISPLAYCONFIG_PATH_INFO> paths(path_count);
+          std::vector<DISPLAYCONFIG_MODE_INFO> modes(mode_count);
+          if (QueryDisplayConfig(QDC_ONLY_ACTIVE_PATHS, &path_count, paths.data(), &mode_count,
+                                 modes.data(), nullptr) == ERROR_SUCCESS) {
+            for (UINT32 i = 0; i < path_count; ++i) {
+              DISPLAYCONFIG_SOURCE_DEVICE_NAME source = {};
+              source.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME;
+              source.header.size = sizeof(source);
+              source.header.adapterId = paths[i].sourceInfo.adapterId;
+              source.header.id = paths[i].sourceInfo.id;
+              if (DisplayConfigGetDeviceInfo(&source.header) != ERROR_SUCCESS ||
+                  wcscmp(source.viewGdiDeviceName, desc.DeviceName)) {
+                continue;
+              }
+              DISPLAYCONFIG_SDR_WHITE_LEVEL white = {};
+              white.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SDR_WHITE_LEVEL;
+              white.header.size = sizeof(white);
+              white.header.adapterId = paths[i].targetInfo.adapterId;
+              white.header.id = paths[i].targetInfo.id;
+              if (DisplayConfigGetDeviceInfo(&white.header) == ERROR_SUCCESS) {
+                info.sdr_white_nits = float(white.SDRWhiteLevel) * (80.0f / 1000.0f);
+              }
+              break;
+            }
+          }
+        }
+      }
+#endif  // REX_PLATFORM_WIN32
+      if (info.known != hdr_display_info.known ||
+          info.hdr_enabled != hdr_display_info.hdr_enabled ||
+          info.peak_nits != hdr_display_info.peak_nits ||
+          info.sdr_white_nits != hdr_display_info.sdr_white_nits) {
+        if (info.known) {
+          REXLOG_INFO(
+              "Presenter: display HDR {}, peak {} nits, full frame {} nits, black {} nits, SDR "
+              "white {} nits",
+              info.hdr_enabled ? "on" : "off", info.peak_nits, info.full_frame_nits,
+              info.min_nits, info.sdr_white_nits);
+        } else {
+          REXLOG_INFO("Presenter: the display's HDR state is unknown");
+        }
+      }
+      hdr_display_info = info;
+    }
+  }
+  if (mode == 2) {
+    return true;
+  }
+  HdrDisplayInfo info = GetLastHdrDisplayInfo();
+  return info.known && info.hdr_enabled;
+}
+
+Presenter::GuestOutputCaptureConverter::GuestOutputCaptureConverter(const GuestOutputHdr& hdr)
+    : is_pq_(hdr.is_pq) {
+  if (!is_pq_) {
+    return;
+  }
+  // HDR10 code values to light relative to the SDR white level.
+  pq_to_relative_.resize(1024);
+  double white = std::max(double(hdr.sdr_white_nits), 1.0);
+  for (uint32_t i = 0; i < 1024; ++i) {
+    double e = std::pow(double(i) / 1023.0, 1.0 / 78.84375);
+    double y = std::max(e - 0.8359375, 0.0) / (18.8515625 - 18.6875 * e);
+    pq_to_relative_[i] = float(10000.0 * std::pow(y, 1.0 / 0.1593017578125) / white);
+  }
+  // Relative light to the SDR code value, inverting the curve SDR content was
+  // decoded with, indexed by the square root of the light.
+  relative_sqrt_to_code_.resize(16384);
+  for (uint32_t i = 0; i < 16384; ++i) {
+    double x = double(i) / 16383.0;
+    x *= x;
+    double code = hdr.sdr_pure_gamma_2_2
+                      ? std::pow(x, 1.0 / 2.2)
+                      : (x > 0.0031308 ? 1.055 * std::pow(x, 1.0 / 2.4) - 0.055 : 12.92 * x);
+    relative_sqrt_to_code_[i] = uint8_t(std::clamp(code * 255.0 + 0.5, 0.0, 255.0));
+  }
+}
+
+uint32_t Presenter::GuestOutputCaptureConverter::operator()(uint32_t rgb10) const {
+  if (!is_pq_) {
+    return Packed10bpcRGBTo8bpcBytes(rgb10);
+  }
+  // BT.2020 to Rec.709.
+  float r2020 = pq_to_relative_[rgb10 & 0x3FF];
+  float g2020 = pq_to_relative_[(rgb10 >> 10) & 0x3FF];
+  float b2020 = pq_to_relative_[(rgb10 >> 20) & 0x3FF];
+  float rgb[3] = {
+      std::max(1.660491f * r2020 - 0.587641f * g2020 - 0.072850f * b2020, 0.0f),
+      std::max(-0.124550f * r2020 + 1.132900f * g2020 - 0.008349f * b2020, 0.0f),
+      std::max(-0.018151f * r2020 - 0.100579f * g2020 + 1.118730f * b2020, 0.0f)};
+  float largest = std::max(rgb[0], std::max(rgb[1], rgb[2]));
+  float scale = largest > 1.0f ? 1.0f / largest : 1.0f;
+  uint32_t code[3];
+  for (uint32_t i = 0; i < 3; ++i) {
+    code[i] = relative_sqrt_to_code_[uint32_t(std::sqrt(rgb[i] * scale) * 16383.0f + 0.5f)];
+  }
+  if constexpr (std::endian::native == std::endian::big) {
+    return (code[0] << 24) | (code[1] << 16) | (code[2] << 8) | 0xFF;
+  }
+  return code[0] | (code[1] << 8) | (code[2] << 16) | (uint32_t(0xFF) << 24);
+}
