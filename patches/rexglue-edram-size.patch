diff --git a/src/graphics/shaders/resolve_edram4096.xesli b/src/graphics/shaders/resolve_edram4096.xesli
new file mode 100644
index 0000000..d15344d
--- /dev/null
+++ b/src/graphics/shaders/resolve_edram4096.xesli
@@ -0,0 +1,60 @@
+// The resolve shaders for a host EDRAM of 4096 tiles (edram_tiles = 4096),
+// built from xenia's resolve sources unchanged: this file goes before them in
+// the resolve_*_edram4096 entry files and redirects two of their functions.
+// - XeEdramOffsetInts wraps the address at 4096 tiles instead of 2048 (the
+//   console's 11-bit periodic EDRAM addressing).
+// - XeResolveGetInfo also takes bit 11 of the EDRAM base, which the host
+//   passes in bit 30 of xe_resolve_edram_info (ResolveEdramInfo::
+//   base_tiles_bit_11); bits 0 to 29 are as for 2048 tiles.
+
+#ifndef XENIA_GPU_SHADERS_RESOLVE_EDRAM4096_XESLI_
+#define XENIA_GPU_SHADERS_RESOLVE_EDRAM4096_XESLI_
+
+#include "edram.xesli"
+
+// XeEdramOffsetInts of edram.xesli with the period of 4096 tiles.
+uint XeEdramOffsetInts4096(uint2_xe pixel_index, uint base_tiles, bool wrap,
+                           uint pitch_tiles, uint msaa_samples, bool is_depth,
+                           uint format_ints_log2, uint pixel_sample_index,
+                           uint2_xe resolution_scale) {
+  uint2_xe rt_sample_index =
+      pixel_index <<
+      uint2_xe(greater_than_equal_xe(
+          uint_x2_xe(msaa_samples),
+          uint2_xe(kXenosMsaaSamples_4X, kXenosMsaaSamples_2X)));
+  rt_sample_index += (uint_x2_xe(pixel_sample_index) >> uint2_xe(1u, 0u)) & 1u;
+  uint2_xe tile_size_at_32bpp = uint2_xe(80u, 16u) * resolution_scale;
+  uint2_xe tile_size_samples =
+      tile_size_at_32bpp >> uint2_xe(format_ints_log2, 0u);
+  uint2_xe tile_offset_xy = rt_sample_index / tile_size_samples;
+  base_tiles += tile_offset_xy.y * pitch_tiles + tile_offset_xy.x;
+  rt_sample_index -= tile_offset_xy * tile_size_samples;
+  if (is_depth) {
+    uint tile_width_half = tile_size_samples.x >> 1u;
+    rt_sample_index.x =
+        uint(int(rt_sample_index.x) +
+             ((rt_sample_index.x >= tile_width_half) ? -int(tile_width_half)
+                                                     : int(tile_width_half)));
+  }
+  uint address =
+      base_tiles * (tile_size_at_32bpp.x * tile_size_at_32bpp.y) +
+      ((rt_sample_index.y * tile_size_samples.x + rt_sample_index.x) <<
+       format_ints_log2);
+  if (wrap) {
+    address %= tile_size_at_32bpp.x * tile_size_at_32bpp.y * 4096u;
+  }
+  return address;
+}
+#define XeEdramOffsetInts XeEdramOffsetInts4096
+
+#include "resolve.xesli"
+
+XeResolveInfo XeResolveGetInfo4096(param_push_consts_xe) {
+  XeResolveInfo resolve_info = XeResolveGetInfo(pass_push_consts_xe);
+  resolve_info.edram_base_tiles |=
+      (push_const_xe(xe_resolve_edram_info) >> (30u - 11u)) & (1u << 11u);
+  return resolve_info;
+}
+#define XeResolveGetInfo XeResolveGetInfo4096
+
+#endif  // XENIA_GPU_SHADERS_RESOLVE_EDRAM4096_XESLI_
