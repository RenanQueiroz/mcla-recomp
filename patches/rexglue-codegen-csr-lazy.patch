diff --git a/include/rex/ppc/context.h b/include/rex/ppc/context.h
index 777023e..a3d43bb 100644
--- a/include/rex/ppc/context.h
+++ b/include/rex/ppc/context.h
@@ -212,6 +212,52 @@ struct FPSCRRegister {
     }
   }
 
+  // The switches the code generator emits with csr_cheap_switch (config/mcla.toml). Same MXCSR
+  // as the calls above, without building the word from the shadow: with the guest's rounding
+  // mode at "to nearest", which is where the game keeps it, the two words are constants, so the
+  // value written does not wait for the load of the shadow, and the shadow is updated by one
+  // read-modify-write. Any other rounding mode takes the old calls. The exception flags in the
+  // MXCSR come out clear instead of as the shadow had them; nothing reads them (mffs returns the
+  // rounding field only). Other CPUs keep the old calls.
+#if defined(__x86_64__) || defined(_M_X64)
+  static constexpr uint32_t kMxcsrFpuNearest = uint32_t(Platform::ExceptionMask);
+  static constexpr uint32_t kMxcsrVmxNearest =
+      uint32_t(Platform::ExceptionMask) | uint32_t(FlushMask);
+
+  inline void enableFlushModeFast() noexcept {
+    if ((csr & RoundMaskVal) == 0) [[likely]] {
+      csr |= FlushMask;
+      Platform::setcsr(kMxcsrVmxNearest);
+    } else {
+      enableFlushModeUnconditional();
+    }
+  }
+
+  inline void disableFlushModeFast() noexcept {
+    if ((csr & RoundMaskVal) == 0) [[likely]] {
+      csr &= ~FlushMask;
+      Platform::setcsr(kMxcsrFpuNearest);
+    } else {
+      disableFlushModeUnconditional();
+    }
+  }
+#else
+  inline void enableFlushModeFast() noexcept { enableFlushModeUnconditional(); }
+  inline void disableFlushModeFast() noexcept { disableFlushModeUnconditional(); }
+#endif
+
+  inline void enableFlushModeCheckedFast() noexcept {
+    if ((csr & FlushMask) != FlushMask) [[unlikely]] {
+      enableFlushModeFast();
+    }
+  }
+
+  inline void disableFlushModeCheckedFast() noexcept {
+    if ((csr & FlushMask) != 0) [[unlikely]] {
+      disableFlushModeFast();
+    }
+  }
+
   inline void InitHost() noexcept {
     csr = getcsr();
     Platform::InitHostExceptions(csr);
