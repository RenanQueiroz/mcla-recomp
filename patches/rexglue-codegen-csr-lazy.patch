@@ -333,13 +333,25 @@ void BuilderContext::emit_set_flush_mode(bool enable) {
   auto newState = enable ? CSRState::VMX : CSRState::FPU;
   if (csrState != newState) {
     auto prefix = enable ? "enable" : "disable";
-    auto suffix = csrState != CSRState::Unknown ? "Unconditional" : "";
-    println("\tctx.fpscr.{}FlushMode{}();", prefix, suffix);
+    // Known to be in the other mode: switch without looking. Unknown: look at the shadow first.
+    if (config().csrCheapSwitch) {
+      auto suffix = csrState != CSRState::Unknown ? "Fast" : "CheckedFast";
+      println("\tctx.fpscr.{}FlushMode{}();", prefix, suffix);
+    } else {
+      auto suffix = csrState != CSRState::Unknown ? "Unconditional" : "";
+      println("\tctx.fpscr.{}FlushMode{}();", prefix, suffix);
+    }
 
     csrState = newState;
   }
 }
 
+void BuilderContext::emit_flush_mode_free_op() {
+  if (config().csrModeFreeOps)
+    return;
+  emit_set_flush_mode(false);
+}
+
 bool BuilderContext::has_mid_asm_hook() const {
   return config().midAsmHooks.find(base) != config().midAsmHooks.end();
 }
