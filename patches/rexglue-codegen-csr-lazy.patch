+  /// csr_mode_free_ops: the scalar floating-point instructions that only move bits (fmr, fabs, fnabs,
+  /// fneg, lfd*, stfd*, stfiwx) or truncate (fctidz, fctiwz, fcfid) give the same result whether
+  /// denormals are flushed (VMX mode) or kept (FPU mode), so they ask for no mode and no switch is
+  /// emitted for them.
+  bool csrModeFreeOps = false;
+  /// csr_cheap_switch: a mode switch writes a constant MXCSR word when the guest's rounding mode
+  /// is "to nearest" (x86-64 hosts; other rounding modes and other hosts keep the old calls).
+  bool csrCheapSwitch = false;
+
