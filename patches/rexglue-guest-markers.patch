diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index 3f31f72..ec99380 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -176,6 +176,22 @@ class CommandProcessor {
   virtual void OnGammaRamp256EntryTableValueWritten() {}
   virtual void OnGammaRampPWLValueWritten() {}
 
+  // Guest markers: a PM4 type-3 NOP of 3 words, 'REXM' (0x5245584D), kind,
+  // value, written into the command stream by a title's own code (MCLA's
+  // src/render_markers.cpp). They draw nothing; kinds are listed in
+  // GuestMarkerKind. Inside predicated tiling a marker is replayed once per
+  // tile, so whatever acts on one must be idempotent.
+  enum class GuestMarkerKind : uint32_t {
+    kFrameBegin = 1,    // value: the title's frame counter
+    kFrameEnd = 2,      // the frame's rendering code returned
+    kSceneEnd = 3,      // the 3D scene is complete, post-processing begins
+    kTonemapBegin = 4,  // the next draws tone-map the scene into the 8-bit target
+    kUIBegin = 5,       // the HUD / UI is drawn from here on
+    kRenderEnd = 6,     // the title's render loop returned (UI drawn after it)
+    kPhase = 0x100,     // diagnostics: value = a title-specific phase
+  };
+  virtual void OnGuestMarker([[maybe_unused]] uint32_t kind, [[maybe_unused]] uint32_t value) {}
+
   virtual void MakeCoherent();
   virtual void PrepareForWait();
   virtual void ReturnFromWait();
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index f69a41e..069c000 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -950,6 +950,17 @@ bool CommandProcessor::ExecutePacketType3_NOP(memory::RingBuffer* reader, uint32
                                               uint32_t count) {
   // skip N 32-bit words to get to the next packet
   // No-op, ignore some data.
+  if (count == 3) {
+    // Possibly a guest marker ('REXM', kind, value), see OnGuestMarker.
+    uint32_t words[3];
+    for (uint32_t& word : words) {
+      word = reader->ReadAndSwap<uint32_t>();
+    }
+    if (words[0] == 0x5245584D) {
+      OnGuestMarker(words[1], words[2]);
+    }
+    return true;
+  }
   reader->AdvanceRead(count * sizeof(uint32_t));
   return true;
 }
