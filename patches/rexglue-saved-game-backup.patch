+void ContentManager::KeepContentBackup(const std::string_view root_name, uint64_t xuid,
+                                       const XCONTENT_AGGREGATE_DATA& data) {
+  // CHECK: that a save reaches XamContentClose for the root it created, after writing. The game's
+  // content layer calls its wrapper from sub_82617300, sub_82617C70, sub_82617F98 and
+  // sub_822C4388; none was followed from the save. If it never closes, the copy stays and the
+  // previous save comes back at the next start (the log's "is being rewritten" line without a
+  // "closed" line after it shows that).
+  if (data.content_type != XContentType::kSavedGame) {
+    return;
+  }
+  auto global_lock = global_critical_region_.Acquire();
+  if (IsContentOpen(data)) {
+    return;  // DeleteContent refuses it as well
+  }
+  const auto package_path = ResolvePackagePath(xuid, data);
+  const auto backup_path = BackupPathFor(package_path);
+  std::error_code ec;
+  if (backup_path.empty() || !std::filesystem::exists(package_path, ec)) {
+    return;
+  }
+  const auto marker = BackupMarkerFor(backup_path);
+  const auto name = rex::path_to_utf8(package_path.filename());
+
+  // An older copy belongs to a save the title never closed before asking for this one.
+  RemoveBackup(package_path);
+  std::filesystem::create_directories(backup_path.parent_path(), ec);
+  if (!ec && !rex::filesystem::CreateEmptyFile(marker)) {
+    ec = std::make_error_code(std::errc::io_error);
+  }
+  if (ec) {
+    REXSYS_WARN("content: no copy of the saved game '{}' kept before it is rewritten: {}", name,
+                ec.message());
+    return;
+  }
+  std::filesystem::rename(package_path, backup_path, ec);
+  if (ec) {
+    // The package cannot be moved (a file of it held open by a scanner or a sync client, say):
+    // copy it, and the caller deletes the original as it always did. The marker comes after the
+    // copy here, so that a copy cut short is never put back over the package, which is still whole.
+    ec.clear();
+    std::filesystem::remove(marker, ec);
+    ec.clear();
+    std::filesystem::remove_all(backup_path, ec);
+    ec.clear();
+    std::filesystem::copy(package_path, backup_path, std::filesystem::copy_options::recursive,
+                          ec);
+    if (!ec && !rex::filesystem::CreateEmptyFile(marker)) {
+      ec = std::make_error_code(std::errc::io_error);
+    }
+    if (ec) {
+      REXSYS_WARN("content: no copy of the saved game '{}' kept before it is rewritten: {}", name,
+                  ec.message());
+      RemoveBackup(package_path);
+      return;
+    }
+  }
+  kept_backups_.erase(string::string_key_case(root_name));
+  kept_backups_.insert({string::string_key_case::create(root_name), package_path});
+  REXSYS_INFO(
+      "content: saved game '{}' is being rewritten; its previous contents are kept until '{}' is "
+      "closed",
+      name, root_name);
+}
+
+bool ContentManager::HasUnclosedBackups() {
+  auto global_lock = global_critical_region_.Acquire();
+  return !kept_backups_.empty();
+}
+
+void ContentManager::DropKeptBackup(const std::string_view root_name) {
+  std::filesystem::path package_path;
+  {
+    auto global_lock = global_critical_region_.Acquire();
+    auto it = kept_backups_.find(string::string_key_case(root_name));
+    if (it == kept_backups_.end()) {
+      return;
+    }
+    package_path = it->second;
+    kept_backups_.erase(it);
+  }
+  RemoveBackup(package_path);
+  REXSYS_INFO("content: '{}' closed; the previous contents of saved game '{}' are no longer kept",
+              root_name, rex::path_to_utf8(package_path.filename()));
+}
+
+void ContentManager::RestoreInterruptedSaves() {
+  // A backup with its marker still here is of a save that never reached its close: the process
+  // ended (crashed, was killed) while the title was writing it, so the package is whatever that
+  // left. The backup goes back in its place. A backup without a marker is the leftover of a save
+  // that did finish (its removal failed): it is not the latest, and is deleted.
+  // content_root/xuid/title_id/Backups/content_type/name
+  for (const auto& xuid_dir : ListSubdirectories(root_path_)) {
+    if (!IsHexName(xuid_dir.filename(), 16)) {
+      continue;
+    }
+    for (const auto& title_dir : ListSubdirectories(xuid_dir)) {
+      if (!IsHexName(title_dir.filename(), 8)) {
+        continue;
+      }
+      for (const auto& type_dir : ListSubdirectories(title_dir / kGameContentBackupDirName)) {
+        if (!IsHexName(type_dir.filename(), 8)) {
+          continue;
+        }
+        for (const auto& backup_path : ListSubdirectories(type_dir)) {
+          const auto package_path = title_dir / type_dir.filename() / backup_path.filename();
+          const auto marker = BackupMarkerFor(backup_path);
+          const auto name = rex::path_to_utf8(backup_path.filename());
+          std::error_code ec;
+          if (!std::filesystem::exists(marker, ec)) {
+            std::filesystem::remove_all(backup_path, ec);
+            continue;
+          }
+          std::filesystem::remove_all(package_path, ec);
+          if (!ec) {
+            std::filesystem::create_directories(package_path.parent_path(), ec);
+          }
+          if (!ec) {
+            std::filesystem::rename(backup_path, package_path, ec);
+          }
+          if (ec) {
+            REXSYS_ERROR("content: could not put back saved game '{}' from '{}': {}", name,
+                         rex::path_to_utf8(backup_path), ec.message());
+            continue;
+          }
+          std::filesystem::remove(marker, ec);
+          REXSYS_WARN(
+              "content: saved game '{}' was being rewritten when the game ended; its previous "
+              "contents are back",
+              name);
+        }
+      }
+    }
+  }
+}
