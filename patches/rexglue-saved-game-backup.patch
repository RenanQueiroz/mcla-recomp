 static const char* kGameContentHeaderDirName = "Headers";
 
+static const char* kGameContentBackupDirName = "Backups";
+
+static const char* kBackupMarkerSuffix = ".inprogress";
+
+// The folders above a package are named by the SDK with hex digits: 16 for the XUID, 8 for the
+// title and the content type.
+static bool IsHexName(const std::filesystem::path& name, size_t digits) {
+  const auto& text = name.native();
+  if (text.size() != digits) {
+    return false;
+  }
+  return std::all_of(text.begin(), text.end(), [](auto c) {
+    return (c >= '0' && c <= '9') || (c >= 'A' && c <= 'F') || (c >= 'a' && c <= 'f');
+  });
+}
+
+static std::vector<std::filesystem::path> ListSubdirectories(
+    const std::filesystem::path& directory) {
+  std::vector<std::filesystem::path> result;
+  std::error_code ec;
+  for (std::filesystem::directory_iterator it(directory, ec), end; !ec && it != end;
+       it.increment(ec)) {
+    std::error_code entry_ec;
+    if (it->is_directory(entry_ec)) {
+      result.push_back(it->path());
+    }
+  }
+  return result;
+}
+
+// Package path:  content_root/xuid/title_id/content_type/name
+// Backup path:   content_root/xuid/title_id/Backups/content_type/name
+static std::filesystem::path BackupPathFor(const std::filesystem::path& package_path) {
+  const auto type_dir = package_path.parent_path();
+  if (package_path.filename().empty() || type_dir.filename().empty()) {
+    return {};
+  }
+  return type_dir.parent_path() / kGameContentBackupDirName / type_dir.filename() /
+         package_path.filename();
+}
+
+// An empty file beside the kept copy: while it is there the copy is of a save that is not complete.
+static std::filesystem::path BackupMarkerFor(const std::filesystem::path& backup_path) {
+  std::filesystem::path marker = backup_path;
+  marker += kBackupMarkerSuffix;
+  return marker;
+}
+
+// The save is complete (or the content is being deleted): the marker goes first, because without
+// it nothing is put back, then the copy.
+static void RemoveBackup(const std::filesystem::path& package_path) {
+  const auto backup_path = BackupPathFor(package_path);
+  if (backup_path.empty()) {
+    return;
+  }
+  std::error_code marker_ec;
+  std::filesystem::remove(BackupMarkerFor(backup_path), marker_ec);
+  std::error_code ec;
+  std::filesystem::remove_all(backup_path, ec);
+  if (marker_ec || ec) {
+    REXSYS_WARN("content: could not remove the kept copy of '{}': {}",
+                rex::path_to_utf8(package_path.filename()),
+                (marker_ec ? marker_ec : ec).message());
+  }
+}
