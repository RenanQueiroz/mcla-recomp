diff --git a/src/core/dynlib_posix.cpp b/src/core/dynlib_posix.cpp
index b44459b..17d1b91 100644
--- a/src/core/dynlib_posix.cpp
+++ b/src/core/dynlib_posix.cpp
@@ -34,6 +34,20 @@ bool DynamicLibrary::Load(const std::filesystem::path& path, SymbolResolution mo
   return handle_ != nullptr;
 }
 
+bool DynamicLibrary::Attach(const std::filesystem::path& path, SymbolResolution mode) {
+  Close();
+#ifdef RTLD_NOLOAD
+  // RTLD_NOLOAD only succeeds if the library is already loaded (and then bumps its refcount).
+  int flags = ((mode == SymbolResolution::kImmediate) ? RTLD_NOW : RTLD_LAZY) | RTLD_NOLOAD;
+  handle_ = dlopen(path.c_str(), flags);
+#else
+  // No way to tell whether it is loaded without loading it: report that it is not.
+  (void)path;
+  (void)mode;
+#endif
+  return handle_ != nullptr;
+}
