+void VulkanPipelineCache::SaveVkPipelineCache() {
+  if (vk_pipeline_cache_ == VK_NULL_HANDLE || vk_pipeline_cache_path_.empty()) {
+    return;
+  }
+  // Cleared before reading, so pipelines created meanwhile request another save.
+  vk_pipeline_cache_dirty_.store(false, std::memory_order_relaxed);
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  std::vector<uint8_t> pipeline_cache_data;
+  // The cache may grow between getting the size and the data.
+  VkResult result = VK_INCOMPLETE;
+  for (uint32_t attempt = 0; attempt < 4 && result == VK_INCOMPLETE; ++attempt) {
+    size_t pipeline_cache_size = 0;
+    if (dfn.vkGetPipelineCacheData(device, vk_pipeline_cache_, &pipeline_cache_size, nullptr) !=
+            VK_SUCCESS ||
+        !pipeline_cache_size) {
+      return;
+    }
+    pipeline_cache_data.resize(pipeline_cache_size);
+    result = dfn.vkGetPipelineCacheData(device, vk_pipeline_cache_, &pipeline_cache_size,
+                                        pipeline_cache_data.data());
+    pipeline_cache_data.resize(pipeline_cache_size);
+  }
+  if (result != VK_SUCCESS) {
+    return;
+  }
+  // Written next to it and renamed, so a run ending during the write doesn't
+  // leave a partial file.
+  std::filesystem::path temporary_path = vk_pipeline_cache_path_;
+  temporary_path += ".tmp";
+  FILE* pipeline_cache_file = rex::filesystem::OpenFile(temporary_path, "wb");
+  if (!pipeline_cache_file) {
+    return;
+  }
+  bool written = fwrite(pipeline_cache_data.data(), 1, pipeline_cache_data.size(),
+                        pipeline_cache_file) == pipeline_cache_data.size();
+  written = fclose(pipeline_cache_file) == 0 && written;
+  std::error_code rename_error;
+  if (written) {
+    std::filesystem::rename(temporary_path, vk_pipeline_cache_path_, rename_error);
+  }
+  if (!written || rename_error) {
+    std::filesystem::remove(temporary_path, rename_error);
+    return;
+  }
+  REXGPU_DEBUG("Saved {} bytes of VkPipelineCache data", pipeline_cache_data.size());
+}
