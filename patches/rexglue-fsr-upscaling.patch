+void CommandProcessor::TaaUpscaleFail(const char* why) {
+  static std::atomic<bool> logged{false};
+  if (!logged.exchange(true)) {
+    REXGPU_ERROR("FSR upscaling: giving up for this session ({})", why);
+  }
+  rex::cvar::SetFlagByName("temporal_aa_upscale_available", "no");
