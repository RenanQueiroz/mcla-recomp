+
+void CommandProcessor::TaaUpscaleDecide() {
+  // At the scene's first draw of a frame that may be squeezed: gameplay is one
+  // single-sampled surface of the output's width. The three-tile 4x MSAA worlds behind
+  // the pause menu and the GPS map are not squeezed.
+  taa_frame_.up_state = 2;
+  if (!taa_frame_.up_armed) {
+    return;
+  }
+  const RegisterFile& regs = *register_file_;
+  auto surface = regs.Get<reg::RB_SURFACE_INFO>();
+  uint32_t scale_x = 1, scale_y = 1;
+  HdrDrawResolutionScale(scale_x, scale_y);
+  if (surface.msaa_samples != xenos::MsaaSamples::k1X || !taa_up_.out_width ||
+      surface.surface_pitch * scale_x != taa_up_.out_width ||
+      taa_up_.render_width >= taa_up_.out_width || !HdrHostRenderTargets()) {
+    return;
+  }
+  taa_up_.scene_pitch = surface.surface_pitch;
+  taa_frame_.up_state = 1;
+}
+
+bool CommandProcessor::TaaDrawSqueezed() const {
+  return taa_frame_.up_state == 1 && taa_frame_.in_scene &&
+         register_file_->Get<reg::RB_SURFACE_INFO>().surface_pitch == taa_up_.scene_pitch;
+}
+
+float CommandProcessor::TaaPsParamGenScale() const {
+  if (!TaaDrawSqueezed() || !taa_up_.render_width) {
+    return 1.0f;
+  }
+  return float(taa_up_.out_width) / float(taa_up_.render_width);
+}
+
+uint32_t CommandProcessor::TaaLodBias() const {
+  if (!TaaDrawSqueezed() || !taa_up_.render_width) {
+    return 0;
+  }
+  // The pixels of the scene are (output / render) times as far apart, so textures are
+  // sampled at that many times the size: log2 of it, in eighths, a level sharper.
+  float bias = std::log2(float(taa_up_.out_width) / float(taa_up_.render_width)) * 8.0f;
+  return uint32_t(std::clamp(bias + 0.5f, 0.0f, 15.0f));
+}
+
+void CommandProcessor::TaaSqueeze(uint32_t viewport_offset[2], uint32_t viewport_extent[2],
+                                  uint32_t scissor_offset[2], uint32_t scissor_extent[2]) {
+  if (!TaaDrawSqueezed()) {
+    return;
+  }
+  const uint32_t render[2] = {taa_up_.render_width, taa_up_.render_height};
+  const uint32_t output[2] = {taa_up_.out_width, taa_up_.out_height};
+  // The edges are scaled, not the sizes, so that rectangles that meet still do.
+  auto scale = [&](uint32_t offset[2], uint32_t extent[2]) {
+    for (uint32_t i = 0; i < 2; ++i) {
+      uint64_t begin = (uint64_t(offset[i]) * render[i] + output[i] / 2) / output[i];
+      uint64_t end = (uint64_t(offset[i]) + extent[i]) * render[i];
+      end = (end + output[i] / 2) / output[i];
+      if (extent[i] && end <= begin) {
+        end = begin + 1;
+      }
+      offset[i] = uint32_t(begin);
+      extent[i] = uint32_t(end - begin);
+    }
