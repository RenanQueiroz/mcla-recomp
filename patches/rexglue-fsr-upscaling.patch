+      ui::d3d12::util::CreateRootSignature(provider, desc);
+  if (taa_gather_root_signature_) {
+    *(taa_gather_pipeline_.ReleaseAndGetAddressOf()) = ui::d3d12::util::CreateComputePipeline(
+        provider.GetDevice(), shaders::taa_upscale_gather_mcla_cs,
+        sizeof(shaders::taa_upscale_gather_mcla_cs), taa_gather_root_signature_.Get());
+  }
+  if (!taa_gather_pipeline_) {
+    REXGPU_ERROR("FSR upscaling: failed to create the gather pipeline");
+    taa_pipeline_failed_ = true;
+    return false;
+  }
