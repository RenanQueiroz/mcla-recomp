index 0000000..0737970
--- /dev/null
+++ b/src/graphics/shaders/taa_upscale_gather_mcla.cs.xesl
@@ -0,0 +1,115 @@
+// FSR upscaling (rexglue-fsr-upscaling.patch): the motion vectors of taa_motion_vectors_mcla.cs
+// at the render size, and FSR's colour and depth inputs, gathered from the output-size
+// textures of the scene (Midnight Club: Los Angeles's motion blur inputs, at its draw).
+//
+// The scene was drawn into the top-left render-size part of the render targets and
+// resolved with a nearest-neighbour stretch to the output size (resolve_direct.xesli,
+// XE_RESOLVE_DIRECT_STRETCH): output pixel d shows the squeezed pixel
+// ((2d + 1) * render) / (2 * output). So the squeezed pixel i is exactly the output
+// pixel that is the first to show it, d(i) = (2 * output * i + render - 1) / (2 * render),
+// which is where this takes the colour, the depth and the stencil from (what a draw at
+// the render size wrote, without the stretch's repeats). Everything else is the vectors
+// pass: per render pixel, the unjittered position (centre minus the frame's jitter) and
+// the depth (1 near, 0 far) make the clip position, which the matrix of the pixel's
+// stencil vehicle ID (0 the world, 1-23 a car, x >> 2 of the stencil view) takes to where
+// it was in the previous frame in guest pixels. Output: previous minus current in render
+// pixels (y down), R16G16 float; the colour (R16G16B16A16 float) and the depth (R32 float).
+
+#include "../../ui/shaders/xesl.xesli"
+
+// The texture caches bind 2D textures as 2D arrays (layer 0 here).
+#if SHADING_LANGUAGE_GLSL_XE
+  #define XeTaaTexture texture2DArray
+  #define XeTaaFetch(texture_name, position) \
+      texelFetch(texture_name, int3_xe(position, 0), 0)
+  #define XeTaaVectorsFormat rg16f
+  #define XeTaaColorFormat rgba16f
+  #define XeTaaDepthFormat r32f
+#else
+  #define XeTaaTexture Texture2DArray<float4_xe>
+  #define XeTaaFetch(texture_name, position) \
+      ((texture_name).Load(int4_xe(position, 0, 0)))
+  #define XeTaaVectorsFormat float2_xe
+  #define XeTaaColorFormat float4_xe
+  #define XeTaaDepthFormat float
+#endif
+
+const_buffer_begin_xe(xe_taa_up, set=0, binding=0, b0, space0)
+  // Per vehicle ID, 4 rows each: clip position to previous guest pixels.
+  float4_xe xe_taa_up_previous[96];
+  // Render width, height; render pixels per guest pixel (x, y).
+  float4_xe xe_taa_up_size;
+  // The jitter (render pixels, y down); which component of the stencil view is the
+  // stencil (its first byte, after the fetch constant's swizzle).
+  float4_xe xe_taa_up_jitter;
+  // Output width, height, render width, height.
+  uint4_xe xe_taa_up_map;
+const_buffer_end_xe(xe_taa_up)
+
+#define LOCAL_SIZE_X_XE 16
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+entry_bindings_begin_compute_xe
+  const_buffer_binding_xe(xe_taa_up, buffer(0))
+  entry_binding_next_xe
+  texture_xe(XeTaaTexture, xe_taa_up_depth, set=0, binding=1, t0, space0, texture(0))
+  entry_binding_next_xe
+  texture_xe(XeTaaTexture, xe_taa_up_stencil, set=0, binding=2, t1, space0, texture(1))
+  entry_binding_next_xe
+  texture_xe(XeTaaTexture, xe_taa_up_scene, set=0, binding=3, t2, space0, texture(2))
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, XeTaaVectorsFormat, xe_taa_up_vectors, set=0, binding=4, u0,
+              space0, texture(3))
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, XeTaaColorFormat, xe_taa_up_color, set=0, binding=5, u1,
+              space0, texture(4))
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, XeTaaDepthFormat, xe_taa_up_depth_out, set=0, binding=6, u2,
+              space0, texture(5))
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+  uint2_xe pixel_index = in_global_thread_id_xe.xy;
+  float4_xe size = constant_xe(xe_taa_up, xe_taa_up_size);
+  dont_flatten_xe
+  if (any(greater_than_equal_xe(pixel_index, uint2_xe(size.xy)))) {
+    return;
+  }
+  uint4_xe map = constant_xe(xe_taa_up, xe_taa_up_map);
+  uint2_xe source = min((pixel_index * map.xy * 2u + map.zw - 1u) / (map.zw * 2u), map.xy - 1u);
+  float depth = XeTaaFetch(xe_taa_up_depth, source).x;
+  float stencil =
+      XeTaaFetch(xe_taa_up_stencil, source)[uint(constant_xe(xe_taa_up, xe_taa_up_jitter).z)];
+  float4_xe color = XeTaaFetch(xe_taa_up_scene, source);
+  uint id = uint(stencil * 255.0f + 0.5f) >> 2u;
+  if (id >= 24u) {
+    id = 0u;
+  }
+  float2_xe position = float2_xe(pixel_index) + 0.5f - constant_xe(xe_taa_up, xe_taa_up_jitter).xy;
+  float2_xe uv = position / size.xy;
+  float4_xe clip = float4_xe(uv.x * 2.0f - 1.0f, 1.0f - uv.y * 2.0f, 1.0f - depth, 1.0f);
+  uint row = id * 4u;
+  float4_xe previous = clip.x * constant_xe(xe_taa_up, xe_taa_up_previous)[row] +
+                       clip.y * constant_xe(xe_taa_up, xe_taa_up_previous)[row + 1u] +
+                       clip.z * constant_xe(xe_taa_up, xe_taa_up_previous)[row + 2u] +
+                       clip.w * constant_xe(xe_taa_up, xe_taa_up_previous)[row + 3u];
+  float2_xe motion = float2_xe(0.0f, 0.0f);
+  if (abs(previous.w) > 1.0e-20f) {
+    motion = previous.xy / previous.w * size.zw - position;
+    // Not NaN (by the bits: a compiler may fold x == x), and within the frame.
+    if ((float_bits_to_uint_xe(motion.x) & 0x7FFFFFFFu) > 0x7F800000u ||
+        (float_bits_to_uint_xe(motion.y) & 0x7FFFFFFFu) > 0x7F800000u) {
+      motion = float2_xe(0.0f, 0.0f);
+    }
+    motion = clamp(motion, -size.xy, size.xy);
+  }
