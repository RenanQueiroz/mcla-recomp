+      pct(now.rounds_ue, prev.rounds_ue), us(now.tsc_s, prev.tsc_s), us(now.tsc_v, prev.tsc_v),
+      us(now.flagged, prev.flagged), per(now.cs_calls, prev.cs_calls), us(now.cs_ticks, prev.cs_ticks),
+      per(now.wait_calls, prev.wait_calls), us(now.wait_ticks, prev.wait_ticks), tpu);
