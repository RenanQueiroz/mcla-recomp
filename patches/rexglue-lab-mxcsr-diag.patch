+  const uint64_t now_us = NowUs();
+  const double secs = static_cast<double>(now_us - st.prev_us) / 1e6;
+  const double rounds = static_cast<double>(now.rounds - prev.rounds);
+  const double tpu = LabTscPerUs();  // ticks per microsecond
+  const auto per = [&](uint64_t a, uint64_t b) { return rounds > 0 ? static_cast<double>(a - b) / rounds : 0.0; };
+  const auto us = [&](uint64_t a, uint64_t b) {
+    return rounds > 0 && tpu > 0 ? static_cast<double>(a - b) / tpu / rounds : 0.0;
+  };
