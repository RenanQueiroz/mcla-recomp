+  inline void diagBegin() noexcept {
+    Platform::setcsr(Platform::getcsr() & ~0x3Fu);
+    diag.last_tsc = __builtin_ia32_rdtsc();
+  }
+  // Its end: closes the last stretch and stops the clock (the time outside it belongs to nobody).
+  inline void diagEnd() noexcept {
+    diagStretch(Platform::getcsr(), false);
+    diag.last_tsc = 0;
+  }
