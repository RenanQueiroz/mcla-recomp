+  // Index 0: stretches in the scalar (denormals kept) mode, 1: in the vector (flush to zero) mode. A stretch is the
+  // time between two writes of the MXCSR; the flags are sticky, so the value read just before a write tells what
+  // happened in the stretch it ends.
+  struct MxcsrDiag {
+    uint64_t switches;     // writes of the MXCSR (not counting diagEnd)
+    uint64_t win[2];       // stretches, by mode
+    uint64_t de[2];        // ... that ended with DE set
+    uint64_t ue[2];        // ... that ended with UE set
+    uint64_t tsc[2];       // time-stamp counter ticks spent in them
+    uint64_t flagged;      // ticks in the stretches that ended with DE or UE set
+    uint64_t last_tsc;
