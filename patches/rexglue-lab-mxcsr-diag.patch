+  inline void diagStretch(uint32_t cur, bool is_switch) noexcept {
+    const uint64_t now = __builtin_ia32_rdtsc();
+    const unsigned m = (cur & uint32_t(FlushMask)) == uint32_t(FlushMask) ? 1u : 0u;
+    const bool de = (cur & 0x02u) != 0;
+    const bool ue = (cur & 0x10u) != 0;
+    diag.switches += is_switch ? 1 : 0;
+    diag.win[m] += 1;
+    diag.de[m] += de ? 1 : 0;
+    diag.ue[m] += ue ? 1 : 0;
+    if (diag.last_tsc) {
+      const uint64_t dt = now - diag.last_tsc;
+      diag.tsc[m] += dt;
+      diag.flagged += (de || ue) ? dt : 0;
+    }
+    diag.last_tsc = now;
+  }
