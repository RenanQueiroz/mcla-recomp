+void CommandProcessor::UpdateGpuMemory(uint64_t now_ms) {
+  const uint32_t log_ms = REXCVAR_GET(gpu_memory_log_ms);
+  const uint32_t pressure_percent = REXCVAR_GET(gpu_memory_pressure_percent);
+  const uint32_t emulate_mb = REXCVAR_GET(gpu_memory_emulate_mb);
+  if (!log_ms && !pressure_percent && !emulate_mb) {
+    if (gpu_memory_pressure_) {
+      gpu_memory_pressure_ = false;
+      OnGpuMemoryPressure(false);
+    }
+    return;
+  }
+  if (now_ms < gpu_memory_next_check_ms_) {
+    return;
+  }
+  gpu_memory_next_check_ms_ = now_ms + 250;
+  GpuMemoryInfo info;
+  const bool have_info = QueryGpuMemoryInfo(info);
+  if (have_info && emulate_mb && !gpu_memory_ballast_tried_) {
+    // Hold what is beyond the pretended size, once, as early as possible.
+    gpu_memory_ballast_tried_ = true;
+    const uint64_t emulated_bytes = uint64_t(emulate_mb) << 20;
+    if (info.budget_bytes > emulated_bytes) {
+      const uint64_t wanted = info.budget_bytes - emulated_bytes;
+      if (AllocateGpuMemoryBallast(wanted)) {
+        gpu_memory_ballast_bytes_ = wanted;
+      }
+      REXGPU_INFO(
+          "Video memory: emulating {} MB: the budget is {} MB, a ballast of {} MB {}", emulate_mb,
+          info.budget_bytes >> 20, wanted >> 20,
+          gpu_memory_ballast_bytes_ ? "is held" : "could not be held (only Direct3D 12 holds one)");
+    } else {
+      REXGPU_INFO("Video memory: emulating {} MB: the budget is {} MB, nothing to hold",
+                  emulate_mb, info.budget_bytes >> 20);
+    }
+  }
+  // What the process uses without the ballast, against the size pretended.
+  const uint64_t usage_bytes = info.usage_bytes > gpu_memory_ballast_bytes_
+                                   ? info.usage_bytes - gpu_memory_ballast_bytes_
+                                   : 0;
+  const uint64_t budget_bytes =
+      emulate_mb ? (uint64_t(emulate_mb) << 20) : info.budget_bytes;
+  if (have_info && pressure_percent && budget_bytes) {
+    const uint64_t percent = usage_bytes * 100 / budget_bytes;
+    const bool pressure =
+        gpu_memory_pressure_ ? percent + 8 >= pressure_percent : percent >= pressure_percent;
+    if (pressure != gpu_memory_pressure_) {
+      gpu_memory_pressure_ = pressure;
+      REXGPU_INFO("Video memory: {} ({} MB of {} MB, {}%)", pressure ? "short" : "no longer short",
+                  usage_bytes >> 20, budget_bytes >> 20, percent);
+      OnGpuMemoryPressure(pressure);
+    }
+  } else if (gpu_memory_pressure_) {
+    gpu_memory_pressure_ = false;
+    OnGpuMemoryPressure(false);
+  }
+  if (log_ms && now_ms >= gpu_memory_next_log_ms_) {
+    gpu_memory_next_log_ms_ = now_ms + log_ms;
+    GpuMemoryStats stats;
+    QueryGpuMemoryStats(stats);
+    REXGPU_INFO(
+        "gpu memory: local_mb={} budget_mb={} nonlocal_mb={} nonlocal_budget_mb={} ballast_mb={} "
+        "emulate_mb={} pressure={} rt_n={} rt_mb={} edram_mb={} resolve_mb={} shared_mb={} "
+        "tex_n={} tex_mb={}",
+        info.usage_bytes >> 20, info.budget_bytes >> 20, info.non_local_usage_bytes >> 20,
+        info.non_local_budget_bytes >> 20, gpu_memory_ballast_bytes_ >> 20, emulate_mb,
+        gpu_memory_pressure_ ? 1 : 0, stats.render_targets, stats.render_targets_bytes >> 20,
+        stats.edram_bytes >> 20, stats.scaled_resolve_bytes >> 20, stats.shared_memory_bytes >> 20,
+        stats.textures, stats.textures_bytes >> 20);
+  }
+}
