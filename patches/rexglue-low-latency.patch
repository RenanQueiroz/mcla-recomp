+/**
+ * Low latency: the frame bookkeeping, the policy and the cvars; the vendors' calls are the
+ * backends' (d3d12/d3d12_low_latency.cpp, vulkan/vulkan_low_latency.cpp).
+ * See include/rex/ui/low_latency.h.
+ */
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <utility>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/platform.h>
+#include <rex/ui/low_latency.h>
+#include <rex/ui/presenter.h>
+
+REXCVAR_DEFINE_STRING(low_latency, "auto", "UI/Presenter",
+                      "The GPU vendor's latency reducer (NVIDIA Reflex, AMD Anti-Lag 2) while the "
+                      "game runs: off, on, or boost (Reflex's On + Boost: the GPU clocks stay "
+                      "high); auto is on for NVIDIA Reflex and off for AMD Anti-Lag 2 "
+                      "(untested; rexglue-low-latency.patch). Frame generation turns it on "
+                      "whatever this says (low_latency_frame_generation)")
+    .allowed({"auto", "off", "on", "boost"})
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_STRING(low_latency_frame_generation, "auto", "UI/Presenter",
+                      "auto: the reducer is on whenever frame generation is on (most games do "
+                      "this; the delay frame generation adds is the one it takes back); off: "
+                      "low_latency alone decides, for troubleshooting (config file only)")
+    .allowed({"auto", "off"})
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_STRING(low_latency_limiter, "auto", "UI/Presenter",
+                      "Who holds the frame rate to the game's limit while the reducer is on: "
+                      "fork: the game's own limiter, which waits at the end of the frame; driver: "
+                      "the driver (the reducer's minimum frame interval), which waits before the "
+                      "frame's input is read, so the input is that much newer when the frame is "
+                      "shown; auto: the driver, where its reducer has been tested and frame "
+                      "generation is off (with it on the game's own is as good or better), else "
+                      "the game's own")
+    .allowed({"auto", "fork", "driver"})
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_BOOL(low_latency_device_extensions, !REX_PLATFORM_PS5, "UI/Presenter",
+                    "Vulkan: ask for the vendor's low latency extensions (VK_NV_low_latency2 and "
+                    "its dependency VK_KHR_present_id on an NVIDIA GPU, VK_AMD_anti_lag on an AMD "
+                    "one) when the device is created, if the device has them. Off by default on "
+                    "the PS5, whose host turns it on when the game starts with low_latency on or "
+                    "boost, or with frame generation chosen, so that the console's device stays as "
+                    "it was otherwise")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
+REXCVAR_DEFINE_STRING(low_latency_debug_backend, "auto", "UI/Presenter",
+                      "Development: auto chooses the reducer from the GPU's vendor and what its "
+                      "driver offers; nvidia or amd tries that one's calls whatever the GPU "
+                      "(on the other vendor's GPU they find no driver, which is how the guards "
+                      "are tested); none turns it off")
+    .allowed({"auto", "nvidia", "amd", "none"})
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+REXCVAR_DEFINE_INT32(low_latency_debug, 0, "UI/Presenter",
+                     "Development, bits: 1 sends the markers even while the reducer is off (a "
+                     "latency tool such as PresentMon then reads them), 2 logs the driver's own "
+                     "report of the latest frames every 300 frames (and sends the markers), 4 "
+                     "leaves the frame of each Vulkan submission to the driver's own rules (no "
+                     "explicit attribution), 8 adds the driver's times of the newest frames, "
+                     "from each one's simulation start, to the report")
+    .range(0, 15)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+namespace rex {
+namespace ui {
+
+namespace {
+
+// Ids of the frames that got an engine timer pass (are marked): the id at id & mask. The
+// update thread sets it, the GPU command thread and the presenters read it.
+constexpr size_t kMarkedFrames = 256;
+std::array<std::atomic<uint64_t>, kMarkedFrames> g_marked_frames;
+
+// The swap packets written so far (VdSwap, the render thread; the high 32 bits) and the frames
+// the update thread started that have no swap yet (the low 32), in one word: a frame's id is
+// both plus one, read at once.
+constexpr uint64_t kSwapUnit = uint64_t(1) << 32;
+constexpr uint64_t kPendingMask = kSwapUnit - 1;
+std::atomic<uint64_t> g_frame_counts{0};
+// A frame that has no swap for this long was lost (the render thread stalled, or the update ran
+// without a frame): the count of such frames is written off, so ids don't stay shifted.
+constexpr int64_t kStaleFrameNs = 250'000'000;
+std::atomic<int64_t> g_last_swap_ns{0};
+std::atomic<uint64_t> g_swaps_executed{0};  // the GPU command thread's swap packets
+std::atomic<uint32_t> g_frame_limit{0};
+
+int64_t SteadyNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+std::mutex g_mutex;
+std::shared_ptr<LowLatencyBackend> g_backend;
+std::string g_unavailable_why;
+std::atomic<bool> g_have_backend{false};
+
+// What the driver has been told, and what the policy asks now. The driver is told nothing until
+// the policy has turned the reducer on (a user's own driver-level setting stays as it is).
+struct Applied {
+  bool on = false;
+  bool boost = false;
+  uint32_t interval_us = 0;
+  bool failed = false;  // the driver refused the mode: no calls, the game's own limiter
+};
+Applied g_applied;                         // the update thread's
+std::string g_failed_why;                  // (g_mutex)
+std::atomic<uint32_t> g_backend_epoch{0};  // changes with the backend: the mode is told again
+std::atomic<bool> g_active{false};         // on, with the driver told
+std::atomic<bool> g_driver_limits{false};
+std::atomic<bool> g_forced{false};
+std::atomic<bool> g_markers{false};              // markers go out (active, or low_latency_debug)
+std::atomic<bool> g_explicit_attribution{true};  // submissions carry their frame (Vulkan)
+
+thread_local uint64_t t_render_frame = 0;    // the frame the GPU command thread is in (marked)
+thread_local bool t_render_started = false;  // its RENDERSUBMIT_START was sent
+thread_local uint64_t t_swap_frame = 0;      // the frame it is swapping now (CurrentFrameId)
+
+std::shared_ptr<LowLatencyBackend> Backend() {
+  if (!g_have_backend.load(std::memory_order_acquire)) {
+    return nullptr;
+  }
+  std::lock_guard lock(g_mutex);
+  return g_backend;
+}
+
+bool IsMarked(uint64_t id) {
+  return id && g_marked_frames[id % kMarkedFrames].load(std::memory_order_acquire) == id;
+}
+
+bool FrameGenerationOn() {
+  return rex::cvar::GetFlagByName("frame_generation") != "off" &&
+         Presenter::GetFrameGenerationStatus().state !=
+             Presenter::FrameGenerationState::kUnavailable;
+}
+
+struct Policy {
+  bool on = false;
+  bool boost = false;
+  uint32_t interval_us = 0;
+  bool forced = false;
+};
+
+// (The settings are read with GetFlagByName, which holds the cvar lock: the menu thread writes
+// them.)
+Policy Evaluate(const LowLatencyBackend& backend) {
+  Policy policy;
+  const std::string setting = rex::cvar::GetFlagByName("low_latency");
+  bool setting_on = setting == "on" || setting == "boost";
+  if (setting == "auto") {
+    setting_on = backend.OnByDefault();
+  }
+  policy.on = setting_on;
+  policy.boost = setting == "boost" && backend.SupportsBoost();
+  const bool frame_generation_on = FrameGenerationOn();
+  if (!policy.on && frame_generation_on &&
+      rex::cvar::GetFlagByName("low_latency_frame_generation") == "auto") {
+    policy.on = true;
+    policy.forced = true;
+  }
+  const uint32_t limit = g_frame_limit.load(std::memory_order_relaxed);
+  if (policy.on && limit && backend.SupportsLimit()) {
+    const std::string limiter = rex::cvar::GetFlagByName("low_latency_limiter");
+    if (limiter == "driver" || (limiter == "auto" && !backend.Untested() && !frame_generation_on)) {
+      policy.interval_us = uint32_t(1000000u / limit);
+    }
+  }
+  return policy;
+}
+
+}  // namespace
+
+LowLatency::Status LowLatency::GetStatus() {
+  Status status;
+  std::shared_ptr<LowLatencyBackend> backend = Backend();
+  if (!backend) {
+    std::lock_guard lock(g_mutex);
+    if (!g_unavailable_why.empty()) {
+      status.state = State::kUnavailable;
+      status.why = g_unavailable_why;
+    }
+    return status;
+  }
+  {
+    // The driver refused the mode: unavailable, as if there were no backend.
+    std::lock_guard lock(g_mutex);
+    if (!g_failed_why.empty()) {
+      status.state = State::kUnavailable;
+      status.name = backend->Name();
+      status.why = g_failed_why;
+      status.untested = backend->Untested();
+      return status;
+    }
+  }
+  status.state = State::kAvailable;
+  status.name = backend->Name();
+  status.active = g_active.load(std::memory_order_relaxed);
+  status.forced_by_frame_generation = g_forced.load(std::memory_order_relaxed);
+  status.boost_available = backend->SupportsBoost();
+  status.untested = backend->Untested();
+  status.on_by_default = backend->OnByDefault();
+  return status;
+}
+
+void LowLatency::Attach(std::shared_ptr<LowLatencyBackend> backend) {
+  {
+    std::lock_guard lock(g_mutex);
+    g_backend = std::move(backend);
+    g_unavailable_why.clear();
+    g_failed_why.clear();
+    g_have_backend.store(g_backend != nullptr, std::memory_order_release);
+  }
+  // The next frame tells the new driver objects the mode.
+  g_backend_epoch.fetch_add(1, std::memory_order_acq_rel);
+  g_active.store(false, std::memory_order_relaxed);
+}
+
+void LowLatency::Detach(const LowLatencyBackend* backend) {
+  std::lock_guard lock(g_mutex);
+  if (g_backend.get() == backend) {
+    g_backend.reset();
+    g_have_backend.store(false, std::memory_order_release);
+    g_active.store(false, std::memory_order_relaxed);
+    g_driver_limits.store(false, std::memory_order_relaxed);
+    g_markers.store(false, std::memory_order_relaxed);
+  }
+}
+
+void LowLatency::SetUnavailable(const char* why) {
+  std::lock_guard lock(g_mutex);
+  if (!g_backend) {
+    g_unavailable_why = why ? why : "";
+  }
+}
+
+void LowLatency::SetFrameLimit(uint32_t fps) {
+  g_frame_limit.store(fps, std::memory_order_relaxed);
+}
+
+bool LowLatency::DriverLimits() {
+  return g_driver_limits.load(std::memory_order_relaxed);
+}
+
+bool LowLatency::WantsVulkanExtensions(uint32_t vendor_id, bool* nvidia, bool* amd) {
+  bool want_nvidia = false, want_amd = false;
+  if (REXCVAR_GET(low_latency_device_extensions)) {
+    const std::string choice = rex::cvar::GetFlagByName("low_latency_debug_backend");
+    if (choice != "none") {
+      want_nvidia = choice == "nvidia" || (choice == "auto" && vendor_id == 0x10DE);
+      want_amd = choice == "amd" || (choice == "auto" && vendor_id == 0x1002);
+    }
+  }
+  if (nvidia) {
+    *nvidia = want_nvidia;
+  }
+  if (amd) {
+    *amd = want_amd;
+  }
+  return want_nvidia || want_amd;
+}
+
+void LowLatency::OnFrameStart() {
+  static std::thread::id frame_thread;
+  if (frame_thread == std::thread::id()) {
+    frame_thread = std::this_thread::get_id();
+    REXLOG_INFO("Low latency: the frames start on thread {}",
+                std::hash<std::thread::id>()(frame_thread));
+  }
+  // The frame's id: the swap packets written so far, the frames started that have no swap yet,
+  // and this one. Frames that have had none for a quarter of a second were lost.
+  uint64_t counts = g_frame_counts.load(std::memory_order_relaxed);
+  uint64_t base;
+  do {
+    base = counts;
+    if ((base & kPendingMask) &&
+        SteadyNs() - g_last_swap_ns.load(std::memory_order_relaxed) > kStaleFrameNs) {
+      base &= ~kPendingMask;
+    }
+  } while (!g_frame_counts.compare_exchange_weak(counts, base + 1, std::memory_order_acq_rel,
+                                                 std::memory_order_relaxed));
+  const uint64_t id = (base >> 32) + (base & kPendingMask) + 1;
+  g_marked_frames[id % kMarkedFrames].store(id, std::memory_order_release);
+  std::shared_ptr<LowLatencyBackend> backend = Backend();
+  if (!backend) {
+    return;
+  }
+  static uint32_t epoch_seen = 0;
+  const uint32_t epoch = g_backend_epoch.load(std::memory_order_acquire);
+  if (epoch != epoch_seen) {
+    epoch_seen = epoch;
+    g_applied = Applied();
+  }
+  const Policy policy = Evaluate(*backend);
+  // The driver hears of the mode only once the policy has turned the reducer on (and of every
+  // change after that).
+  if (!g_applied.failed &&
+      (g_applied.on != policy.on || (policy.on && (g_applied.boost != policy.boost ||
+                                                   g_applied.interval_us != policy.interval_us)))) {
+    if (policy.on != g_applied.on) {
+      REXLOG_INFO("Low latency: {} {}{}{}", backend->Name(), policy.on ? "on" : "off",
+                  policy.boost ? ", boost" : "", policy.forced ? " (frame generation)" : "");
+    }
+    if (backend->SetMode(policy.on, policy.boost, policy.interval_us)) {
+      g_applied.on = policy.on;
+      g_applied.boost = policy.boost;
+      g_applied.interval_us = policy.interval_us;
+    } else {
+      // Refused: the reducer is unavailable (the menu says why) and the game's own limiter
+      // holds the frame rate.
+      g_applied.failed = true;
+      {
+        std::lock_guard lock(g_mutex);
+        g_failed_why = backend->FailureReason();
+      }
+      REXLOG_WARN("Low latency: {} refused the mode ({})", backend->Name(),
+                  backend->FailureReason());
+    }
+  }
+  const bool working = policy.on && !g_applied.failed;
+  g_active.store(working, std::memory_order_relaxed);
+  g_forced.store(working && policy.forced, std::memory_order_relaxed);
+  const int32_t debug = REXCVAR_GET(low_latency_debug);
+  g_explicit_attribution.store(!(debug & 4), std::memory_order_relaxed);
+  const bool markers = working || (debug & 3) != 0;
+  g_markers.store(markers, std::memory_order_relaxed);
+  static uint64_t sleep_us_total = 0;  // the update thread's: the debug log's average
+  static uint32_t sleep_count = 0;
+  bool held = false;
+  if (working) {
+    const auto sleep_start = std::chrono::steady_clock::now();
+    held = backend->Sleep(id);
+    sleep_us_total += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                                   std::chrono::steady_clock::now() - sleep_start)
+                                   .count());
+    ++sleep_count;
+  }
+  // The driver holds the frame rate only if it was told the interval and slept this frame; else
+  // the game's own limiter does.
+  g_driver_limits.store(held && g_applied.interval_us != 0, std::memory_order_relaxed);
+  if (markers) {
+    backend->Marker(LatencyMarker::kSimulationStart, id);
+    backend->Marker(LatencyMarker::kInputSample, id);
+  }
+  if ((debug & 2) && id % 300 == 0) {
+    const std::string report = backend->TimingReport();
+    if (!report.empty()) {
+      REXLOG_INFO("Low latency: {}; the wait before the frame averaged {:.2f} ms over {} frames",
+                  report, sleep_count ? double(sleep_us_total) / sleep_count / 1000.0 : 0.0,
+                  sleep_count);
+    }
+    sleep_us_total = 0;
+    sleep_count = 0;
+  }
+}
+
+void LowLatency::OnGuestSwap() {
+  // One more swap packet, and the oldest frame the update thread started that has none is
+  // this one's (none: an untimed swap, a logo or a loading screen).
+  uint64_t counts = g_frame_counts.load(std::memory_order_relaxed);
+  uint64_t desired;
+  do {
+    desired = counts + kSwapUnit - ((counts & kPendingMask) ? 1 : 0);
+  } while (!g_frame_counts.compare_exchange_weak(counts, desired, std::memory_order_acq_rel,
+                                                 std::memory_order_relaxed));
+  g_last_swap_ns.store(SteadyNs(), std::memory_order_relaxed);
+  const uint64_t id = (counts >> 32) + 1;
+  if ((counts & kPendingMask) && g_markers.load(std::memory_order_relaxed)) {
+    Marker(LatencyMarker::kSimulationEnd, id);
+  }
+}
+
+void LowLatency::OnRenderDraw() {
+  if (t_render_started) {
+    return;
+  }
+  t_render_started = true;
+  const uint64_t id = g_swaps_executed.load(std::memory_order_relaxed) + 1;
+  t_render_frame = IsMarked(id) ? id : 0;
+  if (t_render_frame && g_markers.load(std::memory_order_relaxed)) {
+    Marker(LatencyMarker::kRenderSubmitStart, t_render_frame);
+  }
+}
+
+void LowLatency::OnRenderSwap() {
+  OnRenderDraw();
+  if (!t_render_frame) {
+    // (The frame's mark can come after its first draw, if the update thread is late.)
+    const uint64_t id = g_swaps_executed.load(std::memory_order_relaxed) + 1;
+    t_render_frame = IsMarked(id) ? id : 0;
+  }
+  // The present code's frame: none while no markers go out, so a default-off game's submissions
+  // and presents are as they were.
+  t_swap_frame = g_markers.load(std::memory_order_relaxed) ? t_render_frame : 0;
+  if (t_swap_frame) {
+    Marker(LatencyMarker::kRenderSubmitEnd, t_swap_frame);
+  }
+}
+
+void LowLatency::OnRenderSwapDone() {
+  t_render_started = false;
+  t_render_frame = 0;
+  t_swap_frame = 0;
+  g_swaps_executed.fetch_add(1, std::memory_order_relaxed);
+}
+
+uint64_t LowLatency::CurrentFrameId() {
+  return t_swap_frame;
+}
+
+uint64_t LowLatency::GpuFrameId() {
+  if (!g_markers.load(std::memory_order_relaxed) ||
+      !g_explicit_attribution.load(std::memory_order_relaxed)) {
+    return 0;
+  }
+  const uint64_t id = g_swaps_executed.load(std::memory_order_relaxed) + 1;
+  return IsMarked(id) ? id : 0;
+}
+
+void LowLatency::Marker(LatencyMarker marker, uint64_t frame_id) {
+  if (!frame_id || !g_markers.load(std::memory_order_relaxed)) {
+    return;
+  }
+  std::shared_ptr<LowLatencyBackend> backend = Backend();
+  if (backend) {
+    backend->Marker(marker, frame_id);
+  }
+}
+
+}  // namespace ui
+}  // namespace rex
