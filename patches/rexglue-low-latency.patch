@@ -0,0 +1,265 @@
+// This file is part of the Anti-Lag 2.0 SDK.
+//
+// Copyright (c) 2024 Advanced Micro Devices, Inc. All rights reserved.
+//
+// AMD's sdk/libs/antilag2/ffx_antilag2_dx12.h of the FidelityFX SDK pinned in cmake/rexglue_fsr.cmake,
+// with two changes for llvm-mingw (marked MCLA; neither changes anything for the other
+// toolchains): the cast of GetProcAddress's result is a reinterpret_cast (a static_cast from
+// void* to a function pointer is an MSVC extension), and mingw-w64's __uuidof gets the
+// interface's declaration (__CRT_UUID_DECL) before its first use.
