   return handle_ != nullptr;
 }
 
+LibraryCheck CheckLoadable(const std::filesystem::path& path, std::string* error) {
+  static std::mutex mutex;
+  static std::map<std::filesystem::path, DynamicLibrary*>* loaded =
+      new std::map<std::filesystem::path, DynamicLibrary*>();  // kept
+  if (error) {
+    error->clear();
+  }
+  std::error_code exists_error;
+  if (!std::filesystem::exists(path, exists_error)) {
+    return LibraryCheck::kMissing;
+  }
+  std::lock_guard lock(mutex);
+  if (loaded->count(path)) {
+    return LibraryCheck::kLoads;
+  }
+  auto* library = new DynamicLibrary();
+  if (library->Load(path, SymbolResolution::kImmediate)) {
+    (*loaded)[path] = library;
+    return LibraryCheck::kLoads;
+  }
+  delete library;
+  if (error) {
+    const char* text = dlerror();
+    *error = text ? text : "dlopen failed";
+  }
+  return LibraryCheck::kFailed;
+}
+
 void DynamicLibrary::Close() {
   if (handle_) {
     dlclose(handle_);
