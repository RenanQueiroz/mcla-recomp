 }
 
+LibraryCheck CheckLoadable(const std::filesystem::path& path, std::string* error) {
+  static std::mutex mutex;
+  static std::map<std::filesystem::path, HMODULE>* loaded =
+      new std::map<std::filesystem::path, HMODULE>();  // kept for the process's lifetime
+  if (error) {
+    error->clear();
+  }
+  std::error_code file_error;
+  if (!std::filesystem::exists(path, file_error)) {
+    return LibraryCheck::kMissing;
+  }
+  // By its full path, with its own folder and the system folder as the only places its imports
+  // are looked for (not the application's folder or the current directory).
+  std::filesystem::path full = std::filesystem::absolute(path, file_error);
+  if (file_error) {
+    full = path;
+  }
+  std::lock_guard lock(mutex);
+  if (loaded->count(full)) {
+    return LibraryCheck::kLoads;
+  }
+  HMODULE module = LoadLibraryExW(full.c_str(), nullptr,
+                                  LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32);
+  if (module) {
+    (*loaded)[full] = module;
+    return LibraryCheck::kLoads;
+  }
+  const DWORD code = GetLastError();
+  if (error) {
+    char text[256] = {};
+    FormatMessageA(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS, nullptr, code, 0,
+                   text, sizeof text - 1, nullptr);
+    *error = "error " + std::to_string(code) + ": " + text;
+    while (!error->empty() &&
+           (error->back() == '\n' || error->back() == '\r' || error->back() == ' ')) {
+      error->pop_back();
+    }
+  }
+  return LibraryCheck::kFailed;
+}
+
 void DynamicLibrary::Close() {
   if (handle_) {
     FreeLibrary(static_cast<HMODULE>(handle_));
