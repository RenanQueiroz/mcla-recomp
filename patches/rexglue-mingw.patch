diff --git a/CMakeLists.txt b/CMakeLists.txt
index 64a86fd..887eaf5 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -12,6 +12,19 @@ project(ReXGlue
     LANGUAGES ${REXGLUE_LANGUAGES}
     DESCRIPTION "Xbox 360 Recompilation SDK"
 )
+if(MINGW)
+    # Windows file names, as with MSVC: the GPU plugin is loaded at run time as
+    # rexgpu-<name>.dll (gpu_plugin_loader.cpp), not CMake's MinGW libfoo.dll.
+    set(CMAKE_SHARED_LIBRARY_PREFIX "")
+    set(CMAKE_IMPORT_LIBRARY_PREFIX "")
+    # mingw-w64 assumes Windows 7 (_WIN32_WINNT=0x601) where the Windows SDK
+    # assumes the current Windows; the SDK calls newer APIs (SetProcessInformation
+    # in frame_timing.cpp). In the flags rather than add_compile_definitions, so
+    # that the configure checks of the libraries below see them too.
+    # -fms-extensions: __try/__except, as with MSVC.
+    string(APPEND CMAKE_C_FLAGS " -D_WIN32_WINNT=0x0A00")
+    string(APPEND CMAKE_CXX_FLAGS " -D_WIN32_WINNT=0x0A00 -fms-extensions")
+endif()
 # Floor only: bump MAJOR.MINOR for API changes. Patch is derived from git tags
 # in cmake/rex_version.cmake. See docs/RELEASING.md.
 
diff --git a/cmake/mingw_imp_exports.cmake b/cmake/mingw_imp_exports.cmake
new file mode 100644
index 0000000..6734035
--- /dev/null
+++ b/cmake/mingw_imp_exports.cmake
@@ -0,0 +1,25 @@
+# Writes a .def that exports every __imp_* symbol the given objects define.
+# MinGW only: lld's auto-export (MinGW's WINDOWS_EXPORT_ALL_SYMBOLS) leaves
+# these out, but the recompiler names a title's kernel imports __imp__<name>.
+#   cmake -DNM=<llvm-nm> -DRSP=<file listing the objects> -DOUT=<def> -P mingw_imp_exports.cmake
+# $<TARGET_OBJECTS> also lists the precompiled header (.pch): keep the objects.
+file(STRINGS "${RSP}" _lines)
+list(FILTER _lines INCLUDE REGEX "\\.(obj|o)\"?$")
+list(JOIN _lines "\n" _objects)
+file(WRITE "${OUT}.rsp" "${_objects}\n")
+execute_process(
+    COMMAND "${NM}" --extern-only --defined-only --just-symbol-name "@${OUT}.rsp"
+    OUTPUT_VARIABLE _symbols
+    RESULT_VARIABLE _result)
+if(NOT _result EQUAL 0)
+    message(FATAL_ERROR "llvm-nm failed (${_result})")
+endif()
+string(REGEX MATCHALL "(^|\n)__imp_[A-Za-z0-9_@$?]+" _imports "${_symbols}")
+list(TRANSFORM _imports STRIP)
+list(REMOVE_DUPLICATES _imports)
+list(SORT _imports)
+list(JOIN _imports "\n    " _body)
+file(WRITE "${OUT}.tmp" "EXPORTS\n    ${_body}\n")
+file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
+list(LENGTH _imports _count)
+message(STATUS "rexruntime: ${_count} __imp_ exports for MinGW")
