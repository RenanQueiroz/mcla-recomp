+bool D3D12CommandProcessor::HdrRenderScene(const D3D12Shader& vertex_shader,
+                                           const D3D12Shader& pixel_shader) {
+  ID3D12Resource* scene = HdrGetTexture(kHdrTextureScene);
+  if (!scene || !hdr_scene_pipeline_) {
+    return false;
+  }
+  const D3D12Shader::TextureBinding* bindings[4] = {};
+  for (uint32_t i = 0; i < 4; ++i) {
+    for (const D3D12Shader::TextureBinding& binding :
+         (i < 3 ? pixel_shader : vertex_shader).GetTextureBindingsAfterTranslation()) {
+      if (binding.fetch_constant == kHdrSceneFetchConstants[i]) {
+        bindings[i] = &binding;
+      }
+    }
+    if (!bindings[i]) {
+      return false;
+    }
+  }
+  // Bindful: the textures' views and the output's; bindless: the output's.
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[5];
+  uint32_t one_use_count = bindless_resources_used_ ? 1 : 5;
+  if (!RequestOneUseSingleViewDescriptors(one_use_count, descriptors)) {
+    return false;
+  }
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  D3D12_GPU_DESCRIPTOR_HANDLE tables[5];
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (bindless_resources_used_) {
+      tables[i] = provider.OffsetViewDescriptor(
+          view_bindless_heap_gpu_start_,
+          texture_cache_->GetActiveTextureBindlessSRVIndex(*bindings[i]));
+    } else {
+      texture_cache_->WriteActiveTextureBindfulSRV(*bindings[i], descriptors[1 + i].first);
+      tables[i] = descriptors[1 + i].second;
+    }
+  }
+  D3D12_UNORDERED_ACCESS_VIEW_DESC uav_desc = {};
+  uav_desc.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+  uav_desc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+  provider.GetDevice()->CreateUnorderedAccessView(scene, nullptr, &uav_desc,
+                                                  descriptors[0].first);
+  tables[4] = descriptors[0].second;
+  PushTransitionBarrier(scene, kHdrTextureState, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  SubmitBarriers();
+  deferred_command_list_.D3DSetComputeRootSignature(hdr_scene_root_signature_.Get());
+  SetExternalPipeline(hdr_scene_pipeline_.Get());
+  deferred_command_list_.D3DSetComputeRoot32BitConstants(
+      0, sizeof(HdrSceneConstants) / sizeof(uint32_t), &hdr_scene_constants_, 0);
+  for (uint32_t i = 0; i < 5; ++i) {
+    deferred_command_list_.D3DSetComputeRootDescriptorTable(1 + i, tables[i]);
+  }
+  deferred_command_list_.D3DDispatch((hdr_output_width_ + 15) / 16, (hdr_output_height_ + 7) / 8,
+                                     1);
+  PushTransitionBarrier(scene, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, kHdrTextureState);
+  SubmitBarriers();
+  return true;
+}
