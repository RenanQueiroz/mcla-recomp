diff --git a/src/graphics/shaders/hdr_scene_mcla.cs.xesl b/src/graphics/shaders/hdr_scene_mcla.cs.xesl
new file mode 100644
index 0000000..49b252a
--- /dev/null
+++ b/src/graphics/shaders/hdr_scene_mcla.cs.xesl
@@ -0,0 +1,195 @@
+// HDR output (rexglue-hdr-scene-mcla.patch): Midnight Club: Los Angeles's tone
+// map (guest pixel shader E5EBEFAE4D165CBA) again, run after the game's draw
+// from the same textures and constants, with the scene in the game's linear
+// units (its output before the 1/2.2 encode, 1 = its white) written to an FP16
+// image instead of 8-bit code values. Up to the knee the curve is the game's
+// (Reinhard extended on luminance, chromaticity kept through xy); above it an
+// exponential shoulder with the same value there approaches the peak, never
+// under the game's curve up to its white (with a peak at or below the game's
+// white, the game's curve clipped at its white). Bloom, saturation, colour
+// balance and contrast follow in the game's order, so the grade is the game's.
+// Mode 1 is the game's curve alone, for checking the pass against the game's
+// own output. NaN (from a guest texture or constant) doesn't reach the
+// output.
+
+#include "../../ui/shaders/xesl.xesli"
+
+// The texture caches bind 2D textures as 2D arrays (layer 0 here).
+#if SHADING_LANGUAGE_GLSL_XE
+  #define XeHdrSceneTexture texture2DArray
+  #define XeHdrSceneFetch(texture_name, position) \
+      texelFetch(texture_name, int3_xe(position, 0), 0)
+#else
+  #define XeHdrSceneTexture Texture2DArray<float4_xe>
+  #define XeHdrSceneFetch(texture_name, position) \
+      ((texture_name).Load(int4_xe(position, 0, 0)))
+#endif
+
+push_const_begin_xe(b0, space0)
+  // x, y: the output's size; z: 1 = the game's curve, no shoulder.
+  uint4_xe xe_hdr_scene_size_mode;
+  // x, y: the half-pixel offset of the game's draw, in pixels.
+  float4_xe xe_hdr_scene_pixel_offset;
+  // Key (c64.z), white squared (c65.x), epsilon (c255.w), blur weight scale
+  // (c252.w).
+  float4_xe xe_hdr_scene_curve;
+  // Adapted luminance clamp (vertex shader c64.x, c65.x), saturation (c67.x),
+  // contrast (c69.x).
+  float4_xe xe_hdr_scene_grade;
+  // Colour balance (c68.xyz), bloom gain.
+  float4_xe xe_hdr_scene_balance;
+  // Knee (the game's linear units), Ls at the knee, the shoulder's slope there
+  // (the highlights setting, and at least what reaches the game's white at its
+  // white), peak - knee (at most 1 - knee: no shoulder).
+  float4_xe xe_hdr_scene_shoulder;
+push_const_end_xe
+
+// Not NaN, by the bits (a compiler may fold x == x).
+#define XeHdrSceneNotNan(value) ((float_bits_to_uint_xe(value) & 0x7FFFFFFFu) <= 0x7F800000u)
+
+#define LOCAL_SIZE_X_XE 16
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+// The game's fetches 0 (the scene, 16_16_16_16 float, shader units), 1 (motion
+// blur colour and weight), 2 (bloom) and the vertex shader's 16 (the adapted
+// luminance, 1x1).
+entry_bindings_begin_compute_xe
+  push_const_binding_xe(buffer(0))
+  entry_binding_next_xe
+  texture_xe(XeHdrSceneTexture, xe_hdr_scene_source, set=0, binding=0, t0, space0,
+             texture(0))
+  entry_binding_next_xe
+  texture_xe(XeHdrSceneTexture, xe_hdr_scene_blur, set=0, binding=1, t1, space0,
+             texture(1))
+  entry_binding_next_xe
+  texture_xe(XeHdrSceneTexture, xe_hdr_scene_bloom, set=0, binding=2, t2, space0,
+             texture(2))
+  entry_binding_next_xe
+  texture_xe(XeHdrSceneTexture, xe_hdr_scene_luminance, set=0, binding=3, t3,
+             space0, texture(3))
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, image_format_rgba16f_xe, xe_hdr_scene_dest, set=1,
+              binding=0, u0, space0, texture(4))
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+  uint2_xe pixel_index = in_global_thread_id_xe.xy;
+  uint4_xe size_mode = push_const_xe(xe_hdr_scene_size_mode);
+  dont_flatten_xe
+  if (any(greater_than_equal_xe(pixel_index, size_mode.xy))) {
+    return;
+  }
+  float4_xe curve = push_const_xe(xe_hdr_scene_curve);
+  float4_xe grade = push_const_xe(xe_hdr_scene_grade);
+  float4_xe balance = push_const_xe(xe_hdr_scene_balance);
+  float4_xe shoulder = push_const_xe(xe_hdr_scene_shoulder);
+  // Where the game's draw samples for this pixel, with its pixel offset.
+  float2_xe uv = (float2_xe(pixel_index) + 0.5f - push_const_xe(xe_hdr_scene_pixel_offset).xy) /
+                 float2_xe(size_mode.xy);
+
+  // The inputs' sizes (scaled with the resolution like the output).
+  uint2_xe scene_size, blur_size, bloom_size, luminance_size;
+#if SHADING_LANGUAGE_GLSL_XE
+  scene_size = uint2_xe(textureSize(xe_hdr_scene_source, 0).xy);
+  blur_size = uint2_xe(textureSize(xe_hdr_scene_blur, 0).xy);
+  bloom_size = uint2_xe(textureSize(xe_hdr_scene_bloom, 0).xy);
+  luminance_size = uint2_xe(textureSize(xe_hdr_scene_luminance, 0).xy);
+#else
+  uint layers;
+  xe_hdr_scene_source.GetDimensions(scene_size.x, scene_size.y, layers);
+  xe_hdr_scene_blur.GetDimensions(blur_size.x, blur_size.y, layers);
+  xe_hdr_scene_bloom.GetDimensions(bloom_size.x, bloom_size.y, layers);
+  xe_hdr_scene_luminance.GetDimensions(luminance_size.x, luminance_size.y, layers);
+#endif
+
+  // Point-sampled as the game does (its draw samples on texel edges: a little
+  // past them, as the texture unit's fixed-point coordinates mostly round),
+  // bilinear for the smaller blur and bloom.
+  float3_xe scene = XeHdrSceneFetch(
+      xe_hdr_scene_source,
+      clamp(int2_xe(floor(uv * float2_xe(scene_size) + (1.0f / 512.0f))), int2_xe(0, 0),
+            int2_xe(scene_size) - 1)).rgb;
+  float4_xe blur, bloom4;
+  {
+    float2_xe position = uv * float2_xe(blur_size) - 0.5f;
+    float2_xe weight = position - floor(position);
+    int2_xe last = int2_xe(blur_size) - 1;
+    int2_xe p0 = clamp(int2_xe(floor(position)), int2_xe(0, 0), last);
+    int2_xe p1 = clamp(int2_xe(floor(position)) + 1, int2_xe(0, 0), last);
+    float4_xe top = XeHdrSceneFetch(xe_hdr_scene_blur, p0);
+    top += (XeHdrSceneFetch(xe_hdr_scene_blur, int2_xe(p1.x, p0.y)) - top) * weight.x;
+    float4_xe bottom = XeHdrSceneFetch(xe_hdr_scene_blur, int2_xe(p0.x, p1.y));
+    bottom += (XeHdrSceneFetch(xe_hdr_scene_blur, p1) - bottom) * weight.x;
+    blur = top + (bottom - top) * weight.y;
+  }
+  {
+    float2_xe position = uv * float2_xe(bloom_size) - 0.5f;
+    float2_xe weight = position - floor(position);
+    int2_xe last = int2_xe(bloom_size) - 1;
+    int2_xe p0 = clamp(int2_xe(floor(position)), int2_xe(0, 0), last);
+    int2_xe p1 = clamp(int2_xe(floor(position)) + 1, int2_xe(0, 0), last);
+    float4_xe top = XeHdrSceneFetch(xe_hdr_scene_bloom, p0);
+    top += (XeHdrSceneFetch(xe_hdr_scene_bloom, int2_xe(p1.x, p0.y)) - top) * weight.x;
+    float4_xe bottom = XeHdrSceneFetch(xe_hdr_scene_bloom, int2_xe(p0.x, p1.y));
+    bottom += (XeHdrSceneFetch(xe_hdr_scene_bloom, p1) - bottom) * weight.x;
+    bloom4 = top + (bottom - top) * weight.y;
+  }
+
+  // Motion blur and depth of field: lerp(scene, blur, sat(scale x blur.a)).
+  float3_xe c = scene + saturate_xe(blur.a * curve.w) * (blur.rgb - scene);
+
+  // RGB -> XYZ (the DirectX SDK matrix the game uses), then x, y and Y.
+  float big_x = dot(c, float3_xe(0.514136f, 0.323879f, 0.160364f));
+  float big_y = dot(c, float3_xe(0.265068f, 0.670234f, 0.0640916f));
+  float big_s = dot(c, float3_xe(0.803323f, 1.11693f, 1.06888f));
+  big_s = select_xe(big_s == 0.0f, curve.z, big_s);
+  float chroma_x = big_x / big_s;
+  float chroma_y = big_y / big_s;
+  // The adapted luminance, 1x1 for the game (at a scaled resolution, its
+  // middle texel is the one the game's vertex shader reads).
+  float adapted = clamp(XeHdrSceneFetch(xe_hdr_scene_luminance, int2_xe(luminance_size / 2u)).r,
+                        grade.x, grade.y);
+  // Not negative (the curve divides by 1 + Ls), not NaN, and finite (the
+  // shoulder and the clip take any size).
+  float ls = big_y * curve.x / (adapted + curve.z);
+  ls = XeHdrSceneNotNan(ls) ? clamp(ls, 0.0f, 1.0e18f) : 0.0f;
+
+  // Reinhard extended, then the shoulder above the knee: never under the
+  // game's curve up to its white (Ls = sqrt(W)); with no room above white,
+  // the game's curve clipped at it.
+  float ld = ls * (1.0f + ls / curve.y) / (1.0f + ls);
+  dont_flatten_xe
+  if (size_mode.z == 0u && ls > shoulder.y) {
+    dont_flatten_xe
+    if (shoulder.w > (1.0f - shoulder.x) * 1.0001f) {
+      float shoulder_ld = shoulder.x + shoulder.w * (1.0f - exp2(-(ls - shoulder.y) * shoulder.z /
+                                                                 shoulder.w * 1.44269504f));
+      ld = ls < sqrt(curve.y) ? max(shoulder_ld, ld) : shoulder_ld;
+    } else {
+      ld = min(ld, 1.0f);
+    }
+  }
+
+  // Back to RGB through x and y.
+  float chroma_y_guarded = select_xe(chroma_y == 0.0f, curve.z, chroma_y);
+  float3_xe xyz = float3_xe(ld * chroma_x / chroma_y_guarded, ld,
+                            ld * (1.0f - chroma_x - chroma_y_guarded) / chroma_y_guarded);
+  float3_xe rgb = float3_xe(dot(xyz, float3_xe(2.5651f, -1.1665f, -0.3986f)),
+                            dot(xyz, float3_xe(-1.0217f, 1.9777f, 0.0439f)),
+                            dot(xyz, float3_xe(0.0753f, -0.2543f, 1.1892f)));
+
+  // Bloom after the curve, then saturation around Rec.709 luma, colour
+  // balance and contrast.
+  rgb += bloom4.rgb * balance.w;
+  float luma = dot(rgb, float3_xe(0.2125f, 0.7154f, 0.0721f));
+  rgb = (rgb - luma) * grade.z + luma;
+  rgb = (2.0f * rgb * balance.xyz - 0.5f) * grade.w + 0.5f;
+
+  // Not NaN, and in FP16's range.
+  rgb = float3_xe(XeHdrSceneNotNan(rgb.r) ? rgb.r : 0.0f, XeHdrSceneNotNan(rgb.g) ? rgb.g : 0.0f,
+                  XeHdrSceneNotNan(rgb.b) ? rgb.b : 0.0f);
+  image_store_2d_rgba_xe(xe_hdr_scene_dest, pixel_index,
+                         float4_xe(clamp(rgb, float3_xe(0.0f, 0.0f, 0.0f),
+                                         float3_xe(65504.0f, 65504.0f, 65504.0f)),
+                                   1.0f));
+entry_code_end_compute_xe
