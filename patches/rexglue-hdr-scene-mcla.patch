+
+CommandProcessor::HdrSceneCheck CommandProcessor::HdrPrepareScene() {
+  if (!REXCVAR_GET(mcla_hdr_scene) || !hdr_output_width_ || !REXCVAR_GET(hdr_ui_layer) ||
+      !ui::Presenter::IsHdrOutputActive() || !HdrHostRenderTargets()) {
+    return HdrSceneCheck::kOff;
+  }
+  ui::Presenter::HdrOutputState state = ui::Presenter::GetHdrOutputState();
+  // Debug views that show the frame without the scene.
+  if (state.debug_ui >= 2 && state.debug_ui <= 6) {
+    return HdrSceneCheck::kOff;
+  }
+  HdrSceneCheck check = HdrCheckSceneDraw();
+  if (check != HdrSceneCheck::kFound) {
+    return check;
+  }
+  const RegisterFile& regs = *register_file_;
+  hdr_frame_.scene_target = HdrColorTargetKey(0);
+  auto constant = [&regs](bool pixel, uint32_t index, uint32_t component) {
+    uint32_t bits = regs[(pixel ? XE_GPU_REG_SHADER_CONSTANT_256_X : XE_GPU_REG_SHADER_CONSTANT_000_X) +
+                         index * 4 + component];
+    float value;
+    std::memcpy(&value, &bits, sizeof(float));
+    return value;
+  };
+  HdrSceneConstants& constants = hdr_scene_constants_;
+  constants.size_mode[0] = hdr_output_width_;
+  constants.size_mode[1] = hdr_output_height_;
+  constants.size_mode[2] = uint32_t(state.debug_ui == 7);
+  // The half-pixel offset, as the host draw applies it (draw_util).
+  uint32_t scale_x, scale_y;
+  HdrDrawResolutionScale(scale_x, scale_y);
+  bool pixel_offset = REXCVAR_GET(half_pixel_offset) &&
+                      regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero;
+  constants.pixel_offset[0] = pixel_offset ? 0.5f * float(scale_x) : 0.0f;
+  constants.pixel_offset[1] = pixel_offset ? 0.5f * float(scale_y) : 0.0f;
+  // Also not NaN (a comparison with NaN is false).
+  float white_squared = constant(true, 65, 0);
+  white_squared = white_squared > 1e-4f ? std::min(white_squared, 1e4f) : 1e-4f;
+  constants.curve[0] = constant(true, 64, 2);
+  constants.curve[1] = white_squared;
+  constants.curve[2] = constant(true, 255, 3);
+  constants.curve[3] = constant(true, 252, 3);
+  constants.grade[0] = constant(false, 64, 0);
+  constants.grade[1] = constant(false, 65, 0);
+  constants.grade[2] = constant(true, 67, 0);
+  constants.grade[3] = constant(true, 69, 0);
+  for (uint32_t i = 0; i < 3; ++i) {
+    constants.balance[i] = constant(true, 68, i);
+  }
+  constants.balance[3] = float(REXCVAR_GET(mcla_hdr_bloom_gain));
+  // The shoulder: Reinhard extended (the game's, Ld = Ls (1 + Ls / W) / (1 +
+  // Ls)) up to the knee, then an exponential approach to the peak with the
+  // same value there and its slope times the highlights setting. The peak in
+  // the game's units is where the viewing transfer reaches peak / paper white.
+  // Never darker than the game's curve up to its white (Ld 1 at Ls = sqrt(W)):
+  // where the game's curve bends up towards its white (W < 1, by day), the
+  // shoulder bends down from the same slope and would stay under it, so its
+  // slope is at least what reaches 1 at sqrt(W) (the shader also takes the
+  // game's curve where that is higher, below its white). A peak at or below
+  // the game's white leaves no room for a shoulder: the game's curve, clipped
+  // at its white.
+  float knee = float(REXCVAR_GET(mcla_hdr_knee));
+  float b = 1.0f - knee;
+  float ls_knee = (-b + std::sqrt(b * b + 4.0f * knee / white_squared)) * 0.5f * white_squared;
+  float slope = ((1.0f + 2.0f * ls_knee / white_squared) * (1.0f + ls_knee) -
+                 (ls_knee + ls_knee * ls_knee / white_squared)) /
+                ((1.0f + ls_knee) * (1.0f + ls_knee));
+  float peak_relative = state.peak_nits / std::max(state.paper_white_nits, 1.0f);
+  float low = 0.0f, high = 64.0f;
+  for (uint32_t i = 0; i < 32; ++i) {
+    float middle = (low + high) * 0.5f;
+    (HdrSceneViewingTransfer(middle, state.sdr_pure_gamma_2_2) > peak_relative ? high : low) =
+        middle;
+  }
+  float span = std::max(low - knee, 1e-3f);
+  slope *= float(REXCVAR_GET(mcla_hdr_highlights));
+  float white_ls = std::sqrt(white_squared);
+  if (span > b * 1.0001f && white_ls > ls_knee) {
+    slope = std::max(slope, -span * std::log(1.0f - b / span) / (white_ls - ls_knee));
+  }
+  constants.shoulder[0] = knee;
+  constants.shoulder[1] = ls_knee;
+  constants.shoulder[2] = slope;
+  constants.shoulder[3] = span;
+  return HdrSceneCheck::kFound;
+}
+
+float CommandProcessor::HdrSceneViewingTransfer(float value, bool pure_gamma_2_2) const {
+  float code = value > 0.00304f ? 1.055f * std::pow(value, 1.0f / 2.2f) - 0.055f : value * 12.92f;
+  float position = std::max(code, 0.0f) * 255.0f;
+  uint32_t index = uint32_t(std::min(std::floor(position), 254.0f));
+  float low = gamma_ramp_256_entry_table_[index].color_10_green * (1.0f / 1023.0f);
+  float high = gamma_ramp_256_entry_table_[index + 1].color_10_green * (1.0f / 1023.0f);
+  code = std::max(low + (high - low) * (position - float(index)), 0.0f);
+  if (pure_gamma_2_2) {
+    return std::pow(code, 2.2f);
+  }
+  return code > 0.04045f ? std::pow((code + 0.055f) / 1.055f, 2.4f) : code / 12.92f;
+}
