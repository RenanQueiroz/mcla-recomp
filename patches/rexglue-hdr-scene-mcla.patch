+constexpr uint32_t kHdrSwizzleX111 = 0 | (5 << 3) | (5 << 6) | (5 << 9);
+constexpr HdrSceneFetch kHdrSceneFetches[4] = {
+    {xenos::TextureFormat::k_16_16_16_16_EXPAND, kHdrSwizzleXyzw, xenos::TextureFilter::kPoint},
+    {xenos::TextureFormat::k_16_16_16_16_EXPAND, kHdrSwizzleXyzw, xenos::TextureFilter::kLinear},
+    {xenos::TextureFormat::k_16_16_16_16_EXPAND, kHdrSwizzleXyzw, xenos::TextureFilter::kLinear},
+    {xenos::TextureFormat::k_32_FLOAT, kHdrSwizzleX111, xenos::TextureFilter::kPoint},
+};
