+CommandProcessor::HdrSceneCheck CommandProcessor::HdrCheckSceneDraw() const {
+  const RegisterFile& regs = *register_file_;
+  Shader* vertex_shader = active_vertex_shader();
+  Shader* pixel_shader = active_pixel_shader();
+  if (!vertex_shader || !pixel_shader ||
+      vertex_shader->ucode_data_hash() != kHdrSceneVertexShader ||
+      pixel_shader->ucode_data_hash() != kHdrScenePixelShader) {
+    return HdrSceneCheck::kNotFound;
+  }
+  uint32_t key = HdrColorTargetKey(0);
+  if (xenos::MsaaSamples((key >> 12) & 3) != xenos::MsaaSamples::k1X ||
+      xenos::ColorRenderTargetFormat((key >> 14) & 0xF) !=
+          xenos::ColorRenderTargetFormat::k_8_8_8_8) {
+    return HdrSceneCheck::kTarget;
+  }
+  // The whole output, in guest pixels: the pass writes every pixel of it from
+  // the same place in the inputs.
+  uint32_t scale_x, scale_y;
+  HdrDrawResolutionScale(scale_x, scale_y);
+  uint32_t width = hdr_output_width_ / scale_x, height = hdr_output_height_ / scale_y;
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  if (scissor.offset[0] || scissor.offset[1] || scissor.extent[0] < width ||
+      scissor.extent[1] < height) {
+    return HdrSceneCheck::kCoverage;
+  }
+  auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+  if (regs.Get<reg::PA_SU_SC_MODE_CNTL>().vtx_window_offset_enable &&
+      (window_offset.window_x_offset || window_offset.window_y_offset)) {
+    return HdrSceneCheck::kCoverage;
+  }
+  auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  if (!vte.vport_x_scale_ena || !vte.vport_x_offset_ena || !vte.vport_y_scale_ena ||
+      !vte.vport_y_offset_ena) {
+    return HdrSceneCheck::kCoverage;
+  }
+  float x_scale = std::abs(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE));
+  float x_offset = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET);
+  float y_scale = std::abs(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE));
+  float y_offset = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET);
+  // Within a pixel (the half-pixel offset).
+  if (!(x_offset - x_scale <= 1.0f && x_offset + x_scale >= float(width) - 1.0f &&
+        y_offset - y_scale <= 1.0f && y_offset + y_scale >= float(height) - 1.0f)) {
+    return HdrSceneCheck::kCoverage;
+  }
+  for (uint32_t i = 0; i < 4; ++i) {
+    xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(kHdrSceneFetchConstants[i]);
+    const HdrSceneFetch& expected = kHdrSceneFetches[i];
+    if (fetch.type != xenos::FetchConstantType::kTexture ||
+        fetch.dimension != xenos::DataDimension::k2DOrStacked || fetch.exp_adjust ||
+        fetch.format != expected.format || fetch.swizzle != expected.swizzle ||
+        fetch.sign_x != xenos::TextureSign::kSigned ||
+        fetch.sign_y != xenos::TextureSign::kSigned ||
+        fetch.sign_z != xenos::TextureSign::kSigned ||
+        fetch.sign_w != xenos::TextureSign::kSigned ||
+        fetch.clamp_x != xenos::ClampMode::kClampToEdge ||
+        fetch.clamp_y != xenos::ClampMode::kClampToEdge || fetch.mag_filter != expected.filter ||
+        fetch.min_filter != expected.filter) {
+      return HdrSceneCheck::kFetch;
+    }
+    // The scene itself at the output's size.
+    if (!i && (fetch.size_2d.width + 1 != width || fetch.size_2d.height + 1 != height)) {
+      return HdrSceneCheck::kFetch;
+    }
+  }
+  return HdrSceneCheck::kFound;
+}
