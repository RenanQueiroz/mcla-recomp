+void D3D12CommandProcessor::HdrReleaseTextures() {
+  bool released = false;
+  for (Microsoft::WRL::ComPtr<ID3D12Resource>& resource : hdr_textures_) {
+    if (resource) {
+      // Released once the submissions that may use it are done.
+      resource->AddRef();
+      resources_for_deletion_.emplace_back(GetCurrentSubmission(), resource.Get());
+      resource.Reset();
+      released = true;
+    }
+  }
+  if (released) {
+    REXGPU_INFO("HDR: textures released (HDR output off)");
+  }
+}
