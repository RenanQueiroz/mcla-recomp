+bool VulkanCommandProcessor::HdrRenderScene(const VulkanShader& vertex_shader,
+                                            const VulkanShader& pixel_shader) {
+  HdrImage* scene = HdrGetImage(kHdrTextureScene);
+  if (!scene || hdr_scene_pipeline_ == VK_NULL_HANDLE) {
