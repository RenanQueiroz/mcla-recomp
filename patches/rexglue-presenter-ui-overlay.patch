+bool Presenter::RenderUIOverlayForPaintsFromUIThread() {
+  const uint64_t ui_frame = ++ui_frames_drawn_;
+  const bool rendered = RenderUIOverlayFromUIThread();
+  if (!rendered) {
+    // The UI thread paints as before (presenting the UI) until the next
+    // connection.
+    ui_overlay_render_failed_ = true;
+    REXLOG_WARN("Presenter: the UI overlay couldn't be drawn; the UI thread paints the UI");
+  } else {
+    ui_overlay_ui_frame_.store(ui_frame, std::memory_order_relaxed);
+  }
+  // A dialog that closed itself while drawn left its last frame in the layer:
+  // with no drawers left, nothing is put over the image anymore.
+  ui_overlay_active_.store(rendered && !ui_drawers_.empty(), std::memory_order_release);
+  return rendered;
+}
