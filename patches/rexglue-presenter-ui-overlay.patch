+void Presenter::PaintFromUIThreadInUIOverlayPaintMode(bool force_paint, bool draw_ui,
+                                                       bool resuming) {
+  // is_in_ui_thread_paint_ has been set by PaintFromUIThread. The guest output
+  // thread paints every guest frame, so a forced or requested paint isn't done
+  // here (except once when resuming from the suspension): only the connection
+  // is kept (the guest output thread can't reconnect), and the drawers go into
+  // the overlay.
+  const bool paint_requested =
+      ui_thread_paint_requested_.exchange(false, std::memory_order_relaxed) || force_paint;
+  // Set by the guest output thread's paint (under the paint lock) when it finds
+  // the connection outdated; the state itself is read only once the UI thread
+  // owns painting.
+  const bool outdated = surface_paint_connection_outdated_.exchange(false, std::memory_order_acq_rel);
+  bool request_repaint_immediately = false;
+  bool draw_overlay = draw_ui;
+  PaintResult paint_result = PaintResult::kNotPresented;
+  if (outdated || paint_mode_ != PaintMode::kGuestOutputThreadImmediately) {
+    // Take the painting over (waiting for a paint in progress) only for this;
+    // a guest frame refreshed meanwhile is requested from the UI thread, which
+    // doesn't paint it: taking it over for every overlay would drop frames.
+    if (paint_mode_ == PaintMode::kGuestOutputThreadImmediately) {
+      SetPaintModeFromUIThread(PaintMode::kUIThreadOnRequest);
+    }
+    if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedOutdated) {
+      UpdateSurfacePaintConnectionFromUIThread(nullptr, false);
+      if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedOutdated) {
+        // Retry in the next frame, giving the window system time.
+        request_repaint_immediately = true;
+      }
+    }
+    if (resuming &&
+        surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedPaintable) {
+      // Back from the suspension, where the UI thread painted the UI into the
+      // image itself. Before the guest output thread paints again, the overlay
+      // is drawn (none of its frames goes without the UI, or with the overlay
+      // from before the suspension), and the latest guest frame, if it hasn't
+      // been shown, is shown with it from here, as the guest output thread
+      // would paint it.
+      SetPaintModeFromUIThread(PaintMode::kUIThreadOnRequest);
+      if (draw_ui) {
+        draw_overlay = false;
+        if (!RenderUIOverlayForPaintsFromUIThread()) {
+          request_repaint_immediately = true;
+        }
+      } else {
+        ui_overlay_active_.store(false, std::memory_order_release);
+      }
+      if (paint_requested && IsUIOverlayPaintModeActive()) {
+        tls_in_ui_overlay_resume_paint = true;
+        paint_result = PaintAndPresent(false);
+        tls_in_ui_overlay_resume_paint = false;
+        if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedOutdated) {
+          request_repaint_immediately = true;
+        }
+      }
+    }
+    SetPaintModeFromUIThread(GetDesiredPaintModeFromUIThread(
+        surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedPaintable));
+  }
+  if (draw_overlay && paint_mode_ != PaintMode::kNone) {
+    // As fast as the UI thread would paint (the overlay isn't presented here).
+    WaitForUITickFromUIThread();
+    if (!RenderUIOverlayForPaintsFromUIThread()) {
+      request_repaint_immediately = true;
+    }
+  } else if (!draw_ui) {
+    ui_overlay_active_.store(false, std::memory_order_release);
+  }
+  is_in_ui_thread_paint_ = false;
+  if (paint_result == PaintResult::kGpuLostExternally ||
+      paint_result == PaintResult::kGpuLostResponsible) {
+    if (host_gpu_loss_callback_) {
+      host_gpu_loss_callback_(paint_result == PaintResult::kGpuLostResponsible, true);
+    }
+    // The loss callback might have destroyed the presenter.
+    return;
+  }
+  bool request_repaint_at_tick = false;
+  if (paint_mode_ != PaintMode::kNone) {
+    if (request_ui_paint_after_current_ui_thread_paint_ && !ui_drawers_.empty()) {
+      request_repaint_at_tick = true;
+    }
+  } else {
+    request_repaint_immediately = false;
+  }
+  if (request_repaint_at_tick || request_repaint_immediately) {
+    RequestPaintOrConnectionRecoveryViaWindow(request_repaint_immediately);
+  }
+}
