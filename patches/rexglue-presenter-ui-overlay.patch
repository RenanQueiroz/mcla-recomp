+void Presenter::UpdateUIOverlayPaintSuspensionFromUIThread(bool draw_ui) {
+  // No guest frame for this long with UI to show (the time before the first
+  // guest frame, a long load, a hang): the UI thread paints the UI itself, at
+  // the display's rate. Frame generation, whose pacer then stops presenting,
+  // keeps 1 s.
+  constexpr uint64_t kSilentNs = 250'000'000;
+  constexpr uint64_t kSilentForcedNs = 1'000'000'000;
+  // Resumed once guest frames have been coming for this long with no gap over
+  // kGuestOutputSteadyGapNs, so that a loading hitch doesn't switch back and
+  // forth.
+  constexpr uint64_t kSteadyNs = 250'000'000;
+  const uint64_t now = PresentLog::Now();
+  const uint64_t last = last_refresh_ns_.load(std::memory_order_acquire);
+  const uint64_t steady_since = guest_output_steady_since_ns_.load(std::memory_order_relaxed);
+  if (!ui_overlay_paint_suspended_) {
+    // Before the first guest frame, silent since the presenter was set up.
+    const uint64_t since = last ? last : ui_overlay_paint_start_ns_;
+    const uint64_t silent_ns = ui_overlay_paint_forced_ ? kSilentForcedNs : kSilentNs;
+    if (draw_ui && now > since + silent_ns) {
+      ui_overlay_paint_suspended_ = true;
+      ui_overlay_paint_suspended_ns_ = now;
+      ui_overlay_active_.store(false, std::memory_order_release);
+      REXLOG_INFO("Presenter: no guest frame for {} ms with UI to show; UI overlay painting "
+                  "suspended",
+                  (now - since) / 1'000'000);
+      if (PresentLog::Get().enabled()) {
+        PresentLog::Get().Suspension(now, 1);
+      }
+    }
+  } else if (!draw_ui || (last && now < last + kGuestOutputSteadyGapNs && steady_since &&
+                          now >= steady_since + kSteadyNs)) {
+    ui_overlay_paint_suspended_ = false;
+    REXLOG_INFO("Presenter: UI overlay painting resumed after {} ms{}",
+                (now - ui_overlay_paint_suspended_ns_) / 1'000'000,
+                draw_ui ? "" : " (no UI to show)");
+    if (PresentLog::Get().enabled()) {
+      PresentLog::Get().Suspension(now, draw_ui ? 0 : 2);
+    }
+  }
+}
