index 0000000..2a3c4b7
--- /dev/null
+++ b/src/ui/shaders/ui_overlay_composite.ps.xesl
@@ -0,0 +1,27 @@
+// UI overlay painting (rexglue-presenter-ui-overlay.patch): the presenter's own
+// UI (ImGui, the achievement toasts), drawn by the UI thread into an 8-bit layer
+// cleared to 0, put over the SDR swap chain image as the UI would have been
+// drawn over it: the layer holds the UI's colour premultiplied by its coverage,
+// blended with ONE / INV_SRC_ALPHA. (Over HDR10 output, hdr_ui_composite.ps.)
+// Built with guest_output_triangle_strip_rect.vs.xesl over the whole image, with
+// the bilinear guest output effect's root signature / pipeline layout.
+
+#include "xesl.xesli"
+
+entry_outputs_begin_xe
+  entry_out_target_xe(float4_xe, xe_ui_overlay_composite_color, 0)
+entry_outputs_end_stage_inputs_begin_xe
+entry_stage_inputs_end_bindings_begin_pixel_xe
+  texture_xe(texture_2d_xe, xe_ui_overlay_composite_layer, set=0, binding=0, t0,
+             space0, texture(0))
+  entry_binding_next_xe
+  sampler_state_xe(xe_ui_overlay_composite_sampler, set=0, binding=1, s0, space0,
+                   sampler(0))
+entry_bindings_end_inputs_begin_xe
+  entry_in_pixel_coord_xe
+entry_inputs_end_code_begin_xe
+{
+  out_xe(xe_ui_overlay_composite_color) =
+      texel_fetch_2d_xe(xe_ui_overlay_composite_layer, int2_xe(in_pixel_coord_xe.xy), 0);
+}
+entry_code_end_xe
