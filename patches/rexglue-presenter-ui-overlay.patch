+namespace {
+// The present log (present_log): one buffered line per guest output refresh
+// ("r,<ns>,<refresh>") and per paint ("p,<ns after>,<refresh>,<thread g|u>,
+// <result>,<us in the paint>"), from the refreshing thread and whichever
+// thread paints. With a pacer, its presents are "p" lines of thread
+// q, and the guest output thread's paints don't present. The clock is
+// std::chrono::steady_clock (on Windows, the performance counter in 100 ns
+// units scaled to ns, as PresentMon's --qpc_time). Flushed about once a
+// second, so a run that is killed (a hang) still leaves its lines.
+class PresentLog {
+ public:
+  static PresentLog& Get() {
+    static PresentLog log;
+    return log;
+  }
+  bool enabled() const { return file_ != nullptr; }
+  static uint64_t Now() {
+    return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                        std::chrono::steady_clock::now().time_since_epoch())
+                        .count());
+  }
+  void Refresh(uint64_t time, uint64_t refresh) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::fprintf(file_, "r,%llu,%llu\n", static_cast<unsigned long long>(time),
+                 static_cast<unsigned long long>(refresh));
+    FlushPeriodically(time);
+  }
+  // ui: the number of the UI frame shown (counted by the UI thread whenever it
+  // draws the drawers, into the image or into the overlay), 0 for none.
+  void Paint(uint64_t time, uint64_t refresh, char thread, int result, uint64_t paint_ns,
+             uint64_t ui = 0) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::fprintf(file_, "p,%llu,%llu,%c,%d,%llu,%llu\n", static_cast<unsigned long long>(time),
+                 static_cast<unsigned long long>(refresh), thread, result,
+                 static_cast<unsigned long long>(paint_ns / 1000),
+                 static_cast<unsigned long long>(ui));
+    FlushPeriodically(time);
+  }
+  // UI overlay painting suspended (1), resumed (0), or resumed with no UI to
+  // show (2).
+  void Suspension(uint64_t time, int kind) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::fprintf(file_, "s,%llu,%d\n", static_cast<unsigned long long>(time), kind);
+    std::fflush(file_);
+  }
+  ~PresentLog() {
+    if (file_) {
+      std::fclose(file_);
+    }
+  }
+
+ private:
+  PresentLog() {
+    const std::string path = REXCVAR_GET(present_log);
+    if (path.empty()) {
+      return;
+    }
+#if REX_PLATFORM_WIN32
+    if (fopen_s(&file_, path.c_str(), "w")) {
+      file_ = nullptr;
+    }
+#else
+    file_ = std::fopen(path.c_str(), "w");
+#endif
+    if (!file_) {
+      REXLOG_ERROR("present_log: can't open {}", path);
+      return;
+    }
+    std::setvbuf(file_, nullptr, _IOFBF, 1 << 20);
+    std::fprintf(file_, "kind,ns,refresh,thread,result,paint_us,ui\n");
+    REXLOG_INFO("present_log: {}", path);
+  }
+  // With mutex_ held.
+  void FlushPeriodically(uint64_t time) {
+    if (time >= last_flush_ + 1'000'000'000) {
+      std::fflush(file_);
+      last_flush_ = time;
+    }
+  }
+  std::mutex mutex_;
+  FILE* file_ = nullptr;
+  uint64_t last_flush_ = 0;
+};
