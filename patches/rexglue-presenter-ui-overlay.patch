+bool Presenter::IsUIOverlayPaintModeActive() const {
+  if (!ui_overlay_paint_mode_ || ui_overlay_paint_suspended_ || ui_overlay_render_failed_) {
+    return false;
+  }
+  // With implicit vsync the guest output thread's presents would wait for it,
+  // and without host_present_from_non_ui_thread it doesn't present at all:
+  // there the UI thread paints as before.
+  return ui_overlay_paint_forced_ || (REXCVAR_GET(host_present_from_non_ui_thread) &&
