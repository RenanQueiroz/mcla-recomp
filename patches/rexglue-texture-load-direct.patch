+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2022 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+// texture_load_32bpb.xesli and texture_load_64bpb.xesli for single-level
+// resolution-scaled 2D textures, storing the texels straight into the host
+// texture through an unsigned integer view of the texel size (the ReXGlue SDK's
+// texture_load_direct) instead of into a buffer copied to the texture
+// afterwards: R32_UINT / r32ui for 32bpb, R16G16B16A16_UINT / rgba16ui for
+// 64bpb. The guest addressing, endian swapping and transformation are the same;
+// the host offset and pitch push constants are unused. Built with the
+// xenia-project/xenia 0b2ffa3 shader sources, which the SDK's texture load
+// shaders are built from.
+// XE_TEXTURE_LOAD_DIRECT_64BPB: 64bpb, otherwise 32bpb with
+// XE_TEXTURE_LOAD_32BPB_TRANSFORM.
+
+#define XE_TEXTURE_LOAD_RESOLUTION_SCALED
+#include "texture_load.xesli"
+
+#ifdef XE_TEXTURE_LOAD_DIRECT_64BPB
+  #define XE_TEXTURE_LOAD_DIRECT_BLOCKS_PER_THREAD_LOG2 2u
+  #define XE_TEXTURE_LOAD_DIRECT_BPB 8u
+  #define XE_TEXTURE_LOAD_DIRECT_BPB_LOG2 3u
+#else
+  #define XE_TEXTURE_LOAD_DIRECT_BLOCKS_PER_THREAD_LOG2 3u
+  #define XE_TEXTURE_LOAD_DIRECT_BPB 4u
+  #define XE_TEXTURE_LOAD_DIRECT_BPB_LOG2 2u
+#endif
+
+#if SHADING_LANGUAGE_GLSL_XE
+  #ifdef XE_TEXTURE_LOAD_DIRECT_64BPB
+    layout(rgba16ui, set=0, binding=0) uniform writeonly uimage2DArray
+        xe_texture_load_dest;
+  #else
+    layout(r32ui, set=0, binding=0) uniform writeonly uimage2DArray
+        xe_texture_load_dest;
+  #endif
+  #define XE_TEXTURE_LOAD_DIRECT_STORE(x, y, z, value) \
+      imageStore(xe_texture_load_dest, int3_xe(int(x), int(y), int(z)), \
+                 uint4_xe(value))
+#elif SHADING_LANGUAGE_HLSL_XE
+  #ifdef XE_TEXTURE_LOAD_DIRECT_64BPB
+    RWTexture2DArray<uint4> xe_texture_load_dest : register(u0, space0);
+  #else
+    RWTexture2DArray<uint> xe_texture_load_dest : register(u0, space0);
+  #endif
+  #define XE_TEXTURE_LOAD_DIRECT_STORE(x, y, z, value) \
+      xe_texture_load_dest[uint3_xe(x, y, z)] = (value)
+#else
+  #error Direct texture loads are only implemented for GLSL and HLSL.
+#endif
+
+array_buffer_declare_xe(uint4_xe, xe_texture_load_source, set=1, binding=0, t0,
+                        space0)
+
+// Stores 16 bytes of blocks (4 32bpb or 2 64bpb) starting at block_index,
+// skipping the blocks beyond the width of the texture.
+void XeTextureLoadDirectStore(uint3_xe block_index, uint width,
+                              uint4_xe blocks) {
+  #ifdef XE_TEXTURE_LOAD_DIRECT_64BPB
+    // Little-endian: the low half of each dword is the lower-numbered
+    // component.
