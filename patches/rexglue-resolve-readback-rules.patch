+bool CommandProcessor::IsResolveReadbackSelective() {
+  return !REXCVAR_GET(readback_resolve_rules).empty() || REXCVAR_GET(resolve_log_frames) > 0 ||
+         counter_ < resolve_log_until_;
+}
+
+ReadbackResolveMode CommandProcessor::GetReadbackResolveModeFor(
+    bool legacy_readback_resolve_enabled, uint32_t written_address, uint32_t written_length) {
+  ReadbackResolveMode mode = GetReadbackResolveMode(legacy_readback_resolve_enabled);
+
+  const std::string& rules_text = REXCVAR_GET(readback_resolve_rules);
+  if (rules_text != readback_rules_text_) {
+    readback_rules_text_ = rules_text;
+    ParseReadbackRules(readback_rules_text_, readback_rules_);
+    REXGPU_INFO("readback_resolve_rules: {} rule(s) from \"{}\"", readback_rules_.size(),
+                readback_rules_text_);
+  }
+  const int32_t log_request = REXCVAR_GET(resolve_log_frames);
+  if (log_request > 0) {
+    resolve_log_until_ = counter_ + uint32_t(log_request);
+    resolve_log_count_ = 0;
+    REXCVAR_SET(resolve_log_frames, 0);
+    REXGPU_INFO("resolve log: the next {} frames (swap counter {} to {})", log_request, counter_,
+                resolve_log_until_);
+  }
+  const bool logging = counter_ < resolve_log_until_;
+  if (readback_rules_.empty() && !logging) {
+    return mode;
+  }
+
+  const reg::RB_COPY_CONTROL copy_control = register_file_->Get<reg::RB_COPY_CONTROL>();
+  const reg::RB_COPY_DEST_INFO copy_dest_info = register_file_->Get<reg::RB_COPY_DEST_INFO>();
+  const reg::RB_COPY_DEST_PITCH copy_dest_pitch = register_file_->Get<reg::RB_COPY_DEST_PITCH>();
+  const uint64_t first = written_address;
+  const uint64_t last = first + (written_length ? written_length - 1 : 0);
+  int matched = -1;
+  for (size_t i = 0; i < readback_rules_.size(); ++i) {
+    const ReadbackRule& rule = readback_rules_[i];
+    if (rule.address.set && (last < rule.address.lo || first > rule.address.hi)) {
+      continue;
+    }
+    if (rule.length.Contains(written_length) &&
+        rule.pitch.Contains(copy_dest_pitch.copy_dest_pitch) &&
+        rule.height.Contains(copy_dest_pitch.copy_dest_height) &&
+        rule.format.Contains(uint32_t(copy_dest_info.copy_dest_format)) &&
+        rule.source.Contains(copy_control.copy_src_select) &&
+        rule.phase.Contains(guest_marker_phase_)) {
+      matched = int(i);
+      break;
+    }
+  }
+  if (matched >= 0) {
+    mode = readback_rules_[size_t(matched)].mode;
+  }
+  if (logging) {
+    static const char* const kModeNames[] = {"off", "fast", "some", "full"};
+    REXGPU_INFO(
+        "resolve {}: swap {} guest frame {} phase 0x{:X} address 0x{:08X} length {} pitch {} "
+        "height {} format {} source {} -> {}{}",
+        resolve_log_count_++, counter_, guest_marker_frame_, guest_marker_phase_, written_address,
+        written_length, uint32_t(copy_dest_pitch.copy_dest_pitch),
+        uint32_t(copy_dest_pitch.copy_dest_height), uint32_t(copy_dest_info.copy_dest_format),
+        uint32_t(copy_control.copy_src_select), kModeNames[uint32_t(mode)],
+        matched >= 0 ? fmt::format(" (rule {}: {})", matched,
+                                   readback_rules_[size_t(matched)].text)
+                     : std::string());
+  }
+  return mode;
+}
