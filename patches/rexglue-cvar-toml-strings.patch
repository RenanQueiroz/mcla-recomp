+
+// Written beside the file, flushed to the disk, then renamed over it, so
+// that a crash or a full disk can't leave half a file.
+bool WriteFileDurably(const std::filesystem::path& path, const std::string& content) {
+  auto temporary = path;
+  temporary += "." + std::to_string(CurrentProcessId()) + ".tmp";
+#if defined(_WIN32)
+  FILE* file = _wfopen(temporary.c_str(), L"wb");
+#else
+  FILE* file = std::fopen(temporary.c_str(), "wb");
+#endif
+  if (!file) {
+    return false;
+  }
+  bool ok = std::fwrite(content.data(), 1, content.size(), file) == content.size();
+  ok = std::fflush(file) == 0 && ok;
+#if defined(_WIN32)
+  ok = _commit(_fileno(file)) == 0 && ok;
+#else
+  ok = fsync(fileno(file)) == 0 && ok;
+#endif
+  ok = std::fclose(file) == 0 && ok;
+  std::error_code error;
+  if (ok) {
+    std::filesystem::rename(temporary, path, error);
+    ok = !error;
+  }
+  if (!ok) {
+    std::filesystem::remove(temporary, error);
+  }
+  return ok;
+}
+
+// Sets these `key = value` statements (values already in TOML form) in the
+// file: each replaced where it is, keeping a comment after it, or added
+// before the first [table]; every other line kept. False, with the file as
+// it was, when it can't be read or written.
+bool MergeIntoToml(const std::filesystem::path& path,
+                   const std::vector<std::pair<std::string, std::string>>& values) {
+  std::string old_text;
+  std::error_code error;
+  if (std::filesystem::exists(path, error)) {
+    std::ifstream in(path, std::ios::binary);
+    std::stringstream content;
+    if (in) {
+      content << in.rdbuf();  // (sets failbit on `content` for an empty file)
+    }
+    if (!in || in.bad()) {
+      REXLOG_ERROR("Config: could not read {}; not changed", path.string());
+      return false;
+    }
+    old_text = content.str();
+  } else if (error) {
+    REXLOG_ERROR("Config: could not check {}: {}", path.string(), error.message());
+    return false;
+  }
+  TomlText text = SplitToml(old_text);
+  if (text.lines.empty()) {
+    text.lines.push_back("# Settings");
+  }
+  std::vector<bool> written(values.size(), false);
+  const auto statements = ScanToml(text.lines, nullptr, nullptr);
+  // From the last statement up, so that the line numbers of those above hold.
+  for (auto it = statements.rbegin(); it != statements.rend(); ++it) {
+    bool own = false;
+    for (size_t k = 0; k < values.size() && it->table.empty(); ++k) {
+      if (it->key != values[k].first) {
+        continue;
+      }
+      const std::string& last = text.lines[it->last];
+      const std::string after = last.substr(std::min(it->value_end, last.size()));
+      text.lines[it->first] = text.lines[it->first].substr(0, it->value_col) + values[k].second + after;
+      text.lines.erase(text.lines.begin() + std::ptrdiff_t(it->first + 1),
+                       text.lines.begin() + std::ptrdiff_t(it->last + 1));
+      written[k] = own = true;
+      break;
+    }
+    if (!own && it->first == it->last) {
+      std::string literal = LiteralForBrokenString(text.lines[it->first], it->value_col);
+      if (!literal.empty()) {
+        text.lines[it->first] = std::move(literal);
+      }
+    }
+  }
+  size_t first_table = 0;
+  ScanToml(text.lines, &first_table, nullptr);
+  std::vector<std::string> added;
+  for (size_t k = 0; k < values.size(); ++k) {
+    if (!written[k]) {
+      added.push_back(values[k].first + " = " + values[k].second);
+    }
+  }
+  text.lines.insert(text.lines.begin() + std::ptrdiff_t(first_table), added.begin(), added.end());
+  if (!WriteFileDurably(path, JoinToml(text))) {
+    REXLOG_ERROR("Config: could not write {}; not changed", path.string());
+    return false;
+  }
+  return true;
+}
