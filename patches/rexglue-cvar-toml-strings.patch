+// A TOML basic string. Values used to be written between quotes as they were,
+// so a Windows path came out as "C:\Users\...", where \U starts an escape, and
+// the whole file failed to parse the next time it was loaded.
+std::string TomlString(std::string_view value) {
+  std::string out = "\"";
+  for (char c : value) {
+    switch (c) {
+      case '"':
+        out += "\\\"";
+        break;
+      case '\\':
+        out += "\\\\";
+        break;
+      case '\t':
+        out += "\\t";
+        break;
+      case '\n':
+        out += "\\n";
+        break;
+      case '\r':
+        out += "\\r";
+        break;
+      default:
+        if (static_cast<unsigned char>(c) < 0x20 || c == 0x7F) {
+          char escape[8];
+          std::snprintf(escape, sizeof(escape), "\\u%04X", static_cast<unsigned char>(c));
+          out += escape;
+        } else {
+          out += c;
+        }
+    }
+  }
+  out += '"';
+  return out;
+}
+
+// A file toml++ rejects is read again line by line, so that one bad line no
+// longer costs every setting in it. A double-quoted value that fails only for
+// its backslashes (a path written by an older SaveConfig) is taken as written,
+// as a literal string. Lines that still fail are skipped with a warning.
+void LoadConfigByLine(const std::filesystem::path& config_path) {
+  std::ifstream in(config_path, std::ios::binary);
+  std::string line;
+  std::string prefix;
+  int line_number = 0;
+  int skipped = 0;
+  while (std::getline(in, line)) {
+    ++line_number;
+    if (!line.empty() && line.back() == '\r') {
+      line.pop_back();
+    }
+    const size_t first = line.find_first_not_of(" \t");
+    if (first == std::string::npos || line[first] == '#') {
+      continue;
+    }
+    if (line[first] == '[') {
+      // A table header: its keys are prefixed as ApplyTomlTable does.
+      const size_t close = line.find(']', first);
+      if (close == std::string::npos || line.compare(first, 2, "[[") == 0) {
+        REXLOG_WARN("Config: {} line {} skipped: {}", config_path.filename().string(),
+                    line_number, line);
+        ++skipped;
+        prefix = "\x01";  // keys under it are skipped too
+        continue;
+      }
+      prefix = line.substr(first + 1, close - first - 1);
+      prefix.erase(0, prefix.find_first_not_of(" \t"));
+      prefix.erase(prefix.find_last_not_of(" \t") + 1);
+      for (char& c : prefix) {
+        if (c == '.') {
+          c = '_';
+        }
+      }
+      continue;
+    }
+    if (prefix == "\x01") {
+      ++skipped;
+      continue;
+    }
+    std::optional<toml::table> table;
+    try {
+      table = toml::parse(line);
+    } catch (const toml::parse_error&) {
+      const size_t equals = line.find('=');
+      const size_t open =
+          equals == std::string::npos ? std::string::npos : line.find_first_not_of(" \t", equals + 1);
+      const size_t close = line.rfind('"');
+      if (open != std::string::npos && line[open] == '"' && close != std::string::npos &&
+          close > open && line.find('\'', open) == std::string::npos) {
+        std::string literal = line.substr(0, open) + "'" + line.substr(open + 1, close - open - 1) +
+                              "'" + line.substr(close + 1);
+        try {
+          table = toml::parse(literal);
+        } catch (const toml::parse_error&) {
+        }
+      }
+    }
+    if (!table) {
+      REXLOG_WARN("Config: {} line {} skipped: {}", config_path.filename().string(), line_number,
+                  line);
+      ++skipped;
+      continue;
+    }
+    ApplyTomlTable(*table, prefix);
+  }
+  REXLOG_WARN("Config: {} read line by line, {} line(s) skipped", config_path.string(), skipped);
+}
