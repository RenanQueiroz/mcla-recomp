+// --- The settings file, as text ------------------------------------------------
+//
+// Strings are written as TOML basic strings. They used to be written between
+// quotes as they were, so a Windows path came out as "C:\Users\...", where \U
+// starts an escape, and the whole file failed to parse the next time.
+std::string TomlString(std::string_view value) {
+  std::string out = "\"";
+  for (char c : value) {
+    switch (c) {
+      case '"':
+        out += "\\\"";
+        break;
+      case '\\':
+        out += "\\\\";
+        break;
+      case '\t':
+        out += "\\t";
+        break;
+      case '\n':
+        out += "\\n";
+        break;
+      case '\r':
+        out += "\\r";
+        break;
+      default:
+        if (static_cast<unsigned char>(c) < 0x20 || c == 0x7F) {
+          char escape[8];
+          std::snprintf(escape, sizeof(escape), "\\u%04X", static_cast<unsigned char>(c));
+          out += escape;
+        } else {
+          out += c;
+        }
+    }
+  }
+  out += '"';
+  return out;
+}
+
+// The file is edited in place rather than rewritten: a flag's `key = value`
+// statement is replaced where it is, and every other line (comments, keys of
+// flags not registered, tables, edits by hand) is kept. The scanner finds the
+// statements, including values that span lines (multi-line strings and
+// arrays), so that lines inside such a value are never taken for keys.
+struct TomlText {
+  std::vector<std::string> lines;  // without line endings or a BOM
+  bool bom = false;
+  bool crlf = false;
+};
+
+TomlText SplitToml(std::string_view text) {
+  TomlText out;
+  if (text.substr(0, 3) == "\xEF\xBB\xBF") {
+    out.bom = true;
+    text.remove_prefix(3);
+  }
+  while (!text.empty()) {
+    const size_t end = text.find('\n');
+    std::string line(text.substr(0, end));
+    if (!line.empty() && line.back() == '\r') {
+      line.pop_back();
+      out.crlf = true;
+    }
+    out.lines.push_back(std::move(line));
+    if (end == std::string_view::npos) {
+      break;
+    }
+    text.remove_prefix(end + 1);
+  }
+  return out;
+}
+
+std::string JoinToml(const TomlText& text) {
+  std::string out = text.bom ? "\xEF\xBB\xBF" : "";
+  for (const std::string& line : text.lines) {
+    out += line;
+    out += text.crlf ? "\r\n" : "\n";
+  }
+  return out;
+}
+
+struct TomlPos {
+  size_t line;
+  size_t col;
+};
+
+// Moves past the value that starts at `at`: across lines for a multi-line
+// string or an array, and up to (not including) the whitespace or comment
+// after it. A value still open at the end of the file ends there.
+TomlPos SkipTomlValue(const std::vector<std::string>& lines, TomlPos at) {
+  size_t li = at.line;
+  size_t ci = at.col;
+  int depth = 0;  // [ and { still open
+  auto at_end = [&] { return TomlPos{lines.size() - 1, lines.back().size()}; };
+  while (li < lines.size()) {
+    const std::string& line = lines[li];
+    if (ci >= line.size()) {
+      if (depth == 0) {
+        return {li, line.size()};
+      }
+      ++li;
+      ci = 0;
+      continue;
+    }
+    const char c = line[ci];
+    if (line.compare(ci, 3, "\"\"\"") == 0 || line.compare(ci, 3, "'''") == 0) {
+      const std::string close = line.substr(ci, 3);
+      ci += 3;
+      for (;;) {
+        if (li >= lines.size()) {
+          return at_end();
+        }
+        if (ci >= lines[li].size()) {
+          ++li;
+          ci = 0;
+          continue;
+        }
+        if (close[0] == '"' && lines[li][ci] == '\\') {
+          ci += 2;
+          continue;
+        }
+        if (lines[li].compare(ci, 3, close) == 0) {
+          ci += 3;
+          // Up to two more quotes belong to the string.
+          for (int extra = 0; extra < 2 && ci < lines[li].size() && lines[li][ci] == close[0];
+               ++extra) {
+            ++ci;
+          }
+          break;
+        }
+        ++ci;
+      }
+      if (li >= lines.size()) {
+        return at_end();
+      }
+      if (depth == 0) {
+        return {li, ci};
+      }
+    } else if (c == '"' || c == '\'') {
+      ++ci;
+      while (ci < line.size() && line[ci] != c) {
+        ci += (c == '"' && line[ci] == '\\') ? 2 : 1;
+      }
+      ci = std::min(ci + 1, line.size());
+      if (depth == 0) {
+        return {li, ci};
+      }
+    } else if (c == '[' || c == '{') {
+      ++depth;
+      ++ci;
+    } else if (c == ']' || c == '}') {
+      depth = std::max(0, depth - 1);
+      ++ci;
+      if (depth == 0) {
+        return {li, ci};
+      }
+    } else if (c == '#') {
+      if (depth == 0) {
+        return {li, ci};
+      }
+      ci = line.size();  // a comment inside an array runs to the end of its line
+    } else if ((c == ' ' || c == '\t') && depth == 0) {
+      return {li, ci};
+    } else {
+      ++ci;
+    }
+  }
+  return at_end();
+}
+
+// A key at line[pos], bare or quoted parts joined by dots, up to its '='.
+bool ParseTomlKey(const std::string& line, size_t& pos, std::string& key) {
+  key.clear();
+  for (;;) {
+    pos = line.find_first_not_of(" \t", pos);
+    if (pos == std::string::npos) {
+      return false;
+    }
+    if (line[pos] == '"' || line[pos] == '\'') {
+      const size_t end = line.find(line[pos], pos + 1);
+      if (end == std::string::npos) {
+        return false;
+      }
+      key += line.substr(pos + 1, end - pos - 1);
+      pos = end + 1;
+    } else {
+      size_t end = pos;
+      while (end < line.size() &&
+             (std::isalnum(static_cast<unsigned char>(line[end])) || line[end] == '_' ||
+              line[end] == '-')) {
+        ++end;
+      }
+      if (end == pos) {
+        return false;
+      }
+      key += line.substr(pos, end - pos);
+      pos = end;
+    }
+    pos = line.find_first_not_of(" \t", pos);
+    if (pos != std::string::npos && line[pos] == '.') {
+      key += '.';
+      ++pos;
+      continue;
+    }
+    return pos != std::string::npos && line[pos] == '=';
+  }
+}
+
+struct TomlStatement {
+  std::string key;    // unquoted, dotted parts joined with '.'
+  std::string table;  // the [table] it is under, "" at the top, "\x01" under [[...]]
+  size_t first = 0;   // its lines
+  size_t last = 0;
+  size_t value_col = 0;  // where the value starts on `first`
+  size_t value_end = 0;  // and ends on `last`
+};
+
+std::string TrimToml(std::string text) {
+  const size_t begin = text.find_first_not_of(" \t");
+  const size_t end = text.find_last_not_of(" \t");
+  return begin == std::string::npos ? std::string() : text.substr(begin, end - begin + 1);
+}
+
+// The file's statements. `first_table` gets the line of its first [table];
+// `unknown` the lines that are none of a statement, a table, a comment or blank.
+std::vector<TomlStatement> ScanToml(const std::vector<std::string>& lines, size_t* first_table,
+                                    std::vector<size_t>* unknown) {
+  std::vector<TomlStatement> statements;
+  std::string table;
+  if (first_table) {
+    *first_table = lines.size();
+  }
+  for (size_t i = 0; i < lines.size();) {
+    const std::string& line = lines[i];
+    const size_t p = line.find_first_not_of(" \t");
+    if (p == std::string::npos || line[p] == '#') {
+      ++i;
+      continue;
+    }
+    if (line[p] == '[') {
+      if (first_table && *first_table == lines.size()) {
+        *first_table = i;
+      }
+      const size_t close = line.find(']', p);
+      table = line.compare(p, 2, "[[") == 0 || close == std::string::npos
+                  ? "\x01"
+                  : TrimToml(line.substr(p + 1, close - p - 1));
+      ++i;
+      continue;
+    }
+    TomlStatement statement;
+    size_t pos = p;
+    if (!ParseTomlKey(line, pos, statement.key)) {
+      if (unknown) {
+        unknown->push_back(i);
+      }
+      ++i;
+      continue;
+    }
+    statement.table = table;
+    statement.first = i;
+    statement.value_col = std::min(line.find_first_not_of(" \t", pos + 1), line.size());
+    const TomlPos end = SkipTomlValue(lines, {i, statement.value_col});
+    statement.last = end.line;
+    statement.value_end = end.col;
+    statements.push_back(statement);
+    i = end.line + 1;
+  }
+  return statements;
+}
+
+bool HexDigits(std::string_view text, size_t at, size_t count, uint32_t& value) {
+  if (at + count > text.size()) {
+    return false;
+  }
+  value = 0;
+  for (size_t i = at; i < at + count; ++i) {
+    const char c = text[i];
+    if (!std::isxdigit(static_cast<unsigned char>(c))) {
+      return false;
+    }
+    value = value * 16 + uint32_t(std::isdigit(static_cast<unsigned char>(c))
+                                      ? c - '0'
+                                      : (std::tolower(static_cast<unsigned char>(c)) - 'a' + 10));
+  }
+  return true;
+}
+
+// Whether a basic string's body has only TOML escapes, including \u and \U
+// of a Unicode scalar value.
+bool ValidTomlEscapes(std::string_view body) {
+  for (size_t i = 0; i < body.size(); ++i) {
+    if (body[i] != '\\') {
+      continue;
+    }
+    const char next = i + 1 < body.size() ? body[i + 1] : '\0';
+    uint32_t code = 0;
+    if (next != '\0' && std::strchr("btnfr\"\\", next)) {
+      ++i;
+    } else if ((next == 'u' && HexDigits(body, i + 2, 4, code)) ||
+               (next == 'U' && HexDigits(body, i + 2, 8, code))) {
+      if (code > 0x10FFFF || (code >= 0xD800 && code <= 0xDFFF)) {
+        return false;
+      }
+      i += next == 'u' ? 5 : 9;
+    } else {
+      return false;
+    }
+  }
+  return true;
+}
+
+// A one-line double-quoted value whose backslashes are not TOML escapes, as
+// older saves wrote Windows paths, as the same text in a literal string; empty
+// when it isn't one (or holds a quote, which a literal string can't).
+std::string LiteralForBrokenString(const std::string& line, size_t value_col) {
+  if (value_col >= line.size() || line[value_col] != '"' ||
+      line.compare(value_col, 3, "\"\"\"") == 0) {
+    return {};
+  }
+  const size_t close = line.rfind('"');
+  if (close <= value_col) {
+    return {};
+  }
+  const std::string body = line.substr(value_col + 1, close - value_col - 1);
+  const std::string tail = TrimToml(line.substr(close + 1));
+  if (body.find_first_of("\"'") != std::string::npos || (!tail.empty() && tail[0] != '#') ||
+      ValidTomlEscapes(body)) {
+    return {};
+  }
+  return line.substr(0, value_col) + "'" + body + "'" + line.substr(close + 1);
+}
+
+std::string TablePrefix(std::string table) {
+  table.erase(std::remove(table.begin(), table.end(), '"'), table.end());
+  std::replace(table.begin(), table.end(), '.', '_');
+  return table;
+}
+
+// A file toml++ rejects is read again statement by statement, so that one bad
+// line no longer costs every setting in it: each statement that parses on its
+// own applies (with its [table] prefix), a double-quoted value that fails only
+// for its backslashes is taken as written, and the rest is skipped with a
+// warning.
+void LoadConfigByLine(const std::filesystem::path& config_path) {
+  std::ifstream in(config_path, std::ios::binary);
+  std::stringstream content;
+  content << in.rdbuf();
+  const TomlText text = SplitToml(content.str());
+  std::vector<size_t> unknown;
+  const auto statements = ScanToml(text.lines, nullptr, &unknown);
+  int skipped = 0;
+  auto skip = [&](size_t line) {
+    REXLOG_WARN("Config: {} line {} skipped: {}", config_path.filename().string(), line + 1,
+                text.lines[line]);
+    ++skipped;
+  };
+  for (size_t line : unknown) {
+    skip(line);
+  }
+  for (const TomlStatement& statement : statements) {
+    if (statement.table == "\x01") {
+      skip(statement.first);
+      continue;
+    }
+    std::string snippet;
+    for (size_t i = statement.first; i <= statement.last; ++i) {
+      snippet += text.lines[i] + "\n";
+    }
+    std::optional<toml::table> parsed;
+    try {
+      parsed = toml::parse(snippet);
+    } catch (const toml::parse_error&) {
+      if (statement.first == statement.last) {
+        const std::string literal =
+            LiteralForBrokenString(text.lines[statement.first], statement.value_col);
+        if (!literal.empty()) {
+          try {
+            parsed = toml::parse(literal);
+          } catch (const toml::parse_error&) {
+          }
+        }
+      }
+    }
+    if (!parsed) {
+      skip(statement.first);
+      continue;
+    }
+    ApplyTomlTable(*parsed, TablePrefix(statement.table));
+  }
+  REXLOG_WARN("Config: {} read statement by statement, {} line(s) skipped", config_path.string(),
+              skipped);
+}
