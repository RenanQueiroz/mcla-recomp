 void D3D12CommandProcessor::OnPrimaryBufferEnd() {
+  // The end of a chunk of the primary buffer (where the game's last kick left off) can fall
+  // between the begin and the end of a guest occlusion query. Ending the submission there cut the
+  // host query: it is ended by EndSubmission, so the guest's end found none, which turned host
+  // occlusion queries off for the rest of the run. With the query open the submission goes on
+  // with the next chunk, and ends at the next point that is not inside a query.
   if (REXCVAR_GET(d3d12_submit_on_primary_buffer_end) && submission_open_ &&
-      CanEndSubmissionImmediately()) {
+      CanEndSubmissionImmediately() &&
+      !(active_occlusion_query_.valid && REXCVAR_GET(occlusion_query_keep_submission_open))) {
     EndSubmission(false);
   }
 }
@@ -5928,7 +6020,9 @@ bool D3D12CommandProcessor::EndGuestOcclusionQuery(
   }
 
   uint64_t samples = occlusion_query_readback_mapping_[host_index];
+  g_last_occlusion_raw_samples = samples;
   samples = NormalizeOcclusionSamples(samples);
+  LastOcclusionSamples()[sample_count_address] = samples;
   WriteGuestOcclusionResult(sample_counts, samples);
   return true;
 }
