+        "host, scale {}x{}); {}",
+        sample_count_addr, counter_, uint32_t(sample_counts->ZPass_A), g_last_occlusion_raw_samples,
+        texture_cache_ ? texture_cache_->draw_resolution_scale_x() : 1,
+        texture_cache_ ? texture_cache_->draw_resolution_scale_y() : 1, counters_text());
+  }
   return true;
 }
 
