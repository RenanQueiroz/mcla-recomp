@@ -10,6 +10,8 @@
  */
 #pragma once
 
+#include <atomic>
+#include <cstddef>
 #include <cstdint>
 #include <string>
 
@@ -160,8 +162,44 @@ class Profiler {
 #define PROFILE_PIPELINE_CACHE_HIT() PERF_counter_inc(kPipelineCacheHits)
 #define PROFILE_PIPELINE_CACHE_MISS() PERF_counter_inc(kPipelineCacheMisses)
 
+namespace rex::perf {
+// Totals for counters one thread bumps many times a frame (the GPU command
+// thread, per draw and per texture and pipeline lookup). Adding to them is a
+// plain load and store inside the calling module, with no call into
+// rexruntime and no locked instruction; FlushBatchedCounters, called by that
+// same thread once a frame before Profiler::Flip, moves the totals into the
+// shared counters, so the per-frame snapshot sees them.
+struct BatchedCounters {
+  std::atomic<int64_t> values[static_cast<size_t>(CounterId::kCount)] = {};
+};
+// Inline variable: each module (DLL) gets its own instance.
+inline BatchedCounters g_batched_counters;
+
+inline void AddBatched(CounterId id, int64_t delta) {
+  std::atomic<int64_t>& value = g_batched_counters.values[static_cast<size_t>(id)];
+  value.store(value.load(std::memory_order_relaxed) + delta, std::memory_order_relaxed);
+}
+
+inline void FlushBatchedCounters() {
+  for (size_t i = 0; i < static_cast<size_t>(CounterId::kCount); ++i) {
+    std::atomic<int64_t>& value = g_batched_counters.values[i];
+    if (int64_t total = value.load(std::memory_order_relaxed)) {
+      value.store(0, std::memory_order_relaxed);
+      IncrementCounter(static_cast<CounterId>(i), total);
+    }
+  }
+}
+}  // namespace rex::perf
+
+// Add to a counter, batched (see BatchedCounters) or directly.
+#define PERF_counter_add_batched(batched, id, delta)                         \
+  ((batched) ? rex::perf::AddBatched(rex::perf::CounterId::id, (delta))      \
+             : rex::perf::IncrementCounter(rex::perf::CounterId::id, (delta)))
+
 #else
 
+#define PERF_counter_add_batched(batched, id, delta) ((void)0)
+
 #define PERF_counter_set(id, value)
 #define PERF_counter_inc(id)
 #define PERF_counter_add(id, delta)
