diff --git a/include/rex/ui/imgui_dialog.h b/include/rex/ui/imgui_dialog.h
index a7ab6b3..7be49e0 100644
--- a/include/rex/ui/imgui_dialog.h
+++ b/include/rex/ui/imgui_dialog.h
@@ -12,6 +12,9 @@
 #ifndef REX_UI_IMGUI_DIALOG_H_
 #define REX_UI_IMGUI_DIALOG_H_
 
+// ImGuiDialog::RepaintsContinuously() is available.
+#define REX_UI_IMGUI_DIALOG_REPAINT_ON_DEMAND 1
+
 #include <memory>
 #include <vector>
 
@@ -39,6 +42,12 @@ class ImGuiDialog {
 
   void Draw();
 
+  // Whether the drawer keeps repainting the window while this dialog is shown,
+  // for animation and input. A dialog that returns false is drawn whenever the
+  // window is painted anyway, such as with each new guest frame, so it costs no
+  // presents of its own.
+  virtual bool RepaintsContinuously() const { return true; }
+
  protected:
   ImGuiDialog(ImGuiDrawer* imgui_drawer);
 
diff --git a/src/ui/imgui_drawer.cpp b/src/ui/imgui_drawer.cpp
index f270f3c..9438093 100644
--- a/src/ui/imgui_drawer.cpp
+++ b/src/ui/imgui_drawer.cpp
@@ -9,6 +9,7 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <algorithm>
 #include <cfloat>
 #include <cstring>
 #include <filesystem>
@@ -439,7 +440,11 @@ void ImGuiDrawer::Draw(UIDrawContext& ui_draw_context) {
   if (!dialogs_.empty()) {
     // Repaint (and handle input) continuously if still active. In detached mode
     // there is no presenter; the app drives repaint via its own present loop.
-    if (presenter_) {
+    // Dialogs that need no repaints of their own are drawn with the paints
+    // that happen anyway (new guest frames).
+    if (presenter_ && std::any_of(dialogs_.begin(), dialogs_.end(), [](const ImGuiDialog* dialog) {
+          return dialog->RepaintsContinuously();
+        })) {
       presenter_->RequestUIPaintFromUIThread();
     }
   }
