+// Copies the float constants a shader uses from the register file into a constant buffer, the way
+// the draw's constant buffer is laid out: only the constants the shader's bitmap names (bit i of
+// bitmap[w] is constant w * 64 + i), in that order, four floats (16 bytes) each. The same bytes the
+// loop that copies them one at a time writes, but a run of consecutive constants is one memcpy.
+// `registers` is the register file's first float constant of the shader's stage
+// (&regs[XE_GPU_REG_SHADER_CONSTANT_000_X] for the vertex shader, _256_X for the pixel shader).
+// Returns `destination` advanced past what was written.
+inline uint8_t* CopyUsedFloatConstants(uint8_t* destination, const uint32_t* registers,
+                                       const uint64_t* bitmap) {
+  for (uint32_t word = 0; word < 4; ++word) {
+    uint64_t bits = bitmap[word];
+    const uint32_t* block = registers + (word << 8);  // 64 constants of four registers
+    while (bits) {
+      const uint32_t first = uint32_t(std::countr_zero(bits));
+      const uint32_t run = uint32_t(std::countr_one(bits >> first));  // consecutive constants in use
+      std::memcpy(destination, block + (first << 2), size_t(run) * 4 * sizeof(float));
+      destination += size_t(run) * 4 * sizeof(float);
+      bits &= ~(((run >= 64) ? ~uint64_t(0) : ((uint64_t(1) << run) - 1)) << first);
+    }
+  }
+  return destination;
+}
