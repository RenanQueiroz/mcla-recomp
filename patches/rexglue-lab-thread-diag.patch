+void OnThreadCreated(uint32_t handle, uint32_t host_tid, uint32_t entry, uint32_t xapi_startup, uint32_t context,
+                     uint32_t creation_flags, uint32_t stack_size, bool guest) {
+  if (!g_diag) {
+    return;
+  }
+  REXAPU_INFO(
+      "audio lab thread created: h={:08X} tid={} guest={} entry={:08X} xapi={:08X} ctx={:08X} flags={:08X} stack={} proc={}",
+      handle, host_tid, guest ? 1 : 0, entry, xapi_startup, context, creation_flags, stack_size, creation_flags >> 24);
+}
+
+void OnThreadStart(uint32_t entry) {
+  if (g_boost <= 0 || g_entry_count == 0) {
+    return;
+  }
+  for (size_t i = 0; i < g_entry_count; ++i) {
+    if (g_entries[i] == entry) {
+      BoostSelf(g_boost, "its entry is in audio_mixer_entries");
+      return;
+    }
+  }
+}
