+/**
+ * @file        audio/audio_lab.cpp
+ * @brief       LAB ONLY: the thread behind the audio pump's wait, and a host priority for it (issue #21)
+ *
+ * Added by the mcla-recomp fork (patches/rexglue-lab-thread-diag.patch), never released. See audio_lab.h.
+ *
+ * What it records, with audio_thread_diag (and audio_stats):
+ *  - every guest thread's creation parameters, and the priorities and affinities the game asks for (log lines);
+ *  - a table of waits and signals: one row per (thread, call site, kernel object, kind) with the count, the time in
+ *    the wait and the time from the object's last signal to the wake-up (the scheduling delay when the signal came
+ *    while the thread waited);
+ *  - the objects the audio pump's callback waits on, and the guest thread that signals one of them: that is the
+ *    "mixer thread". Per signal of such an object it keeps a round (CPU time by QueryThreadCycleTime, wall time in
+ *    time-stamp ticks, time in kernel waits and in critical sections) and prints it once a second together with
+ *    the thread's MXCSR counters.
+ * With audio_mixer_priority > 0 that thread (and the guest threads whose entry address is in audio_mixer_entries)
+ * gets the host priority and MMCSS treatment that audio_thread_priority gives the audio worker.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <rex/audio/audio_dump.h>
+#include <rex/audio/audio_lab.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ppc/context.h>
+#include <rex/system/kernel_state.h>
+#include <rex/system/thread_state.h>
+#include <rex/system/xobject.h>
+#include <rex/system/xthread.h>
+#include <rex/thread.h>
+
+REXCVAR_DEFINE_BOOL(audio_thread_diag, false, "Audio",
+                    "Lab build only (patches/rexglue-lab-thread-diag.patch): with audio_stats, log which guest thread the "
+                    "audio pump's callback waits for ('audio lab' lines): the guest threads' creation parameters, the "
+                    "priorities and affinities the game asks for, a table of waits and signals, and a round of the thread "
+                    "that signals what the pump waits on. Restart")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+REXCVAR_DEFINE_INT32(audio_mixer_priority, 0, "Audio",
+                     "Lab build only: host priority of the game's own audio mixer thread, as audio_thread_priority gives it "
+                     "to the audio worker: 0 = normal, 1 = above normal, 2 = highest, 3 = highest and MMCSS (\"Pro Audio\"). "
+                     "It goes to the guest thread that signals what the pump's callback waits on (audio_mixer_entries "
+                     "auto) and to guest threads whose entry address is listed. Restart")
+    .range(0, 3)
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+REXCVAR_DEFINE_STRING(audio_mixer_entries, "auto", "Audio",
+                      "Lab build only: which guest threads audio_mixer_priority applies to: 'auto' = the one that signals what "
+                      "the audio pump waits on, and/or guest entry addresses in hex (82123456,8212ABCD), separated by commas "
+                      "or semicolons; 'auto' may be listed with them");
+
+namespace rex::audio::lab {
+
+std::atomic<bool> g_active{false};
+thread_local bool tls_in_pump = false;
+
+namespace {
+
+using rex::audio::dump::LabTsc;
+
+constexpr size_t kRows = 4096;
+constexpr size_t kObjs = 1024;
+constexpr size_t kMixers = 8;
+constexpr size_t kPump = 16;
+constexpr size_t kEntries = 8;
+constexpr int kBuckets = 9;
+constexpr uint64_t kEdgesUs[kBuckets - 1] = {50, 100, 200, 400, 800, 1600, 3200, 6400};
+
+bool g_diag = false;
+int g_boost = 0;
+bool g_auto = true;
+uint32_t g_entries[kEntries] = {};
+size_t g_entry_count = 0;
+std::atomic<uint32_t> g_worker_tid{0};
+std::atomic<uint64_t> g_dropped{0};
+
+struct Row {
+  std::atomic<uint64_t> key{0};
+  std::atomic<uint32_t> ready{0};
+  uint32_t op = 0, tid = 0, handle = 0, lr = 0, obj_handle = 0, obj_guest = 0, obj_type = 0;
+  const void* obj = nullptr;
+  std::atomic<uint64_t> n{0}, ticks{0}, max_ticks{0}, max_all{0}, lat_n{0}, lat_ticks{0}, lat_max{0};
+};
+Row g_rows[kRows];
+
+struct ObjSlot {
+  std::atomic<const void*> ptr{nullptr};
+  std::atomic<uint64_t> last_sig{0};
+  std::atomic<uint32_t> sig_tid{0};
+};
+ObjSlot g_objs[kObjs];
+std::atomic<const void*> g_pump[kPump];
+
+struct Mixer {
+  uint32_t tid = 0, handle = 0, xid = 0, entry = 0, context = 0, flags = 0;
+  void* thread_state = nullptr;
+  // owned by the mixer thread
+  uint64_t r_tsc0 = 0, r_cpu0 = 0, r_wait = 0, r_cs = 0;
+  // read by the reporter
+  std::atomic<uint64_t> rounds{0}, cpu_ns{0}, wall{0}, wait{0}, busy{0}, cs{0}, cs_n{0}, lat_n{0}, lat_ticks{0}, lat_max{0};
+  std::atomic<uint64_t> hist_cpu[kBuckets], hist_busy[kBuckets];
+};
+Mixer g_mixers[kMixers];
+std::atomic<size_t> g_mixer_count{0};
+
+struct Tls {
+  bool init = false;
+  uint32_t tid = 0, handle = 0, xid = 0;
+  Mixer* mixer = nullptr;
+};
+thread_local Tls t_tls;
+
+Tls& T() {
+  Tls& t = t_tls;
+  if (!t.init) {
+    t.init = true;
+    t.tid = rex::thread::current_thread_system_id();
+    if (rex::system::XThread::IsInThread()) {
+      rex::system::XThread* xt = rex::system::XThread::GetCurrentThread();
+      t.handle = xt->handle();
+      t.xid = xt->thread_id();
+    }
+  }
+  return t;
+}
+
+uint32_t CurrentLr() {
+  rex::runtime::ThreadState* ts = rex::runtime::ThreadState::Get();
+  return ts ? static_cast<uint32_t>(ts->context()->lr) : 0;
+}
+
+void RaiseMax(std::atomic<uint64_t>& a, uint64_t v) {
+  uint64_t cur = a.load(std::memory_order_relaxed);
+  while (v > cur && !a.compare_exchange_weak(cur, v, std::memory_order_relaxed)) {
+  }
+}
+
+uint64_t Mix(uint64_t x) {
+  x ^= x >> 33;
+  x *= 0xFF51AFD7ED558CCDull;
+  x ^= x >> 33;
+  x *= 0xC4CEB9FE1A85EC53ull;
+  x ^= x >> 33;
+  return x;
+}
+
+uint64_t RowKey(Op op, uint32_t tid, uint32_t lr, const void* obj) {
+  uint64_t h = Mix(static_cast<uint64_t>(op) + 1);
+  h = Mix(h ^ (static_cast<uint64_t>(tid) << 1));
+  h = Mix(h ^ (static_cast<uint64_t>(lr) << 7));
+  h = Mix(h ^ reinterpret_cast<uintptr_t>(obj));
+  return h | 1;
+}
+
+Row* FindRow(uint64_t key, bool& fresh) {
+  fresh = false;
+  size_t i = static_cast<size_t>(key) & (kRows - 1);
+  for (size_t probe = 0; probe < 64; ++probe, i = (i + 1) & (kRows - 1)) {
+    Row& r = g_rows[i];
+    uint64_t k = r.key.load(std::memory_order_acquire);
+    if (k == key) {
+      return &r;
+    }
+    if (k == 0) {
+      uint64_t expected = 0;
+      if (r.key.compare_exchange_strong(expected, key, std::memory_order_acq_rel)) {
+        fresh = true;
+        return &r;
+      }
+      if (expected == key) {
+        return &r;
+      }
+    }
+  }
+  return nullptr;
+}
+
+ObjSlot* FindObj(const void* p, bool create) {
+  size_t i = static_cast<size_t>(Mix(reinterpret_cast<uintptr_t>(p))) & (kObjs - 1);
+  for (size_t probe = 0; probe < 32; ++probe, i = (i + 1) & (kObjs - 1)) {
+    ObjSlot& s = g_objs[i];
+    const void* cur = s.ptr.load(std::memory_order_acquire);
+    if (cur == p) {
+      return &s;
+    }
+    if (!cur) {
+      if (!create) {
+        return nullptr;
+      }
+      const void* expected = nullptr;
+      if (s.ptr.compare_exchange_strong(expected, p, std::memory_order_acq_rel) || expected == p) {
+        return &s;
+      }
+    }
+  }
+  return nullptr;
+}
+
+void MarkPump(const void* p) {
+  for (size_t i = 0; i < kPump; ++i) {
+    const void* cur = g_pump[i].load(std::memory_order_relaxed);
+    if (cur == p) {
+      return;
+    }
+    if (!cur) {
+      const void* expected = nullptr;
+      if (g_pump[i].compare_exchange_strong(expected, p, std::memory_order_relaxed) || expected == p) {
+        return;
+      }
+    }
+  }
+}
+
+bool IsPump(const void* p) {
+  for (size_t i = 0; i < kPump; ++i) {
+    if (g_pump[i].load(std::memory_order_relaxed) == p) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void AddRow(Op op, const Tls& t, uint32_t lr, const rex::system::XObject* obj, uint64_t ticks, uint64_t lat) {
+  bool fresh = false;
+  Row* r = FindRow(RowKey(op, t.tid, lr, obj), fresh);
+  if (!r) {
+    g_dropped.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  if (fresh) {
+    r->op = static_cast<uint32_t>(op);
+    r->tid = t.tid;
+    r->handle = t.handle;
+    r->lr = lr;
+    r->obj = obj;
+    if (obj) {
+      r->obj_handle = obj->handle();
+      r->obj_guest = obj->guest_object();
+      r->obj_type = static_cast<uint32_t>(obj->type());
+    }
+    r->ready.store(1, std::memory_order_release);
+  }
+  r->n.fetch_add(1, std::memory_order_relaxed);
+  if (ticks) {
+    r->ticks.fetch_add(ticks, std::memory_order_relaxed);
+    RaiseMax(r->max_ticks, ticks);
+    RaiseMax(r->max_all, ticks);
+  }
+  if (lat) {
+    r->lat_n.fetch_add(1, std::memory_order_relaxed);
+    r->lat_ticks.fetch_add(lat, std::memory_order_relaxed);
+    RaiseMax(r->lat_max, lat);
+  }
+}
+
+int Bucket(uint64_t us) {
+  int i = 0;
+  while (i < kBuckets - 1 && us >= kEdgesUs[i]) {
+    ++i;
+  }
+  return i;
+}
+
+// ---- host priority and MMCSS for the calling thread
+
+void BoostSelf(int level, const char* why) {
+#if defined(_WIN32)
+  if (level <= 0) {
+    return;
+  }
+  const BOOL ok = SetThreadPriority(GetCurrentThread(), level >= 2 ? THREAD_PRIORITY_HIGHEST : THREAD_PRIORITY_ABOVE_NORMAL);
+  const char* mmcss = "not requested";
+  if (level >= 3) {
+    using SetCharacteristics = HANDLE(WINAPI*)(LPCWSTR, LPDWORD);
+    static const SetCharacteristics set_characteristics = []() -> SetCharacteristics {
+      HMODULE avrt = LoadLibraryW(L"avrt.dll");
+      return avrt ? reinterpret_cast<SetCharacteristics>(
+                        reinterpret_cast<void*>(GetProcAddress(avrt, "AvSetMmThreadCharacteristicsW")))
+                  : nullptr;
+    }();
+    DWORD task_index = 0;
+    HANDLE task = set_characteristics ? set_characteristics(L"Pro Audio", &task_index) : nullptr;
+    mmcss = task ? "joined (Pro Audio)" : "FAILED";
+  }
+  REXAPU_INFO("audio lab boost: guest thread h={:08X} tid={} ({}) host priority {} at level {}, MMCSS {}",
+              T().handle, T().tid, why, ok ? "set" : "NOT set", level, mmcss);
+#else
+  (void)level;
+  (void)why;
+#endif
+}
+
+Mixer* ClaimMixer(const Tls& t) {
+  const size_t idx = g_mixer_count.fetch_add(1, std::memory_order_relaxed);
+  if (idx >= kMixers) {
+    return nullptr;
+  }
+  Mixer& m = g_mixers[idx];
+  m.tid = t.tid;
+  m.handle = t.handle;
+  m.xid = t.xid;
+  rex::system::XThread* xt = rex::system::XThread::GetCurrentThread();
+  m.entry = xt->creation_params()->start_address;
+  m.context = xt->creation_params()->start_context;
+  m.flags = xt->creation_params()->creation_flags;
+  m.thread_state = xt->thread_state();
+  REXAPU_INFO("audio lab mixer thread found: h={:08X} tid={} xid={} entry={:08X} ctx={:08X} flags={:08X} (it signals an object the audio pump waits on)",
+              m.handle, m.tid, m.xid, m.entry, m.context, m.flags);
+  return &m;
+}
+
+// One round of the mixer thread ends at each signal of a pump object by that thread.
+void MixerRound(Mixer& m, uint64_t now) {
+  const uint64_t cpu = rex::audio::dump::ThreadCpuNs();
+  if (m.r_tsc0) {
+    const uint64_t wall = now - m.r_tsc0;
+    const uint64_t cpu_d = cpu >= m.r_cpu0 ? cpu - m.r_cpu0 : 0;
+    const uint64_t busy = wall > m.r_wait ? wall - m.r_wait : 0;
+    const double tpu = rex::audio::dump::LabTscPerUs();
+    m.rounds.fetch_add(1, std::memory_order_relaxed);
+    m.cpu_ns.fetch_add(cpu_d, std::memory_order_relaxed);
+    m.wall.fetch_add(wall, std::memory_order_relaxed);
+    m.wait.fetch_add(m.r_wait, std::memory_order_relaxed);
+    m.busy.fetch_add(busy, std::memory_order_relaxed);
+    m.cs.fetch_add(m.r_cs, std::memory_order_relaxed);
+    m.hist_cpu[Bucket(cpu_d / 1000)].fetch_add(1, std::memory_order_relaxed);
+    m.hist_busy[Bucket(tpu > 0 ? static_cast<uint64_t>(static_cast<double>(busy) / tpu) : 0)].fetch_add(1, std::memory_order_relaxed);
+  }
+  m.r_tsc0 = now;
+  m.r_cpu0 = cpu;
+  m.r_wait = 0;
+  m.r_cs = 0;
+}
+
+const char* OpName(uint32_t op) {
+  switch (static_cast<Op>(op)) {
+    case Op::kWait: return "wait";
+    case Op::kWaitAny: return "wait_any";
+    case Op::kWaitAll: return "wait_all";
+    case Op::kSignalAndWait: return "signal_and_wait";
+    case Op::kDelay: return "delay";
+    case Op::kSet: return "set";
+    case Op::kPulse: return "pulse";
+    case Op::kRelease: return "release";
+    case Op::kMutant: return "release_mutant";
+  }
+  return "?";
+}
+
+bool IsWaitOp(uint32_t op) {
+  return op <= static_cast<uint32_t>(Op::kDelay);
+}
+
+}  // namespace
+
+// ---------------------------------------------------------------------------------------------------------------
+
+void Init() {
+  g_diag = REXCVAR_GET(audio_thread_diag) && rex::audio::dump::StatsEnabled();
+  g_boost = REXCVAR_GET(audio_mixer_priority);
+  g_auto = false;
+  g_entry_count = 0;
+  const std::string spec = REXCVAR_GET(audio_mixer_entries);
+  size_t pos = 0;
+  while (pos < spec.size()) {
+    size_t end = spec.find_first_of(",; ", pos);
+    if (end == std::string::npos) {
+      end = spec.size();
+    }
+    const std::string tok = spec.substr(pos, end - pos);
+    pos = end + 1;
+    if (tok.empty()) {
+      continue;
+    }
+    if (tok == "auto") {
+      g_auto = true;
+    } else if (g_entry_count < kEntries) {
+      g_entries[g_entry_count++] = static_cast<uint32_t>(std::strtoul(tok.c_str(), nullptr, 16));
+    }
+  }
+  g_active.store(g_diag || g_boost > 0, std::memory_order_relaxed);
+  if (REXCVAR_GET(audio_thread_diag) && !g_diag) {
+    REXAPU_WARN("audio_thread_diag needs audio_stats; the thread lines stay off");
+  }
+  if (g_diag || g_boost > 0) {
+    REXAPU_INFO("audio lab: thread table {}, mixer priority {} for {}{} listed entries",
+                g_diag ? "on" : "off", g_boost, g_auto ? "the thread that wakes the pump (auto) and " : "", g_entry_count);
+  }
+}
+
+void WaitScope::Begin(Op op, const rex::system::XObject* object) {
+  on_ = true;
+  op_ = op;
+  object_ = object;
+  t0_ = LabTsc();
+  if (tls_in_pump) {
+    g_worker_tid.store(T().tid, std::memory_order_relaxed);
+    if (object) {
+      MarkPump(object);
+    }
+  }
+}
+
+void WaitScope::AddObject(const rex::system::XObject* object) {
+  if (on_ && tls_in_pump && object) {
+    MarkPump(object);
+  }
+}
+
+void WaitScope::End() {
+  const uint64_t t1 = LabTsc();
+  const uint64_t dt = t1 - t0_;
+  Tls& t = T();
+  uint64_t lat = 0;
+  if (object_) {
+    ObjSlot* s = FindObj(object_, false);
+    if (s) {
+      const uint64_t sig = s->last_sig.load(std::memory_order_relaxed);
+      if (sig > t0_ && t1 >= sig) {
+        lat = t1 - sig;
+      }
+    }
+  }
+  AddRow(op_, t, CurrentLr(), object_, dt, lat);
+  if (Mixer* m = t.mixer) {
+    m->r_wait += dt;
+    if (lat) {
+      m->lat_n.fetch_add(1, std::memory_order_relaxed);
+      m->lat_ticks.fetch_add(lat, std::memory_order_relaxed);
+      RaiseMax(m->lat_max, lat);
+    }
+  }
+}
+
+void CsScope::Begin() {
+  if (T().mixer) {
+    t0_ = LabTsc();
+  }
+}
+
+void CsScope::End() {
+  Mixer* m = T().mixer;
+  if (m) {
+    const uint64_t dt = LabTsc() - t0_;
+    m->r_cs += dt;
+    m->cs_n.fetch_add(1, std::memory_order_relaxed);
+  }
+}
+
+void Signal(Op op, const rex::system::XObject* object) {
+  if (!Active() || !object) {
+    return;
+  }
+  Tls& t = T();
+  const uint64_t now = LabTsc();
+  if (ObjSlot* s = FindObj(object, true)) {
+    s->last_sig.store(now, std::memory_order_relaxed);
+    s->sig_tid.store(t.tid, std::memory_order_relaxed);
+  }
+  AddRow(op, t, CurrentLr(), object, 0, 0);
+  if (!tls_in_pump && t.handle != 0 && IsPump(object)) {
+    if (!t.mixer && g_mixer_count.load(std::memory_order_relaxed) < kMixers) {
+      t.mixer = ClaimMixer(t);
+      if (t.mixer && g_auto && g_boost > 0) {
+        BoostSelf(g_boost, "signals what the audio pump waits on");
+      }
+    }
+    if (t.mixer) {
+      MixerRound(*t.mixer, now);
+    }
+  }
+}
