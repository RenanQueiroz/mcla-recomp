+namespace {
+std::mutex g_ask_mutex;
+std::set<uint64_t> g_asked;
+}  // namespace
+
+void OnPriorityRequest(uint32_t handle, int32_t increment) {
+  if (!g_diag) {
+    return;
+  }
+  const uint64_t key = (static_cast<uint64_t>(handle) << 32) ^ static_cast<uint32_t>(increment) ^ (1ull << 62);
+  {
+    std::lock_guard<std::mutex> lock(g_ask_mutex);
+    if (!g_asked.insert(key).second) {
+      return;
+    }
+  }
+  REXAPU_INFO("audio lab game asks: thread h={:08X} KeSetBasePriorityThread increment={}", handle, increment);
+}
+
+void OnAffinityRequest(uint32_t handle, uint32_t mask) {
+  if (!g_diag) {
+    return;
+  }
+  const uint64_t key = (static_cast<uint64_t>(handle) << 32) ^ mask ^ (1ull << 61);
+  {
+    std::lock_guard<std::mutex> lock(g_ask_mutex);
+    if (!g_asked.insert(key).second) {
+      return;
+    }
+  }
+  REXAPU_INFO("audio lab game asks: thread h={:08X} KeSetAffinityThread mask={:X}", handle, mask);
+}
+
+void OnClientRegistered(uint32_t callback, uint32_t argument) {
+  if (!g_diag) {
+    return;
+  }
+  REXAPU_INFO("audio lab pump: the game registered its audio callback {:08X} with argument {:08X}", callback, argument);
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// The reporter's once-a-second lines.
+
+namespace {
+
+struct Snap {
+  uint64_t n = 0, ticks = 0, lat_n = 0, lat_ticks = 0;
+};
+Snap g_prev[kRows];
+
+struct MixPrev {
+  bool seen = false;
+  uint64_t t_us = 0, rounds = 0, cpu_ns = 0, wall = 0, wait = 0, busy = 0, cs = 0, cs_n = 0, lat_n = 0, lat_ticks = 0;
+  uint64_t hist_cpu[kBuckets] = {}, hist_busy[kBuckets] = {};
+#if defined(REX_MXCSR_DIAG_ON)
+  PPCFPSCRRegister::MxcsrDiag diag{};
+#endif
+};
+MixPrev g_mix_prev[kMixers];
+uint64_t g_tick = 0;
+
+#if defined(REX_MXCSR_DIAG_ON)
+struct DiagWant {
+  std::vector<std::pair<void*, PPCFPSCRRegister::MxcsrDiag>>* out;
+  const std::vector<void*>* want;
+};
+void CollectDiag(rex::runtime::ThreadState* ts, void* arg) {
+  auto* w = static_cast<DiagWant*>(arg);
+  for (void* p : *w->want) {
+    if (p == static_cast<void*>(ts)) {
+      w->out->emplace_back(p, ts->context()->fpscr.diag);
+    }
+  }
+}
+#endif
+
+std::string ThreadNameOf(uint32_t xid) {
+  rex::system::KernelState* ks = rex::system::kernel_state();
+  if (ks) {
+    auto thread = ks->GetThreadByID(xid);
+    if (thread && thread->thread()) {
+      return thread->thread()->name();
+    }
+  }
+  return "?";
+}
+
+const char* PercentileLabel(const uint64_t* delta, double q, char* buf, size_t cap) {
+  uint64_t total = 0;
+  for (int i = 0; i < kBuckets; ++i) {
+    total += delta[i];
+  }
+  if (!total) {
+    std::snprintf(buf, cap, "-");
+    return buf;
+  }
+  const double want = q * static_cast<double>(total);
+  uint64_t acc = 0;
+  for (int i = 0; i < kBuckets; ++i) {
+    acc += delta[i];
+    if (static_cast<double>(acc) >= want) {
+      if (i < kBuckets - 1) {
+        std::snprintf(buf, cap, "<%llu", static_cast<unsigned long long>(kEdgesUs[i]));
+      } else {
+        std::snprintf(buf, cap, ">=%llu", static_cast<unsigned long long>(kEdgesUs[kBuckets - 2]));
+      }
+      return buf;
+    }
+  }
+  std::snprintf(buf, cap, "-");
+  return buf;
+}
+
+}  // namespace
+
+void Interval() {
+  if (!g_diag) {
+    return;
+  }
+  ++g_tick;
+  const uint64_t now_us = rex::audio::dump::NowUs();
+  const double t_s = static_cast<double>(now_us) / 1e6;
+  const double tpu = rex::audio::dump::LabTscPerUs();
+  if (tpu <= 0) {
+    return;
+  }
+  // Snapshot of every row (and the interval maxima, which are reset here).
+  static std::vector<Snap> cur(kRows);
+  static std::vector<uint64_t> cur_max(kRows), cur_latmax(kRows);
+  for (size_t i = 0; i < kRows; ++i) {
+    Row& r = g_rows[i];
+    if (!r.ready.load(std::memory_order_acquire)) {
+      cur[i] = Snap{};
+      cur_max[i] = cur_latmax[i] = 0;
+      continue;
+    }
+    cur[i].n = r.n.load(std::memory_order_relaxed);
+    cur[i].ticks = r.ticks.load(std::memory_order_relaxed);
+    cur[i].lat_n = r.lat_n.load(std::memory_order_relaxed);
+    cur[i].lat_ticks = r.lat_ticks.load(std::memory_order_relaxed);
+    cur_max[i] = r.max_ticks.exchange(0, std::memory_order_relaxed);
+    cur_latmax[i] = r.lat_max.exchange(0, std::memory_order_relaxed);
+  }
+  char line[1024];
+
+  // 1. what the audio pump's callback waits on, and who signals it
+  const uint32_t wtid = g_worker_tid.load(std::memory_order_relaxed);
+  for (size_t i = 0; i < kRows && wtid; ++i) {
+    const Row& r = g_rows[i];
+    if (!r.ready.load(std::memory_order_acquire) || r.tid != wtid || !IsWaitOp(r.op)) {
+      continue;
+    }
+    const uint64_t dn = cur[i].n - g_prev[i].n;
+    if (!dn) {
+      continue;
+    }
+    const uint64_t dt = cur[i].ticks - g_prev[i].ticks;
+    const uint64_t dln = cur[i].lat_n - g_prev[i].lat_n;
+    const uint64_t dlt = cur[i].lat_ticks - g_prev[i].lat_ticks;
+    std::string sig;
+    int shown = 0;
+    for (size_t j = 0; j < kRows && shown < 3; ++j) {
+      const Row& s = g_rows[j];
+      if (!s.ready.load(std::memory_order_acquire) || IsWaitOp(s.op) || s.obj != r.obj) {
+        continue;
+      }
+      const uint64_t sn = cur[j].n - g_prev[j].n;
+      if (!sn) {
+        continue;
+      }
+      char one[160];
+      std::snprintf(one, sizeof(one), " [tid=%u h=%08X lr=%08X %s n=%llu]", s.tid, s.handle, s.lr, OpName(s.op),
+                    static_cast<unsigned long long>(sn));
+      sig += one;
+      ++shown;
+    }
+    std::snprintf(line, sizeof(line),
+                  "audio lab pump-wait t=%.1fs tid=%u %s lr=%08X obj=%08X h=%08X guest=%08X type=%u | waits n=%llu avg_us=%.0f "
+                  "max_us=%.0f | woken after a signal n=%llu avg_us=%.0f max_us=%.0f | signaled by:%s",
+                  t_s, r.tid, OpName(r.op), r.lr, static_cast<unsigned>(reinterpret_cast<uintptr_t>(r.obj)), r.obj_handle,
+                  r.obj_guest, r.obj_type, static_cast<unsigned long long>(dn), static_cast<double>(dt) / tpu / static_cast<double>(dn),
+                  static_cast<double>(cur_max[i]) / tpu, static_cast<unsigned long long>(dln),
+                  dln ? static_cast<double>(dlt) / tpu / static_cast<double>(dln) : 0.0, static_cast<double>(cur_latmax[i]) / tpu,
+                  sig.empty() ? " (none seen)" : sig.c_str());
+    REXAPU_INFO("{}", line);
+  }
+
+  // 2. the mixer threads, per round
+  const size_t mixers = std::min(g_mixer_count.load(std::memory_order_relaxed), kMixers);
+#if defined(REX_MXCSR_DIAG_ON)
+  std::vector<void*> want;
+  for (size_t k = 0; k < mixers; ++k) {
+    want.push_back(g_mixers[k].thread_state);
+  }
+  std::vector<std::pair<void*, PPCFPSCRRegister::MxcsrDiag>> diags;
+  DiagWant dw{&diags, &want};
+  rex::runtime::ThreadState::DiagForEach(&CollectDiag, &dw);
+#endif
+  for (size_t k = 0; k < mixers; ++k) {
+    Mixer& m = g_mixers[k];
+    MixPrev& p = g_mix_prev[k];
+    const uint64_t rounds = m.rounds.load(std::memory_order_relaxed);
+    const uint64_t cpu_ns = m.cpu_ns.load(std::memory_order_relaxed);
+    const uint64_t wall = m.wall.load(std::memory_order_relaxed);
+    const uint64_t wait = m.wait.load(std::memory_order_relaxed);
+    const uint64_t busy = m.busy.load(std::memory_order_relaxed);
+    const uint64_t cs = m.cs.load(std::memory_order_relaxed);
+    const uint64_t cs_n = m.cs_n.load(std::memory_order_relaxed);
+    const uint64_t lat_n = m.lat_n.load(std::memory_order_relaxed);
+    const uint64_t lat_ticks = m.lat_ticks.load(std::memory_order_relaxed);
+    const uint64_t lat_max = m.lat_max.exchange(0, std::memory_order_relaxed);
+    uint64_t hc[kBuckets], hb[kBuckets], dhc[kBuckets], dhb[kBuckets];
+    for (int b = 0; b < kBuckets; ++b) {
+      hc[b] = m.hist_cpu[b].load(std::memory_order_relaxed);
+      hb[b] = m.hist_busy[b].load(std::memory_order_relaxed);
+      dhc[b] = hc[b] - p.hist_cpu[b];
+      dhb[b] = hb[b] - p.hist_busy[b];
+    }
+    const double dr = static_cast<double>(rounds - p.rounds);
+    const double secs = static_cast<double>(now_us - p.t_us) / 1e6;
+    double sw = 0, de_s = 0, ue_s = 0, de_v = 0, ue_v = 0, flagged_us = 0, win_s = 0;
+#if defined(REX_MXCSR_DIAG_ON)
+    for (const auto& d : diags) {
+      if (d.first == m.thread_state) {
+        const auto& a = d.second;
+        const auto& b = p.diag;
+        if (dr > 0 && p.seen) {
+          sw = static_cast<double>(a.switches - b.switches) / dr;
+          win_s = static_cast<double>(a.win[0] - b.win[0]) / dr;
+          de_s = static_cast<double>(a.de[0] - b.de[0]) / dr;
+          ue_s = static_cast<double>(a.ue[0] - b.ue[0]) / dr;
+          de_v = static_cast<double>(a.de[1] - b.de[1]) / dr;
+          ue_v = static_cast<double>(a.ue[1] - b.ue[1]) / dr;
+          flagged_us = static_cast<double>(a.flagged - b.flagged) / tpu / dr;
+        }
+        p.diag = a;
+      }
+    }
+#endif
+    if (p.seen && dr > 0) {
+      char p50c[16], p99c[16], p50b[16], p99b[16];
+      std::snprintf(line, sizeof(line),
+                    "audio lab mixer t=%.1fs h=%08X tid=%u entry=%08X name=\"%s\" | rounds/s=%.1f | per round: wall_us=%.0f "
+                    "wait_us=%.0f busy_us=%.0f cpu_us=%.0f not_running_us=%.0f cs_us=%.1f cs_n=%.1f | cpu_us p50%s p99%s "
+                    "busy_us p50%s p99%s | woken after a signal n=%.2f avg_us=%.0f max_us=%.0f | MXCSR per round: writes=%.1f "
+                    "scalar stretches=%.1f DE scalar=%.2f UE scalar=%.2f DE vector=%.2f UE vector=%.2f flagged_us=%.1f",
+                    t_s, m.handle, m.tid, m.entry, ThreadNameOf(m.xid).c_str(), secs > 0 ? dr / secs : 0.0,
+                    static_cast<double>(wall - p.wall) / tpu / dr, static_cast<double>(wait - p.wait) / tpu / dr,
+                    static_cast<double>(busy - p.busy) / tpu / dr, static_cast<double>(cpu_ns - p.cpu_ns) / 1000.0 / dr,
+                    std::max(0.0, static_cast<double>(busy - p.busy) / tpu - static_cast<double>(cpu_ns - p.cpu_ns) / 1000.0) / dr,
+                    static_cast<double>(cs - p.cs) / tpu / dr, static_cast<double>(cs_n - p.cs_n) / dr,
+                    PercentileLabel(dhc, 0.5, p50c, sizeof(p50c)), PercentileLabel(dhc, 0.99, p99c, sizeof(p99c)),
+                    PercentileLabel(dhb, 0.5, p50b, sizeof(p50b)), PercentileLabel(dhb, 0.99, p99b, sizeof(p99b)),
+                    static_cast<double>(lat_n - p.lat_n) / dr,
+                    lat_n > p.lat_n ? static_cast<double>(lat_ticks - p.lat_ticks) / tpu / static_cast<double>(lat_n - p.lat_n) : 0.0,
+                    static_cast<double>(lat_max) / tpu, sw, win_s, de_s, ue_s, de_v, ue_v, flagged_us);
+      REXAPU_INFO("{}", line);
+    }
+    p.seen = true;
+    p.t_us = now_us;
+    p.rounds = rounds;
+    p.cpu_ns = cpu_ns;
+    p.wall = wall;
+    p.wait = wait;
+    p.busy = busy;
+    p.cs = cs;
+    p.cs_n = cs_n;
+    p.lat_n = lat_n;
+    p.lat_ticks = lat_ticks;
+    std::memcpy(p.hist_cpu, hc, sizeof(hc));
+    std::memcpy(p.hist_busy, hb, sizeof(hb));
+  }
+
+  // 3. every 5 s: the table (cumulative since the start): the audio worker's waits, the mixer threads' waits, the signals of
+  //    every object those wait on, and the 25 other waits with the most time.
+  if (g_tick % 5 == 0) {
+    std::set<const void*> objs;
+    std::vector<size_t> pick;
+    std::vector<std::pair<uint64_t, size_t>> others;
+    for (size_t i = 0; i < kRows; ++i) {
+      const Row& r = g_rows[i];
+      if (!r.ready.load(std::memory_order_acquire) || !IsWaitOp(r.op)) {
+        continue;
+      }
+      bool mine = wtid && r.tid == wtid;
+      for (size_t k = 0; k < mixers; ++k) {
+        mine = mine || r.tid == g_mixers[k].tid;
+      }
+      if (mine) {
+        pick.push_back(i);
+        if (r.obj) {
+          objs.insert(r.obj);
+        }
+      } else {
+        others.emplace_back(cur[i].ticks, i);
+      }
+    }
+    std::sort(others.begin(), others.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+    for (size_t i = 0; i < kRows; ++i) {
+      const Row& r = g_rows[i];
+      if (r.ready.load(std::memory_order_acquire) && !IsWaitOp(r.op) && objs.count(r.obj)) {
+        pick.push_back(i);
+      }
+    }
+    for (size_t k = 0; k < others.size() && k < 25; ++k) {
+      pick.push_back(others[k].second);
+    }
+    if (pick.size() > 120) {
+      pick.resize(120);
+    }
+    for (size_t i : pick) {
+      const Row& r = g_rows[i];
+      std::snprintf(line, sizeof(line),
+                    "audio lab site t=%.1fs tid=%u h=%08X %s lr=%08X obj=%08X oh=%08X og=%08X ot=%u | n=%llu us=%.0f max_us=%.0f "
+                    "woken n=%llu woken_us=%.0f",
+                    t_s, r.tid, r.handle, OpName(r.op), r.lr, static_cast<unsigned>(reinterpret_cast<uintptr_t>(r.obj)),
+                    r.obj_handle, r.obj_guest, r.obj_type, static_cast<unsigned long long>(cur[i].n),
+                    static_cast<double>(cur[i].ticks) / tpu, static_cast<double>(r.max_all.load(std::memory_order_relaxed)) / tpu,
+                    static_cast<unsigned long long>(cur[i].lat_n), static_cast<double>(cur[i].lat_ticks) / tpu);
+      REXAPU_INFO("{}", line);
+    }
+    if (g_dropped.load(std::memory_order_relaxed)) {
+      REXAPU_INFO("audio lab site table full: {} events not counted", g_dropped.load(std::memory_order_relaxed));
+    }
+  }
+  for (size_t i = 0; i < kRows; ++i) {
+    g_prev[i] = cur[i];
+  }
+}
+
+}  // namespace rex::audio::lab
