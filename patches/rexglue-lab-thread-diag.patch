+/**
+ * @file        audio/audio_lab.h
+ * @brief       LAB ONLY: which guest thread the audio pump waits for, what it does, and a host priority for it (issue #21)
+ *
+ * Added by the mcla-recomp fork (patches/rexglue-lab-thread-diag.patch), never released. The audio pump's
+ * round (the client callback on the "Audio Worker") is almost all waiting; these hooks find out on what, who
+ * signals it, what that thread creates, asks for and does, and let a host priority be given to it.
+ *
+ * Everything is off unless a cvar asks (audio_thread_diag with audio_stats, audio_mixer_priority,
+ * audio_mixer_entries); the hooks on the kernel's wait and signal paths then cost one relaxed load.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace rex::system {
+class XObject;
+}
+
+namespace rex::audio::lab {
+
+enum class Op : uint32_t {
+  kWait = 0,           // XObject::Wait (KeWaitForSingleObject, NtWaitForSingleObjectEx, a contended critical section)
+  kWaitAny = 1,        // XObject::WaitMultiple, wait for any
+  kWaitAll = 2,        // XObject::WaitMultiple, wait for all
+  kSignalAndWait = 3,  // XObject::SignalAndWait (the wait half)
+  kDelay = 4,          // XThread::Delay (KeDelayExecutionThread, Sleep)
+  kSet = 5,            // XEvent::Set
+  kPulse = 6,          // XEvent::Pulse
+  kRelease = 7,        // XSemaphore::ReleaseSemaphore
+  kMutant = 8,         // XMutant::ReleaseMutant
+};
+
+/// True when any hook has work to do (audio_thread_diag with audio_stats, or a mixer priority option).
+extern std::atomic<bool> g_active;
+inline bool Active() {
+  return g_active.load(std::memory_order_relaxed);
+}
+
+/// True while the calling thread is inside the audio client's callback (the Audio Worker, around Execute).
+extern thread_local bool tls_in_pump;
+
+/// Reads the cvars (AudioSystem::Setup -> dump::Init). Logs one line with what is on.
+void Init();
+/// The reporter thread, once a second: the pump-wait, mixer and (every 5 s) site lines.
+void Interval();
+
+/// A wait of the calling thread: time (time-stamp counter), latency from the object's last signal, call site.
+class WaitScope {
+ public:
+  WaitScope(Op op, const rex::system::XObject* object) {
+    if (Active()) {
+      Begin(op, object);
+    }
+  }
+  ~WaitScope() {
+    if (on_) {
+      End();
+    }
+  }
+  /// Wait for several objects: marks each as a pump object if the pump waits (the one that woke the wait goes to SetObject).
+  void AddObject(const rex::system::XObject* object);
+  void SetObject(const rex::system::XObject* object) {
+    object_ = object;
+  }
+  WaitScope(const WaitScope&) = delete;
+  WaitScope& operator=(const WaitScope&) = delete;
+
+ private:
+  void Begin(Op op, const rex::system::XObject* object);
+  void End();
+  bool on_ = false;
+  Op op_ = Op::kWait;
+  const rex::system::XObject* object_ = nullptr;
+  uint64_t t0_ = 0;
+};
+
+/// A critical-section enter of the calling thread (spinning and waiting), counted for the mixer threads only.
+class CsScope {
+ public:
+  CsScope() {
+    if (Active()) {
+      Begin();
+    }
+  }
+  ~CsScope() {
+    if (t0_) {
+      End();
+    }
+  }
+  CsScope(const CsScope&) = delete;
+  CsScope& operator=(const CsScope&) = delete;
+
+ private:
+  void Begin();
+  void End();
+  uint64_t t0_ = 0;
+};
+
+/// A signal (XEvent::Set / Pulse, XSemaphore::ReleaseSemaphore, XMutant::ReleaseMutant) by the calling thread.
+void Signal(Op op, const rex::system::XObject* object);
+
+/// XThread::Create: the thread's guest creation parameters (a log line).
+void OnThreadCreated(uint32_t handle, uint32_t host_tid, uint32_t entry, uint32_t xapi_startup, uint32_t context,
+                     uint32_t creation_flags, uint32_t stack_size, bool guest);
+/// XThread::Execute, on the new thread itself: a thread whose entry is in audio_mixer_entries gets the priority.
+void OnThreadStart(uint32_t entry);
+/// KeSetBasePriorityThread / KeSetAffinityThread as the game calls them (logged when a thread asks for a new value).
+void OnPriorityRequest(uint32_t handle, int32_t increment);
+void OnAffinityRequest(uint32_t handle, uint32_t mask);
+/// AudioSystem::RegisterClient: the game's callback and argument.
+void OnClientRegistered(uint32_t callback, uint32_t argument);
+
+}  // namespace rex::audio::lab
