+void D3D12CommandProcessor::LabAfterRenderTargetUpdate() {
+  Lab& lab = *lab_;
+  if (!lab.logging || !render_target_cache_) {
+    return;
+  }
+  uint32_t keys[1 + xenos::kMaxColorRenderTargets];
+  render_target_cache_->LabGetBoundKeys(keys);
+  std::array<uint32_t, 1 + xenos::kMaxColorRenderTargets> set;
+  for (size_t i = 0; i < set.size(); ++i) {
+    set[i] = keys[i];
+  }
+  int32_t id = -1;
+  for (size_t i = 0; i < lab.sets.size(); ++i) {
+    if (lab.sets[i] == set) {
+      id = int32_t(i);
+      break;
+    }
+  }
+  if (id < 0) {
+    id = int32_t(lab.sets.size());
+    lab.sets.push_back(set);
+  }
+  lab.current_set = id;
+  uint32_t depth_transfers = 0;
+  uint32_t color_transfers = 0;
+  render_target_cache_->GetLastUpdateTransferCounts(depth_transfers, color_transfers);
+  if (depth_transfers + color_transfers) {
+    lab.sub_transfers += depth_transfers + color_transfers;
+    lab.last_transfer_draw = lab.frame_draws;
+  }
+  if (lab.events.size() < Lab::kMaxEvents) {
+    Lab::Event event;
+    event.type = Lab::kEvDraw;
+    event.aux = uint16_t(id);
+    event.a = lab.frame_draws;
+    event.b = (std::min(depth_transfers, uint32_t(0xFFFF)) << 16) | std::min(color_transfers, uint32_t(0xFFFF));
+    lab.events.push_back(event);
+  }
+}
