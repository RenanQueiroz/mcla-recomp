+void D3D12CommandProcessor::OnGuestMarker(uint32_t kind, uint32_t value) {
+  CommandProcessor::OnGuestMarker(kind, value);
+  Lab& lab = *lab_;
+  if (!lab.frame_started) {
+    LabFrameBegin();
+  }
+  if (kind == uint32_t(Lab::kMarkerPhase)) {
+    lab.phase = value;
+    lab.phase_draws = 0;
+    const uint32_t mask = REXCVAR_GET(d3d12_debug_end_submission_phase_mask);
+    if (mask && (mask & value)) {
+      lab.phase_pending = true;
+    }
+  }
+  if (lab.logging && lab.events.size() < Lab::kMaxEvents) {
+    Lab::Event event;
+    event.type = Lab::kEvMarker;
+    event.aux = uint16_t(kind);
+    event.a = value;
+    event.b = lab.frame_draws;
+    lab.events.push_back(event);
+  }
+}
