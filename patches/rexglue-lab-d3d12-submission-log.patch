+// Lab only (fork issue #28 research, branch diag/amd-list-boundary): see the header.
+void D3D12RenderTargetCache::LabGetBoundKeys(uint32_t* keys_out) const {
+  for (uint32_t i = 0; i < 1 + xenos::kMaxColorRenderTargets; ++i) {
+    keys_out[i] = 0;
+  }
+  if (GetPath() != Path::kHostRenderTargets) {
+    return;
+  }
+  RenderTarget* const* render_targets = last_update_accumulated_render_targets();
+  for (uint32_t i = 0; i < 1 + xenos::kMaxColorRenderTargets; ++i) {
+    if (render_targets[i]) {
+      keys_out[i] = render_targets[i]->key().key;
+    }
+  }
+}
+
+std::string D3D12RenderTargetCache::LabKeyName(uint32_t key) const {
+  RenderTargetKey render_target_key;
+  render_target_key.key = key;
+  char head[24];
+  std::snprintf(head, sizeof(head), "%08X ", static_cast<unsigned>(key));
+  return std::string(head) + render_target_key.GetDebugName();
+}
+
+std::string D3D12RenderTargetCache::LabDescribeBound() const {
+  if (GetPath() != Path::kHostRenderTargets) {
+    return "no host render targets (the pixel shader interlock path)";
+  }
+  std::string out;
+  RenderTarget* const* render_targets = last_update_accumulated_render_targets();
+  for (uint32_t i = 0; i < 1 + xenos::kMaxColorRenderTargets; ++i) {
+    const RenderTarget* render_target = render_targets[i];
+    if (!render_target) {
+      continue;
+    }
+    const D3D12RenderTarget* d3d12_rt = static_cast<const D3D12RenderTarget*>(render_target);
+    D3D12_RESOURCE_DESC desc = d3d12_rt->resource()->GetDesc();
+    char head[16];
+    if (i == 0) {
+      std::snprintf(head, sizeof(head), "ds");
+    } else {
+      std::snprintf(head, sizeof(head), "c%u", static_cast<unsigned>(i - 1));
+    }
+    char tail[96];
+    std::snprintf(tail, sizeof(tail), " %llux%u s%u state 0x%X",
+                  static_cast<unsigned long long>(desc.Width), static_cast<unsigned>(desc.Height),
+                  static_cast<unsigned>(desc.SampleDesc.Count),
+                  static_cast<unsigned>(d3d12_rt->resource_state()));
+    if (!out.empty()) {
+      out += " | ";
+    }
+    out += head;
+    out += "=";
+    out += LabKeyName(render_target->key().key);
+    out += tail;
+  }
+  if (out.empty()) {
+    out = "nothing bound";
+  }
+  return out;
 }
 
