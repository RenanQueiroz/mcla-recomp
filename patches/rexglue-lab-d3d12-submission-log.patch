+// ---- Lab only (fork issue #28 research): the submission log and the forced ends of submissions ----------------------------
+void D3D12CommandProcessor::LabFrameBegin() {
+  Lab& lab = *lab_;
+  lab.frame_started = true;
+  lab.logging = REXCVAR_GET(d3d12_lab_log_on) != 0;
+  if (lab.logging && !lab.file && !lab.file_tried) {
+    lab.file_tried = true;
+    const std::string path = REXCVAR_GET(d3d12_lab_log);
+    if (!path.empty()) {
+      lab.file = std::fopen(path.c_str(), "wb");
+      if (lab.file) {
+        std::fprintf(lab.file,
+                     "# Lab submission log (fork issue #28 research). F = a frame (swap = its swap number), SET = a set of render "
+                     "target keys, MK = the guest's markers (P = a render phase) with the frame's draws so far, B = an end of a "
+                     "submission (reason, draws in the submission and in the frame, phase, render targets, counts), then the "
+                     "events before and after it: dN(sS,tD+C) = draw N with render target set S and D+C ownership transfers, "
+                     "CLR = a clear drawn as a rectangle, RES = a resolve, |END:x| = an end of a submission.\n");
+        REXGPU_INFO("Lab: submission log opened: {}", path);
+      } else {
+        REXGPU_INFO("Lab: could not open the submission log: {}", path);
+      }
+    }
+  }
+  if (lab.logging && !lab.file) {
+    lab.logging = false;
+  }
+  lab.events.clear();
+  lab.boundaries.clear();
+  lab.frame_draws = 0;
+  lab.frame_ops = 0;
+  lab.lists = 0;
+  lab.phase = 0;
+  lab.phase_draws = 0;
+  lab.forced_deferred = 0;
+  lab.forced_coincided = 0;
+  lab.draw_target_done = false;
+  lab.phase_target_done = false;
+  lab.phase_pending = false;
+  lab.current_set = -1;
+  lab.sub_transfers = 0;
+  lab.sub_clears = 0;
+  lab.sub_resolves = 0;
+  lab.last_transfer_draw = UINT32_MAX;
+  lab.last_clear_draw = UINT32_MAX;
+  lab.last_resolve_draw = UINT32_MAX;
+  // This frame's place for the extra end; the sweep moves it from frame to frame.
+  const int32_t at_draw = REXCVAR_GET(d3d12_debug_end_submission_at_draw);
+  const int32_t phase_draw = REXCVAR_GET(d3d12_debug_end_submission_phase_draw);
+  lab.target_phase = REXCVAR_GET(d3d12_debug_end_submission_at_phase);
+  lab.target_draw = at_draw;
+  lab.target_phase_draw = phase_draw;
+  const int32_t step = REXCVAR_GET(d3d12_debug_end_submission_sweep_step);
+  if (step > 0) {
+    if (!lab.sweep_active) {
+      lab.sweep_active = true;
+      lab.sweep_base_swap = counter_;
+    }
+    const int64_t per_value = std::max<int32_t>(1, REXCVAR_GET(d3d12_debug_end_submission_sweep_frames));
+    const int64_t ordinal = int64_t(counter_) - int64_t(lab.sweep_base_swap);
+    const int64_t first = lab.target_phase ? phase_draw : at_draw;
+    int64_t value = first + int64_t(step) * (ordinal / per_value);
+    int64_t last = REXCVAR_GET(d3d12_debug_end_submission_sweep_to);
+    if (last <= 0) {
+      last = int64_t(lab.last_frame_draws);
+    }
+    if (last > first && value > last) {
+      value = first + (value - first) % (last - first + 1);
+    }
+    if (lab.target_phase) {
+      lab.target_phase_draw = int32_t(value);
+    } else {
+      lab.target_draw = int32_t(value);
+    }
+  } else {
+    lab.sweep_active = false;
+  }
+}
