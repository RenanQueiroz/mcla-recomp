+void D3D12CommandProcessor::LabBeforeOp(bool is_copy) {
+  Lab& lab = *lab_;
+  if (!lab.frame_started) {
+    LabFrameBegin();
+  }
+  ++lab.frame_ops;
+  if (is_copy) {
+    ++lab.sub_resolves;
+    lab.last_resolve_draw = lab.frame_draws;
+    if (lab.logging && lab.events.size() < Lab::kMaxEvents) {
+      Lab::Event event;
+      event.type = Lab::kEvResolve;
+      event.a = lab.frame_draws;
+      event.b = lab.frame_ops;
+      lab.events.push_back(event);
+    }
+  }
+  const bool want_draw = lab.target_phase == 0 && lab.target_draw > 0 && !lab.draw_target_done &&
+                         lab.frame_draws >= uint32_t(lab.target_draw);
+  const bool want_phase =
+      lab.phase_pending ||
+      (lab.target_phase != 0 && !lab.phase_target_done && lab.phase == lab.target_phase &&
+       lab.phase_draws >= uint32_t(std::max<int32_t>(0, lab.target_phase_draw)));
+  if (!want_draw && !want_phase) {
+    return;
+  }
+  if (!submission_open_) {
+    // Nothing to end: a list begins with the next op anyway.
+    if (want_draw) {
+      lab.draw_target_done = true;
+    }
+    if (want_phase) {
+      lab.phase_pending = false;
+      lab.phase_target_done = true;
+    }
+    ++lab.forced_coincided;
+    return;
+  }
+  if (active_occlusion_query_.valid || !CanEndSubmissionImmediately()) {
+    // A host query cannot span submissions, and pending pipelines would be waited for: try again at the next op.
+    ++lab.forced_deferred;
+    return;
+  }
+  if (want_draw) {
+    lab.draw_target_done = true;
+  }
+  if (want_phase) {
+    lab.phase_pending = false;
+    lab.phase_target_done = true;
+  }
+  lab.reason = want_phase ? Lab::kReasonForcedPhase : Lab::kReasonForcedDraw;
+  EndSubmission(false);
+}
+
+void D3D12CommandProcessor::LabOnEndSubmission(bool is_swap, uint32_t reason) {
+  Lab& lab = *lab_;
+  if (!lab.frame_started) {
+    LabFrameBegin();
+  }
+  if (is_swap) {
+    reason = Lab::kReasonSwap;
+  } else if (!reason) {
+    reason = Lab::kReasonOther;
+  }
+  ++lab.lists;
+  if (lab.logging) {
+    Lab::Boundary b;
+    b.event_index = uint32_t(lab.events.size());
+    b.reason = reason;
+    b.submission = submission_current_;
+    b.submission_draws = submission_draws_;
+    b.frame_draw = lab.frame_draws;
+    b.frame_op = lab.frame_ops;
+    b.phase = lab.phase;
+    b.phase_draw = lab.phase_draws;
+    b.set_id = lab.current_set;
+    b.inflight = int32_t(int64_t(submission_current_) - 1 - int64_t(submission_completed_));
+    b.backlog = int32_t(int64_t(submission_thread_queued_) -
+                        int64_t(submission_thread_submitted_.load(std::memory_order_acquire)));
+    b.query_open = active_occlusion_query_.valid;
+    b.transfers = lab.sub_transfers;
+    b.clears = lab.sub_clears;
+    b.resolves = lab.sub_resolves;
+    if (lab.last_transfer_draw != UINT32_MAX) {
+      b.since_transfer = lab.frame_draws - lab.last_transfer_draw;
+    }
+    if (lab.last_clear_draw != UINT32_MAX) {
+      b.since_clear = lab.frame_draws - lab.last_clear_draw;
+    }
+    if (lab.last_resolve_draw != UINT32_MAX) {
+      b.since_resolve = lab.frame_draws - lab.last_resolve_draw;
+    }
+    b.t_ms = rex::chrono::Clock::QueryHostUptimeMillis();
+    if (render_target_cache_) {
+      b.rt = render_target_cache_->LabDescribeBound();
+    }
+    Lab::Event event;
+    event.type = Lab::kEvBoundary;
+    event.aux = uint16_t(reason);
+    event.a = uint32_t(lab.boundaries.size());
+    lab.events.push_back(event);
+    lab.boundaries.push_back(std::move(b));
+  }
+  lab.sub_transfers = 0;
+  lab.sub_clears = 0;
+  lab.sub_resolves = 0;
+}
+
+void D3D12CommandProcessor::LabFrameEnd() {
+  Lab& lab = *lab_;
+  if (!lab.frame_started) {
+    return;
+  }
+  if (lab.logging && lab.file) {
+    std::string out;
+    out.reserve(8192);
+    const size_t context = size_t(std::max<int32_t>(0, REXCVAR_GET(d3d12_lab_log_context)));
+    LabAppendf(out,
+               "F swap=%u guest_frame=%u t_ms=%llu draws=%u ops=%u lists=%u forced_deferred=%u forced_coincided=%u "
+               "target_draw=%d target_phase=0x%X target_phase_draw=%d\n",
+               unsigned(counter_ + 1), unsigned(guest_marker_frame_),
+               static_cast<unsigned long long>(rex::chrono::Clock::QueryHostUptimeMillis()), unsigned(lab.frame_draws),
+               unsigned(lab.frame_ops), unsigned(lab.lists), unsigned(lab.forced_deferred), unsigned(lab.forced_coincided),
+               int(lab.target_draw), unsigned(lab.target_phase), int(lab.target_phase_draw));
+    for (; lab.sets_printed < lab.sets.size(); ++lab.sets_printed) {
+      LabAppendf(out, "SET %u:", unsigned(lab.sets_printed));
+      for (size_t i = 0; i < lab.sets[lab.sets_printed].size(); ++i) {
+        const uint32_t key = lab.sets[lab.sets_printed][i];
+        if (!key) {
+          continue;
+        }
+        if (i == 0) {
+          out += " ds=";
+        } else {
+          LabAppendf(out, " c%u=", unsigned(i - 1));
+        }
+        out += render_target_cache_ ? render_target_cache_->LabKeyName(key) : std::string("?");
+      }
+      out += "\n";
+    }
+    out += "MK:";
+    for (const Lab::Event& event : lab.events) {
+      if (event.type == Lab::kEvMarker) {
+        Lab::AppendEvent(out, event);
+      }
+    }
+    out += "\n";
+    for (size_t bi = 0; bi < lab.boundaries.size(); ++bi) {
+      const Lab::Boundary& b = lab.boundaries[bi];
+      LabAppendf(out,
+                 "B %u reason=%s sub=%llu sub_draws=%u frame_draw=%u op=%u phase=0x%X phase_draw=%u set=%d inflight=%d "
+                 "backlog=%d query=%d tx=%u clr=%u res=%u since_tx=%d since_clr=%d since_res=%d t_ms=%llu\n",
+                 unsigned(bi), Lab::ReasonName(b.reason), static_cast<unsigned long long>(b.submission),
+                 unsigned(b.submission_draws), unsigned(b.frame_draw), unsigned(b.frame_op), unsigned(b.phase),
+                 unsigned(b.phase_draw), int(b.set_id), int(b.inflight), int(b.backlog), b.query_open ? 1 : 0,
+                 unsigned(b.transfers), unsigned(b.clears), unsigned(b.resolves), int(b.since_transfer),
+                 int(b.since_clear), int(b.since_resolve), static_cast<unsigned long long>(b.t_ms));
+      out += "  rt: " + b.rt + "\n";
+      const size_t at = b.event_index;
+      out += "  before:";
+      for (size_t i = at > context ? at - context : 0; i < at && i < lab.events.size(); ++i) {
+        Lab::AppendEvent(out, lab.events[i]);
+      }
+      out += "\n  after:";
+      for (size_t i = at + 1; i < lab.events.size() && i <= at + context; ++i) {
+        Lab::AppendEvent(out, lab.events[i]);
+      }
+      out += "\n";
+    }
+    std::fwrite(out.data(), 1, out.size(), lab.file);
+    std::fflush(lab.file);
+    ++lab.frames_written;
+  }
+  lab.last_frame_draws = lab.frame_draws;
+  lab.frame_started = false;
+}
 
