+struct D3D12CommandProcessor::Lab {
+  static constexpr uint32_t kReasonSwap = 1;
+  static constexpr uint32_t kReasonPrimaryEnd = 2;
+  static constexpr uint32_t kReasonSplit = 3;
+  static constexpr uint32_t kReasonWait = 4;
+  static constexpr uint32_t kReasonForcedDraw = 5;
+  static constexpr uint32_t kReasonForcedPhase = 6;
+  static constexpr uint32_t kReasonOther = 7;
+  static const char* ReasonName(uint32_t reason) {
+    static const char* const kNames[] = {"none", "swap", "primary_end", "split", "wait", "forced_draw", "forced_phase", "other"};
+    return reason < 8 ? kNames[reason] : "?";
+  }
+
+  static constexpr size_t kMaxEvents = 65536;
+  static constexpr uint16_t kEvDraw = 1;
+  static constexpr uint16_t kEvClear = 2;
+  static constexpr uint16_t kEvResolve = 3;
+  static constexpr uint16_t kEvMarker = 4;
+  static constexpr uint16_t kEvBoundary = 5;
+  static constexpr uint16_t kMarkerPhase = 0x100;
+
+  // A guest event of the frame: a draw (aux = id of the render target set, a = the frame's draw number, b = transfers of the
+  // update: depth << 16 | colour), a clear drawn as a rectangle, a resolve, a guest marker (aux = kind, a = value, b = the
+  // frame's draws so far), or an end of a submission (aux = reason, a = index in boundaries).
+  struct Event {
+    uint16_t type = 0;
+    uint16_t aux = 0;
+    uint32_t a = 0;
+    uint32_t b = 0;
+  };
+
+  struct Boundary {
+    uint32_t event_index = 0;
+    uint32_t reason = 0;
+    uint64_t submission = 0;
+    uint32_t submission_draws = 0;
+    uint32_t frame_draw = 0;
+    uint32_t frame_op = 0;
+    uint32_t phase = 0;
+    uint32_t phase_draw = 0;
+    int32_t set_id = -1;
+    int32_t inflight = 0;
+    int32_t backlog = 0;
+    bool query_open = false;
+    uint32_t transfers = 0;
+    uint32_t clears = 0;
+    uint32_t resolves = 0;
+    uint32_t since_transfer = UINT32_MAX;
+    uint32_t since_clear = UINT32_MAX;
+    uint32_t since_resolve = UINT32_MAX;
+    uint64_t t_ms = 0;
+    std::string rt;
+  };
+
+  static void AppendEvent(std::string& out, const Event& e) {
+    switch (e.type) {
+      case kEvDraw:
+        LabAppendf(out, " d%u(s%u,t%u+%u)", e.a, unsigned(e.aux), e.b >> 16, e.b & 0xFFFFu);
+        break;
+      case kEvClear:
+        LabAppendf(out, " CLR@%u", e.a);
+        break;
+      case kEvResolve:
+        LabAppendf(out, " RES@%u", e.a);
+        break;
+      case kEvMarker:
+        if (e.aux == kMarkerPhase) {
+          LabAppendf(out, " P0x%X@%u", e.a, e.b);
+        } else {
+          LabAppendf(out, " K%u=0x%X@%u", unsigned(e.aux), e.a, e.b);
+        }
+        break;
+      case kEvBoundary:
+        LabAppendf(out, " |END:%s|", ReasonName(e.aux));
+        break;
+      default:
+        break;
+    }
+  }
+
+  std::FILE* file = nullptr;
+  bool file_tried = false;
+  bool frame_started = false;
+  bool logging = false;
+  // Left by whoever calls EndSubmission(false), read and cleared by EndSubmission.
+  uint32_t reason = 0;
+
+  // The frame so far.
+  uint32_t frame_draws = 0;
+  uint32_t frame_ops = 0;
+  uint32_t last_frame_draws = 0;
+  uint32_t lists = 0;
+  uint32_t phase = 0;
+  uint32_t phase_draws = 0;
+  uint32_t forced_deferred = 0;
+  uint32_t forced_coincided = 0;
+  int32_t target_draw = 0;
+  uint32_t target_phase = 0;
+  int32_t target_phase_draw = 0;
+  bool draw_target_done = false;
+  bool phase_target_done = false;
+  bool phase_pending = false;
+  int32_t current_set = -1;
+  uint32_t sub_transfers = 0;
+  uint32_t sub_clears = 0;
+  uint32_t sub_resolves = 0;
+  uint32_t last_transfer_draw = UINT32_MAX;
+  uint32_t last_clear_draw = UINT32_MAX;
+  uint32_t last_resolve_draw = UINT32_MAX;
+  std::vector<Event> events;
+  std::vector<Boundary> boundaries;
+
+  // The whole run.
+  bool sweep_active = false;
