+void D3D12CommandProcessor::LabClearRectangleDone() {
+  Lab& lab = *lab_;
+  ++lab.sub_clears;
+  lab.last_clear_draw = lab.frame_draws;
+  if (lab.logging && lab.events.size() < Lab::kMaxEvents) {
+    Lab::Event event;
+    event.type = Lab::kEvClear;
+    event.a = lab.frame_draws;
+    lab.events.push_back(event);
+  }
+}
