+void WindowSDL::HideAutoHiddenCursorNow() {
+  // SDL only blanks the cursor over the client area (WM_SETCURSOR with
+  // HTCLIENT on Windows), so the title bar, the borders and other windows keep
+  // theirs.
+  if (GetCursorVisibility() != CursorVisibility::kAutoHidden || !IsAutoHiddenCursorShown() ||
+      !HasFocus() || IsCursorAutoHideVetoed()) {
+    return;
+  }
+  if (cursor_hide_timer_) {
+    SDL_RemoveTimer(cursor_hide_timer_);
+    cursor_hide_timer_ = 0;
+  }
+  SetAutoHiddenCursorShown(false);
