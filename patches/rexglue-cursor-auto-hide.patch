+void Window::RequestAutoHiddenCursorHide() {
+  // Called on every poll that finds a pad in use, so it does nothing while the
+  // cursor is hidden and keeps at most one request in flight.
+  if (!IsAutoHiddenCursorShown() ||
+      auto_hidden_cursor_hide_requested_.exchange(true, std::memory_order_acq_rel)) {
+    return;
+  }
+  std::weak_ptr<bool> alive = alive_token_;
+  bool queued = app_context().CallInUIThreadDeferred([this, alive] {
+    if (alive.expired()) {
+      return;
+    }
+    auto_hidden_cursor_hide_requested_.store(false, std::memory_order_release);
+    HideAutoHiddenCursorNow();
+  });
+  if (!queued) {
+    auto_hidden_cursor_hide_requested_.store(false, std::memory_order_release);
+  }
+}
