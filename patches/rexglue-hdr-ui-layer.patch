+  // the alpha blend ONE / INV_SRC_ALPHA, so it collects the UI premultiplied,
+  // with coverage in alpha. When the guest resolves it, the UI and the
+  // underlay are copied to the screen-space textures, and the target is put
+  // back to what the guest drew (UI + underlay x (1 - alpha)) for the resolve.
+  // A blend outside SrcAlpha or One / InvSrcAlpha ends the separation for the
+  // frame (the target is put back at once): the refresher then tells the UI
+  // from the scene by comparing the front buffer with the underlay.
+  enum HdrTexture : uint32_t {
+    kHdrTextureUnderlay,    // screen space
+    kHdrTextureUnderlayRt,  // render target space, for putting the target back
+    kHdrTextureUiLayer,     // screen space
