+ID3D12Resource* D3D12CommandProcessor::HdrGetTexture(HdrTexture texture) {
+  Microsoft::WRL::ComPtr<ID3D12Resource>& resource = hdr_textures_[texture];
+  if (resource && (resource->GetDesc().Width != hdr_output_width_ ||
+                   resource->GetDesc().Height != hdr_output_height_)) {
+    resource->AddRef();
+    resources_for_deletion_.emplace_back(GetCurrentSubmission(), resource.Get());
+    resource.Reset();
+  }
+  if (!resource && hdr_output_width_ && hdr_output_height_) {
+    ID3D12Device* device = GetD3D12Provider().GetDevice();
+    D3D12_RESOURCE_DESC desc = {};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = hdr_output_width_;
+    desc.Height = hdr_output_height_;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    desc.SampleDesc.Count = 1;
+    bool is_ui_layer = texture == kHdrTextureUiLayer;
+    desc.Flags = is_ui_layer ? D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET : D3D12_RESOURCE_FLAG_NONE;
+    if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+                                               GetD3D12Provider().GetHeapFlagCreateNotZeroed(),
+                                               &desc, kHdrTextureState, nullptr,
+                                               IID_PPV_ARGS(&resource)))) {
+      return nullptr;
+    }
+    if (is_ui_layer) {
+      if (!hdr_ui_layer_rtv_heap_) {
+        D3D12_DESCRIPTOR_HEAP_DESC heap_desc = {D3D12_DESCRIPTOR_HEAP_TYPE_RTV, 1,
+                                                D3D12_DESCRIPTOR_HEAP_FLAG_NONE, 0};
+        device->CreateDescriptorHeap(&heap_desc, IID_PPV_ARGS(&hdr_ui_layer_rtv_heap_));
+      }
+      if (hdr_ui_layer_rtv_heap_) {
+        device->CreateRenderTargetView(resource.Get(), nullptr,
+                                       hdr_ui_layer_rtv_heap_->GetCPUDescriptorHandleForHeapStart());
+      }
+    }
+  }
+  return resource.Get();
+}
+
+void D3D12CommandProcessor::HdrWriteTextureSRV(HdrTexture texture,
+                                               D3D12_CPU_DESCRIPTOR_HANDLE handle) {
+  D3D12_SHADER_RESOURCE_VIEW_DESC srv_desc = {};
+  srv_desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+  srv_desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  srv_desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  srv_desc.Texture2D.MipLevels = 1;
+  GetD3D12Provider().GetDevice()->CreateShaderResourceView(hdr_textures_[texture].Get(),
+                                                           &srv_desc, handle);
+}
