+VulkanRenderTargetCache::VulkanRenderTarget* VulkanRenderTargetCache::HdrColorTarget(
+    uint32_t key, VkRect2D& rect) {
+  auto* rt = static_cast<VulkanRenderTarget*>(HdrFindColorTarget(key));
+  if (!rt) {
+    return nullptr;
+  }
+  uint32_t width = rt->key().GetWidth() * draw_resolution_scale_x();
+  uint32_t height = GetRenderTargetHeight(rt->key().pitch_tiles_at_32bpp, rt->key().msaa_samples) *
+                    draw_resolution_scale_y();
+  if (uint32_t(rect.offset.x) >= width || uint32_t(rect.offset.y) >= height) {
+    return nullptr;
+  }
+  rect.extent.width = std::min(rect.extent.width, width - uint32_t(rect.offset.x));
+  rect.extent.height = std::min(rect.extent.height, height - uint32_t(rect.offset.y));
+  return rect.extent.width && rect.extent.height ? rt : nullptr;
+}
+
+bool VulkanRenderTargetCache::HdrCopyColorTarget(uint32_t key, VkImageView dest,
+                                                 VkRect2D source, int32_t dest_x,
+                                                 int32_t dest_y) {
+  VulkanRenderTarget* rt = HdrColorTarget(key, source);
+  if (!rt) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (hdr_copy_pipeline_layout_ == VK_NULL_HANDLE) {
+    VkDescriptorSetLayout set_layouts[] = {
+        descriptor_set_layout_sampled_image_,
+        command_processor_.GetSingleTransientDescriptorLayout(
+            VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageImageCompute)};
+    VkPushConstantRange push_constant_range = {VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                               sizeof(uint32_t) * 4};
+    VkPipelineLayoutCreateInfo layout_create_info = {};
+    layout_create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    layout_create_info.setLayoutCount = 2;
+    layout_create_info.pSetLayouts = set_layouts;
+    layout_create_info.pushConstantRangeCount = 1;
+    layout_create_info.pPushConstantRanges = &push_constant_range;
+    if (dfn.vkCreatePipelineLayout(device, &layout_create_info, nullptr,
+                                   &hdr_copy_pipeline_layout_) != VK_SUCCESS) {
+      return false;
+    }
+  }
+  bool msaa = rt->key().msaa_samples != xenos::MsaaSamples::k1X;
+  VkPipeline& pipeline = hdr_copy_pipelines_[msaa];
+  if (pipeline == VK_NULL_HANDLE) {
+    pipeline = msaa ? ui::vulkan::util::CreateComputePipeline(
+                          vulkan_device, hdr_copy_pipeline_layout_, shaders::hdr_rt_copy_4xmsaa_cs,
+                          sizeof(shaders::hdr_rt_copy_4xmsaa_cs))
+                    : ui::vulkan::util::CreateComputePipeline(
+                          vulkan_device, hdr_copy_pipeline_layout_, shaders::hdr_rt_copy_cs,
+                          sizeof(shaders::hdr_rt_copy_cs));
+    if (pipeline == VK_NULL_HANDLE) {
+      return false;
+    }
+  }
+  VkDescriptorSet dest_set = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageImageCompute);
+  if (dest_set == VK_NULL_HANDLE) {
+    return false;
+  }
+  VkDescriptorImageInfo dest_info = {VK_NULL_HANDLE, dest, VK_IMAGE_LAYOUT_GENERAL};
+  VkWriteDescriptorSet write = {};
+  write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  write.dstSet = dest_set;
+  write.descriptorCount = 1;
+  write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+  write.pImageInfo = &dest_info;
+  dfn.vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+  // The target as a sampled image (its transfer source view, R8G8B8A8_UNORM
+  // for 8_8_8_8).
+  command_processor_.PushImageMemoryBarrier(
+      rt->image(), ui::vulkan::util::InitializeSubresourceRange(), rt->current_stage_mask(),
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, rt->current_access_mask(), VK_ACCESS_SHADER_READ_BIT,
+      rt->current_layout(), VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  rt->SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+               VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  command_processor_.SubmitBarriers(true);
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.BindExternalComputePipeline(pipeline);
+  VkDescriptorSet descriptor_sets[] = {rt->GetDescriptorSetTransferSource(), dest_set};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE,
+                                         hdr_copy_pipeline_layout_, 0, 2, descriptor_sets, 0,
+                                         nullptr);
+  uint32_t constants[4] = {
+      uint32_t(source.offset.x) | (uint32_t(source.offset.y) << 16),
+      uint32_t(dest_x) | (uint32_t(dest_y) << 16),
+      source.extent.width | (source.extent.height << 16), 0};
+  command_buffer.CmdVkPushConstants(hdr_copy_pipeline_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    sizeof(constants), constants);
+  command_buffer.CmdVkDispatch((source.extent.width + 7) / 8, (source.extent.height + 7) / 8, 1);
+  // The draw that may follow needs it as an attachment.
+  VkPipelineStageFlags stage_mask;
+  VkAccessFlags access_mask;
+  VkImageLayout layout;
+  rt->GetDrawUsage(&stage_mask, &access_mask, &layout);
+  command_processor_.PushImageMemoryBarrier(
+      rt->image(), ui::vulkan::util::InitializeSubresourceRange(),
+      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, stage_mask, VK_ACCESS_SHADER_READ_BIT, access_mask,
+      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, layout);
+  rt->SetUsage(stage_mask, access_mask, layout);
+  return true;
+}
+
+bool VulkanRenderTargetCache::HdrEnterColorTargetRenderPass(VulkanRenderTarget& rt) {
+  RenderPassKey render_pass_key;
+  render_pass_key.msaa_samples = rt.key().msaa_samples;
+  render_pass_key.depth_and_color_used = 0b1 << 1;
+  render_pass_key.color_0_view_format = rt.key().GetColorFormat();
+  VkRenderPass render_pass = GetHostRenderTargetsRenderPass(render_pass_key);
+  const RenderTarget* render_targets[1 + xenos::kMaxColorRenderTargets] = {};
+  render_targets[1] = &rt;
+  const Framebuffer* framebuffer = render_pass != VK_NULL_HANDLE
+                                       ? GetHostRenderTargetsFramebuffer(
+                                             render_pass_key, rt.key().pitch_tiles_at_32bpp,
+                                             render_targets)
+                                       : nullptr;
+  if (!framebuffer) {
+    return false;
+  }
+  VkPipelineStageFlags stage_mask;
+  VkAccessFlags access_mask;
+  VkImageLayout layout;
+  rt.GetDrawUsage(&stage_mask, &access_mask, &layout);
+  command_processor_.PushImageMemoryBarrier(
+      rt.image(), ui::vulkan::util::InitializeSubresourceRange(), rt.current_stage_mask(),
+      stage_mask, rt.current_access_mask(), access_mask, rt.current_layout(), layout);
+  rt.SetUsage(stage_mask, access_mask, layout);
+  command_processor_.SubmitBarriersAndEnterRenderTargetCacheRenderPass(
+      render_pass, framebuffer, rt.view_depth_color(), false);
+  return true;
+}
+
+bool VulkanRenderTargetCache::HdrClearColorTarget(uint32_t key, VkRect2D rect) {
+  VulkanRenderTarget* rt = HdrColorTarget(key, rect);
+  if (!rt || !HdrEnterColorTargetRenderPass(*rt)) {
+    return false;
+  }
+  VkClearAttachment attachment = {};
+  attachment.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  VkClearRect clear_rect = {rect, 0, 1};
+  command_processor_.deferred_command_buffer().CmdVkClearAttachments(1, &attachment, 1,
+                                                                     &clear_rect);
+  return true;
+}
+
+bool VulkanRenderTargetCache::HdrRestoreColorTarget(uint32_t key, VkImageView underlay_view,
+                                                    VkRect2D rect) {
+  VulkanRenderTarget* rt = HdrColorTarget(key, rect);
+  if (!rt) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  if (hdr_restore_pipeline_layout_ == VK_NULL_HANDLE) {
+    hdr_restore_shaders_[0] = ui::vulkan::util::CreateShaderModule(
+        vulkan_device, shaders::hdr_fullscreen_vs, sizeof(shaders::hdr_fullscreen_vs));
+    hdr_restore_shaders_[1] = ui::vulkan::util::CreateShaderModule(
+        vulkan_device, shaders::hdr_underlay_restore_ps, sizeof(shaders::hdr_underlay_restore_ps));
+    VkPipelineLayoutCreateInfo layout_create_info = {};
+    layout_create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    layout_create_info.setLayoutCount = 1;
+    layout_create_info.pSetLayouts = &descriptor_set_layout_sampled_image_;
+    if (!hdr_restore_shaders_[0] || !hdr_restore_shaders_[1] ||
+        dfn.vkCreatePipelineLayout(device, &layout_create_info, nullptr,
+                                   &hdr_restore_pipeline_layout_) != VK_SUCCESS) {
+      return false;
+    }
+  }
+  bool msaa = rt->key().msaa_samples != xenos::MsaaSamples::k1X;
+  VkPipeline& pipeline = hdr_restore_pipelines_[msaa];
+  bool use_dynamic_rendering =
+      REXCVAR_GET(vulkan_dynamic_rendering) && vulkan_device->properties().dynamicRendering;
+  if (pipeline == VK_NULL_HANDLE) {
+    VkPipelineShaderStageCreateInfo stages[2] = {};
+    for (uint32_t i = 0; i < 2; ++i) {
+      stages[i].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stages[i].stage = i ? VK_SHADER_STAGE_FRAGMENT_BIT : VK_SHADER_STAGE_VERTEX_BIT;
+      stages[i].module = hdr_restore_shaders_[i];
+      stages[i].pName = "main";
+    }
+    VkPipelineVertexInputStateCreateInfo vertex_input = {};
+    vertex_input.sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
+    VkPipelineInputAssemblyStateCreateInfo input_assembly = {};
+    input_assembly.sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
+    input_assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    VkPipelineViewportStateCreateInfo viewport_state = {};
+    viewport_state.sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
+    viewport_state.viewportCount = 1;
+    viewport_state.scissorCount = 1;
+    VkPipelineRasterizationStateCreateInfo rasterization = {};
+    rasterization.sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
+    rasterization.cullMode = VK_CULL_MODE_NONE;
+    rasterization.lineWidth = 1.0f;
+    VkPipelineMultisampleStateCreateInfo multisample = {};
+    multisample.sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
+    multisample.rasterizationSamples = msaa ? VK_SAMPLE_COUNT_4_BIT : VK_SAMPLE_COUNT_1_BIT;
+    VkPipelineColorBlendAttachmentState blend_attachment = {};
+    blend_attachment.blendEnable = VK_TRUE;
+    blend_attachment.srcColorBlendFactor = VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA;
+    blend_attachment.dstColorBlendFactor = VK_BLEND_FACTOR_ONE;
+    blend_attachment.srcAlphaBlendFactor = VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA;
+    blend_attachment.dstAlphaBlendFactor = VK_BLEND_FACTOR_ONE;
+    blend_attachment.colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT |
+                                      VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT;
+    VkPipelineColorBlendStateCreateInfo blend = {};
+    blend.sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
+    blend.attachmentCount = 1;
+    blend.pAttachments = &blend_attachment;
+    VkDynamicState dynamic_states[] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR};
+    VkPipelineDynamicStateCreateInfo dynamic_state = {};
+    dynamic_state.sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
+    dynamic_state.dynamicStateCount = 2;
+    dynamic_state.pDynamicStates = dynamic_states;
+    VkFormat color_format = VK_FORMAT_R8G8B8A8_UNORM;
+    VkPipelineRenderingCreateInfo rendering = {};
+    rendering.sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO;
+    rendering.colorAttachmentCount = 1;
+    rendering.pColorAttachmentFormats = &color_format;
+    RenderPassKey render_pass_key;
+    render_pass_key.msaa_samples = rt->key().msaa_samples;
+    render_pass_key.depth_and_color_used = 0b1 << 1;
+    render_pass_key.color_0_view_format = rt->key().GetColorFormat();
+    VkGraphicsPipelineCreateInfo pipeline_create_info = {};
+    pipeline_create_info.sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
+    pipeline_create_info.pNext = use_dynamic_rendering ? &rendering : nullptr;
+    pipeline_create_info.stageCount = 2;
+    pipeline_create_info.pStages = stages;
+    pipeline_create_info.pVertexInputState = &vertex_input;
+    pipeline_create_info.pInputAssemblyState = &input_assembly;
+    pipeline_create_info.pViewportState = &viewport_state;
+    pipeline_create_info.pRasterizationState = &rasterization;
+    pipeline_create_info.pMultisampleState = &multisample;
+    pipeline_create_info.pColorBlendState = &blend;
+    pipeline_create_info.pDynamicState = &dynamic_state;
+    pipeline_create_info.layout = hdr_restore_pipeline_layout_;
+    pipeline_create_info.renderPass =
+        use_dynamic_rendering ? VK_NULL_HANDLE : GetHostRenderTargetsRenderPass(render_pass_key);
+    pipeline_create_info.basePipelineIndex = -1;
+    if (dfn.vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &pipeline_create_info, nullptr,
+                                      &pipeline) != VK_SUCCESS) {
+      pipeline = VK_NULL_HANDLE;
+      return false;
+    }
+  }
+  // A descriptor set per underlay image (they change only with the output
+  // size), so none is rewritten while in use; replaced ones are freed once
+  // their last submission has completed.
+  uint64_t completed_submission = command_processor_.GetCompletedSubmission();
+  std::erase_if(hdr_restore_descriptor_sets_retired_,
+                [this, completed_submission](const std::pair<uint64_t, size_t>& retired) {
+                  if (retired.first > completed_submission) {
+                    return false;
+                  }
+                  descriptor_set_pool_sampled_image_->Free(retired.second);
+                  return true;
+                });
+  if (hdr_restore_underlay_view_ != underlay_view) {
+    if (hdr_restore_descriptor_set_ != SIZE_MAX) {
+      hdr_restore_descriptor_sets_retired_.emplace_back(command_processor_.GetCurrentSubmission(),
+                                                        hdr_restore_descriptor_set_);
+    }
+    hdr_restore_descriptor_set_ = descriptor_set_pool_sampled_image_->Allocate();
+    if (hdr_restore_descriptor_set_ == SIZE_MAX) {
+      return false;
+    }
+    hdr_restore_underlay_view_ = underlay_view;
+    VkDescriptorImageInfo image_info = {VK_NULL_HANDLE, underlay_view,
+                                        VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+    VkWriteDescriptorSet write = {};
+    write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    write.dstSet = descriptor_set_pool_sampled_image_->Get(hdr_restore_descriptor_set_);
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    write.pImageInfo = &image_info;
+    dfn.vkUpdateDescriptorSets(device, 1, &write, 0, nullptr);
+  }
+  if (!HdrEnterColorTargetRenderPass(*rt)) {
+    return false;
+  }
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  command_processor_.BindExternalGraphicsPipeline(pipeline);
+  VkDescriptorSet descriptor_set =
+      descriptor_set_pool_sampled_image_->Get(hdr_restore_descriptor_set_);
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                         hdr_restore_pipeline_layout_, 0, 1, &descriptor_set, 0,
+                                         nullptr);
+  VkViewport viewport = {0.0f,
+                         0.0f,
+                         float(rt->key().GetWidth() * draw_resolution_scale_x()),
+                         float(GetRenderTargetHeight(rt->key().pitch_tiles_at_32bpp,
+                                                     rt->key().msaa_samples) *
+                               draw_resolution_scale_y()),
+                         0.0f,
+                         1.0f};
+  command_processor_.SetViewport(viewport);
+  command_processor_.SetScissor(rect);
+  command_buffer.CmdVkDraw(3, 1, 0, 0);
+  return true;
+}
