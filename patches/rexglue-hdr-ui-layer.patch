+void CommandProcessor::OnGuestMarker(uint32_t kind, [[maybe_unused]] uint32_t value) {
+  switch (GuestMarkerKind(kind)) {
+    case GuestMarkerKind::kTonemapBegin:
+      hdr_frame_.tonemap = true;
+      break;
+    case GuestMarkerKind::kUIBegin:
+      // Replayed once per tile in a tiled UI pass.
+      hdr_frame_.ui_begin = true;
+      hdr_frame_.ui |= hdr_frame_.tonemap && hdr_output_width_ && REXCVAR_GET(hdr_ui_layer) &&
+                       ui::Presenter::IsHdrOutputActive();
+      if (hdr_frame_.ui && !hdr_frame_.ui_target) {
+        hdr_frame_.ui_target = HdrColorTargetKey(0);
+        hdr_frame_.width = hdr_output_width_;
+        hdr_frame_.height = hdr_output_height_;
+      }
+      break;
+    default:
+      break;
+  }
+}
