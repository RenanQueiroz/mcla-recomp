+    pipeline_desc.NumRenderTargets = 1;
+    pipeline_desc.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+    pipeline_desc.SampleDesc.Count = rt_resource->GetDesc().SampleDesc.Count;
+    if (FAILED(device->CreateGraphicsPipelineState(&pipeline_desc, IID_PPV_ARGS(&pipeline)))) {
+      return false;
+    }
+  }
+  command_processor_.PushTransitionBarrier(
+      rt_resource, rt->SetResourceState(D3D12_RESOURCE_STATE_RENDER_TARGET),
+      D3D12_RESOURCE_STATE_RENDER_TARGET);
+  command_processor_.SubmitBarriers();
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  are_current_command_list_render_targets_valid_ = false;
+  D3D12_CPU_DESCRIPTOR_HANDLE rtv = rt->descriptor_draw().GetHandle();
+  command_list.D3DOMSetRenderTargets(1, &rtv, FALSE, nullptr);
+  command_processor_.SetExternalPipeline(pipeline.Get());
+  command_processor_.SetExternalGraphicsRootSignature(hdr_restore_root_signature_.Get());
+  command_list.D3DSetGraphicsRootDescriptorTable(0, underlay_srv);
+  D3D12_RESOURCE_DESC desc = rt_resource->GetDesc();
+  command_processor_.SetViewport({0.0f, 0.0f, float(desc.Width), float(desc.Height), 0.0f, 1.0f});
+  command_processor_.SetScissorRect(rect);
+  command_processor_.SetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+  command_list.D3DDrawInstanced(3, 1, 0, 0);
+  // Back to the guest's render targets in case a draw follows.
+  SetCommandListRenderTargets(last_update_accumulated_render_targets());
+  return true;
+}
+
 void D3D12RenderTargetCache::SetCommandListRenderTargets(
     RenderTarget* const* depth_and_color_render_targets) {
   assert_true(GetPath() == Path::kHostRenderTargets);
