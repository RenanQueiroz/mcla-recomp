diff --git a/src/graphics/shaders/hdr_rt_copy.cs.xesl b/src/graphics/shaders/hdr_rt_copy.cs.xesl
new file mode 100644
index 0000000..6b66799
--- /dev/null
+++ b/src/graphics/shaders/hdr_rt_copy.cs.xesl
@@ -0,0 +1,58 @@
+// HDR output (rexglue-hdr-ui-layer.patch), Vulkan: copies a rectangle of an
+// 8_8_8_8 host render target through its sampled view into one of the HDR
+// output's textures (a storage image), averaging the samples of a 4x MSAA
+// target, so that render targets need no transfer source usage.
+
+#include "../../ui/shaders/xesl.xesli"
+
+#ifndef image_format_rgba8_xe
+  #if SHADING_LANGUAGE_GLSL_XE
+    #define image_format_rgba8_xe rgba8
+  #else
+    #define image_format_rgba8_xe unorm float4
+  #endif
+#endif
+
+push_const_begin_xe(b0, space0)
+  // x: the source's origin, y: the destination's, z: the size (16 bits each,
+  // x in the low half).
+  uint4_xe xe_hdr_rt_copy_rect;
+push_const_end_xe
+
+#define LOCAL_SIZE_X_XE 8
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+entry_bindings_begin_compute_xe
+  push_const_binding_xe(buffer(0))
+  entry_binding_next_xe
+#if XE_HDR_RT_COPY_4XMSAA
+  texture_xe(texture_2d_ms_xe, xe_hdr_rt_copy_source, set=0, binding=0, t0,
+             space0, texture(0))
+#else
+  texture_xe(texture_2d_xe, xe_hdr_rt_copy_source, set=0, binding=0, t0,
+             space0, texture(0))
+#endif
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, image_format_rgba8_xe, xe_hdr_rt_copy_dest, set=1,
+              binding=0, u0, space0, texture(1))
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+  uint4_xe rect = push_const_xe(xe_hdr_rt_copy_rect);
+  uint2_xe pixel_index = in_global_thread_id_xe.xy;
+  dont_flatten_xe
+  if (any(greater_than_equal_xe(pixel_index, uint2_xe(rect.z & 0xFFFFu, rect.z >> 16u)))) {
+    return;
+  }
+  int2_xe source = int2_xe(uint2_xe(rect.x & 0xFFFFu, rect.x >> 16u) + pixel_index);
+#if XE_HDR_RT_COPY_4XMSAA
+  float4_xe color = (texel_fetch_2d_ms_xe(xe_hdr_rt_copy_source, source, 0) +
+                     texel_fetch_2d_ms_xe(xe_hdr_rt_copy_source, source, 1) +
+                     texel_fetch_2d_ms_xe(xe_hdr_rt_copy_source, source, 2) +
+                     texel_fetch_2d_ms_xe(xe_hdr_rt_copy_source, source, 3)) * 0.25f;
+#else
+  float4_xe color = texel_fetch_2d_xe(xe_hdr_rt_copy_source, source, 0);
+#endif
+  image_store_2d_rgba_xe(xe_hdr_rt_copy_dest,
+                         uint2_xe(rect.y & 0xFFFFu, rect.y >> 16u) + pixel_index, color);
+entry_code_end_compute_xe
