+bool D3D12CommandProcessor::HdrRestoreColorTarget(uint32_t key, const HdrRect& rect) {
+  ui::d3d12::util::DescriptorCpuGpuHandlePair underlay_srv;
+  if (!BeginSubmission(true) || !HdrGetTexture(kHdrTextureUnderlayRt) ||
+      !RequestOneUseSingleViewDescriptors(1, &underlay_srv)) {
+    return false;
+  }
+  HdrWriteTextureSRV(kHdrTextureUnderlayRt, underlay_srv.first);
+  return render_target_cache_->HdrRestoreColorTarget(key, underlay_srv.second, HdrD3D12Rect(rect));
+}
+
+bool D3D12CommandProcessor::HdrCopyTexture(HdrTexture source, HdrTexture dest,
+                                           const HdrRect& source_rect, uint32_t dest_x,
+                                           uint32_t dest_y) {
+  ID3D12Resource* source_resource = HdrGetTexture(source);
+  ID3D12Resource* dest_resource = HdrGetTexture(dest);
+  if (!BeginSubmission(true) || !source_resource || !dest_resource) {
+    return false;
+  }
+  PushTransitionBarrier(source_resource, kHdrTextureState, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  PushTransitionBarrier(dest_resource, kHdrTextureState, D3D12_RESOURCE_STATE_COPY_DEST);
+  SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION copy_dest = {};
+  copy_dest.pResource = dest_resource;
+  copy_dest.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  D3D12_TEXTURE_COPY_LOCATION copy_source = {};
+  copy_source.pResource = source_resource;
+  copy_source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  D3D12_BOX copy_box = {source_rect.x, source_rect.y, 0, source_rect.x + source_rect.width,
+                        source_rect.y + source_rect.height, 1};
+  deferred_command_list_.D3DCopyTextureRegion(&copy_dest, dest_x, dest_y, 0, &copy_source,
+                                              &copy_box);
+  PushTransitionBarrier(source_resource, D3D12_RESOURCE_STATE_COPY_SOURCE, kHdrTextureState);
+  PushTransitionBarrier(dest_resource, D3D12_RESOURCE_STATE_COPY_DEST, kHdrTextureState);
+  SubmitBarriers();
+  return true;
+}
+
+bool D3D12CommandProcessor::HdrClearTexture(HdrTexture texture) {
+  ID3D12Resource* resource = HdrGetTexture(texture);
+  if (!BeginSubmission(true) || !resource || texture != kHdrTextureUiLayer ||
+      !hdr_ui_layer_rtv_heap_) {
+    return false;
+  }
+  PushTransitionBarrier(resource, kHdrTextureState, D3D12_RESOURCE_STATE_RENDER_TARGET);
+  SubmitBarriers();
+  const float kZero[4] = {};
+  deferred_command_list_.D3DClearRenderTargetView(
+      hdr_ui_layer_rtv_heap_->GetCPUDescriptorHandleForHeapStart(), kZero, 0, nullptr);
+  PushTransitionBarrier(resource, D3D12_RESOURCE_STATE_RENDER_TARGET, kHdrTextureState);
+  SubmitBarriers();
+  return true;
+}
