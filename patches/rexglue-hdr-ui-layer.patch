+  };
+  struct HdrFrame {
+    bool tonemap = false;     // kTonemapBegin seen
+    bool ui_begin = false;    // kUIBegin seen
+    bool ui = false;          // kUIBegin seen after kTonemapBegin, HDR output on
+    // HdrColorTargetKey of the UI's render target: at kUIBegin the one drawn to
+    // last (for frames with no UI), then the one the first colour draw goes to.
+    uint32_t ui_target = 0;
+    bool ui_target_drawn = false;
+    bool snapshot = false;    // this tile's underlay is in kHdrTextureUnderlayRt
+    bool started = false;     // this tile's UI goes to the cleared target
+    bool failed = false;      // separation ended for this frame
