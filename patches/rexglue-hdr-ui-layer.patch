+ID3D12Resource* D3D12RenderTargetCache::HdrColorTarget(uint32_t key, D3D12_RECT& rect,
+                                                       bool& msaa_out) {
+  auto* rt = static_cast<D3D12RenderTarget*>(HdrFindColorTarget(key));
+  if (!rt) {
+    return nullptr;
+  }
+  D3D12_RESOURCE_DESC desc = rt->resource()->GetDesc();
+  rect.right = std::min(rect.right, LONG(desc.Width));
+  rect.bottom = std::min(rect.bottom, LONG(desc.Height));
+  msaa_out = desc.SampleDesc.Count > 1;
+  return rect.right > rect.left && rect.bottom > rect.top ? rt->resource() : nullptr;
+}
+
+bool D3D12RenderTargetCache::HdrCopyColorTarget(uint32_t key, ID3D12Resource* dest,
+                                                D3D12_RESOURCE_STATES dest_state,
+                                                D3D12_RECT source, uint32_t dest_x,
+                                                uint32_t dest_y) {
+  bool msaa;
+  ID3D12Resource* rt_resource = HdrColorTarget(key, source, msaa);
+  if (!rt_resource) {
+    return false;
+  }
+  auto* rt = static_cast<D3D12RenderTarget*>(HdrFindColorTarget(key));
+  D3D12_RESOURCE_STATES source_state =
+      msaa ? D3D12_RESOURCE_STATE_RESOLVE_SOURCE : D3D12_RESOURCE_STATE_COPY_SOURCE;
+  D3D12_RESOURCE_STATES dest_op_state =
+      msaa ? D3D12_RESOURCE_STATE_RESOLVE_DEST : D3D12_RESOURCE_STATE_COPY_DEST;
+  command_processor_.PushTransitionBarrier(rt_resource, rt->SetResourceState(source_state),
+                                           source_state);
+  command_processor_.PushTransitionBarrier(dest, dest_state, dest_op_state);
+  command_processor_.SubmitBarriers();
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  if (msaa) {
+    command_list.D3DResolveSubresourceRegion(dest, dest_x, dest_y, rt_resource, source,
+                                             DXGI_FORMAT_R8G8B8A8_UNORM);
+  } else {
+    D3D12_TEXTURE_COPY_LOCATION copy_dest = {};
+    copy_dest.pResource = dest;
+    copy_dest.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_TEXTURE_COPY_LOCATION copy_source = {};
+    copy_source.pResource = rt_resource;
+    copy_source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_BOX copy_box = {UINT(source.left), UINT(source.top), 0, UINT(source.right),
+                          UINT(source.bottom), 1};
+    command_list.D3DCopyTextureRegion(&copy_dest, dest_x, dest_y, 0, &copy_source, &copy_box);
+  }
+  command_processor_.PushTransitionBarrier(dest, dest_op_state, dest_state);
+  // The draw that may follow needs it as a render target. Submitted now, not
+  // merged with later barriers on the same resources.
+  command_processor_.PushTransitionBarrier(
+      rt_resource, rt->SetResourceState(D3D12_RESOURCE_STATE_RENDER_TARGET),
+      D3D12_RESOURCE_STATE_RENDER_TARGET);
+  command_processor_.SubmitBarriers();
+  return true;
+}
