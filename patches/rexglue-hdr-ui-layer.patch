+
+bool VulkanCommandProcessor::HdrCopyFromColorTarget(uint32_t key, HdrTexture dest,
+                                                    const HdrRect& source, uint32_t dest_x,
+                                                    uint32_t dest_y) {
+  HdrImage* image = HdrGetImage(dest);
+  if (!image) {
+    return false;
+  }
+  EndRenderPass();
+  HdrTransitionImage(*image, VK_IMAGE_LAYOUT_GENERAL);
+  bool copied = render_target_cache_->HdrCopyColorTarget(
+      key, image->view,
+      {{int32_t(source.x), int32_t(source.y)}, {source.width, source.height}}, int32_t(dest_x),
+      int32_t(dest_y));
+  HdrTransitionImage(*image, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  return copied;
+}
+
+bool VulkanCommandProcessor::HdrClearColorTarget(uint32_t key, const HdrRect& rect) {
+  return BeginSubmission(true) &&
+         render_target_cache_->HdrClearColorTarget(
+             key, {{int32_t(rect.x), int32_t(rect.y)}, {rect.width, rect.height}});
+}
+
+bool VulkanCommandProcessor::HdrRestoreColorTarget(uint32_t key, const HdrRect& rect) {
+  HdrImage* underlay = HdrGetImage(kHdrTextureUnderlayRt);
+  return underlay && render_target_cache_->HdrRestoreColorTarget(
+                         key, underlay->view,
+                         {{int32_t(rect.x), int32_t(rect.y)}, {rect.width, rect.height}});
+}
+
+bool VulkanCommandProcessor::HdrCopyTexture(HdrTexture source, HdrTexture dest,
+                                            const HdrRect& source_rect, uint32_t dest_x,
+                                            uint32_t dest_y) {
+  HdrImage* source_image = HdrGetImage(source);
+  HdrImage* dest_image = HdrGetImage(dest);
+  if (!source_image || !dest_image) {
+    return false;
+  }
+  EndRenderPass();
+  HdrTransitionImage(*source_image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+  HdrTransitionImage(*dest_image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  SubmitBarriers(true);
+  VkImageCopy region = {};
+  region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  region.srcSubresource.layerCount = 1;
+  region.srcOffset = {int32_t(source_rect.x), int32_t(source_rect.y), 0};
+  region.dstSubresource = region.srcSubresource;
+  region.dstOffset = {int32_t(dest_x), int32_t(dest_y), 0};
+  region.extent = {source_rect.width, source_rect.height, 1};
+  deferred_command_buffer_.CmdVkCopyImage(source_image->image, source_image->layout,
+                                          dest_image->image, dest_image->layout, region);
+  HdrTransitionImage(*source_image, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  HdrTransitionImage(*dest_image, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  return true;
+}
+
+bool VulkanCommandProcessor::HdrClearTexture(HdrTexture texture) {
+  HdrImage* image = HdrGetImage(texture);
+  if (!image) {
+    return false;
+  }
+  EndRenderPass();
+  HdrTransitionImage(*image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  SubmitBarriers(true);
+  VkClearColorValue zero = {};
+  VkImageSubresourceRange range = ui::vulkan::util::InitializeSubresourceRange();
+  deferred_command_buffer_.CmdVkClearColorImage(image->image, image->layout, &zero, 1, &range);
+  HdrTransitionImage(*image, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  return true;
+}
