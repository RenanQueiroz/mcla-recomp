+uint32_t CommandProcessor::HdrColorTargetKey(uint32_t rt_index) const {
+  const RegisterFile& regs = *register_file_;
+  auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  auto color_info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[rt_index]);
+  return color_info.GetBaseTiles(HdrEdramTileCount()) | (uint32_t(surface_info.msaa_samples) << 12) |
+         (uint32_t(color_info.color_format) << 14) | (surface_info.surface_pitch << 18);
+}
+
+void CommandProcessor::HdrFail(HdrFailure failure) {
+  if (hdr_frame_.failed) {
+    return;
+  }
+  hdr_frame_.failed = true;
+  uint32_t failure_bit = uint32_t(1) << uint32_t(failure);
+  if (!(hdr_failures_logged_ & failure_bit)) {
+    hdr_failures_logged_ |= failure_bit;
+    static const char* const kReasons[] = {
+        "the UI's render target format", "a blend mode", "a render target copy",
+        "the UI's target resolved elsewhere", "a resolve's place in the front buffer",
+        "the UI layer's texture", "putting the render target back"};
+    static_assert(std::size(kReasons) == size_t(HdrFailure::kCount));
+    REXGPU_INFO(
+        "HDR: separating the UI ended for a frame ({}); frames like it fall back to the "
+        "difference with the underlay, or to the whole frame as SDR",
+        kReasons[uint32_t(failure)]);
+  }
+}
+
+bool CommandProcessor::HdrFrontBufferPosition(uint32_t offset, uint32_t pitch, uint32_t height,
+                                              uint32_t& x, uint32_t& y) {
+  for (const HdrPositionCacheEntry& entry : hdr_position_cache_) {
+    if (entry.pitch == pitch && entry.offset == offset) {
+      x = entry.x;
+      y = entry.y;
+      return true;
+    }
+  }
+  // 32bpp 2D: bases are aligned to 32x32 (xenos::GetTextureTiled*BaseGranularityLog2).
+  for (uint32_t base_y = 0; base_y < height; base_y += 32) {
+    for (uint32_t base_x = 0; base_x < pitch; base_x += 32) {
+      if (uint32_t(texture_util::GetTiledOffset2D(int32_t(base_x), int32_t(base_y), pitch, 2)) ==
+          offset) {
+        hdr_position_cache_[hdr_position_cache_next_++ % std::size(hdr_position_cache_)] = {
+            offset, pitch, base_x, base_y};
+        x = base_x;
+        y = base_y;
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+bool CommandProcessor::HdrBeforeDraw() {
+  hdr_pending_ = HdrPending::kNone;
+  if (!hdr_frame_.ui) {
+    return false;
+  }
+  RegisterFile& regs = *register_file_;
+  xenos::EdramMode edram_mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  if (edram_mode == xenos::EdramMode::kCopy) {
+    HdrBeforeResolve();
+    return false;
+  }
+  uint32_t color_mask = regs[XE_GPU_REG_RB_COLOR_MASK] & 0xF;
+  if (edram_mode != xenos::EdramMode::kColorDepth || !color_mask) {
+    return false;
+  }
+  uint32_t key = HdrColorTargetKey(0);
+  if (!hdr_frame_.ui_target_drawn) {
+    // The UI's render target is the first one drawn to.
+    hdr_frame_.ui_target_drawn = true;
+    hdr_frame_.ui_target = key;
+    auto format = xenos::ColorRenderTargetFormat((key >> 14) & 0xF);
+    auto msaa = xenos::MsaaSamples((key >> 12) & 3);
+    if (format != xenos::ColorRenderTargetFormat::k_8_8_8_8 || msaa == xenos::MsaaSamples::k2X) {
+      HdrFail(HdrFailure::kFormat);
+    }
+  }
+  if (key != hdr_frame_.ui_target) {
+    return false;
+  }
+  Register blend_register = reg::RB_BLENDCONTROL::rt_register_indices[0];
+  auto blend = regs.Get<reg::RB_BLENDCONTROL>(blend_register);
+  bool opaque = blend.color_srcblend == xenos::BlendFactor::kOne &&
+                blend.color_destblend == xenos::BlendFactor::kZero &&
+                blend.color_comb_fcn == xenos::BlendOp::kAdd;
+  bool over = color_mask == 0xF && blend.color_comb_fcn == xenos::BlendOp::kAdd &&
+              blend.color_destblend == xenos::BlendFactor::kOneMinusSrcAlpha &&
+              (blend.color_srcblend == xenos::BlendFactor::kSrcAlpha ||
+               blend.color_srcblend == xenos::BlendFactor::kOne);
+  if (!hdr_frame_.failed && !hdr_frame_.started && !opaque) {
+    if (over) {
+      hdr_pending_ = HdrPending::kStart;
+    } else {
+      HdrFail(HdrFailure::kBlend);
+    }
+  } else if (!hdr_frame_.failed && hdr_frame_.started && !over) {
+    // Put the target back now, before this draw: a draw may still return
+    // before its render target update.
+    HdrFail(HdrFailure::kBlend);
+    if (!HdrRestoreColorTarget(key, {0, 0, hdr_output_width_, hdr_output_height_})) {
+      hdr_frame_.snapshot = false;
+    }
+    hdr_frame_.started = false;
+    return false;
+  }
+  if (hdr_frame_.failed) {
+    // For the difference mask: the underlay of this tile.
+    if (!hdr_frame_.snapshot && !opaque) {
+      hdr_pending_ = HdrPending::kSnapshot;
+    }
+    return false;
+  }
+  if (!over) {
+    return false;
+  }
+  // Alpha collects the coverage.
+  hdr_saved_blend_control_ = blend.value;
+  blend.alpha_srcblend = xenos::BlendFactor::kOne;
+  blend.alpha_destblend = xenos::BlendFactor::kOneMinusSrcAlpha;
+  blend.alpha_comb_fcn = xenos::BlendOp::kAdd;
+  regs[blend_register] = blend.value;
+  return true;
+}
+
+void CommandProcessor::HdrRenderTargetsReady() {
+  HdrPending pending = hdr_pending_;
+  hdr_pending_ = HdrPending::kNone;
+  if (pending == HdrPending::kNone) {
+    return;
+  }
+  // The underlay and the clear cover what the output can show.
+  uint32_t key = hdr_frame_.ui_target;
+  HdrRect rect = {0, 0, hdr_output_width_, hdr_output_height_};
+  hdr_frame_.snapshot = HdrCopyFromColorTarget(key, kHdrTextureUnderlayRt, rect, 0, 0);
+  if (pending == HdrPending::kStart) {
+    if (hdr_frame_.snapshot && HdrClearColorTarget(key, rect)) {
+      hdr_frame_.started = true;
+    } else {
+      // No host render target (ROV, FSI) or the copy failed: this draw keeps
+      // the guest's blend (the pipeline isn't configured yet).
+      HdrFail(HdrFailure::kCopy);
+      (*register_file_)[reg::RB_BLENDCONTROL::rt_register_indices[0]] = hdr_saved_blend_control_;
+    }
+  }
+}
+
+void CommandProcessor::HdrBeforeResolve() {
+  const RegisterFile& regs = *register_file_;
+  auto copy_control = regs.Get<reg::RB_COPY_CONTROL>();
+  if (!hdr_frame_.ui_target || copy_control.copy_src_select >= xenos::kMaxColorRenderTargets ||
+      HdrColorTargetKey(copy_control.copy_src_select) != hdr_frame_.ui_target) {
+    return;
+  }
+  // Where the resolved area is in the render target and in the front buffer.
+  uint32_t scale_x, scale_y;
+  HdrDrawResolutionScale(scale_x, scale_y);
+  draw_util::ResolveInfo info;
+  if (!draw_util::GetResolveInfo(regs, *memory_, scale_x, scale_y, HdrEdramTileCount(), false,
+                                 false, info) ||
+      !info.coordinate_info.width_div_8 || !info.height_div_8) {
+    return;
+  }
+  uint32_t key = hdr_frame_.ui_target;
+  // Only a resolve to a front buffer is the picture. Another one mid-UI ends
+  // the separation (the target is put back first); before the UI, it's the
+  // scene going somewhere else, and doesn't matter.
+  uint32_t front_buffer_height = hdr_output_height_ / scale_y;
+  uint32_t front_buffer_size = hdr_output_width_ / scale_x * front_buffer_height * 4;
+  uint32_t front_buffer = 0;
+  for (uint32_t buffer : hdr_front_buffers_) {
+    if (buffer && info.copy_dest_base - buffer < front_buffer_size) {
+      front_buffer = buffer;
+    }
+  }
+  uint32_t dest_pitch = info.copy_dest_coordinate_info.pitch_aligned_div_32 << 5;
+  uint32_t screen_x = 0, screen_y = 0;
+  HdrFailure failure = HdrFailure::kResolvedElsewhere;
+  if (front_buffer &&
+      xenos::TextureFormat(info.copy_dest_info.copy_dest_format) ==
+          xenos::TextureFormat::k_8_8_8_8 &&
+      !info.copy_dest_info.copy_dest_array) {
+    failure = HdrFailure::kResolveArea;
+    if (HdrFrontBufferPosition(info.copy_dest_base - front_buffer, dest_pitch,
+                               front_buffer_height, screen_x, screen_y)) {
+      screen_x += info.copy_dest_coordinate_info.offset_x_div_8 * 8;
+      screen_y += info.copy_dest_coordinate_info.offset_y_div_8 * 8;
+      failure = HdrFailure::kCount;
+    }
+  }
+  if (failure != HdrFailure::kCount) {
+    if (hdr_frame_.started) {
+      HdrRestoreColorTarget(key, {0, 0, hdr_output_width_, hdr_output_height_});
+      hdr_frame_.started = false;
+      HdrFail(failure);
+    } else if (hdr_frame_.snapshot && failure == HdrFailure::kResolveArea) {
+      HdrFail(failure);
+    }
+    return;
+  }
+  bool msaa_4x = info.color_edram_info.msaa_samples >= xenos::MsaaSamples::k4X;
+  uint32_t tile_width = xenos::kEdramTileWidthSamples >> uint32_t(msaa_4x);
+  uint32_t tile_height =
+      xenos::kEdramTileHeightSamples >>
+      uint32_t(info.color_edram_info.msaa_samples >= xenos::MsaaSamples::k2X);
+  uint32_t base_offset = (info.color_edram_info.GetBaseTiles() - (key & 0xFFF)) &
+                         (HdrEdramTileCount() - 1);
+  uint32_t pitch_tiles = std::max(info.color_edram_info.pitch_tiles, uint32_t(1));
+  uint32_t rt_x = (base_offset % pitch_tiles) * tile_width +
+                  info.coordinate_info.edram_offset_x_div_8 * 8;
+  uint32_t rt_y = (base_offset / pitch_tiles) * tile_height +
+                  info.coordinate_info.edram_offset_y_div_8 * 8;
+  // Both clipped to the textures (the output's size).
+  HdrRect rect = {rt_x * scale_x, rt_y * scale_y, info.coordinate_info.width_div_8 * 8 * scale_x,
+                  info.height_div_8 * 8 * scale_y};
+  uint32_t dest_x = screen_x * scale_x, dest_y = screen_y * scale_y;
+  rect.width = std::min({rect.width, hdr_output_width_ - std::min(dest_x, hdr_output_width_),
+                         hdr_output_width_ - std::min(rect.x, hdr_output_width_)});
+  rect.height = std::min({rect.height, hdr_output_height_ - std::min(dest_y, hdr_output_height_),
+                          hdr_output_height_ - std::min(rect.y, hdr_output_height_)});
+  if (!rect.width || !rect.height) {
+    if (hdr_frame_.started) {
+      HdrRestoreColorTarget(key, {0, 0, hdr_output_width_, hdr_output_height_});
+      hdr_frame_.started = false;
+    }
+    hdr_frame_.snapshot = false;
+    return;
+  }
+  if (!hdr_frame_.ui_layer_cleared) {
+    hdr_frame_.ui_layer_cleared = true;
+    if (!HdrClearTexture(kHdrTextureUiLayer)) {
+      HdrFail(HdrFailure::kTexture);
+    }
+  }
+  bool copied;
+  if (hdr_frame_.started) {
+    // The UI, the underlay, and the target put back for the resolve.
+    copied = HdrCopyFromColorTarget(key, kHdrTextureUiLayer, rect, dest_x, dest_y) &&
+             HdrCopyTexture(kHdrTextureUnderlayRt, kHdrTextureUnderlay, rect, dest_x, dest_y);
+    if (!HdrRestoreColorTarget(key, {0, 0, hdr_output_width_, hdr_output_height_})) {
+      HdrFail(HdrFailure::kRestore);
+    }
+  } else if (hdr_frame_.snapshot) {
+    copied = HdrCopyTexture(kHdrTextureUnderlayRt, kHdrTextureUnderlay, rect, dest_x, dest_y);
+  } else {
+    // No UI over this area.
+    copied = HdrCopyFromColorTarget(key, kHdrTextureUnderlay, rect, dest_x, dest_y);
+  }
+  if (copied) {
+    hdr_frame_.captured_area += uint64_t(rect.width) * rect.height;
+  }
+  hdr_frame_.started = false;
+  hdr_frame_.snapshot = false;
+}
