+uint32_t Presenter::IsHdrOutputWanted() {
+  HdrRegisterSettingCallbacks();
+  int mode = hdr_mode.load(std::memory_order_relaxed);
+  if (!mode) {
+    return 0;
+  }
+  HdrDisplayWorker& worker = HdrDisplayWorker::Get();
+  if (hdr_display_info_stale.exchange(false)) {
+    worker.Wake();
+  }
+  static std::atomic<bool> first_query_awaited{false};
+  if (!first_query_awaited.exchange(true, std::memory_order_relaxed)) {
+    worker.AwaitFirstQuery();
+  }
+  if (!hdr_guest_output_available.load(std::memory_order_relaxed)) {
+    return 0;
   }
   HdrDisplayInfo info = GetLastHdrDisplayInfo();
-  return info.known && info.hdr_enabled;
