+CommandProcessor::HdrComposite CommandProcessor::HdrGetComposite(uint32_t output_width,
+                                                                 uint32_t output_height) {
+  HdrComposite composite = HdrComposite::kWholeFrame;
+  if (hdr_frame_.ui && hdr_frame_.width == output_width && hdr_frame_.height == output_height &&
+      hdr_frame_.captured_area >= uint64_t(output_width) * output_height) {
+    composite = hdr_frame_.failed ? HdrComposite::kMask : HdrComposite::kLayer;
+  } else if (hdr_frame_.tonemap && !hdr_frame_.ui_begin && REXCVAR_GET(hdr_ui_layer) &&
+             ui::Presenter::IsHdrOutputActive()) {
+    // A frame drawn without a UI pass (one now and then, at transitions).
+    composite = HdrComposite::kScene;
+  }
+  if (composite != hdr_last_composite_) {
+    hdr_last_composite_ = composite;
+    static const char* const kNames[] = {"the front buffer as SDR", "the difference mask",
+                                         "the UI layer", "the front buffer as the scene"};
+    REXGPU_INFO("HDR: frames are put together from {}", kNames[uint32_t(composite)]);
+  }
+  return composite;
+}
+
+uint32_t CommandProcessor::HdrRefreshCompositeFlags(HdrComposite composite, uint32_t debug_ui) {
+  // Bits 3:4: 0 the front buffer alone, 1 the difference mask, 2 the UI layer,
+  // 3 a texture shown raw (bits 6:7); bit 5: the UI in magenta; bit 8: the
+  // front buffer alone is the scene.
+  if (debug_ui >= 3) {
+    return (3u << 3) | ((debug_ui - 3) << 6);
+  }
+  if (debug_ui == 2) {
+    return 0;
+  }
+  uint32_t flags = uint32_t(debug_ui == 1) << 5;
+  if (composite == HdrComposite::kScene) {
+    return flags | (1u << 8);
+  }
+  return flags | (uint32_t(composite) << 3);
+}
