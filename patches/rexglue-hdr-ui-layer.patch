+bool D3D12RenderTargetCache::HdrClearColorTarget(uint32_t key, D3D12_RECT rect) {
+  bool msaa;
+  ID3D12Resource* rt_resource = HdrColorTarget(key, rect, msaa);
+  if (!rt_resource) {
+    return false;
+  }
+  auto* rt = static_cast<D3D12RenderTarget*>(HdrFindColorTarget(key));
+  command_processor_.PushTransitionBarrier(
+      rt_resource, rt->SetResourceState(D3D12_RESOURCE_STATE_RENDER_TARGET),
+      D3D12_RESOURCE_STATE_RENDER_TARGET);
+  command_processor_.SubmitBarriers();
+  const float kZero[4] = {};
+  command_processor_.GetDeferredCommandList().D3DClearRenderTargetView(
+      rt->descriptor_draw().GetHandle(), kZero, 1, &rect);
+  return true;
+}
