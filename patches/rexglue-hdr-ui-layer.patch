+  // HDR output (rexglue-hdr-ui-layer.patch): the 8_8_8_8 host render target with
+  // the base, the MSAA and the pitch of `key` (CommandProcessor::
+  // HdrColorTargetKey), if it exists.
+  RenderTarget* HdrFindColorTarget(uint32_t key) const {
+    if (GetPath() != Path::kHostRenderTargets) {
+      return nullptr;
+    }
+    RenderTargetKey rt_key;
+    rt_key.base_tiles = key & 0xFFF;
+    rt_key.msaa_samples = xenos::MsaaSamples((key >> 12) & 3);
+    rt_key.pitch_tiles_at_32bpp =
+        (((key >> 18) << uint32_t(rt_key.msaa_samples >= xenos::MsaaSamples::k4X)) +
+         xenos::kEdramTileWidthSamples - 1) /
+        xenos::kEdramTileWidthSamples;
+    rt_key.resource_format = uint32_t(xenos::ColorRenderTargetFormat::k_8_8_8_8);
+    auto it = render_targets_.find(rt_key);
+    return it != render_targets_.end() ? it->second : nullptr;
+  }
   RenderTarget* const* last_update_accumulated_render_targets() const {
     assert_true(GetPath() == Path::kHostRenderTargets);
