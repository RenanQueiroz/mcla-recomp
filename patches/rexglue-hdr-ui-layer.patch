diff --git a/src/graphics/shaders/hdr_underlay_restore.ps.xesl b/src/graphics/shaders/hdr_underlay_restore.ps.xesl
new file mode 100644
index 0000000..fd8fe9a
--- /dev/null
+++ b/src/graphics/shaders/hdr_underlay_restore.ps.xesl
@@ -0,0 +1,22 @@
+// HDR output (rexglue-hdr-ui-layer.patch): puts the guest's own frame back
+// together after its UI was drawn on a cleared target: drawn over the target
+// with INV_DEST_ALPHA / ONE for colour and alpha, so target = UI + underlay x
+// (1 - UI alpha), alpha included, per sample (the menus' target is 4x MSAA).
+// The underlay is the copy taken before the UI, in render target pixels.
+
+#include "../../ui/shaders/xesl.xesli"
+
+entry_outputs_begin_xe
+  entry_out_target_xe(float4_xe, xe_underlay_color, 0)
+entry_outputs_end_stage_inputs_begin_xe
+entry_stage_inputs_end_bindings_begin_pixel_xe
+  texture_xe(texture_2d_xe, xe_underlay_source, set=0, binding=0, t0, space0,
+             texture(0))
+entry_bindings_end_inputs_begin_xe
+  entry_in_pixel_coord_xe
+entry_inputs_end_code_begin_xe
+{
+  out_xe(xe_underlay_color) =
+      texel_fetch_2d_xe(xe_underlay_source, int2_xe(in_pixel_coord_xe.xy), 0);
+}
+entry_code_end_xe
