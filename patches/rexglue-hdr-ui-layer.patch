+Presenter::HdrMetadataLevels Presenter::GetHdrMetadataLevels() {
+  auto valid = [](float nits) { return std::isfinite(nits) ? std::clamp(nits, 0.0f, 10000.0f) : 0.0f; };
+  HdrOutputState state = GetHdrOutputState();
+  HdrDisplayInfo info = GetLastHdrDisplayInfo();
+  HdrMetadataLevels levels;
+  levels.max_nits = valid(state.peak_nits);
+  levels.max_frame_average_nits =
+      std::min(info.full_frame_nits > 0.0f ? valid(info.full_frame_nits) : levels.max_nits,
+               levels.max_nits);
+  levels.min_nits = std::min(valid(info.min_nits), levels.max_nits);
+  return levels;
+}
