diff --git a/cmake/fidelityfx/CMakeLists.txt b/cmake/fidelityfx/CMakeLists.txt
index 365a133..fef4722 100644
--- a/cmake/fidelityfx/CMakeLists.txt
+++ b/cmake/fidelityfx/CMakeLists.txt
@@ -10,13 +10,24 @@
 #   REXGLUE_FSR_STATIC          static libraries instead, checked and copied to
 #                               REXGLUE_FSR_ARCHIVE_DIR by the target rexglue_fsr_static
 #                               (the PS5)
+#   REXGLUE_FSR_WRAPPER_HASH    this folder's files' hash (only to make a changed wrapper
+#                               configure and build the runtime again)
 cmake_minimum_required(VERSION 3.23)
 project(rexglue_fidelityfx C CXX)
 if(NOT FFX_ROOT OR NOT FFX_API_BACKEND)
     message(FATAL_ERROR "FFX_ROOT and FFX_API_BACKEND are required")
 endif()
-# Upscaling only: no frame generation providers.
-set(FFX_API_ENABLE_FRAMEGEN_PROVIDER OFF CACHE BOOL "" FORCE)
+set(_wrapper_hash "${REXGLUE_FSR_WRAPPER_HASH}")
+# Upscaling, and on Windows frame generation (rexglue-frame-generation.patch):
+# the frame generation provider and its optical flow and frame interpolation
+# components, on Vulkan without AMD's frame-interpolation swapchain (below).
+# Elsewhere upscaling only, as before, until frame generation is checked there
+# (phase 5), so FSR anti-aliasing can't be lost to code that isn't used yet.
+if(WIN32)
+    set(FFX_API_ENABLE_FRAMEGEN_PROVIDER ON CACHE BOOL "" FORCE)
+else()
+    set(FFX_API_ENABLE_FRAMEGEN_PROVIDER OFF CACHE BOOL "" FORCE)
+endif()
 if(REXGLUE_FSR_SHADERS_DIR)
     # FidelityFX_SC isn't run: right after the SDK's project() for the Vulkan
     # backend (after it has picked its compiler), the hook puts
@@ -50,6 +61,41 @@ unset(CMAKE_GENERATOR_PLATFORM CACHE)
 string(TOLOWER "${FFX_API_BACKEND}" _backend)
 string(REGEX REPLACE "_x64$" "" _backend "${_backend}")
 set(_target amd_fidelityfx_${_backend})
+if(_backend STREQUAL "vk" AND FFX_API_ENABLE_FRAMEGEN_PROVIDER)
+    # Vulkan frame generation is "manual" (FFX_FRAMEGENERATION_FLAG_NO_SWAPCHAIN_CONTEXT_NOTIFY):
+    # rexglue presents the frames itself. AMD's Vulkan frame-interpolation
+    # swapchain is Win32-only and doesn't compile with Clang at this commit, so
+    # its sources are left out and its ffx-api provider is a stub that provides
+    # nothing (ffx_provider.cpp's table still names it).
+    set(_vk_backend_target ffx_backend_vk_x64)
+    if(NOT TARGET ${_vk_backend_target})
+        message(FATAL_ERROR "FSR: FidelityFX's Vulkan backend isn't ${_vk_backend_target} any more")
+    endif()
+    get_target_property(_sources ${_vk_backend_target} SOURCES)
+    list(FILTER _sources EXCLUDE REGEX "FrameInterpolationSwapchain/")
+    set_property(TARGET ${_vk_backend_target} PROPERTY SOURCES ${_sources})
+    # The backend's swapchain hook refers to that swapchain only when it is
+    # compiled with FFX_API_ENABLE_FRAMEGEN_PROVIDER (ffx_vk.cpp), which ffx-api
+    # gives to its own library alone; with it, Linux and the PS5 couldn't link.
+    get_target_property(_definitions ${_vk_backend_target} COMPILE_DEFINITIONS)
+    get_target_property(_backend_dir ${_vk_backend_target} SOURCE_DIR)
+    get_directory_property(_dir_definitions DIRECTORY "${_backend_dir}" COMPILE_DEFINITIONS)
+    if("${_definitions};${_dir_definitions}" MATCHES "FFX_API_ENABLE_FRAMEGEN_PROVIDER")
+        message(FATAL_ERROR "FSR: FidelityFX's Vulkan backend is compiled with "
+                            "FFX_API_ENABLE_FRAMEGEN_PROVIDER, so it needs the frame-interpolation "
+                            "swapchain left out of the build")
+    endif()
+    get_target_property(_sources ${_target} SOURCES)
+    list(LENGTH _sources _count_before)
+    list(FILTER _sources EXCLUDE REGEX "ffx_provider_framegenerationswapchain_vk\\.cpp$")
+    list(LENGTH _sources _count_after)
+    if(_count_before EQUAL _count_after)
+        message(FATAL_ERROR "FSR: no ffx_provider_framegenerationswapchain_vk.cpp in ${_target} to replace")
+    endif()
+    list(APPEND _sources "${CMAKE_CURRENT_LIST_DIR}/ffx_provider_framegenerationswapchain_vk_stub.cpp")
+    set_property(TARGET ${_target} PROPERTY SOURCES ${_sources})
+    target_include_directories(${_target} PRIVATE "${FFX_ROOT}/ffx-api/src/vk")
+endif()
 # Outputs into this build tree (ffx-api's CMake would put them next to this file).
 foreach(_config "" _DEBUG _RELEASE _RELWITHDEBINFO)
     set_target_properties(${_target} PROPERTIES
diff --git a/cmake/fidelityfx/ffx_provider_framegenerationswapchain_vk_stub.cpp b/cmake/fidelityfx/ffx_provider_framegenerationswapchain_vk_stub.cpp
