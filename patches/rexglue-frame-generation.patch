+namespace {
+
+#if defined(REX_HAS_FSR) && REX_HAS_FSR
+struct FgDispatch {
+  PfnFfxConfigure configure;
+  PfnFfxDispatch dispatch;
+  // The context's handle as it was when recorded.
+  ffxContext context;
+  std::atomic<bool>* failed;
+  uint32_t configure_flags;
+  ffxDispatchDescFrameGenerationPrepare prepare;
+  ffxDispatchDescFrameGeneration generate;
+};
+
+// On the submission thread, into the frame's command buffer: the frame's
+// configuration, the preparation, generation.
+void FgDispatchCallback(VkCommandBuffer command_buffer, const void* data) {
+  FgDispatch dispatch;
+  std::memcpy(&dispatch, data, sizeof(dispatch));
+  ffxContext context = dispatch.context;
+  ffxConfigureDescFrameGeneration config = {};
+  config.header.type = FFX_API_CONFIGURE_DESC_TYPE_FRAMEGENERATION;
+  config.frameGenerationEnabled = true;
+  config.flags = dispatch.configure_flags;
+  config.generationRect = dispatch.generate.generationRect;
+  config.frameID = dispatch.generate.frameID;
+  const char* what = "configuration";
+  ffxReturnCode_t result = dispatch.configure(&context, &config.header);
+  if (result == FFX_API_RETURN_OK) {
+    what = "preparation";
+    dispatch.prepare.commandList = command_buffer;
+    result = dispatch.dispatch(&context, &dispatch.prepare.header);
+  }
+  if (result == FFX_API_RETURN_OK) {
+    what = "dispatch";
+    dispatch.generate.commandList = command_buffer;
+    result = dispatch.dispatch(&context, &dispatch.generate.header);
+  }
+  if (result == FFX_API_RETURN_OK) {
+    return;
+  }
+  dispatch.failed->store(true, std::memory_order_release);
+  static std::atomic<bool> failure_logged{false};
+  if (!failure_logged.exchange(true)) {
+    REXGPU_ERROR("Frame generation: its {} failed ({}); giving frame generation up", what,
+                 result);
+  }
+}
