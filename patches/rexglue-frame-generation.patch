diff --git a/src/graphics/shaders/fg_depth_copy.cs.xesl b/src/graphics/shaders/fg_depth_copy.cs.xesl
new file mode 100644
index 0000000..a30b152
--- /dev/null
+++ b/src/graphics/shaders/fg_depth_copy.cs.xesl
@@ -0,0 +1,50 @@
+// Frame generation (rexglue-frame-generation.patch), Vulkan: the frame's depth
+// (the anti-aliasing draw's, a 2D array texture as the guest's textures are)
+// copied into an image of its own for generation's preparation at the swap
+// (the guest's textures can't be a transfer source here, and the UI may
+// resolve into the same memory before the swap).
+
+#include "../../ui/shaders/xesl.xesli"
+
+#if SHADING_LANGUAGE_GLSL_XE
+  #define XeFgDepthTexture texture2DArray
+  #define XeFgDepthFetch(texture_name, position) \
+      texelFetch(texture_name, int3_xe(position, 0), 0)
+  #define XeFgDepthFormat r32f
+  #define XeFgDepthStore(name, position, value) \
+      imageStore(name, int2_xe(position), float4_xe(value, 0.0f, 0.0f, 0.0f))
+#else
+  #define XeFgDepthTexture Texture2DArray<float4_xe>
+  #define XeFgDepthFetch(texture_name, position) \
+      ((texture_name).Load(int4_xe(position, 0, 0)))
+  #define XeFgDepthFormat float
+  #define XeFgDepthStore(name, position, value) name[position] = (value)
+#endif
+
+push_const_begin_xe(b0, space0)
+  uint2_xe xe_fg_depth_copy_size;
+push_const_end_xe
+
+#define LOCAL_SIZE_X_XE 16
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+
+entry_bindings_begin_compute_xe
+  push_const_binding_xe(buffer(0))
+  entry_binding_next_xe
+  texture_xe(XeFgDepthTexture, xe_fg_depth_copy_source, set=0, binding=0, t0, space0,
+             texture(0))
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, XeFgDepthFormat, xe_fg_depth_copy_dest, set=1, binding=0, u0,
+              space0, texture(1))
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+  uint2_xe pixel_index = in_global_thread_id_xe.xy;
+  dont_flatten_xe
+  if (any(greater_than_equal_xe(pixel_index, push_const_xe(xe_fg_depth_copy_size)))) {
+    return;
+  }
+  XeFgDepthStore(xe_fg_depth_copy_dest, pixel_index,
+                 XeFgDepthFetch(xe_fg_depth_copy_source, int2_xe(pixel_index)).r);
+entry_code_end_compute_xe
diff --git a/src/graphics/shaders/fg_hudless_downscale.cs.xesl b/src/graphics/shaders/fg_hudless_downscale.cs.xesl
new file mode 100644
index 0000000..ea7c25a
--- /dev/null
+++ b/src/graphics/shaders/fg_hudless_downscale.cs.xesl
@@ -0,0 +1,51 @@
+// Frame generation (rexglue-frame-generation.patch): the HUD-less image
+// (hdr_refresh_fg.cs.xesl's code values for generation) scaled down to the
+// generation size, the size the real frame is shown at when that is smaller
+// than the guest output: bilinear, at the positions the presenter's bilinear
+// scaling of the real frame samples (pixel centres), so both are scaled alike.
+
+#include "../../ui/shaders/xesl.xesli"
+
+push_const_begin_xe(b0, space0)
+  uint2_xe xe_fg_downscale_source_size;
+  uint2_xe xe_fg_downscale_dest_size;
+push_const_end_xe
+
+#define LOCAL_SIZE_X_XE 16
+#define LOCAL_SIZE_Y_XE 8
+#define LOCAL_SIZE_Z_XE 1
+
+entry_bindings_begin_compute_xe
+  push_const_binding_xe(buffer(0))
+  entry_binding_next_xe
+  texture_xe(texture_2d_xe, xe_fg_downscale_source, set=0, binding=0, t0, space0,
+             texture(0))
+  entry_binding_next_xe
+  image_wo_xe(image_2d_xe, image_format_rgba16f_xe, xe_fg_downscale_dest, set=1,
+              binding=0, u0, space0, texture(1))
+entry_bindings_end_inputs_begin_compute_xe
+  entry_in_global_thread_id_xe
+entry_inputs_end_code_begin_compute_xe
+  uint2_xe pixel_index = in_global_thread_id_xe.xy;
+  uint2_xe dest_size = push_const_xe(xe_fg_downscale_dest_size);
+  dont_flatten_xe
+  if (any(greater_than_equal_xe(pixel_index, dest_size))) {
+    return;
+  }
+  uint2_xe source_size = push_const_xe(xe_fg_downscale_source_size);
+  float2_xe position = max((float2_xe(pixel_index) + 0.5f) * float2_xe(source_size) /
+                               float2_xe(dest_size) -
+                               0.5f,
+                           float2_xe(0.0f, 0.0f));
+  float2_xe position_floor = floor(position);
+  float2_xe fraction = position - position_floor;
+  int2_xe p0 = int2_xe(min(position_floor, float2_xe(source_size) - 1.0f));
+  int2_xe p1 = int2_xe(min(position_floor + 1.0f, float2_xe(source_size) - 1.0f));
+  float4_xe c00 = texel_fetch_2d_xe(xe_fg_downscale_source, p0, 0);
+  float4_xe c10 = texel_fetch_2d_xe(xe_fg_downscale_source, int2_xe(p1.x, p0.y), 0);
+  float4_xe c01 = texel_fetch_2d_xe(xe_fg_downscale_source, int2_xe(p0.x, p1.y), 0);
+  float4_xe c11 = texel_fetch_2d_xe(xe_fg_downscale_source, p1, 0);
+  float4_xe top = c00 + (c10 - c00) * fraction.x;
+  float4_xe bottom = c01 + (c11 - c01) * fraction.x;
+  image_store_2d_rgba_xe(xe_fg_downscale_dest, pixel_index, top + (bottom - top) * fraction.y);
+entry_code_end_compute_xe
