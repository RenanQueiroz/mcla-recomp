+struct VulkanCommandProcessor::FgContext {
+  // The context for a generation and render size, made on another thread (it
+  // takes a while); a failure stays one for its sizes.
+  enum State : uint32_t { kNone, kCreating, kReady, kFailed };
+  std::atomic<uint32_t> state{kNone};
+  std::thread thread;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t render_width = 0;
+  uint32_t render_height = 0;
+#if defined(REX_HAS_FSR) && REX_HAS_FSR
+  FsrRuntime runtime;
+  ffxContext context = nullptr;
+#endif
+  // Set on the submission thread when a frame's generation failed (its
+  // generated frame isn't shown, and generation is given up).
+  std::atomic<bool> dispatch_failed{false};
+  bool given_up = false;
+  // Released contexts, destroyed once the submissions that may use them are
+  // done.
+  std::vector<std::pair<uint64_t, void*>> retired;
+  // FidelityFX's frame IDs: one more per generated frame.
+  uint64_t next_frame_id = 1;
+  // The next generation has no history (the first, after a frame without).
+  bool reset_next = true;
+  // Guest frames in a row without generation; after many, the context (hundreds
+  // of MB at 4K) is released until generation can run again.
+  uint32_t frames_without_generation = 0;
+  // frame_generation_timing (development): timestamps around generation and
+  // the compose, a pair per slot, read once its submission is done.
+  static constexpr uint32_t kTimerSlots = 4;
+  VkQueryPool timer_pool = VK_NULL_HANDLE;
+  PFN_vkCmdWriteTimestamp write_timestamp = nullptr;
+  PFN_vkGetQueryPoolResults get_results = nullptr;
+  uint64_t timer_submission[kTimerSlots] = {};  // 0: free
+  uint32_t timer_next = 0;
+  double timer_tick_ms = 0.0;
+  double timer_ms = 0.0;
+  uint32_t timer_count = 0;
+};
+
+void VulkanCommandProcessor::FgContextDeleter::operator()(FgContext* context) const {
+  if (context->thread.joinable()) {
+    context->thread.join();
+  }
+  delete context;
+}
