+    whole.width = 2.0f;
+    whole.height = -2.0f;
+    command_list->SetGraphicsRoot32BitConstants(UINT(GuestOutputPaintRootParameter::kRectangle),
+                                                sizeof(whole) / sizeof(uint32_t), &whole, 0);
