+#ifdef XE_HDR_REFRESH_FG
+// Code values to frame generation's input: 0.75 times, and a rational shoulder
+// above 0.8 that approaches 1 without reaching it.
+float3_xe XeHdrRefreshFgEncode(float3_xe code, bool sdr) {
+  dont_flatten_xe if (sdr) {
+    return max(code, XeHdrSplat(0.0f));
+  }
+  float3_xe v = max(code, XeHdrSplat(0.0f)) * 0.75f;
+  float3_xe x = max(v - 0.8f, XeHdrSplat(0.0f));
+  return select_xe(greater_than_xe(v, XeHdrSplat(0.8f)), 0.8f + 0.2f * x / (x + 0.2f), v);
+}
+// Its inverse.
+float3_xe XeHdrRefreshFgDecode(float3_xe v, bool sdr) {
+  v = max(v, XeHdrSplat(0.0f));
+  dont_flatten_xe if (sdr) {
+    return v;
+  }
+  float3_xe y = min(v - 0.8f, XeHdrSplat(0.1999f));
+  float3_xe x = 0.2f * y / (0.2f - y);
+  return select_xe(greater_than_xe(v, XeHdrSplat(0.8f)), 0.8f + x, v) * (1.0f / 0.75f);
+}
+#endif
