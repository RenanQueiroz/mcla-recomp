new file mode 100644
index 0000000..5956c12
--- /dev/null
+++ b/src/graphics/frame_generation_fsr.h
@@ -0,0 +1,26 @@
+/**
+ * Frame generation (rexglue-frame-generation.patch): AMD FSR 3.1's frame
+ * generation from the same FidelityFX runtime as the temporal anti-aliasing
+ * (temporal_aa_fsr.h, cmake/rexglue_fsr.cmake).
+ */
