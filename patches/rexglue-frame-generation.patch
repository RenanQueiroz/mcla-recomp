+/**
+ ******************************************************************************
+ * ReXGlue: frame generation (rexglue-frame-generation.patch), Vulkan side of  *
+ * the presenter: the image the refresher composes the generated frame into,  *
+ * the present images (a pair per frame) and the pacer thread.                *
+ ******************************************************************************
+ *
+ * On Vulkan the refresher generates (the command processor has FidelityFX's
+ * context, gpu vulkan/frame_generation.cpp) in the frame's own submission. The
+ * guest output thread's paint right after it puts the generated frame and the
+ * real one into the two present images of a pair (as the real frame is
+ * painted: bilinear, with the UI overlay) and hands the pair to the pacer,
+ * which copies each into a swapchain image and presents it on a queue of its
+ * own: the generated frame as soon as it's ready, the real one half a frame
+ * later (AMD's pacing).
+ */
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <thread>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ui/vulkan/presenter.h>
+#include <rex/ui/vulkan/util.h>
+
+REXCVAR_DEFINE_INT32(frame_generation_dump, 0, "GPU",
+                     "Development: when changed to a positive value, the frame pacer (Vulkan, "
+                     "frame generation) writes that many of the next images it presents as "
+                     "PPM files into frame_generation_dump_path (HDR10: 10-bit PQ codes)")
+    .range(0, 1000);
+REXCVAR_DEFINE_STRING(frame_generation_dump_path, "", "GPU",
+                      "Development: the folder frame_generation_dump writes into");
+REXCVAR_DECLARE(int32_t, frame_generation_debug);
+
+namespace rex {
+namespace ui {
+namespace vulkan {
+
+namespace {
+// Waits on the pacer's side are cut into these, to see device loss and
+// requests to stop.
+constexpr uint64_t kFramePacerWaitSliceNs = 100'000'000;
+constexpr auto kFramePacerWaitSlice = std::chrono::milliseconds(100);
+
+uint64_t SteadyNs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+}  // namespace
+
+bool VulkanPresenter::SupportsFrameGeneration() const {
+  // The pacer's synchronisation needs timeline semaphores (Vulkan 1.2); the
+  // device asks for them with frame generation on Windows only, until it is
+  // checked elsewhere (phase 5).
+  return REX_PLATFORM_WIN32 && vulkan_device_->properties().timelineSemaphore;
+}
+
+void VulkanPresenter::PrepareGuestOutputThreadPaint() {
+  // Back-pressure, before the paint lock is taken: until the pacer has taken
+  // the previous frame. Bounded, so a present or acquire blocked in the driver
+  // never holds the guest output thread (and through the lock, the UI thread).
+  if (!frame_pacer_connected_.load(std::memory_order_acquire)) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(frame_pacer_mutex_);
+  const uint64_t wait_start_ns = SteadyNs();
+  if (!frame_pacer_condition_.wait_for(lock, std::chrono::seconds(1), [this] {
+        return frame_pacer_taken_ >= frame_pacer_pushed_ || frame_pacer_paused_ ||
+               (frame_pacer_status_.load(std::memory_order_relaxed) &
+                kFramePacerStatusDeviceLost);
+      })) {
+    REXLOG_WARN("VulkanPresenter: the frame pacer hasn't taken a frame for 1 s (a present or "
+                "acquire blocked?)");
+  }
+  frame_pacer_blocked_ns_ += SteadyNs() - wait_start_ns;
+}
+
+void VulkanPresenter::CreateFramePacerFromUIThread() {
+  if (!frame_generation_wanted() || paint_context_.swapchain == VK_NULL_HANDLE) {
+    return;
+  }
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+  const VkExtent2D extent = paint_context_.swapchain_extent;
+
+  // The pacer: needs a queue of its own that can present to this surface and
+  // swapchain images it can copy into. Without them, painting goes as without
+  // frame generation on this connection (UI overlay painting isn't forced, so
+  // implicit vsync stays with the UI thread, and MAILBOX was allowed).
+  if (!paint_context_.swapchain_transfer_dst || paint_context_.pacer_queue_family == UINT32_MAX) {
+    REXLOG_WARN("VulkanPresenter: frame generation can't present on this connection (no queue of "
+                "its own that can present here and copy into the swapchain); painting as "
+                "without it");
+    SetFrameGenerationPresentingFromUIThread(false);
+    return;
+  }
+  if (frame_pacer_paint_timeline_ == VK_NULL_HANDLE) {
+    VkSemaphoreTypeCreateInfo semaphore_type_info = {};
+    semaphore_type_info.sType = VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO;
+    semaphore_type_info.semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE;
+    semaphore_type_info.initialValue = 0;
+    VkSemaphoreCreateInfo semaphore_create_info = {};
+    semaphore_create_info.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
+    semaphore_create_info.pNext = &semaphore_type_info;
+    VkFenceCreateInfo fence_create_info = {};
+    fence_create_info.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+    if (dfn.vkCreateSemaphore(device, &semaphore_create_info, nullptr,
+                              &frame_pacer_paint_timeline_) != VK_SUCCESS ||
+        dfn.vkCreateSemaphore(device, &semaphore_create_info, nullptr,
+                              &frame_pacer_copy_timeline_) != VK_SUCCESS ||
+        dfn.vkCreateFence(device, &fence_create_info, nullptr, &frame_pacer_acquire_fence_) !=
+            VK_SUCCESS) {
+      REXLOG_ERROR("VulkanPresenter: Failed to create the frame pacer's synchronisation objects");
+      util::DestroyAndNullHandle(dfn.vkDestroySemaphore, device, frame_pacer_paint_timeline_);
+      util::DestroyAndNullHandle(dfn.vkDestroySemaphore, device, frame_pacer_copy_timeline_);
+      util::DestroyAndNullHandle(dfn.vkDestroyFence, device, frame_pacer_acquire_fence_);
+      return;
+    }
