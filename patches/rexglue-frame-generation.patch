new file mode 100644
index 0000000..bacaaa7
--- /dev/null
+++ b/src/graphics/vulkan/frame_generation.cpp
@@ -0,0 +1,874 @@
+/**
+ * Frame generation on Vulkan (rexglue-frame-generation.patch): the command
+ * processor's part, which on Vulkan includes generation itself. FidelityFX's
+ * frame generation context comes from the same Vulkan runtime as FSR's
+ * (amd_fidelityfx_vk, cmake/rexglue_fsr.cmake, its swap chain provider a stub)
+ * and runs without a swap chain (FFX_FRAMEGENERATION_FLAG_NO_SWAPCHAIN_CONTEXT_NOTIFY):
+ * everything is in the frame's own submission, at the swap, before the next
+ * frame's work. The refresher writes the HUD-less image (hdr_refresh_fg.cs.xesl:
+ * the scene's code values before the UI, scaled to the generation size if
+ * smaller); the preparation reads this frame's depth (copied at the
+ * anti-aliasing draw, fg_depth_copy.cs.xesl) and motion vectors (temporal
+ * anti-aliasing's pass); generation interpolates between the previous HUD-less
+ * image and this one; and hdr_refresh_fg.cs composes the generated frame with
+ * this frame's UI layer and levels into the presenter's image. The presenter
+ * paints it and the real frame into a pair of present images, and its pacer
+ * shows the generated one half a frame before the real one
+ * (vulkan_presenter_frame_generation.cpp).
+ */
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <thread>
+#include <utility>
+#include <vector>
+
