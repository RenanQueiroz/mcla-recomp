+std::string GraphicsSystem::ShaderStorageReport(bool shutdown) {
+  if (!command_processor_) {
+    return {};
+  }
+  // On the command processor's thread, as InitializeShaderStorage.
+  std::string report;
+  if (command_processor_->is_paused()) {
+    report = command_processor_->ShaderStorageReport(shutdown);
+  } else {
+    rex::thread::Fence fence;
+    command_processor_->CallInThread([this, shutdown, &report, &fence]() {
+      report = command_processor_->ShaderStorageReport(shutdown);
+      fence.Signal();
+    });
+    fence.Wait();
+  }
+  return report;
+}
