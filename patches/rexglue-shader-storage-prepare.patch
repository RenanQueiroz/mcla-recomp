+std::string VulkanCommandProcessor::ShaderStorageReport(bool shutdown) {
+  std::string storage = pipeline_cache_ ? pipeline_cache_->ShaderStorageReport(shutdown) : "";
+  if (storage.empty()) {
+    return storage;
+  }
+  // The device and its driver: the driver's version and the pipeline cache UUID (what a driver
+  // update changes).
+  std::string adapter = "{}";
+  if (const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice()) {
+    VkPhysicalDeviceProperties properties = {};
+    vulkan_device->vulkan_instance()->functions().vkGetPhysicalDeviceProperties(
+        vulkan_device->physical_device(), &properties);
+    std::string uuid;
+    for (uint8_t byte : properties.pipelineCacheUUID) {
+      uuid += fmt::format("{:02x}", byte);
+    }
+    adapter = fmt::format(
+        "{{\"name\":{},\"vendor\":{},\"device\":{},\"driver_version\":{},"
+        "\"pipeline_cache_uuid\":\"{}\"}}",
+        ShaderStorageJsonString(properties.deviceName), properties.vendorID, properties.deviceID,
+        properties.driverVersion, uuid);
+  }
+  return fmt::format(
+      "{{\"api\":\"vulkan\",{},\"adapter\":{},\"resolution_scale\":[{},{}],\"edram_tiles\":{}}}",
+      storage, adapter,
+      render_target_cache_ ? render_target_cache_->draw_resolution_scale_x() : 0,
+      render_target_cache_ ? render_target_cache_->draw_resolution_scale_y() : 0,
+      graphics_system_->edram_tile_count());
+}
