+std::string D3D12CommandProcessor::ShaderStorageReport(bool shutdown) {
+  std::string storage = pipeline_cache_ ? pipeline_cache_->ShaderStorageReport(shutdown) : "";
+  if (storage.empty()) {
+    return storage;
+  }
+  // The adapter the device is on, and its user-mode driver's version (what a driver update
+  // changes).
+  std::string adapter = "{}";
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  IDXGIFactory4* factory = nullptr;
+  if (provider.GetDevice() && provider.GetDXGIFactory() &&
+      SUCCEEDED(provider.GetDXGIFactory()->QueryInterface(IID_PPV_ARGS(&factory)))) {
+    IDXGIAdapter1* dxgi_adapter = nullptr;
+    if (SUCCEEDED(factory->EnumAdapterByLuid(provider.GetDevice()->GetAdapterLuid(),
+                                             IID_PPV_ARGS(&dxgi_adapter)))) {
+      DXGI_ADAPTER_DESC1 desc;
+      if (SUCCEEDED(dxgi_adapter->GetDesc1(&desc))) {
+        LARGE_INTEGER umd_version{};
+        std::string driver;
+        if (SUCCEEDED(dxgi_adapter->CheckInterfaceSupport(__uuidof(IDXGIDevice), &umd_version))) {
+          driver = fmt::format(
+              "{}.{}.{}.{}", uint32_t(umd_version.HighPart) >> 16,
+              uint32_t(umd_version.HighPart) & 0xFFFF, uint32_t(umd_version.LowPart) >> 16,
+              uint32_t(umd_version.LowPart) & 0xFFFF);
+        }
+        adapter = fmt::format(
+            "{{\"name\":{},\"vendor\":{},\"device\":{},\"subsys\":{},\"revision\":{},"
+            "\"driver\":{}}}",
+            ShaderStorageJsonString(
+                rex::string::to_utf8(std::u16string_view(reinterpret_cast<const char16_t*>(desc.Description)))),
+            desc.VendorId, desc.DeviceId, desc.SubSysId, desc.Revision,
+            ShaderStorageJsonString(driver));
+      }
+      dxgi_adapter->Release();
+    }
+    factory->Release();
+  }
+  return fmt::format(
+      "{{\"api\":\"d3d12\",{},\"adapter\":{},\"resolution_scale\":[{},{}],\"edram_tiles\":{}}}",
+      storage, adapter,
+      render_target_cache_ ? render_target_cache_->draw_resolution_scale_x() : 0,
+      render_target_cache_ ? render_target_cache_->draw_resolution_scale_y() : 0,
+      graphics_system_->edram_tile_count());
+}
