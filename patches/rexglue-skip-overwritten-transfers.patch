+bool RenderTargetCache::GetOverwrittenRectangle(const Shader& vertex_shader,
+                                                const Shader& pixel_shader,
+                                                reg::RB_DEPTHCONTROL normalized_depth_control,
+                                                uint32_t normalized_color_mask,
+                                                Transfer::Rectangle& rectangle_out) {
+  const RegisterFile& regs = register_file();
+
+  // One rectangle (the host draws a rectangle list as two triangles that cover
+  // it exactly, with the fourth vertex mirrored across the diagonal).
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (vgt_draw_initiator.prim_type != xenos::PrimitiveType::kRectangleList ||
+      vgt_draw_initiator.num_indices != 3 ||
+      vgt_draw_initiator.source_select != xenos::SourceSelect::kAutoIndex ||
+      (xenos::IsMajorModeExplicit(vgt_draw_initiator.major_mode, vgt_draw_initiator.prim_type) &&
+       regs.Get<reg::VGT_OUTPUT_PATH_CNTL>().path_select ==
+           xenos::VGTOutputPath::kTessellationEnable)) {
+    return false;
+  }
+  auto pa_cl_clip_cntl = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  if (pa_cl_clip_cntl.ucp_ena || pa_su_sc_mode_cntl.cull_front || pa_su_sc_mode_cntl.cull_back ||
+      pa_su_sc_mode_cntl.poly_mode != xenos::PolygonModeEnable::kDisabled ||
+      pa_su_sc_mode_cntl.poly_offset_front_enable || pa_su_sc_mode_cntl.poly_offset_back_enable ||
+      pa_su_sc_mode_cntl.poly_offset_para_enable) {
+    return false;
+  }
+
+  // Nothing but color, all components of every color render target replaced:
+  // the blending is a plain replacement, and nothing masked, discarded or
+  // tested away.
+  if (normalized_depth_control.z_enable || normalized_depth_control.stencil_enable ||
+      !normalized_color_mask) {
+    return false;
+  }
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    uint32_t rt_write_mask = (normalized_color_mask >> (4 * i)) & 0b1111;
+    if (!rt_write_mask) {
+      continue;
+    }
+    if (rt_write_mask != 0b1111) {
+      return false;
+    }
+    auto rb_blendcontrol =
+        regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[i]);
+    if (rb_blendcontrol.color_srcblend != xenos::BlendFactor::kOne ||
+        rb_blendcontrol.color_destblend != xenos::BlendFactor::kZero ||
+        rb_blendcontrol.color_comb_fcn != xenos::BlendOp::kAdd ||
+        rb_blendcontrol.alpha_srcblend != xenos::BlendFactor::kOne ||
+        rb_blendcontrol.alpha_destblend != xenos::BlendFactor::kZero ||
+        rb_blendcontrol.alpha_comb_fcn != xenos::BlendOp::kAdd) {
+      return false;
+    }
+  }
+  auto rb_colorcontrol = regs.Get<reg::RB_COLORCONTROL>();
+  if (pixel_shader.kills_pixels() ||
+      (rb_colorcontrol.alpha_test_enable &&
+       rb_colorcontrol.alpha_func != xenos::CompareFunction::kAlways) ||
+      rb_colorcontrol.alpha_to_mask_enable) {
+    return false;
+  }
+  auto rb_surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  xenos::MsaaSamples msaa_samples = rb_surface_info.msaa_samples;
+  if (msaa_samples > xenos::MsaaSamples::k4X || !rb_surface_info.surface_pitch) {
+    return false;
+  }
+
+  // The vertices, on the CPU. The vertex shader may fetch textures (the tone
+  // map's reads the exposure for the pixel shader), whose results are not
+  // known, but only if the position and the vertex kill flag don't depend on
+  // them.
+  ShaderInterpreter& interpreter = clear_rectangle_shader_interpreter_;
+  ClearRectangleVertexExportSink vertices[3];
+  interpreter.SetShader(vertex_shader.type(), vertex_shader.ucode_dwords());
+  uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  uint32_t min_index = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  uint32_t max_index = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+  bool vertices_known = true;
+  for (uint32_t i = 0; i < 3 && vertices_known; ++i) {
+    interpreter.SetExportSink(&vertices[i]);
+    // Like the host's registers, zero except for the vertex index.
+    float* temps = interpreter.temp_registers();
+    std::fill(temps, temps + 4 * xenos::kMaxShaderTempRegisters, 0.0f);
+    temps[0] = float(std::min(max_index, std::max(min_index, (i + index_offset) & 0xFFFFFF)));
+    interpreter.Execute();
+    vertices_known =
+        !interpreter.IsExportTainted(ucode::ExportRegister::kVSPosition) &&
+        !interpreter.IsExportTainted(ucode::ExportRegister::kVSPointSizeEdgeFlagKillVertex);
+  }
+  interpreter.SetExportSink(nullptr);
+  if (!vertices_known) {
+    return false;
+  }
+
+  // The vertices in pixels, as the host shaders transform them: the division
+  // by W if it hasn't been done, the viewport, the window and the half-pixel
+  // offsets.
+  auto pa_cl_vte_cntl = regs.Get<reg::PA_CL_VTE_CNTL>();
+  float viewport_scale[2] = {
+      pa_cl_vte_cntl.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0f,
+      pa_cl_vte_cntl.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0f,
+  };
+  float offset[2] = {
+      pa_cl_vte_cntl.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0f,
+      pa_cl_vte_cntl.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0f,
+  };
+  if (pa_su_sc_mode_cntl.vtx_window_offset_enable) {
+    auto pa_sc_window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+    offset[0] += float(pa_sc_window_offset.window_x_offset);
+    offset[1] += float(pa_sc_window_offset.window_y_offset);
+  }
+  if (REXCVAR_GET(half_pixel_offset) &&
+      regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero) {
+    offset[0] += 0.5f;
+    offset[1] += 0.5f;
+  }
+  float pixels[3][2];
+  for (uint32_t i = 0; i < 3; ++i) {
+    const ClearRectangleVertexExportSink& vertex = vertices[i];
+    float w = vertex.position[3];
+    if (vertex.killed || vertex.position_mask != 0b1111 || !(w > 0.0f) || !(w < FLT_MAX)) {
+      return false;
+    }
+    // The factor the host shaders multiply by: 1 / W, or W as it is if the
+    // vertex shader gives 1 / W.
+    float w_factor = pa_cl_vte_cntl.vtx_w0_fmt ? 1.0f / w : w;
+    float xy_factor = pa_cl_vte_cntl.vtx_xy_fmt ? 1.0f : w_factor;
+    if (!pa_cl_clip_cntl.clip_disable) {
+      // Not clipped away by the near and the far planes.
+      float z = vertex.position[2] * (pa_cl_vte_cntl.vtx_z_fmt ? 1.0f : w_factor);
+      if (!(z >= (pa_cl_clip_cntl.dx_clip_space_def ? 0.0f : -1.0f) && z <= 1.0f)) {
+        return false;
+      }
+    }
+    for (uint32_t j = 0; j < 2; ++j) {
+      pixels[i][j] = vertex.position[j] * xy_factor * viewport_scale[j] + offset[j];
+    }
+  }
+  // Three corners of one axis-aligned rectangle.
+  float edges[2][2];
+  for (uint32_t i = 0; i < 2; ++i) {
+    float a = pixels[0][i], b = pixels[1][i], c = pixels[2][i];
+    edges[i][0] = std::min(a, std::min(b, c));
+    edges[i][1] = std::max(a, std::max(b, c));
+    if (!(edges[i][0] < edges[i][1]) || (a != edges[i][0] && a != edges[i][1]) ||
+        (b != edges[i][0] && b != edges[i][1]) || (c != edges[i][0] && c != edges[i][1]) ||
+        !(edges[i][0] > -4096.0f) || !(edges[i][1] < 4096.0f)) {
+      return false;
+    }
+  }
+  for (uint32_t i = 0; i < 3; ++i) {
+    for (uint32_t j = i + 1; j < 3; ++j) {
+      if (pixels[i][0] == pixels[j][0] && pixels[i][1] == pixels[j][1]) {
+        return false;
+      }
+    }
+  }
+
+  // What's rewritten: the pixels whose whole area is surely covered, by the
+  // rectangle and within the viewport (as the host sets it) and the scissor.
+  // Without MSAA the host covers a pixel if its center is within the
+  // rectangle, or on its left or upper edge (the top-left rule); the vertices
+  // are rounded to 1/256 of a pixel (at least 1/16 on Vulkan), the center
+  // stands exactly at a 1/2 of a pixel, so a vertex that is within 1/1024 of
+  // the center on the left or the upper edge is still rounded to it, and one
+  // on the lower or the right edge needs the center to be 1/256 inside. With
+  // MSAA, all the samples in the pixel, at least 1/8 of it from its sides, are
+  // taken to be covered 1/64 inside the rectangle. With resolution scaling, a
+  // guest pixel is surely covered when all its host pixels are, which doesn't
+  // hold for the first one when the half-pixel offset moves the left side to
+  // the middle of a guest pixel: this is left to be transferred.
+  draw_util::ViewportInfo viewport_info;
+  draw_util::GetHostViewportInfo(regs, 1, 1, false, 4096, 4096, true, normalized_depth_control,
+                                 false, false, false, viewport_info);
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  uint32_t pitch_tiles_at_32bpp =
+      ((rb_surface_info.surface_pitch << uint32_t(msaa_samples >= xenos::MsaaSamples::k4X)) +
+       (xenos::kEdramTileWidthSamples - 1)) /
+      xenos::kEdramTileWidthSamples;
+  uint32_t limits[2] = {
+      rb_surface_info.surface_pitch,
+      GetRenderTargetHeight(pitch_tiles_at_32bpp, msaa_samples),
+  };
+  int32_t covered[2][2];
+  for (uint32_t i = 0; i < 2; ++i) {
+    float scale = float(i ? draw_resolution_scale_y() : draw_resolution_scale_x());
+    float host_low = edges[i][0] * scale;
+    float host_high = edges[i][1] * scale;
+    float low_pixel, high_pixel_exclusive;
+    if (msaa_samples == xenos::MsaaSamples::k1X) {
+      low_pixel = std::ceil((host_low - 0.5f - 1.0f / 1024.0f) / scale);
+      high_pixel_exclusive =
+          std::floor((host_high - 0.5f - 1.0f / 256.0f - scale + 1.0f) / scale) + 1.0f;
+    } else {
+      low_pixel = std::ceil((host_low - 0.109375f) / scale);
+      high_pixel_exclusive = std::floor((host_high + 0.109375f) / scale);
+    }
+    int32_t low = int32_t(std::max(low_pixel, 0.0f));
+    int32_t high = int32_t(std::min(high_pixel_exclusive, 4096.0f));
+    low = std::max(low, int32_t(std::max(viewport_info.xy_offset[i], scissor.offset[i])));
+    high = std::min(high, int32_t(std::min(viewport_info.xy_offset[i] + viewport_info.xy_extent[i],
+                                           scissor.offset[i] + scissor.extent[i])));
+    high = std::min(high, int32_t(limits[i]));
+    if (low >= high) {
+      return false;
+    }
+    covered[i][0] = low;
+    covered[i][1] = high;
+  }
+  rectangle_out.x_pixels = uint32_t(covered[0][0]);
+  rectangle_out.y_pixels = uint32_t(covered[1][0]);
+  rectangle_out.width_pixels = uint32_t(covered[0][1] - covered[0][0]);
+  rectangle_out.height_pixels = uint32_t(covered[1][1] - covered[1][0]);
+  return true;
+}
