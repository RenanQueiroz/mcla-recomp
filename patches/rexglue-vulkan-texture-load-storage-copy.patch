+  if (!IsStorageImageFormat(storage_copy_format)) {
+    return VK_FORMAT_UNDEFINED;
+  }
+  for (uint32_t i = 0; i < view_format_count; ++i) {
+    if (!IsStorageImageFormat(view_formats[i])) {
+      return VK_FORMAT_UNDEFINED;
+    }
+  }
+  return storage_copy_format;
