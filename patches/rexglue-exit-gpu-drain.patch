+bool GraphicsSystem::StopForProcessExit(uint32_t timeout_ms) {
+  if (!command_processor_ || !timeout_ms) {
+    return true;
+  }
+  // CommandProcessor::Shutdown ends the worker thread, which first waits for the GPU to finish the
+  // submitted work, joins the pipeline creation threads and the storage writer, and releases the
+  // host GPU objects. It runs on a thread of its own so that a worker stuck in the driver costs
+  // timeout_ms and not the process's exit. After it the object must not be shut down again (nothing
+  // does: the process ends next).
+  struct State {
+    std::mutex mutex;
+    std::condition_variable cv;
+    bool done = false;
+  };
+  auto state = std::make_shared<State>();
+  CommandProcessor* processor = command_processor_.get();
+  std::thread([processor, state]() {
+    processor->Shutdown();
+    {
+      std::lock_guard<std::mutex> lock(state->mutex);
+      state->done = true;
+    }
+    state->cv.notify_all();
+  }).detach();
+  std::unique_lock<std::mutex> lock(state->mutex);
+  return state->cv.wait_for(lock, std::chrono::milliseconds(timeout_ms),
+                            [&state]() { return state->done; });
+}
