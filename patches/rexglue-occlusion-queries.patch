+bool CommandProcessor::OcclusionDrawLogWanted() const {
+  if (!occlusion_guest_open_ || !occlusion_host_began_ || REXCVAR_GET(occlusion_query_log) <= 0) {
+    return false;
+  }
+  const uint64_t query = occlusion_stats_.begins;
+  return query <= kOcclusionDrawLogFirstQueries || query % kOcclusionDrawLogEvery == 0;
