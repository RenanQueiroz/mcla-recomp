+uint64_t CommandProcessor::WriteOcclusionCounts(xenos::xe_gpu_depth_sample_counts* sample_counts,
+                                                uint32_t samples) {
+  sample_counts->Total_A = samples;
+  sample_counts->Total_B = 0;
+  sample_counts->ZFail_A = 0;
+  sample_counts->ZFail_B = 0;
+  sample_counts->StencilFail_A = 0;
+  sample_counts->StencilFail_B = 0;
+  // The ZPass words last, both in one store: the game takes the query as finished as soon as one
+  // of them differs from 0xFFFFFEED, and adds them up (the struct is little-endian: A is the low
+  // word).
+  std::atomic_thread_fence(std::memory_order_release);
+  const uint64_t zpass = samples;
+  std::memcpy(&sample_counts->ZPass_A, &zpass, sizeof(zpass));
+  return zpass;
+}
+
+bool CommandProcessor::OcclusionGuessSamples(uint32_t& samples_out) const {
+  // The newest real count the host has delivered (a few frames old: the depth of its GPU queue),
+  // as xenia-canary's fast mode tells the guest the last real delta before the real one lands.
+  if (occlusion_latest_valid_) {
+    samples_out = occlusion_latest_samples_;
+    return true;
+  }
+  const int32_t fake_sample_count = REXCVAR_GET(query_occlusion_fake_sample_count);
+  if (fake_sample_count >= 0) {
+    samples_out = uint32_t(fake_sample_count);
+    return true;
+  }
+  return false;
+}
+
+void CommandProcessor::DropPendingOcclusionResult(uint32_t end_address) {
+  for (auto it = occlusion_pending_.begin(); it != occlusion_pending_.end();) {
+    if (it->end_address == end_address) {
+      it = occlusion_pending_.erase(it);
+      ++occlusion_stats_.superseded;
+    } else {
+      ++it;
+    }
+  }
+}
+
+bool CommandProcessor::ExecuteGuestOcclusionEvent(
+    uint32_t address, xenos::xe_gpu_depth_sample_counts* sample_counts, bool sentinel_present) {
+  OcclusionStats& stats = occlusion_stats_;
+  ++occlusion_events_;
+  const int32_t log_events = REXCVAR_GET(occlusion_query_log);
+  const bool log_event = log_events > 0 && occlusion_events_ <= uint64_t(log_events);
+
+  // Which event it is. An event 0x20 below the open begin's address is that query's end, whatever
+  // the snapshot holds: the sentinel the game stores there with the CPU could be gone (a count
+  // written late over it), and an end taken for a begin would zero the snapshot and the game
+  // would read a count of 0. Anything else goes by the sentinel.
+  bool is_end;
+  if (occlusion_guest_open_ && address + kOcclusionBeginOffset == occlusion_begin_address_) {
+    is_end = true;
+    if (!sentinel_present) {
+      ++stats.sentinel_lost;
+      if (stats.sentinel_lost <= 4) {
+        REXGPU_INFO(
+            "occlusion query end at {:08X} (swap {}): the snapshot does not hold the game's "
+            "sentinel; paired by address with the begin at {:08X}",
+            address, counter_, occlusion_begin_address_);
+      }
+    }
+  } else {
+    is_end = sentinel_present;
+  }
+
+  if (log_events > 0) {
+    // Every record the game queries, once, however late in the run: the users of occlusion queries.
+    const uint32_t record = is_end ? address : address - kOcclusionBeginOffset;
+    if (occlusion_seen_records_.size() < 64 && occlusion_seen_records_.insert(record).second) {
+      REXGPU_INFO(
+          "occlusion query: record {:08X} first used by a {} event at {:08X} (swap {}, event {}, "
+          "render phase {:08X})",
+          record, is_end ? "end" : "begin", address, counter_, occlusion_events_,
+          guest_marker_phase_);
+    }
+  }
+
+  if (!is_end) {
+    ++stats.begins;
+    // The begin snapshot starts from zero, so the end snapshot then holds the count of the query
+    // alone (the game subtracts the begin from the end).
+    std::memset(sample_counts, 0, sizeof(*sample_counts));
+    if (address >= kOcclusionBeginOffset) {
+      // A new use of the record: a count still on its way for the previous use must not land on it.
+      DropPendingOcclusionResult(address - kOcclusionBeginOffset);
+    }
+    if (occlusion_guest_open_) {
+      // One hardware counter: Direct3D 9 does not nest occlusion queries. The earlier one is lost.
+      ++stats.restarted;
+      if (HostOcclusionQueryRecording()) {
+        HostOcclusionQueryAbandon();
+      }
+      if (stats.restarted <= 4) {
+        REXGPU_INFO(
+            "occlusion query begin at {:08X} (swap {}) inside the open query begun at {:08X}: the "
+            "earlier host query is dropped",
+            address, counter_, occlusion_begin_address_);
+      }
+    }
+    occlusion_guest_open_ = true;
+    occlusion_begin_address_ = address;
+    occlusion_host_began_ = HostOcclusionQueryBegin();
+    occlusion_recorded_at_begin_ = host_draws_recorded_;
+    occlusion_draw_in_query_ = 0;
+    if (log_event) {
+      REXGPU_INFO("occlusion query begin at {:08X} (swap {}, event {}, render phase {:08X}): {}",
+                  address, counter_, occlusion_events_, guest_marker_phase_,
+                  occlusion_host_began_ ? "host query started" : "no host query");
+    }
+    return true;
+  }
+
+  ++stats.ends;
+  const bool was_open = occlusion_guest_open_;
+  const bool host_began = occlusion_host_began_;
+  const uint32_t begin_address = occlusion_begin_address_;
+  occlusion_guest_open_ = false;
+  occlusion_host_began_ = false;
+
+  if (was_open && host_began && HostOcclusionQueryRecording()) {
+    uint32_t host_index = 0;
+    uint64_t submission = 0;
+    uint32_t draws = 0;
+    if (HostOcclusionQueryEnd(host_index, submission, draws)) {
+      const uint32_t recorded = uint32_t(host_draws_recorded_ - occlusion_recorded_at_begin_);
+      stats.draws_seen += draws;
+      stats.draws_recorded += recorded;
+      DropPendingOcclusionResult(address);
+      // The newest count the host has (reading never waits), then what the game is told now.
+      PollOcclusionQueryResults();
+      uint32_t guess = 0;
+      if (OcclusionGuessSamples(guess)) {
+        WriteOcclusionCounts(sample_counts, guess);
+      }
+      uint64_t pair_after = 0;
+      std::memcpy(&pair_after, &sample_counts->ZPass_A, sizeof(pair_after));
+      occlusion_pending_.push_back(OcclusionPending{address, host_index, submission, draws,
+                                                    recorded, counter_, occlusion_events_,
+                                                    pair_after, OcclusionNowUs()});
+      if (occlusion_pending_.size() > kOcclusionMaxPending) {
+        occlusion_pending_.pop_front();
+        ++stats.dropped;
+      }
+      ++stats.issued;
+      if (begin_address != address + kOcclusionBeginOffset) {
+        ++stats.odd_pairs;
+        if (stats.odd_pairs <= 4) {
+          REXGPU_INFO(
+              "occlusion query end at {:08X} closes the query begun at {:08X} (not the record's "
+              "begin snapshot at {:08X}): paired by order",
+              address, begin_address, address + kOcclusionBeginOffset);
+        }
+      }
+      if (log_event) {
+        REXGPU_INFO(
+            "occlusion query end at {:08X} (swap {}, event {}): host query ended after {} draws, "
+            "{} recorded on the host (host query {}, submission {}); the game is told {} until "
+            "the count arrives",
+            address, counter_, occlusion_events_, draws, recorded, host_index, submission,
+            uint32_t(sample_counts->ZPass_A));
+      }
+      return true;
+    }
+  }
+
+  // No host query behind this end: the newest real count (the fake one before the first).
+  if (!was_open) {
+    ++stats.unpaired;
+  } else if (host_began) {
+    ++stats.cut;
+  } else {
+    ++stats.no_host;
+  }
+  uint32_t guess = 0;
+  if (OcclusionGuessSamples(guess)) {
+    WriteOcclusionCounts(sample_counts, guess);
+  }
+  if (log_event || stats.cut + stats.unpaired + stats.no_host <= 4) {
+    const char* why = !was_open
+                          ? "no query was open"
+                          : (host_began ? "the host query was cut by the end of a submission"
+                                        : "the begin got no host query");
+    REXGPU_INFO("occlusion query end at {:08X} (swap {}, event {}): {}; the game is told {}",
+                address, counter_, occlusion_events_, why, uint32_t(sample_counts->ZPass_A));
+  }
+  return true;
+}
+
+void CommandProcessor::PollOcclusionQueryResults() {
+  const int32_t log_events = REXCVAR_GET(occlusion_query_log);
+  while (!occlusion_pending_.empty()) {
+    const OcclusionPending pending = occlusion_pending_.front();
+    uint64_t samples = 0;
+    uint64_t raw_samples = 0;
+    if (!HostOcclusionQueryRead(pending.host_index, pending.submission, samples, raw_samples)) {
+      break;
+    }
+    occlusion_pending_.pop_front();
+    const uint32_t clamped = samples > uint64_t(UINT32_MAX) ? UINT32_MAX : uint32_t(samples);
+    // What the next end event tells the game.
+    occlusion_latest_valid_ = true;
+    occlusion_latest_samples_ = clamped;
+    OcclusionStats& stats = occlusion_stats_;
+    ++stats.delivered;
+    if (clamped) {
+      ++stats.nonzero;
+    }
+    stats.late_events += occlusion_events_ - pending.event_number;
+    const int64_t latency_us = std::max<int64_t>(0, OcclusionNowUs() - pending.end_time_us);
+    stats.latency_us += uint64_t(latency_us);
+    // Into the record too, if the game has not touched it since the end event (it may have read
+    // the guess already: then the count is for the next end event's guess only).
+    bool written = false;
+    auto* sample_counts =
+        memory_->TranslatePhysical<xenos::xe_gpu_depth_sample_counts*>(pending.end_address);
+    if (sample_counts) {
+      written = ReplaceOcclusionCounts(sample_counts, pending.guess_zpass, clamped);
+      if (written) {
+        ++stats.written;
+      }
+    }
+    if (log_events > 0 && (stats.delivered <= uint64_t(log_events) || stats.delivered % 120 == 0)) {
+      REXGPU_INFO(
+          "occlusion query result for {:08X}: {} samples ({} on the host), {} draws, {} recorded, "
+          "issued at swap {}, delivered at swap {} after {} events and {:.2f} ms, {} into the "
+          "record; begins {}, ends {}, host {}, delivered {} (nonzero {}, written {}), superseded "
+          "{}, dropped {}, cut {}, no host {}, unpaired {}, restarted {}, sentinel lost {}, odd "
+          "pairs {}",
+          pending.end_address, clamped, raw_samples, pending.draws, pending.draws_recorded,
+          pending.swap_counter, counter_, occlusion_events_ - pending.event_number,
+          double(latency_us) / 1000.0, written ? "written" : "not written", stats.begins,
+          stats.ends, stats.issued, stats.delivered, stats.nonzero, stats.written,
+          stats.superseded, stats.dropped, stats.cut, stats.no_host, stats.unpaired,
+          stats.restarted, stats.sentinel_lost, stats.odd_pairs);
+    }
+  }
+}
+
+void CommandProcessor::ClearOcclusionQueryState() {
+  occlusion_guest_open_ = false;
+  occlusion_host_began_ = false;
+  occlusion_pending_.clear();
+}
