+// Each draw's primitive type and render target path are decided once here,
+// and the update runs as a copy with both as constants, so its many branches
+// on them fold away (the split xenia-canary makes in its
+// UpdateSystemConstantValues).
 void D3D12CommandProcessor::UpdateSystemConstantValues(
     bool shared_memory_is_uav, bool primitive_polygonal, uint32_t line_loop_closing_index,
     xenos::Endian index_endian, const draw_util::ViewportInfo& viewport_info,
     uint32_t used_texture_mask, reg::RB_DEPTHCONTROL normalized_depth_control,
     uint32_t normalized_color_mask) {
+#define REX_SYSTEM_CONSTANT_ARGS                                                          \
+  shared_memory_is_uav, primitive_polygonal, line_loop_closing_index, index_endian,       \
+      viewport_info, used_texture_mask, normalized_depth_control, normalized_color_mask
+  if (!REXCVAR_GET(gpu_specialize_system_constants)) {
+    UpdateSystemConstantValuesImpl<false, false, false>(REX_SYSTEM_CONSTANT_ARGS);
+  } else if (render_target_cache_->GetPath() == RenderTargetCache::Path::kPixelShaderInterlock) {
+    if (primitive_polygonal) {
+      UpdateSystemConstantValuesImpl<true, true, true>(REX_SYSTEM_CONSTANT_ARGS);
+    } else {
+      UpdateSystemConstantValuesImpl<true, false, true>(REX_SYSTEM_CONSTANT_ARGS);
+    }
+  } else {
+    if (primitive_polygonal) {
+      UpdateSystemConstantValuesImpl<true, true, false>(REX_SYSTEM_CONSTANT_ARGS);
+    } else {
+      UpdateSystemConstantValuesImpl<true, false, false>(REX_SYSTEM_CONSTANT_ARGS);
+    }
+  }
+#undef REX_SYSTEM_CONSTANT_ARGS
+}
